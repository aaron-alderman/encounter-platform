    ".task-inspector-heading,.task-inspector-close{display:none}.task-workbench #approval-record:target,.task-workbench #activity-record:target{display:block;position:fixed;z-index:3;inset:clamp(.65rem,6vh,3.5rem) clamp(.65rem,6vw,5rem) auto auto;width:min(42rem,calc(100vw - 2 * clamp(.65rem,6vw,5rem)));max-height:calc(100dvh - 2 * clamp(.65rem,6vh,3.5rem));overflow:auto;padding:clamp(.75rem,3vw,1.5rem);margin:0;border:1px solid #244858;border-top:5px solid #244858;background:#fff9e9;box-shadow:0 .65rem 2rem #182f3555;font-size:.875rem}.task-workbench :target>.task-inspector-heading,.task-workbench :target>.task-inspector-close{display:block}.task-inspector-close{float:inline-end;margin-block:0 .45rem;padding:.2rem .45rem;background:#e5e5cc;border:1px solid #a5ad99}.task-inspector-close:focus-visible{outline:2px solid #955713}.task-workbench #approval-record:target+.task-receipt-close{display:block;position:fixed;z-index:4;inset:calc(clamp(.65rem,6vh,3.5rem) + .65rem) calc(clamp(.65rem,6vw,5rem) + .65rem) auto auto}.task-workbench #approval-record:target>h2{padding-inline-end:7rem}",

process-module "temple/surface-process-module/1"

# Shared page and form projections.

process work.form:
  let spec = $eventInput
  let hidden = { _csrf = $spec.csrf; base = $spec.revision; action = $spec.action }
  port record.entries { value = $hidden } → coordinates
  let fields = map($coordinates, "entry", { tag = "input"; attrs = { type = "hidden"; name = at($entry, 0); value = at($entry, 1) }; children = list() })
  let children = append($fields, $spec.fields)
  let result = { tag = "form"; attrs = { method = "post"; action = "/"; class = $spec.style }; children = append($children, list({ tag = "button"; attrs = { type = "submit" }; children = list($spec.button) })) }

process work.addForm:
  let board = $eventInput
  let inputField = { tag = "label"; attrs = {}; children = list("New work item", { tag = "input"; attrs = { name = "title"; required = true; maxlength = 500 }; children = list() }) }
  port kernel.invoke { query = "work.form"; input = { csrf = $board.csrf; revision = $board.revision; action = "add"; fields = list($inputField); button = "Add work item"; style = "entry" } } → result

process work.page:
  let view = $eventInput
  let head = { tag = "head"; attrs = {}; children = list({ tag = "meta"; attrs = { charset = "utf-8" }; children = list() }, { tag = "meta"; attrs = { name = "viewport"; content = "width=device-width, initial-scale=1" }; children = list() }, { tag = "title"; attrs = {}; children = list($view.page.title) }, { tag = "link"; attrs = { rel = "stylesheet"; href = "/styles.css" }; children = list() }) }
  let heading = { tag = "header"; attrs = {}; children = list({ tag = "h1"; attrs = {}; children = list($view.page.title) }, { tag = "p"; attrs = {}; children = list($view.page.summary) }) }
  let feedback = { tag = "p"; attrs = { class = if($view.error, "feedback error", "feedback"); role = if($view.error, "alert", "status") }; children = list($view.notice) }
  let main = { tag = "main"; attrs = {}; children = append(list($heading, $feedback), $view.page.content) }
  let fragment = eq(at($view, "fragment"), true)
  let document = { tag = "html"; attrs = { lang = "en" }; children = list($head, { tag = "body"; attrs = {}; children = list($main) }) }
  let input = if($fragment, $main, $document)
  call html.serialize
  when not($fragment):
    let result = concat("<!doctype html>", $result)

process ui.styles:
  let result = concat(
    ".cb-workbench canvas[data-encounter-canvas]{width:100%;height:auto;display:block;background:#071b26;border-radius:.25rem;aspect-ratio:16/9}.cb-canvas-form.entry{display:grid;grid-template-columns:1fr;gap:.55rem}.cb-canvas-control{display:grid;grid-template-columns:1fr auto;gap:.15rem .5rem}.cb-canvas-control input{grid-column:1/-1;accent-color:#286b61;padding:0}.cb-canvas-control output,.cb-canvas-transport output{font-variant-numeric:tabular-nums}.cb-canvas-transport{display:flex;flex-wrap:wrap;gap:.4rem .75rem;align-items:center;margin:.6rem 0}.cb-canvas-transport label{flex:1 1 9rem;font-size:.8rem}.cb-canvas-transport .cb-canvas-audio-toggle{display:flex;align-items:center;flex:0 0 auto;gap:.35rem}.cb-canvas-audio-toggle input{width:auto}.cb-canvas-form button[data-canvas-reset]{background:transparent;color:#214c63}.cb-canvas-form textarea[hidden]{display:none}.cb-workbench #canvas-preview{scroll-margin-top:.6rem}",
    ".cb-review-player{width:min(calc(100% - 1.1rem),74rem);margin:10px auto;padding:12px 16px}.cb-review-player video{display:block;width:100%;max-height:65vh;margin:.55rem 0;background:#162a30}.cb-narration audio{display:block;width:100%;margin:.55rem 0}",

    ".cb-workbench .cb-review{margin:0}.cb-workbench #opening-candidate{margin:.5rem 0 0;scroll-margin-top:.75rem}.cb-review-grid{display:grid;grid-template-columns:minmax(0,2.5fr) minmax(16rem,1fr);gap:clamp(.85rem,2vw,1.65rem);margin-top:.5rem;align-items:start}.cb-screening{min-width:0}.cb-screening video,.cb-review-references video{display:block;width:100%;aspect-ratio:16/9;background:#111b26;border-radius:3px}.cb-screening section{margin:.7rem 0 0}.cb-screening section>h2{font:650 .86rem system-ui;margin:0}.cb-screening .nb1-tabs{border:0;background:none;padding:0;gap:.3rem}.cb-screening .nb1-tabs a{border:1px solid #a5ae9e;border-radius:3px;padding:.3rem .45rem}.cb-screening .nb1-tabs a[aria-current=true]{background:#e2d39e;border-color:#836c35;color:#243440}.cb-shot-inspector{padding:.85rem;background:#f5edd7;border:1px solid #acb6a4;min-width:0;overflow-wrap:anywhere}.cb-shot-inspector h2{font:500 clamp(1.3rem,2vw,1.65rem)/1.1 Georgia,serif;margin:.25rem 0 .55rem}.cb-shot-inspector #shot-feedback{border-top:1px solid #b5b7a3;margin:.75rem 0;padding-top:.75rem}.cb-shot-inspector #shot-feedback h3{font-size:.9rem}.cb-shot-inspector #shot-feedback li{padding:.5rem .65rem}.cb-review-references{display:grid;gap:.65rem;margin-top:1rem;border-top:1px solid #acb6a4;padding-top:.8rem}.cb-review-references details>details{margin:.55rem 0 0 .65rem}.cb-review-references summary{cursor:pointer;font-weight:650}.cb-review-references video{max-width:56rem;margin-top:.5rem}.cb-workbench #context>header [data-encounter-connection]{display:inline-block;margin-inline-start:.55rem}.cb-workbench [data-encounter-pending]:empty{display:none}@media(max-width:48rem){.cb-review-grid{grid-template-columns:minmax(0,1fr)}.cb-screening .nb1-tabs a{min-height:2rem}.cb-workbench .nb1-tabs>a{padding-block:.45rem}}",
    ":root{font:16px/1.5 system-ui,sans-serif;color:#192d36;background:#f3f7f6}",
    "*{box-sizing:border-box}body{margin:0}main{max-width:70rem;margin:auto;padding:clamp(1rem,4vw,3rem)}",
    "header{border-bottom:2px solid #1b685b;padding-bottom:1rem}h1,h2,h3,p{margin:0 0 .65rem}h1{font-size:clamp(2rem,5vw,3.4rem)}",
    "section,article{min-width:0}section{margin-block:1.2rem}ul{padding:0;list-style:none}li,article{background:white;border:1px solid #b8cdc7;border-radius:.65rem;padding:1rem;margin-block:.6rem;overflow-wrap:anywhere}",
    "label{display:grid;gap:.25rem;font-weight:600;min-width:0}input,select,textarea,button{font:inherit;min-width:0;padding:.45rem .7rem;border-radius:.4rem;border:1px solid #547269}input,select,textarea{color:inherit;background:white;width:100%;max-width:100%}",
    "button{background:#1b685b;color:white;border-color:#1b685b;cursor:pointer}button:hover{background:#164f45}button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{outline:3px solid #955713;outline-offset:3px}",
    "form{display:flex;align-items:end;gap:.6rem;flex-wrap:wrap;margin-block:.5rem}form.entry label{flex:1 1 16rem}form.inline label{flex:1 1 9rem}.feedback:empty{display:none}.feedback{margin-block:1rem;padding:.65rem;background:#e0f0e9}.error{background:#fbe6e4;color:#712722}",
    ".board{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}.board section{margin:0}.quiet{color:#435953}.done{border-left:.3rem solid #1b685b}",
    "@media(max-width:48rem){.board{grid-template-columns:1fr}form.entry button{width:100%}}",

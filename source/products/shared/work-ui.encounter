    ".nb1 p.nr-ed-approval-link{margin-top:.6rem;font-size:13px}.nb1 p.nr-ed-handoff-scope{max-width:58ch}.nb1-inspector-group+.nb1-inspector-group{margin-top:.7rem;padding-top:.55rem;border-top:1px solid var(--nb1-line)}.nb1-inspector-group h3{font:600 16px Georgia,serif;margin:0 0 .35rem}.nb1-inspector-head{position:sticky;top:-12px;background:var(--nb1-paper);padding-top:4px}",
    ".nb1{font-family:Tahoma,Verdana,Arial,sans-serif;background:#c8c7bf;border:2px outset #e2e1da}.nb1 .nb1-title{background:linear-gradient(90deg,#00006c,#195294);color:#fff}.nb1 .nb1-title small{color:#fff}.nb1 .nb1-book{color:#ffd25d}.nb1 .nb1-tabs{background:#c8c7bf;border-bottom:1px solid #808079}.nb1 .nb1-tabs a{border:2px outset #ededdf;background:#deddd5;color:#171717}.nb1 .nb1-tabs a[aria-current=page]{border-style:inset;background:#f8ecb3;color:#171717}.nb1 .nb1-rail,.nb1 .nb1-docket{background:#f8f5df}.nb1 .nb1-paper{background:#fffef5}.nb1 .rich-positive{color:#235d2e}.nb1 .rich-negative{color:#932a23}",
    ".nb1-editor .nr-ed-code{background:#fffdf4;border:2px inset #e2e1d8}.nb1-editor .nr-ed-code-line>span{color:#565b65;background:#e9ebef}.nb1-editor .nr-ed-source-target code{background:#fff0a2}.nb1-editor .nr-token-keyword{color:#152a91;font-weight:bold}.nb1-editor .nr-token-string{color:#a22e1d}.nb1-editor .nr-token-reference{color:#713b82}.nb1-editor .nr-token-literal{color:#844900}.nb1-editor .nr-token-qualified{color:#20537e}.nb1-editor .nr-token-comment{color:#376340;font-style:italic}",
    "@media(max-width:22rem){.nb1-editor .nb1-title small,.nb1-editor .nr-ed-path-current{display:none}.nb1-editor .nb1-tabs{gap:3px;padding-inline:6px}.nb1-editor .nb1-tabs a{padding-inline:6px}.nb1-editor .nb1-paper header{padding-bottom:6px;margin-bottom:8px}.nb1-editor .nb1-decision{padding-block:8px}.nb1-editor p.nr-ed-approval-link{margin-top:.4rem}}"
    , "body main:has(>.cb-workbench){height:100dvh;min-height:0;max-width:none;margin:0;padding:0;background:#9e9e99}"
    , ".cb-workbench{height:100%;display:grid;grid-template-rows:28px minmax(0,1fr);gap:4px;padding:3px;box-shadow:none;font:13px/1.4 Tahoma,Verdana,Arial,sans-serif;color:#171717}"
    , ".cb-workbench .nb1-title{padding:0 8px;flex-wrap:nowrap}.cb-workbench .nb1-title small{margin-left:auto}"
    , ".cb-workspace{min-height:0;display:grid;grid-template-columns:clamp(136px,14vw,200px) minmax(0,1fr);gap:4px}"
    , ".cb-folders{min-height:0;overflow:auto;background:#f8f5df;border:2px inset #dfded7;padding:6px}.cb-folder p{margin:6px 0 2px;color:#1c2850;font-weight:bold}.cb-folder p::before{content:'▣ ';color:#a57112}.cb-folder a{display:block;padding:3px 5px 3px 14px;color:#171717;text-decoration:none}.cb-folder a[aria-current]{background:#000080;color:#fff}.cb-folder a:hover{text-decoration:underline}"
    , ".cb-workbench #context{min-height:0;display:flex;flex-direction:column;padding:0;border:2px inset #e2e1da;background:#fffef5}"
    , ".cb-workbench #context>header{display:flex;align-items:center;flex-wrap:wrap;gap:4px 8px;margin:0;padding:5px 8px;border-bottom:1px solid #aba381;background:#fff1b5}.cb-workbench #context h1{font:bold 15px/1.15 Tahoma,Verdana,Arial,sans-serif;margin:0;letter-spacing:normal}.cb-workbench #context .nb1-stamp{margin-left:auto}.cb-workbench #context [data-encounter-connection]{margin:0;color:#414238;letter-spacing:normal;text-transform:none}"
    , ".cb-workbench .cb-document{margin:0;min-height:0;min-width:0;flex:1;overflow:auto;padding:7px}.cb-workbench .cb-document:has(.cb-film-view){display:flex;flex-direction:column}.cb-workbench #ollama-notes{margin:0;padding:5px 8px;border-top:1px solid #aba381;max-height:35%;overflow:auto}"
    , ".cb-workbench .cb-film-view{flex:1;min-height:0;min-width:0;margin:0;display:grid;grid-template-rows:auto minmax(0,1fr) auto;gap:5px}.cb-workbench #opening-candidate{margin:0}.cb-workbench .cb-film-tabs{padding:3px 3px 0;gap:3px}.cb-workbench .cb-film-tabs a{font:inherit;font-weight:bold;padding:3px 7px;border-radius:0}"
    , ".cb-workbench .cb-review-grid{min-height:0;grid-template-columns:minmax(0,2fr) minmax(215px,1fr);gap:5px;margin:0;align-items:stretch}.cb-workbench .cb-screening{min-height:0;background:#101720;border:2px inset #e2e1d8;display:grid;grid-template-rows:minmax(0,1fr);overflow:hidden}.cb-workbench [data-canvas-stage]{grid-template-rows:minmax(0,1fr) auto auto}.cb-workbench .cb-screening video,.cb-workbench canvas[data-encounter-canvas]{width:100%;height:100%;min-height:0;max-height:none;object-fit:contain;border-radius:0}.cb-workbench .cb-canvas-transport{margin:0;padding:4px 6px;background:#e5e9f3;gap:4px 7px}.cb-workbench [data-canvas-status]{margin:0;padding:0 6px;color:#fff}.cb-workbench [data-canvas-status]:empty{display:none}"
    , ".cb-workbench .cb-shot-inspector,.cb-workbench .cb-record-pane{min-height:0;overflow:auto;background:#fffdf4;border:2px inset #e2e1d8;border-radius:0;padding:7px}.cb-workbench .cb-shot-inspector h2,.cb-workbench .cb-record-pane h3{font:bold 14px/1.2 Tahoma,Verdana,Arial,sans-serif;margin:0 0 6px;color:#1c2850}.cb-workbench .cb-shot-inspector #shot-feedback{margin:5px 0;padding-top:5px}.cb-workbench .cb-shot-inspector .entry{margin:4px 0;padding:4px;gap:5px}.cb-workbench .cb-canvas-form input[type=range]{padding:0;min-height:0}.cb-workbench .cb-canvas-form button{min-height:0;padding:3px 5px}"
    , ".cb-workbench .cb-timeline{margin:0;border:2px inset #e2e1d8;padding:4px;background:#fffdf4}.cb-workbench .cb-shot-pager{display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:4px;align-items:center}.cb-workbench .cb-shot-pager p{text-align:center;margin:0;font-variant-numeric:tabular-nums}.cb-workbench .cb-shot-pager a,.cb-workbench .cb-shot-pager span{padding:2px 6px;background:#deddd5;border:2px outset #ededdf;color:#171717;text-decoration:none}.cb-workbench .cb-shot-pager span{color:#676760}.cb-workbench .cb-timeline svg{display:block;height:20px}.cb-workbench .cb-timeline .nb1-tabs{gap:2px;padding:0;border:0;background:none}.cb-workbench .cb-timeline .nb1-tabs a{font-size:11px;padding:2px 4px;border-radius:0;min-height:0}.cb-workbench .cb-timeline .nb1-tabs a[aria-current]{color:#fff;background:#000080}"
    , ".cb-workbench .cb-review-references{grid-template-columns:minmax(0,1fr) minmax(0,1fr);border:0;margin:0;padding:6px}.cb-workbench .cb-review-references section{margin:0}.cb-workbench .cb-review-references .board{grid-template-columns:minmax(0,1fr)}"
    , ".cb-workbench #shot-detail{margin:0}.cb-workbench .cb-film-tabs{position:sticky;top:0;z-index:1}@media(min-width:701px){.cb-workbench #shot-detail .task-columns{grid-template-columns:repeat(2,minmax(0,1fr))}}"
    , ".cb-workbench button{background:#deddd5;color:#171717;border:2px outset #ededdf;border-radius:0}.cb-workbench button:hover{background:#ebe9e0}.cb-workbench button:active{border-style:inset}.cb-workbench button[data-canvas-reset]{background:#deddd5;color:#171717}.cb-workbench button:disabled{color:#676760}.cb-workbench a:focus-visible{outline:2px solid #000080;outline-offset:1px}"
    , "@media(max-width:700px){.cb-workspace{grid-template-columns:minmax(0,1fr);grid-template-rows:auto minmax(0,1fr)}.cb-folders{display:flex;flex-wrap:wrap;gap:2px 6px;padding:2px}.cb-folder{display:flex;flex-wrap:wrap;gap:2px}.cb-folder p{display:none}.cb-folder a{padding:2px 4px}.cb-workspace:has(.cb-film-tabs) .cb-folder:last-child{display:none}.cb-workbench .cb-document{padding:4px}.cb-workbench .cb-film-tabs a{font-size:12px;padding-inline:4px}.cb-workbench .cb-review-grid{grid-template-columns:minmax(0,1fr);grid-template-rows:minmax(0,1fr) minmax(0,1fr)}.cb-workbench .cb-review-references{grid-template-columns:minmax(0,1fr)}}"
    , "@media(max-width:700px) and (max-height:575px){.cb-workbench .cb-review-grid{grid-template-columns:minmax(0,1.25fr) minmax(115px,1fr);grid-template-rows:minmax(0,1fr)}.cb-workbench .cb-canvas-transport{display:grid;grid-template-columns:auto 1fr auto;gap:0 3px;padding:2px 4px}.cb-workbench .cb-canvas-transport button{padding:2px 4px;min-height:0}.cb-workbench .cb-canvas-transport label:has([data-canvas-scrub]){grid-area:2/1/3/-1;font-size:0;gap:0}.cb-workbench .cb-canvas-transport input[type=range]{padding:0}.cb-workbench .cb-timeline svg{height:14px}.cb-workbench .cb-timeline .nb1-tabs a{padding:0 3px}}"
  )

    "html:has(.nb1),body:has(.nb1){background:#243440;color:#222d31}.pilot-app:has(.nb1)>.pilot-shell{display:none}body main:has(>.nb1){max-width:1450px;margin:10px auto;padding:0 .55rem}.nb1{--nb1-paper:#fff9e9;--nb1-blue:#214c63;--nb1-line:#a5ae9e;position:relative;margin:0;border:1px solid #b5b7a3;background:#e0e1d1;box-shadow:0 7px 30px #13212caa;font:14px/1.42 system-ui,sans-serif;color:#222d31}.nb1 h1,.nb1 h2,.nb1 p{margin:0}.nb1 a{color:#234d60}.nb1 a:focus-visible,.nb1 button:focus-visible{outline:2px solid #2a697e;outline-offset:2px}",
    ".nb1-title,.nb1-path{display:flex;align-items:center;flex-wrap:wrap;gap:5px 10px;padding:6px 12px}.nb1-title{justify-content:space-between;background:linear-gradient(90deg,#244456,#2d5a68);color:#fff4d8;border-bottom:1px solid #192f40}.nb1-title strong{display:flex;align-items:center;gap:7px}.nb1-title small{color:#e6e2cd}.nb1-book{display:grid;place-items:center;width:22px;height:21px;border:1px solid #edcf8d;border-radius:2px;color:#f7dd9d;font:16px Georgia,serif;box-shadow:inset 3px 0 #ecc97870}.nb1-path{background:#eeeede;border-block:1px solid #a3aca0;color:#4b5c60;font-size:12px}.nb1-tabs{display:flex;flex-wrap:wrap;gap:4px;padding:6px 10px 0;background:#d8ded1;border-bottom:1px solid #87998e}.nb1-tabs a{padding:5px 10px;border:1px solid #87998e;border-bottom:0;border-radius:4px 4px 0 0;background:#e5e5d3;text-decoration:none;font-size:12px;font-weight:650}.nb1-tabs a[aria-current]{background:#fff5d9}",
    ".nb1-workspace{display:grid;grid-template-columns:174px minmax(0,1fr) 246px;min-height:490px}.nb1-rail{background:#dfe6d8;border-inline-end:1px solid #9dab9b;padding:11px 8px;display:grid;align-content:start;gap:4px}.nb1-label{font-size:10px;letter-spacing:.1em;text-transform:uppercase;font-weight:750;color:#4b5c60}.nb1-rail h2{font:500 20px/1.1 Georgia,serif;margin:0 0 5px}.nb1-rail a{padding:4px 5px;border:1px solid transparent;text-decoration:none;font-size:12px}.nb1-rail a[aria-current]{background:#f0e1ae;border-color:#a19366}.nb1-paper{min-width:0;background:var(--nb1-paper);padding:13px clamp(10px,2vw,25px) 16px}.nb1-paper header{border:0;border-bottom:1px solid #a9aa8e;padding:0 0 9px;margin:0 0 11px}.nb1-paper h1{font:500 clamp(24px,3.7vw,37px)/1.04 Georgia,serif;letter-spacing:-.026em;margin:3px 0 6px;overflow-wrap:anywhere}.nb1-stamp{display:inline-block;border:1px solid #ac9b61;padding:2px 6px;background:#f1e4b5;font-size:10px;color:#594a2c}",

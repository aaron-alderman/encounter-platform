process-module "temple/surface-process-module/1"

process sourcery.compact.home:
  let cssRuleSeparator = ""
  let cssRules = list(
    { selector = "body:has(#aster-codex-window[data-active=true]:not([hidden])) #aster-desktop"; declarations = list(

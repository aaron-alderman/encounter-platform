      { property = "height"; value = "7px" },
      { property = "border-radius"; value = "50%" },
      { property = "margin-inline-end"; value = "4px" },
      { property = "background"; value = "#326844" }
    ) },
    { selector = "#aster-status-document p[data-state=unavailable] .connection-dot"; declarations = list(
      { property = "background"; value = "#963c35" }
    ) },
    { selector = "#aster-status-document .running-dots"; declarations = list(
      { property = "animation"; value = "aster-running 1.4s ease-in-out infinite" },
      { property = "font-family"; value = "monospace" }
    ) },
    { atRule = "keyframes"; prelude = " aster-running"; rules = list(
      { selector = "50%"; declarations = list(
        { property = "opacity"; value = ".35" }
      ) }
    ) },
    { atRule = "media"; prelude = "(prefers-reduced-motion:reduce)"; rules = list(
      { selector = "#aster-status-document .running-dots"; declarations = list(
        { property = "animation"; value = "none" }
      ) }
    ) },
    { atRule = "media"; prelude = "(max-height:300px)"; rules = list(

  ) };
      proof = "The selected reference opens at its full published resolution." },
    { id = "game-folio"; title = "Recent Folio · Find the shipment controls"; route = "home/catalogue/game-folio";
      href = "/game/recent-folio/"; actions = list("open Dispatch an export shipment", "follow the link to the simulation controls");

  ) };
      proof = "Preview leaves the saved revision unchanged. A committed edit keeps its new revision after reopening." },
    { id = "design-references"; title = "Design References · Inspect a full-size reference"; route = "home/catalogue/design-references";
      href = "/game/design-references/"; actions = list("choose a retained reference", "open its full-size image");

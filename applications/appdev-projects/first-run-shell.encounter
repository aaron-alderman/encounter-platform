    { tag = "strong"; children = list("Worlds & tools") },
    ", choose One World to work on the transport simulation or choose a Foundry to work on its inputs."
  ) };
      proof = "The signed-in hub shows the actual tools for the current game release." },
    { id = "one-world"; title = "One World · Advance the shipment simulation"; route = "home/catalogue/one-world";
      href = "/game/one-world/"; actions = list("read current simulation clock", "advance simulation", "reopen the world");
      body = { tag = "p"; children = list(

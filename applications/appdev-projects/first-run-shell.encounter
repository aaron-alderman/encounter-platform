    { tag = "strong"; children = list("Advance simulation") },
    ". Reopen the same world to check the new clock reading."
  ) };
      proof = "The world retains the accepted simulation clock after reopening." },
    { id = "asset-foundry"; title = "Asset Foundry · Save a recipe draft"; route = "home/catalogue/asset-foundry";
      href = "/game/asset-foundry/"; actions = list("choose an asset", "edit recipe directly", "save draft", "reopen the asset");
      body = { tag = "p"; children = list(

process-module "temple/surface-process-module/1"

process onboarding.styles:
  let cssRuleSeparator = ""
  let cssRules = list(
    { selector = ".onboarding-dialog"; declarations = list(
      { property = "width"; value = "min(760px,calc(100vw - 24px))" },
      { property = "max-height"; value = "calc(100dvh - 24px)" },
      { property = "padding"; value = "4px" },
      { property = "border"; value = "0" },
      { property = "background"; value = "var(--gray,var(--chrome,#d4d0c8))" },
      { property = "color"; value = "var(--ink,#16172a)" },
      { property = "box-shadow"; value = "var(--raised)" },
      { property = "font"; value = "14px/1.45 Tahoma,Verdana,sans-serif" }
    ) },
    { selector = ".onboarding-dialog[open]"; declarations = list(
      { property = "display"; value = "flex" },
      { property = "flex-direction"; value = "column" },
      { property = "overflow"; value = "hidden" }
    ) },
    { selector = ".onboarding-heading,.onboarding-navigation,.onboarding-footer"; declarations = list(
      { property = "flex"; value = "none" }
    ) },
    { selector = ".onboarding-heading"; declarations = list(
      { property = "margin"; value = "0" },
      { property = "padding"; value = "8px 10px" },
      { property = "background"; value = "var(--navy,#080c62)" },
      { property = "color"; value = "white" },
      { property = "font-size"; value = "16px" }
    ) },
    { selector = ".onboarding-navigation"; declarations = list(
      { property = "padding"; value = "4px 12px 10px" },
      { property = "border-bottom"; value = "1px solid #79777c" }
    ) },
    { selector = ".onboarding-navigation p"; declarations = list(
      { property = "margin"; value = "6px 0" }
    ) },
    { selector = ".onboarding-navigation nav"; declarations = list(
      { property = "display"; value = "flex" },
      { property = "flex-wrap"; value = "wrap" },
      { property = "gap"; value = "8px" }
    ) },
    { selector = ".onboarding-body"; declarations = list(
      { property = "min-height"; value = "0" },
      { property = "padding"; value = "12px" },
      { property = "overflow"; value = "auto" },
      { property = "overscroll-behavior"; value = "contain" }
    ) },
    { selector = ".onboarding-body h3"; declarations = list(
      { property = "margin"; value = "0 0 8px" },
      { property = "font-size"; value = "20px" }
    ) },
    { selector = ".onboarding-body h3[tabindex]:focus"; declarations = list(
      { property = "outline"; value = "none" }
    ) },
    { selector = ".onboarding-body p"; declarations = list(
      { property = "margin"; value = "8px 0" }
    ) },
    { selector = ".onboarding-dialog button,.onboarding-dialog .onboarding-link,.onboarding-launch"; declarations = list(
      { property = "display"; value = "inline-block" },
      { property = "min-height"; value = "44px" },
      { property = "padding"; value = "10px 12px" },
      { property = "border"; value = "0" },
      { property = "background"; value = "var(--gray,var(--chrome,#d4d0c8))" },
      { property = "color"; value = "var(--ink,#16172a)" },
      { property = "box-shadow"; value = "var(--raised)" },
      { property = "font"; value = "inherit" },
      { property = "text-decoration"; value = "none" },
      { property = "cursor"; value = "pointer" }
    ) },
    { selector = ".onboarding-dialog button:focus-visible,.onboarding-dialog a:focus-visible,.onboarding-launch:focus-visible"; declarations = list(
      { property = "outline"; value = "2px dotted var(--navy,#080c62)" },
      { property = "outline-offset"; value = "-4px" }
    ) },
    { selector = ".onboarding-dialog nav button[aria-pressed=true]"; declarations = list(
      { property = "box-shadow"; value = "var(--sunken,var(--well))" },
      { property = "font-weight"; value = "bold" }
    ) },
    { selector = ".onboarding-layout"; declarations = list(
      { property = "display"; value = "grid" },
      { property = "grid-template-columns"; value = "minmax(0,2fr) minmax(0,1fr)" },
      { property = "gap"; value = "16px" }
    ) },
    { selector = ".onboarding-example h4"; declarations = list(
      { property = "margin"; value = "0 0 8px" }
    ) },
    { selector = ".onboarding-example"; declarations = list(
      { property = "min-width"; value = "0" },
      { property = "padding"; value = "14px" },
      { property = "background"; value = "#fffef3" },
      { property = "box-shadow"; value = "var(--sunken,var(--well))" },
      { property = "overflow-wrap"; value = "anywhere" }
    ) },
    { selector = ".onboarding-tip"; declarations = list(
      { property = "min-width"; value = "0" },
      { property = "overflow-wrap"; value = "anywhere" }
    ) },
    { selector = ".onboarding-tip h4"; declarations = list(
      { property = "margin"; value = "0" }
    ) },
    { selector = ".onboarding-form"; declarations = list(
      { property = "display"; value = "grid" },
      { property = "gap"; value = "8px" }
    ) },
    { selector = ".onboarding-form label"; declarations = list(
      { property = "font-weight"; value = "bold" }
    ) },
    { selector = ".onboarding-form textarea"; declarations = list(
      { property = "box-sizing"; value = "border-box" },
      { property = "width"; value = "100%" },
      { property = "min-width"; value = "0" },
      { property = "min-height"; value = "130px" },
      { property = "padding"; value = "10px" },
      { property = "border"; value = "1px solid #79777c" },
      { property = "background"; value = "#fffef8" },
      { property = "color"; value = "#16172a" },
      { property = "font"; value = "inherit" },
      { property = "resize"; value = "vertical" }
    ) },
    { selector = ".onboarding-actions"; declarations = list(
      { property = "display"; value = "flex" },
      { property = "flex-wrap"; value = "wrap" },
      { property = "gap"; value = "8px" },
      { property = "margin-top"; value = "16px" }
    ) },
    { selector = ".onboarding-dialog .onboarding-primary"; declarations = list(
      { property = "font-weight"; value = "bold" }
    ) },
    { selector = ".onboarding-feedback"; declarations = list(
      { property = "flex"; value = "none" },
      { property = "margin"; value = "0" },
      { property = "padding"; value = "6px 12px" },
      { property = "background"; value = "#fffef3" }
    ) },
    { selector = ".onboarding-feedback:empty"; declarations = list(
      { property = "padding"; value = "0" }
    ) },
    { selector = ".onboarding-footer"; declarations = list(
      { property = "display"; value = "flex" },
      { property = "align-items"; value = "center" },
      { property = "flex-wrap"; value = "wrap" },
      { property = "justify-content"; value = "space-between" },
      { property = "gap"; value = "8px" },
      { property = "padding"; value = "8px 12px" },
      { property = "border-top"; value = "1px solid #79777c" }
    ) },
    { selector = ".onboarding-card"; declarations = list(
      { property = "padding"; value = "10px 14px" },
      { property = "background"; value = "#fffef3" },
      { property = "color"; value = "var(--ink,#16172a)" },
      { property = "box-shadow"; value = "var(--sunken,var(--well))" },
      { property = "overflow-wrap"; value = "anywhere" }
    ) },
    { selector = ".onboarding-card p"; declarations = list(
      { property = "margin"; value = "4px 0" }
    ) },
    { selector = ".onboarding-card summary"; declarations = list(
      { property = "font-weight"; value = "bold" },
      { property = "cursor"; value = "pointer" }
    ) },
    { selector = ".onboarding-shortcuts"; declarations = list(
      { property = "display"; value = "flex" },
      { property = "flex-wrap"; value = "wrap" },
      { property = "gap"; value = "8px" }
    ) },
    { selector = ".onboarding-dialog::backdrop"; declarations = list(
      { property = "background"; value = "#10172b88" }
    ) },
    { selector = ".formation-resource"; declarations = list(
      { property = "margin-block"; value = "6px" },
      { property = "padding-inline"; value = "10px" },
      { property = "background"; value = "#fffef3" },
      { property = "box-shadow"; value = "var(--sunken,var(--well))" },
      { property = "overflow-wrap"; value = "anywhere" }
    ) },
    { selector = ".formation-resource[open]"; declarations = list(
      { property = "padding-bottom"; value = "10px" }
    ) },
    { selector = ".formation-resource summary"; declarations = list(
      { property = "display"; value = "list-item" },
      { property = "list-style"; value = "revert" },
      { property = "cursor"; value = "pointer" },
      { property = "font-weight"; value = "bold" },
      { property = "min-height"; value = "44px" },
      { property = "padding-block"; value = "10px" }
    ) },
    { selector = ".formation-resource summary::-webkit-details-marker"; declarations = list(
      { property = "display"; value = "revert" }
    ) },
    { atRule = "media"; prelude = "(max-width:620px)"; rules = list(
      { selector = ".onboarding-layout"; declarations = list(
        { property = "grid-template-columns"; value = "minmax(0,1fr)" }
      ) },
      { selector = ".onboarding-tip"; declarations = list(
        { property = "border-top"; value = "1px solid #79777c" },
        { property = "padding-top"; value = "10px" }
      ) },
      { selector = ".onboarding-body"; declarations = list(
        { property = "padding"; value = "10px" }
      ) },
      { selector = ".onboarding-navigation nav"; declarations = list(
        { property = "display"; value = "grid" },
        { property = "grid-template-columns"; value = "repeat(4,minmax(0,1fr))" },
        { property = "gap"; value = "4px" }
      ) },
      { selector = ".onboarding-navigation nav button"; declarations = list(
        { property = "padding"; value = "6px 4px" },
        { property = "line-height"; value = "1.15" }
      ) },
      { selector = ".onboarding-form textarea"; declarations = list(
        { property = "min-height"; value = "110px" },
        { property = "font-size"; value = "16px" }
      ) }
    ) },
    { atRule = "media"; prelude = "(max-width:620px) and (max-height:650px)"; rules = list(
      { selector = ".onboarding-form textarea"; declarations = list(
        { property = "height"; value = "84px" },
        { property = "min-height"; value = "84px" }
      ) }
    ) }
  )
  call css.renderCompactRules


process formation.workgardenExercise:
  let result = {
    id = "workgarden"; title = "Workgarden · Complete a real work item";
    route = "home/catalogue/hosted-workgarden"; href = "/life-board/workgarden/";
    actions = list("workgarden.add-item", "workgarden.toggle-item");
    proof = "After returning from Work’s Start menu, the same item still says Completed. Choose Reopen to move it back to Open.";
    body = { tag = "p"; children = list(
    "Use a task you actually need to do. In Workgarden, enter its title under ",
    { tag = "strong"; children = list("New work item") },
    " and choose ",
    { tag = "strong"; children = list("Add work item") },
    ". After doing the task, choose ",
    { tag = "strong"; children = list("Complete") },
    "."
  ) }
  }

process formation.workspaceExercises:
  let result = list(
    { id = "front-gate"; title = "Front Gate · Check a service over SSH";
      route = "home/desktop/front-gate"; relatedRoute = "home/catalogue/front-gate"; launch = "front-gate";
      actions = list("open Front Gate", "set Auto-refresh", "check recovery");
      body = { tag = "p"; children = list(
    "Connect the existing Front Gate SSH tunnel. Open Front Gate, choose an interval under ",
    { tag = "strong"; children = list("Auto-refresh") },
    ", and watch the countdown. If your connection drops, reconnect the tunnel and wait for the next scheduled check."
  ) };
      proof = "The next successful check clears Stale and updates Checked in the same window.";
      link = { tag = "a"; attrs = { class = "onboarding-link"; href = "/workspace/home?open=front-gate" }; children = list("Open Front Gate") };
      verification = "workspace-routes/verify.py --front-gate-only" },
    { id = "file-manager"; title = "File Manager · Inspect a published record";
      route = "home/desktop/file-manager"; launch = "file-manager";
      actions = list("open File Manager", "open a REL record", "search facts", "view REL source");
      body = { tag = "p"; children = list(
    "In Home, open ",
    { tag = "strong"; children = list("File Manager") },
    " from the desktop. Choose an available collection and open a ",
    { tag = "strong"; children = list(".rel") },
    " file. Use ",
    { tag = "strong"; children = list("Search facts") },
    " to filter the table, then open ",
    { tag = "strong"; children = list("REL source preview") },
    " to read the original record."
  ) };
      proof = "The filtered facts and the source preview show the same published record.";
      link = "";
      verification = "workspace-routes/verify.py --front-gate-only" },
    { id = "service-manager"; title = "Service Manager · Follow a scheduled run";
      route = "home/desktop/service-manager"; launch = "service-manager";
      actions = list("inspect Schedules", "open a published receipt", "return to the same service");
      body = { tag = "p"; children = list(
    "Open ",
    { tag = "strong"; children = list("Service Manager") },
    " in Home. In ",
    { tag = "strong"; children = list("Schedules") },
    ", choose a timer and inspect its last service execution. If an execution has a published receipt, choose ",
    { tag = "strong"; children = list("Open receipt in File Manager") },
    ". Use ",
    { tag = "strong"; children = list("Back to Service Manager") },
    " when you finish."
  ) };
      proof = "You return to the same service, and the receipt shows that execution’s outcome.";
      link = ""; verification = "workspace-routes/verify.py --front-gate-only" },
    { id = "file-viewer"; title = "File Viewer · Read a release record";
      route = "home/desktop/file-viewer"; launch = "file-viewer";
      actions = list("open File Viewer from File Manager", "search facts", "return to the folder");
      body = { tag = "p"; children = list(
    "In File Manager, select a published REL file. Choose ",
    { tag = "strong"; children = list("Open in File Viewer") },
    " for that file and search for a fact. Close File Viewer to return to the source folder in File Manager."
  ) };
      proof = "The separate viewer displays the selected record and leaves the original folder available.";
      link = ""; verification = "workspace-routes/verify.py --front-gate-only" },
    { id = "performance"; title = "Performance · Inspect a launch timing";
      route = "home/desktop/performance"; launch = "performance";
      actions = list("open an app", "review Recent launches", "copy recent launches");
      body = { tag = "p"; children = list(
    "Open an Operations tool, such as ",
    { tag = "strong"; children = list("Network Settings") },
    ", then open ",
    { tag = "strong"; children = list("Performance") },
    ". In ",
    { tag = "strong"; children = list("Recent launches") },
    ", select the launch and inspect its queue, request and total timings. Choose ",
    { tag = "strong"; children = list("Copy recent launches") },
    " to share the readings."
  ) };
      proof = "The copied rows identify the launch and its outcome.";
      link = ""; verification = "workspace-routes/verify.py --front-gate-only" },
    { id = "about"; title = "About this build · Identify your Home release";
      route = "home/desktop/about"; launch = "about";
      actions = list("open build badge", "read Build ID", "read Home fingerprint");
      body = { tag = "p"; children = list(
    "Select the build badge in Home to open ",
    { tag = "strong"; children = list("About this build") },
    ". Read the full ",
    { tag = "strong"; children = list("Build ID") },
    " and ",
    { tag = "strong"; children = list("Home fingerprint") },
    " when you need to identify the release someone is using."
  ) };
      proof = "The About window shows the build and its complete SHA-256 fingerprint.";
      link = ""; verification = "workspace-routes/verify.py --formation-tools" },
    { id = "assurance"; title = "Assurance · Look up an app’s declared purpose";
      route = "home/desktop/assurance"; launch = "assurance";
      actions = list("open Assurance", "read App semantic definitions", "inspect an app finding");
      body = { tag = "p"; children = list(
    "Open ",
    { tag = "strong"; children = list("Assurance") },
    " under Operations. In ",
    { tag = "strong"; children = list("App semantic definitions") },
    ", find an app, read its declared purpose and launch destination, then review its finding before relying on it."
  ) };
      proof = "The published row ties the app’s purpose and review finding to its launch destination.";
      link = ""; verification = "workspace-routes/verify.py --formation-tools" },
    { id = "semantic-compiler"; title = "Semantic Compiler · Dry-run a route";
      route = "home/desktop/semantic-compiler"; relatedRoute = "home/catalogue/semantic-compiler"; launch = "semantic-compiler";
      actions = list("open Semantic Compiler", "run route dry run", "read coverage and conflict");
      body = { tag = "p"; children = list(
    "Open ",
    { tag = "strong"; children = list("Semantic Compiler") },
    " from Apps and choose ",
    { tag = "strong"; children = list("Dry run") },
    ". Run it with the published route in ",
    { tag = "strong"; children = list("Proposed route") },
    " to see its coverage. Try ",
    { tag = "code"; children = list("/workspace/mobile/") },
    " to see why an existing workspace route is reserved."
  ) };
      proof = "The result changes in the Compiler window, while the published Home route stays in place.";
      link = ""; verification = "workspace-routes/verify.py --formation-tools" },
    { id = "store"; title = "Store · Reopen an app release";
      route = "home/desktop/store"; relatedRoute = "home/catalogue/store"; launch = "store";
      actions = list("open Store", "sign in to Store", "reopen a release");
      body = { tag = "p"; children = list(
    "Open ",
    { tag = "strong"; children = list("Store") },
    " from Work and select a release. If Store asks you to sign in, complete the sign-in in this tab. Reopen the release when you return to Work."
  ) };
      proof = "After sign-in, Work returns to the selected release.";
      link = { tag = "a"; attrs = { class = "onboarding-link"; href = "/workspace/work?open=store" }; children = list("Open Store in Work") };
      verification = "workspace-routes/verify.py --store-only" },
    { id = "customization"; title = "Customization · Try a readable typeface";
      route = "home/desktop/design"; launch = "design";
      actions = list("change Preview typeface", "switch Preview example", "reset");
      body = { tag = "p"; children = list(
    "In Home Operations, open ",
    { tag = "strong"; children = list("Sourcery OS Customization") },
    ". Choose ",
    { tag = "strong"; children = list("Atkinson Hyperlegible Next") },
    " under ",
    { tag = "strong"; children = list("Preview typeface") },
    ". Switch ",
    { tag = "strong"; children = list("Preview example") },
    " to Service Manager, then choose ",
    { tag = "strong"; children = list("Reset to standard") },
    "."
  ) };
      proof = "The chosen typeface carries across the two previews. Reset returns the preview to Standard.";
      link = ""; verification = "workspace-routes/verify.py --formation-desktop" },
    { id = "steward"; title = "Steward · Check which role you are using";
      route = "home/desktop/acting-as"; launch = "acting-as";
      actions = list("open Steward", "read Current role", "check Verified identity", "inspect Decision history");
      body = { tag = "p"; children = list(
    "Sign in to Temple, then open ",
    { tag = "strong"; children = list("Steward") },
    " in Home Operations. Check ",
    { tag = "strong"; children = list("Current role") },
    " and ",
    { tag = "strong"; children = list("Verified identity") },
    ". Read ",
    { tag = "strong"; children = list("Notes authority") },
    " and inspect ",
    { tag = "strong"; children = list("Decision history") },
    " before using steward controls."
  ) };
      proof = "The window shows the signed-in Temple identity, its current role, and any decisions visible to that role.";
      link = ""; verification = "workspace-routes/verify.py --formation-desktop" },
    { id = "certificates"; title = "Certificates · Check a managed certificate";
      route = "home/desktop/certificates"; launch = "certificates";
      actions = list("open Certificates", "compare leaf and issuer expiry", "read Certificate details");
      body = { tag = "p"; children = list(
    "While acting as Sourcery steward, open ",
    { tag = "strong"; children = list("Certificates") },
    " in Home Operations. Choose a Managed Super CRM entry. Compare ",
    { tag = "strong"; children = list("Certificate expires") },
    " and ",
    { tag = "strong"; children = list("Issuer expires") },
    ", then expand ",
    { tag = "strong"; children = list("Certificate details") },
    " to read the public SHA-256 fingerprint."
  ) };
      proof = "The named certificate shows two expiry timestamps and a public fingerprint. You can check these without starting a renewal.";
      link = ""; verification = "workspace-routes/verify.py --formation-desktop" },
    { id = "keys"; title = "Keys · Match a public fingerprint";
      route = "home/desktop/keys"; launch = "keys";
      actions = list("open Keys", "locate managed key", "read algorithm and fingerprint");
      body = { tag = "p"; children = list(
    "While acting as Sourcery steward, open ",
    { tag = "strong"; children = list("Keys") },
    " in Home Operations. Find the managed key you need to identify. Read its ",
    { tag = "strong"; children = list("Algorithm") },
    " and compare its ",
    { tag = "strong"; children = list("Public key fingerprint (SHA-256)") },
    " with the value you were given."
  ) };
      proof = "The inventory identifies the key by name, algorithm and public fingerprint.";
      link = ""; verification = "workspace-routes/verify.py --formation-desktop" },
    { id = "temple-manager"; title = "Temple Manager · Reopen Memory and Journal";
      route = "home/desktop/temple-manager"; launch = "temple-manager";
      actions = list("open signed-in Temple Manager", "edit a memory in its editor", "refresh and reopen the saved records");
      body = { tag = "p"; children = list(
    "Sign in to Temple, then open ",
    { tag = "strong"; children = list("Temple Manager") },
    " in Home Operations. ",
    { tag = "strong"; children = list("Memory") },
    " shows your saved note and ",
    { tag = "strong"; children = list("Journal") },
    " shows your Field visit entry. Use ",
    { tag = "strong"; children = list("Edit memory") },
    " to save something you want to remember, then choose ",
    { tag = "strong"; children = list("File → Refresh saved records") },
    " in Temple Manager."
  ) };
      proof = "Temple Manager shows the same signed-in records that reopen in Work and can be sent to Mobile.";
      link = ""; verification = "workspace-routes/verify.py --system-journeys" },
    { id = "game-zone"; title = "Game Zone · Follow a release into Store";
      route = "home/desktop/game"; relatedRoute = "home/catalogue/game"; launch = "game";
      actions = list("open Game Zone", "inspect Tools", "open Publish and install");
      body = { tag = "p"; children = list(
    "Open ",
    { tag = "strong"; children = list("Game Zone") },
    " in Home Apps and sign in if prompted. Use ",
    { tag = "strong"; children = list("Tools") },
    " to locate the One World editor. Switch to ",
    { tag = "strong"; children = list("Operations") },
    " and choose ",
    { tag = "strong"; children = list("Publish and install") },
    " to open Store, where releases and receipts are listed."
  ) };
      proof = "Game Zone opens the real Store window from its Operations tab.";
      link = ""; verification = "workspace-routes/verify.py --formation-desktop" })

process formation.workExercises:
  let result = list(
    { id = "work-performance"; title = "Work Performance · Read a live host sample";
      route = "work/capability/performance"; capabilities = list("window.open", "performance.observe");
      actions = list("open Performance from Work Start", "read Host uptime", "wait for a second sample");
      body = { tag = "p"; children = list(
    "In Work, open ",
    { tag = "strong"; children = list("Performance") },
    " from Start. Compare ",
    { tag = "strong"; children = list("Host uptime") },
    " and ",
    { tag = "strong"; children = list("Browser connections") },
    " across two readings. Use the second reading to interpret the CPU chart."
  ) };
      proof = "The sample timestamp advances while Performance is open.";
      link = ""; verification = "workspace-routes/verify.py --system-journeys" },
    { id = "super-crm"; title = "Super CRM · Reopen a case and its activity";
      route = "work/capability/super-crm"; relatedRoute = "home/catalogue/hosted-super-crm";
      capabilities = list("window.open", "super-crm.open-case");
      href = "/life-board/super-crm/";
      actions = list("open Super CRM", "open a case", "save a case update", "reopen the case");
      body = { tag = "p"; children = list(
    "Open ",
    { tag = "strong"; children = list("Super CRM") },
    " from Work Start. In a CRM workspace you are allowed to edit, add an account if needed, then open a case. Choose a ",
    { tag = "strong"; children = list("Case stage") },
    ", enter an ",
    { tag = "strong"; children = list("Activity note") },
    ", and choose ",
    { tag = "strong"; children = list("Save case update") },
    ". Return through Start and find the same case."
  ) };
      proof = "The reopened case retains the stage and the activity note.";
      link = { tag = "a"; attrs = { class = "onboarding-link"; href = "/life-board/super-crm/" }; children = list("Open Super CRM") };
      verification = "workspace-routes/verify.py --system-journeys" },
    { id = "decompiler"; title = "Semantic Decompiler · Inspect a retained document";
      route = "work/capability/decompiler"; relatedRoute = "home/catalogue/hosted-decompiler";
      capabilities = list("window.open", "decompiler.inspect-source");
      href = "/life-board/decompiler/";
      actions = list("open Semantic Decompiler", "find a retained document", "page retained replies");
      body = { tag = "p"; children = list(
    "Open ",
    { tag = "strong"; children = list("Semantic Decompiler") },
    " from Work Start. Find ",
    { tag = "strong"; children = list("CSV import and time entry") },
    " under ",
    { tag = "strong"; children = list("Document") },
    ". In a narrow window, open ",
    { tag = "strong"; children = list("Replies") },
    " and page forward and back to inspect the retained record."
  ) };
      proof = "The document is available in the Work mount, and paging returns to the starting reply.";
      link = { tag = "a"; attrs = { class = "onboarding-link"; href = "/life-board/decompiler/" }; children = list("Open Semantic Decompiler") };
      verification = "workspace-routes/verify.py --system-journeys; encounter appdev-decompiler-check APP_ROOT paging 24220" },
    { id = "temple-mailbox"; title = "Temple Mailbox · Review and send an appointment";
      route = "work/capability/temple"; capabilities = list("window.open", "temple.review-appointment", "temple.send-offer");
      actions = list("open the coordinating Mailbox", "review the UTC appointment", "approve and send");
      body = { tag = "p"; children = list(
    "In enrolled managed Work, sign in to ",
    { tag = "strong"; children = list("Temple Mailbox") },
    " as the coordinating operator and open an appointment case. Enter the UTC appointment and private scheduling reason, then choose ",
    { tag = "strong"; children = list("Review schedule") },
    ". Check the recipient, time and case revision before choosing ",
    { tag = "strong"; children = list("Approve and send") },
    "."
  ) };
      proof = "The coordinating Mailbox records the reviewed proposal and the signed exchange.";
      link = ""; verification = "workspace-routes/verify.py --system-journeys" },
    { id = "temple-receiving"; title = "Receiving Temple · Accept a delivered appointment";
      route = "work/capability/temple-receiving"; capabilities = list("window.open", "temple.accept-offer");
      actions = list("open the receiving inbox", "read the delivered proposal", "accept the appointment");
      body = { tag = "p"; children = list(
    "Open ",
    { tag = "strong"; children = list("Receiving Temple") },
    " in enrolled managed Work and sign in as the receiving operator. Open the delivered offer, check its UTC time and choose ",
    { tag = "strong"; children = list("Accept appointment") },
    " when it suits. Reopen the Mailbox in each Temple to check the confirmed time."
  ) };
      proof = "Both independently stored Mailboxes retain the same confirmation.";
      link = ""; verification = "workspace-routes/verify.py --system-journeys" },
    { id = "work-today"; title = "Today · Read the confirmed appointment";
      route = "work/capability/today"; capabilities = list("window.open", "calendar.read-appointment");
      actions = list("open Today in managed Work", "check the confirmed appointment and CRM revision");
      body = { tag = "p"; children = list(
    "Open ",
    { tag = "strong"; children = list("Today") },
    " in enrolled managed Work as the coordinating operator. Read the ",
    { tag = "strong"; children = list("Confirmed appointment") },
    " and current CRM revision. Use ",
    { tag = "strong"; children = list("Refresh calendar") },
    " to reread the coordinating Temple's ledger."
  ) };
      proof = "Today shows the same UTC appointment as the two Mailboxes.";
      link = ""; verification = "workspace-routes/verify.py --system-journeys" },
    { id = "work-assurance"; title = "Work Assurance · Trace the signed appointment exchange";
      route = "work/capability/assurance"; capabilities = list("window.open", "app.receipts");
      actions = list("open Assurance in managed Work", "read the Appointment Saga", "inspect the signed receipt");
      body = { tag = "p"; children = list(
    "Open ",
    { tag = "strong"; children = list("Assurance") },
    " in enrolled managed Work as the coordinating operator. In ",
    { tag = "strong"; children = list("Appointment Saga") },
    ", find the confirmed exchange and choose ",
    { tag = "strong"; children = list("Inspect signed receipt") },
    ". Use the workflow ID to follow the exchange across the local events and signed evidence."
  ) };
      proof = "Assurance identifies a verified signed receipt and its workflow.";
      link = ""; verification = "workspace-routes/verify.py --system-journeys" })

process formation.gameExercises:
  let result = list(
    { id = "game-hub"; title = "Game Hub · Choose a world or tool"; route = "work/capability/game-hub";
      href = "/game/"; actions = list("open Game Hub from Work", "choose Worlds & tools");

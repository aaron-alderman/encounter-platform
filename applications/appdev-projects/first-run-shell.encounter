  ) };
      proof = "The draft retains the edited label without creating a new candidate build." },
    { id = "landscape-foundry"; title = "Landscape Foundry · Preview a terrain edit"; route = "home/catalogue/landscape-foundry";
      href = "/game/landscape-foundry/"; actions = list("inspect terrain revision", "preview a terrain edit", "commit and reopen an approved edit");

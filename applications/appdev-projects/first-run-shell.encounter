    { id = "worldwright-unified"; title = "Worldwright Unified · Follow and reopen a trail";
      href = "http://worldwright-unified.localhost:24220/";
      actions = list("enter the garden of possibilities", "try two linked quantities", "follow the narrowing trail", "reopen the expedition");
      body = { tag = "p"; children = list(
    "Open ",
    { tag = "strong"; children = list("The garden of possibilities") },
    ". Try ",
    { tag = "strong"; children = list("Two linked quantities") },
    " and compare it with ",
    { tag = "strong"; children = list("A shared limit") },
    ". Follow ",
    { tag = "strong"; children = list("What survives the narrowing?") },
    ", then reload and open the expedition from the discovery count."
  ) };
      proof = "The expedition remembers both places in the same browser profile." },
    { id = "context-hub"; title = "Context Hub · Reopen a retained evidence comparison";
      href = "http://context-hub.localhost:24220/";
      actions = list("open a frozen episode", "compare baseline and adaptive context", "reopen the retained revision");
      body = { tag = "p"; children = list(
    "Open a frozen audit episode for ",
    { tag = "strong"; children = list("Does the Jordan face inside the relation quotient select its own positive order?") },
    " and note its episode ID. Read the corpus, policy and admitted-state pins, then compare the sources under ",
    { tag = "strong"; children = list("Baseline") },
    " and ",
    { tag = "strong"; children = list("Adaptive") },
    ". Reload and select the same episode to recover its evidence and comparison."
  ) };
      proof = "The same episode revision, pins and comparison reopen." },
    { id = "worldbox"; title = "Worldbox K1 · Inspect the current world and its recovery points";
      href = "http://worldbox.localhost:24220/";
      actions = list("open the current world", "fingerprint numeric state", "list and reopen a retained checkpoint");
      body = { tag = "p"; children = list(
    "Wait for the Encounter workspace, then choose ",
    { tag = "strong"; children = list("Open current world") },
    ". Use ",
    { tag = "strong"; children = list("Fingerprint numeric state") },
    " to read the current state hash. Choose ",
    { tag = "strong"; children = list("List runtime checkpoints") },
    " to see existing recovery points and their definition binding. Reload and list the checkpoints again."
  ) };
      proof = "The current world reports a state hash and the same retained checkpoint can be found again." },
    { id = "encounter"; title = "Encounter Authoring · Review and reopen a change";
      href = "http://encounter.localhost:24220/";
      actions = list("write an intent", "review without changing the accepted revision", "accept the change", "reopen its decision receipt");
      body = { tag = "p"; children = list(
    "In a new authoring workspace you may edit, describe what you want to make and why. Fill in the reason, target and goal, then choose ",
    { tag = "strong"; children = list("Review one change") },
    ". Check the proposal and choose ",
    { tag = "strong"; children = list("Accept this change") },
    ". Open ",
    { tag = "strong"; children = list("History") },
    " and expand the revision's ",
    { tag = "strong"; children = list("Decision receipt") },
    "."
  ) };
      proof = "Review leaves the revision unchanged. Acceptance advances it once, and History retains the decision and source hash." },
    { id = "creator-studio"; title = "Creator Studio · Preview and save a document version";
      href = "http://creator-studio.localhost:24220/";
      actions = list("open an editable document", "preview a title change", "save the version", "reopen the accepted document");
      body = { tag = "p"; children = list(
    "In an editable project, open ",
    { tag = "strong"; children = list("Documents") },
    ". Choose a document and give it a descriptive title. Select ",
    { tag = "strong"; children = list("Preview changes") },
    " to keep the edit as a draft. Choose ",
    { tag = "strong"; children = list("Save version") },
    ", then reopen the project in the same browser profile and find the document by its new title."
  ) };
      proof = "Preview leaves the accepted version unchanged. The saved version and its document title survive reload." })

process formation.publicationExercises:
  let result = list(
    { id = "personal-site"; title = "Personal website · Follow the Atlas";
      actions = list("open Atlas / Map", "read the map", "reopen the same page");
      body = { tag = "p"; children = list(
    "Open the personal website preview and choose ",
    { tag = "strong"; children = list("Atlas / Map") },
    ". Use the map to find how the site groups evidence, boundaries and repair. Reopen the map when you need that overview again."
  ) };
      proof = "Atlas / Map opens the published page with its map sections." },
    { id = "pyramid-material-history"; title = "The Missing Middle · Follow a worked investigation";
      actions = list("open a worked case", "inspect its corpus records", "reopen the case");
      body = { tag = "p"; children = list(
    "In ",
    { tag = "strong"; children = list("The Missing Middle") },
    ", choose ",
    { tag = "strong"; children = list("First identify the stone") },
    ". Read the current conclusion alongside ",
    { tag = "strong"; children = list("Connected corpus records") },
    " and the traversal graph. Use the record links to see what the published investigation cites."
  ) };
      proof = "The worked case and its corpus references remain available at the same URL." },
    { id = "the-field"; title = "The Field · Inspect a synthetic household period";
      actions = list("change scenario", "read usable capacity", "move Inspect period");
      body = { tag = "p"; children = list(
    "Set ",
    { tag = "strong"; children = list("Change scenario") },
    " to ",
    { tag = "strong"; children = list("B has fewer usable hours") },
    ". Check the displayed ",
    { tag = "strong"; children = list("Usable capacity") },
    ", then move ",
    { tag = "strong"; children = list("Inspect period") },
    " to read a different period. These are results from the published synthetic household explorer."
  ) };
      proof = "The scenario changes the displayed inputs and the period control updates its reading." },
    { id = "perth-encounter"; title = "Perth Encounter · Find the published guardrails";
      actions = list("open Guardrails", "inspect the stewardship sections", "reopen");
      body = { tag = "p"; children = list(
    "Open the Perth Encounter preview and choose ",
    { tag = "strong"; children = list("Guardrails") },
    ". Find ",
    { tag = "strong"; children = list("Operational independence") },
    " and the section on how the treasury is governed. Return to the same page when reviewing the event's published boundaries."
  ) };
      proof = "The Guardrails link opens the same published sections on return." },
    { id = "church-on-air"; title = "Church on Air · Inspect shots in the retained cut";
      actions = list("read the current shot title", "advance one shot", "return to the same shot");
      body = { tag = "p"; children = list(
    "Open the broadcast studio and check the title in ",
    { tag = "strong"; children = list("Shot inspector") },
    ". Use ",
    { tag = "strong"; children = list("Next shot") },
    " to inspect the next part of the cut, then ",
    { tag = "strong"; children = list("Previous shot") },
    " to return. The MP4 link identifies the retained output."
  ) };
      proof = "The inspector title changes and returns to the original shot." },
    { id = "worldwright-platform"; title = "Worldwright Platform · Find the first-world instructions";
      actions = list("follow Make your first world", "read the guide", "reopen");
      body = { tag = "p"; children = list(
    "Open the Worldwright Platform preview. Choose ",
    { tag = "strong"; children = list("Make your first world") },
    " to open the published starting instructions. Reopen that guide when you are ready to build."
  ) };
      proof = "The published link opens the Make your world guide at a stable address." })

process formation.helpShell:
  call formation.workgardenExercise
  let exercise = $result
  let workgarden = { id = $exercise.id; title = $exercise.title;
    body = list($exercise.body, { tag = "p"; children = list($exercise.proof) },
      { tag = "a"; attrs = { class = "onboarding-link"; href = $exercise.href }; children = list("Open Workgarden") }) }
  call formation.workspaceExercises
  let homeExercises = $result
  call formation.workExercises
  let workExercises = $result
  call formation.gameExercises
  let gameExercises = map($result, "exercise", {
    id = $exercise.id; title = $exercise.title; body = $exercise.body; proof = $exercise.proof;
    link = { tag = "a"; attrs = { class = "onboarding-link"; href = $exercise.href }; children = list("Open app") } })
  call formation.signedInExercises
  let signedInExercises = $result
  call formation.workPreviewLaunches
  let workPreviews = map($result, "app", $app.id)
  call formation.portfolioExercises
  let portfolioExercises = map($result, "exercise", {
    id = concat("preview-", $exercise.id); title = $exercise.title;
    body = list({ tag = "p"; children = list("Connect your Front Gate SSH tunnel before opening this preview.",
      if(includes($workPreviews, $exercise.id), " You can also open it from Work Start.", "")) }, $exercise.body);
    proof = $exercise.proof;
    link = { tag = "a"; attrs = { class = "onboarding-link"; href = concat("http://", $exercise.id, ".localhost:24220/"); target = "_blank"; rel = "noopener" }; children = list("Open preview") } })
  call formation.platformPreviewExercises
  let platformPreviews = map($result, "exercise", {
    id = concat("preview-", $exercise.id); title = $exercise.title;
    body = list({ tag = "p"; children = list("Connect your Front Gate SSH tunnel before opening this preview.",
      if(includes($workPreviews, $exercise.id), " You can also open it from Work Start.", "")) }, $exercise.body);
    proof = $exercise.proof;
    link = { tag = "a"; attrs = { class = "onboarding-link"; href = $exercise.href; target = "_blank"; rel = "noopener" }; children = list("Open preview") } })
  call formation.publicationExercises
  let publications = map($result, "exercise", {
    id = concat("preview-", $exercise.id); title = $exercise.title;
    body = list({ tag = "p"; children = list("Connect your Front Gate SSH tunnel before opening this preview.") }, $exercise.body);
    proof = $exercise.proof;
    link = { tag = "a"; attrs = { class = "onboarding-link"; href = concat("http://", $exercise.id, ".localhost:24220/"); target = "_blank"; rel = "noopener" }; children = list("Open preview") } })
  let workspaceExercises = map(append(append($homeExercises, $workExercises), append(append($gameExercises, $signedInExercises), append(append($portfolioExercises, $platformPreviews), $publications))), "exercise", { id = $exercise.id; title = $exercise.title;
    body = list($exercise.body, { tag = "p"; children = list($exercise.proof) }, $exercise.link) })
  let resources = append(list(
    $workgarden,
    { id = "shop"; title = "Shop · Request an item and track it"; body = list(
      { tag = "p"; children = list(
        "Sign in, choose an item and quantity, then select ",
        { tag = "strong"; children = list("Request order") },
        ". Reopen Shop and find the same order under ",
        { tag = "strong"; children = list("Your orders") },
        ". The order history records each change. You can cancel while the request is still pending."
      ) },
      { tag = "p"; children = list("Shop operators can publish an item, accept a request, and mark it fulfilled.") },
      { tag = "a"; attrs = { class = "onboarding-link"; href = "/shop/" }; children = list("Open Shop") }
    ) },
    { id = "mobile"; title = "Mobile · Prepare a trip"; body = list(
      { tag = "p"; children = list("Pair your phone from a desktop. Choose your saved Formation note or Field visit task, then send the trip. On the phone, turn on airplane mode and reopen Mobile. Reconnect so the phone can send its offline receipt.") },
      { tag = "p"; children = list("The desktop shows Ready only after every selected item reopened offline on that phone.") },
      { tag = "a"; attrs = { class = "onboarding-link"; href = "/workspace/mobile" }; children = list("Prepare a trip") }
    ) },
    { id = "starter"; title = "Starter guide"; body = list(
      { tag = "p"; children = list("Formation starts with a short walkthrough of Home and Work. Save a note, complete a work item in Workgarden, and decide whether to pin Work in Home. You can return whenever you need to.") },
      { tag = "button"; attrs = { type = "button"; "data-first-run" = "resume" }; children = list("Open Getting started") }
    ) },
    { id = "navigation"; title = "General help · Home, Work and Inbox"; body = list(
      { tag = "p"; children = list("Use the environment controls in the top bar. Home is your personal starting place. Work brings together the apps you use for your projects.") },
      { tag = "p"; children = list("Open Inbox from Start to review incoming requests and follow them to their environment. Platform has two apps, Platform Inbox for incoming requests and Work items for development. A sign-in prompt means the queue needs an approved identity.") }
    ) },
    { id = "note"; title = "Contextual help · My first note"; body = list(
      { tag = "p"; children = list(
        "Replace the example text with something you want to remember, then choose ",
        { tag = "strong"; children = list("Save note") },
        ". Reopen ",
        { tag = "strong"; children = list("My first note") },
        " from the Getting started card in Home or Work."
      ) },
      { tag = "p"; children = list(
        "If you have an older draft, open ",
        { tag = "strong"; children = list("Browser draft") },
        " to review it or import it into your signed-in records."
      ) }
    ) },
    { id = "project"; title = "Contextual help · Field visit"; body = list(
      { tag = "p"; children = list(
        "Read the sample brief and write one task someone could do next. Choose ",
        { tag = "strong"; children = list("Save project task") },
        ". You can pick up that saved task from the walkthrough’s final screen or the Getting started card."
      ) },
      { tag = "p"; children = list("Try naming a person or a deadline, such as “Ask the site manager to confirm access by Friday.”") }
    ) },
    { id = "setup"; title = "Contextual help · Customize and save"; body = list(
      { tag = "p"; children = list(
        "Under ",
        { tag = "strong"; children = list("Make it yours") },
        ", choose ",
        { tag = "strong"; children = list("Pin Work shortcut") },
        " to add a direct link in Home. Return to the same screen to remove it."
      ) },
      { tag = "p"; children = list("Signed-in records are available on your other devices. Work shortcut preferences stay in this browser.") }
    ) },
    { id = "tips"; title = "Tips and tricks"; body = { tag = "ul"; children = list(
      { tag = "li"; children = list("Use the Getting started card to reopen a specific example without going through every step.") },
      { tag = "li"; children = list("Turn a vague reminder into a task by adding a person, place, or date.") },
      { tag = "li"; children = list("On desktop, press Escape to close Help and return to the screen you were using.") }
    ) } }
  ), $workspaceExercises)
  let articles = map($resources, "resource", { tag = "details"; attrs = {
    class = "formation-resource"; name = "formation-resource"; id = concat("formation-resource-", $resource.id)
  }; children = list({ tag = "summary"; children = list($resource.title) }, $resource.body) })
  let result = { tag = "dialog"; attrs = { id = "formation-help"; class = "onboarding-dialog"; "aria-labelledby" = "formation-help-title" }; children = list(
    { tag = "h2"; attrs = { class = "onboarding-heading"; id = "formation-help-title" }; children = list("Help · Sourcery OS") },
    { tag = "div"; attrs = { class = "onboarding-body" }; children = list(
      { tag = "h3"; attrs = { id = "formation-help-index"; tabindex = "-1" }; children = list("Formation resources") },
      { tag = "p"; children = list("Start with the guide, look up an action, or try a tip when you need it.") },
      $articles
    ) },
    { tag = "form"; attrs = { method = "dialog"; class = "onboarding-footer" }; children = list(
      { tag = "button"; children = list("Close Help") }
    ) }
  ) }

process onboarding.shell:
  call formation.workgardenExercise
  let workgarden = $result
  let shortcut = if($work, null, { tag = "p"; attrs = { id = "first-run-pin"; hidden = true }; children = list(
    { tag = "a"; attrs = { href = "/workspace/work" }; children = list("Open Work") }
  ) })
  let dismiss = if($work, null, { tag = "button"; attrs = { class = "workspace-action onboarding-dismiss"; type = "button"; "data-first-run" = "dismiss-home"; "aria-label" = "Dismiss Getting started in Home" }; children = list("×") })
  let input = { tag = "section"; attrs = { class = "onboarding-card"; "aria-label" = "Getting started" }; children = list(
    { tag = "details"; children = list(
      { tag = "summary"; children = list(concat("Getting started in ", if($work, "Work", "Home"))) },
      { tag = "p"; children = list(if($work, "Try the Field visit starter project and save a task you can come back to.", "Start with a note and reopen it from Home or Work.")) },
      { tag = "div"; attrs = { class = "onboarding-shortcuts" }; children = list(
        { tag = "button"; attrs = { class = "onboarding-launch"; type = "button"; "data-first-run" = "resume" }; children = list("Getting started") },
        { tag = "button"; attrs = { class = "onboarding-launch"; type = "button"; "data-first-run" = "note" }; children = list("My first note") },
        { tag = "button"; attrs = { class = "onboarding-launch"; type = "button"; "data-first-run" = "project" }; children = list("Field visit · starter project") }
      ) }
    ) },
    concat($dismiss, $shortcut)
  ) }
  call html.serialize
  let card = $result
  let dialog = { tag = "dialog"; attrs = { id = "first-run-dialog"; class = "onboarding-dialog"; "aria-labelledby" = "first-run-title" }; children = list(
    { tag = "h2"; attrs = { class = "onboarding-heading"; id = "first-run-title" }; children = list("Formation · Getting started") },
    { tag = "div"; attrs = { class = "onboarding-navigation" }; children = list(
      { tag = "p"; attrs = { id = "first-run-progress"; role = "status" } },
      { tag = "nav"; attrs = { "aria-label" = "Getting started steps" }; children = list(
        { tag = "button"; attrs = { type = "button"; "data-first-run" = "home" }; children = list("Home") },
        { tag = "button"; attrs = { type = "button"; "data-first-run" = "work" }; children = list("Work") },
        { tag = "button"; attrs = { type = "button"; "data-first-run" = "customize" }; children = list("Make it yours") },
        { tag = "button"; attrs = { type = "button"; "data-first-run" = "finish" }; children = list("Next step") }
      ) }
    ) },
    { tag = "div"; attrs = { class = "onboarding-body" }; children = list(
      { tag = "section"; attrs = { id = "first-run-home"; class = "onboarding-step"; hidden = true; "aria-labelledby" = "first-run-home-title" }; children = list(
        { tag = "h3"; attrs = { id = "first-run-home-title"; tabindex = "-1" }; children = list("A place to begin") },
        { tag = "div"; attrs = { class = "onboarding-layout" }; children = list(
          { tag = "article"; attrs = { class = "onboarding-example" }; children = list(
            { tag = "h4"; children = list("Your Home") },
            { tag = "p"; children = list("Keep a note, collect a reference, or pick up something you were doing. Home is your personal starting place.") },
            { tag = "p"; children = list("We have left a welcome note for you. Open it, change a line, and save something you want to remember.") },
            { tag = "button"; attrs = { type = "button"; class = "onboarding-primary"; "data-first-run" = "note" }; children = list("Open the welcome note") }
          ) },
          { tag = "aside"; attrs = { class = "onboarding-tip" }; children = list(
            { tag = "h4"; children = list("Finding your way") },
            { tag = "p"; children = list("Use Home and Work in the top bar to change environment. Apps give you a place to do something within that context.") },
            { tag = "p"; children = list("Your examples stay available under Getting started.") },
            { tag = "button"; attrs = { type = "button"; "data-formation-help" = "navigation" }; children = list("Help with Home and Work") }
          ) }
        ) },
        { tag = "div"; attrs = { class = "onboarding-actions" }; children = list(
          { tag = "button"; attrs = { type = "button"; "data-first-run" = "work" }; children = list("Explore Work") }
        ) }
      ) },
      { tag = "section"; attrs = { id = "first-run-work"; class = "onboarding-step"; hidden = true; "aria-labelledby" = "first-run-work-title" }; children = list(
        { tag = "h3"; attrs = { id = "first-run-work-title"; tabindex = "-1" }; children = list("Give your work a context") },
        { tag = "div"; attrs = { class = "onboarding-layout" }; children = list(
          { tag = "article"; attrs = { class = "onboarding-example" }; children = list(
            { tag = "h4"; children = list($workgarden.title) },
            $workgarden.body,
            { tag = "p"; children = list($workgarden.proof) },
            { tag = "a"; attrs = { id = "first-run-workgarden"; class = "onboarding-link onboarding-primary"; href = $workgarden.href }; children = list("Open Workgarden") }
          ) },
          { tag = "aside"; attrs = { class = "onboarding-tip" }; children = list(
            { tag = "h4"; children = list("Field visit drafts") },
            { tag = "p"; children = list("Use the starter project to revisit a Field visit draft.") },
            { tag = "button"; attrs = { type = "button"; "data-first-run" = "project" }; children = list("Open the starter project") }
          ) }
        ) },
        { tag = "div"; attrs = { class = "onboarding-actions" }; children = list(
          { tag = "button"; attrs = { type = "button"; "data-first-run" = "customize" }; children = list("Make it yours") }
        ) }
      ) },
      { tag = "section"; attrs = { id = "first-run-note"; class = "onboarding-step"; hidden = true; "aria-labelledby" = "first-run-note-title" }; children = list(
        { tag = "h3"; attrs = { id = "first-run-note-title"; tabindex = "-1" }; children = list("My first note") },
        { tag = "div"; attrs = { class = "onboarding-layout" }; children = list(
          { tag = "div"; children = list(
            { tag = "form"; attrs = { class = "onboarding-example onboarding-form"; "data-first-run-form" = "note" }; children = list(
              { tag = "label"; attrs = { for = "first-run-note-text" }; children = list("Something to remember") },
              { tag = "textarea"; attrs = { id = "first-run-note-text"; maxlength = "2000"; rows = "6"; required = true; "aria-describedby" = "first-run-note-help" } },
              { tag = "button"; attrs = { class = "onboarding-primary"; type = "submit" }; children = list("Save note") },
              { tag = "p"; attrs = { id = "first-run-note-help" }; children = list("Sign in to save this record across devices. Signed-out drafts stay in this browser.") }
            ) },
            { tag = "details"; attrs = { id = "first-run-note-legacy"; hidden = true }; children = list(
              { tag = "summary"; children = list("Browser draft") },
              { tag = "p"; attrs = { id = "first-run-note-legacy-text" } },
              { tag = "button"; attrs = { type = "button"; id = "first-run-note-import"; "data-first-run" = "import-note" }; children = list("Import browser draft") }
            ) }
          ) },
          { tag = "aside"; attrs = { class = "onboarding-tip" }; children = list(
            { tag = "h4"; children = list("A useful first habit") },
            { tag = "p"; children = list("Capture one concrete next action while it is fresh. You can reopen this note from Getting started in Home or Work.") },
            { tag = "p"; children = list("Keep the note short so you can scan it when you come back.") },
            { tag = "button"; attrs = { type = "button"; "data-formation-help" = "note" }; children = list("Help with this note") }
          ) }
        ) },
        { tag = "div"; attrs = { class = "onboarding-actions" }; children = list(
          { tag = "button"; attrs = { type = "button"; "data-first-run" = "work" }; children = list("Explore Work") },
          { tag = "button"; attrs = { type = "button"; "data-first-run" = "customize" }; children = list("Make it yours") }
        ) }
      ) },
      { tag = "section"; attrs = { id = "first-run-project"; class = "onboarding-step"; hidden = true; "aria-labelledby" = "first-run-project-title" }; children = list(
        { tag = "h3"; attrs = { id = "first-run-project-title"; tabindex = "-1" }; children = list("Field visit · starter project") },
        { tag = "div"; attrs = { class = "onboarding-layout" }; children = list(
          { tag = "div"; children = list(
            { tag = "form"; attrs = { class = "onboarding-example onboarding-form"; "data-first-run-form" = "project" }; children = list(
              { tag = "p"; children = list(
                { tag = "strong"; children = list("Example brief") },
                " · Arrange a field visit. Confirm the location, read the background, and agree on a time with the team."
              ) },
              { tag = "label"; attrs = { for = "first-run-project-text" }; children = list("Your next task") },
              { tag = "textarea"; attrs = { id = "first-run-project-text"; maxlength = "2000"; rows = "4"; required = true; "aria-describedby" = "first-run-project-help" } },
              { tag = "button"; attrs = { type = "submit"; class = "onboarding-primary" }; children = list("Save project task") },
              { tag = "p"; attrs = { id = "first-run-project-help" }; children = list("Sign in to save this record across devices. Signed-out drafts stay in this browser.") }
            ) },
            { tag = "details"; attrs = { id = "first-run-project-legacy"; hidden = true }; children = list(
              { tag = "summary"; children = list("Browser draft") },
              { tag = "p"; attrs = { id = "first-run-project-legacy-text" } },
              { tag = "button"; attrs = { type = "button"; id = "first-run-project-import"; "data-first-run" = "import-project" }; children = list("Import browser draft") }
            ) }
          ) },
          { tag = "aside"; attrs = { class = "onboarding-tip" }; children = list(
            { tag = "h4"; children = list("From practice to your work") },
            { tag = "p"; children = list("Use the apps in Work for your projects. This example lets you practice writing a next task.") },
            { tag = "button"; attrs = { type = "button"; "data-formation-help" = "project" }; children = list("Help with this project") },
            concat(" ", if($work, null, { tag = "a"; attrs = { class = "onboarding-link"; href = "/workspace/work" }; children = list("Open Work") }))
          ) }
        ) },
        { tag = "div"; attrs = { class = "onboarding-actions" }; children = list(
          { tag = "button"; attrs = { type = "button"; "data-first-run" = "customize" }; children = list("Make it yours") }
        ) }
      ) },
      { tag = "section"; attrs = { id = "first-run-customize"; class = "onboarding-step"; hidden = true; "aria-labelledby" = "first-run-customize-title" }; children = list(
        { tag = "h3"; attrs = { id = "first-run-customize-title"; tabindex = "-1" }; children = list("Make this starting place yours") },
        { tag = "div"; attrs = { class = "onboarding-layout" }; children = list(
          { tag = "article"; attrs = { class = "onboarding-example" }; children = list(
            { tag = "h4"; children = list("A shortcut for your work") },
            { tag = "p"; children = list("Pin a shortcut in Home’s Getting started card so you can go straight to Work.") },
            { tag = "button"; attrs = { type = "button"; "data-first-run" = "pin"; id = "first-run-pin-button"; "aria-pressed" = "false" }; children = list("Pin Work shortcut") },
            { tag = "p"; children = list("You can change this choice here whenever you need to.") }
          ) },
          { tag = "aside"; attrs = { class = "onboarding-tip" }; children = list(
            { tag = "h4"; children = list("Across devices") },
            { tag = "p"; children = list("Sign in on another device to reopen your saved records. The Work shortcut preference stays in this browser.") },
            { tag = "p"; children = list("Use Mobile to prepare read-only trip copies on your phone.") },
            { tag = "p"; children = list(
              { tag = "a"; attrs = { class = "onboarding-link"; href = "/workspace/mobile"; "data-first-run" = "prepare-mobile" }; children = list("Pair a phone and prepare a trip") }
            ) },
            { tag = "button"; attrs = { type = "button"; "data-formation-help" = "setup" }; children = list("Help with this setup") }
          ) }
        ) },
        { tag = "div"; attrs = { class = "onboarding-actions" }; children = list(
          { tag = "button"; attrs = { type = "button"; class = "onboarding-primary"; "data-first-run" = "finish" }; children = list("Show my next step") }
        ) }
      ) },
      { tag = "section"; attrs = { id = "first-run-finish"; class = "onboarding-step"; hidden = true; "aria-labelledby" = "first-run-finish-title" }; children = list(
        { tag = "h3"; attrs = { id = "first-run-finish-title"; tabindex = "-1" }; children = list("Your setup and what to do next") },
        { tag = "article"; attrs = { class = "onboarding-example" }; children = list(
          { tag = "p"; attrs = { id = "first-run-summary" } },
          { tag = "p"; attrs = { id = "first-run-next-explanation" } },
          { tag = "button"; attrs = { type = "button"; class = "onboarding-primary"; id = "first-run-next"; "data-first-run" = "next" }; children = list("Open your next step") }
        ) },
        { tag = "p"; children = list("To change your setup, reopen Getting started and choose Make it yours. Your note and starter project stay available there.") },
        { tag = "div"; attrs = { class = "onboarding-actions" }; children = list(
          { tag = "button"; attrs = { type = "button"; "data-first-run" = "customize" }; children = list("Customize my setup") },
          { tag = "button"; attrs = { type = "button"; "data-first-run" = "done" }; children = list("Finish and return") }
        ) }
      ) }
    ) },
    { tag = "form"; attrs = { id = "formation-record-form"; hidden = true }; children = list(
      { tag = "input"; attrs = { id = "formation-record-kind"; name = "kind" } },
      { tag = "input"; attrs = { id = "formation-record-owner"; name = "owner" } },
      { tag = "input"; attrs = { id = "formation-record-base"; name = "base" } },
      { tag = "input"; attrs = { id = "formation-record-action"; name = "action" } },
      { tag = "textarea"; attrs = { id = "formation-record-text"; name = "text" } }
    ) },
    { tag = "p"; attrs = { id = "first-run-feedback"; class = "onboarding-feedback"; role = "status" } },
    { tag = "footer"; attrs = { class = "onboarding-footer" }; children = list(
      { tag = "span"; attrs = { id = "first-run-custody" }; children = list("Checking saved records…") },
      { tag = "button"; attrs = { type = "button"; "data-first-run" = "pause"; id = "first-run-close" }; children = list("Close for now") }
    ) }
  ) }
  call formation.helpShell
  let input = list($dialog, $result)
  call html.serialize
  let result = { card = $card; dialog = $result }

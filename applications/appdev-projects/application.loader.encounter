        "applications/appdev-projects/managers.encounter",
        "applications/appdev-projects/front-gate-desktop.encounter",
        "applications/appdev-projects/front-gate-presentation.encounter",
        "applications/appdev-projects/store-desktop.encounter", "applications/appdev-projects/store-window.encounter",
        "applications/appdev-projects/game-hub-desktop.encounter",
        "applications/appdev-projects/first-run-shell.encounter",
        "applications/appdev-projects/notes-inbox-shell.encounter",
        "applications/appdev-projects/presentation.encounter",

    "</defs></svg>"
  )

process desktop.documentStyles:
  let rules = list(
    { selector = ".desktop-app-window[data-desktop-layout=document]"; properties = list(list("height", "min(42rem, 100%)")) },
    { selector = ".desktop-app-window[data-desktop-layout=document][data-manager-maximized=true]"; properties = list(list("height", "auto")) },
    { selector = ".desktop-app-window[data-desktop-layout=document] > .desktop-app-content"; properties = list(list("display", "flex"),
      list("flex", "1 1 auto"), list("flex-direction", "column"), list("overflow", "hidden"), list("padding", "0"), list("background", "var(--gray)"), list("box-shadow", "none")) },
    { selector = ".desktop-app-window[data-window-type=document] > :is([data-window-slot=menu], [data-window-slot=banner])"; properties = list(list("flex", "none")) },
    { selector = ".document-menu-bar > button"; properties = list(list("border", "0"), list("background", "transparent"), list("cursor", "pointer")) },
    { selector = ".document-menu-panel"; properties = list(list("inset", "auto"), list("margin", "0"), list("position-area", "block-end span-inline-end"),
      list("position-try-fallbacks", "flip-inline, flip-block"), list("justify-self", "start"), list("align-self", "start"),
      list("width", "max-content"), list("max-width", "min(23rem, calc(100vw - 24px))"), list("max-height", "min(20rem, 70dvh)"),
      list("border", "0"), list("padding", "4px"), list("color", "var(--sourcery-ink)"),
      list("--sourcery-menu-shadow", "3px 4px #10294156")) },
    { selector = ".document-menu-panel p"; properties = list(list("margin", "0"), list("padding", "6px 8px"), list("line-height", "1.45")) },
    { selector = ".document-menu-panel button"; properties = list(list("display", "block"), list("width", "100%"), list("padding", "6px 8px"),
      list("border", "0"), list("text-align", "start"), list("font", "inherit"), list("background", "transparent"), list("color", "inherit"), list("cursor", "pointer")) },
    { selector = ".document-menu-panel button:is(:hover, :focus-visible)"; properties = list(list("background", "var(--navy)"), list("color", "white")) },
    { selector = ".desktop-app-content > .manager-panel"; properties = list(list("display", "flex"), list("flex", "1 1 auto"),
      list("flex-direction", "column"), list("min-height", "0"), list("margin", "0 3px 3px")) },
    { selector = ".manager-panel > .manager-tabs"; properties = list(list("background", "var(--sourcery-frame)")) },
    { selector = ".manager-location"; properties = list(list("flex", "none"), list("flex-wrap", "wrap"), list("align-items", "center"),
      list("justify-content", "space-between"), list("--sourcery-status-gap", "4px 8px"), list("padding", "6px 10px"), list("border-bottom", "1px solid var(--sourcery-line)")) },
    { selector = ".manager-panes"; properties = list(list("display", "grid"), list("flex", "1 1 auto"), list("min-height", "0"),
      list("grid-template-columns", "minmax(0,3fr) minmax(0,7fr)"), list("grid-template-rows", "minmax(0,1fr)")) },
    { selector = ".manager-panes.manager-single-pane"; properties = list(list("grid-template-columns", "minmax(0,1fr)")) },
    { selector = ".manager-panes > textarea[data-workspace-widget=text]"; properties = list(
      list("min-height", "0"), list("min-width", "0"), list("resize", "none"), list("padding", "10px"),
      list("border", "1px solid var(--sourcery-line)"), list("background", "var(--sourcery-paper)"),
      list("color", "var(--sourcery-ink)"), list("font", "14px/1.5 ui-monospace, monospace")) },
    { selector = "#system-catalogue-detail"; properties = list(list("overflow-wrap", "anywhere")) },
    { selector = ".catalogue-relationships"; properties = list(list("margin", "6px 0 0"), list("padding-inline-start", "1.4em")) },
    { selector = ".catalogue-relationships > li"; properties = list(list("padding-block", "2px")) },
    { selector = ".catalogue-tree"; properties = list(list("margin-block-end", "10px")) },
    { selector = ".catalogue-tree > ul, .catalogue-tree details > ul"; properties = list(list("padding", "0"),
      list("margin", "0"), list("list-style", "none")) },
    { selector = ".catalogue-tree details > ul"; properties = list(list("border-inline-start", "1px solid var(--sourcery-line)"),
      list("margin-inline-start", "9px"), list("padding-inline-start", "10px")) },
    { selector = ".catalogue-tree summary"; properties = list(list("padding", "5px 6px"),
      list("border-radius", "2px"), list("color", "var(--sourcery-ink)")) },
    { selector = ".catalogue-tree details[open] > summary"; properties = list(list("background", "var(--sourcery-panel)")) },
    { selector = "#system-catalogue-detail .catalogue-tree .catalogue-fields"; properties = list(list("background", "var(--sourcery-paper)"),
      list("border", "1px solid var(--sourcery-line)"), list("margin", "2px 0 5px"), list("padding", "4px 7px")) },
    { selector = ".catalogue-tree .catalogue-fields ul"; properties = list(list("margin", "0"), list("padding-inline-start", "1.2em")) },
    { selector = "#system-catalogue-detail :is(.catalogue-groups > details, .catalogue-entry)"; properties = list(list("border", "1px solid var(--sourcery-line)"),
      list("padding", "6px 9px"), list("margin-block-end", "6px"), list("background", "var(--sourcery-paper)")) },
    { selector = "#system-catalogue-detail .catalogue-groups > details > summary"; properties = list(list("background", "var(--sourcery-panel)"),
      list("padding", "7px 9px"), list("margin", "-6px -9px"), list("color", "var(--sourcery-ink)")) },
    { selector = "#system-catalogue-detail .catalogue-groups > details[open] > summary"; properties = list(list("margin-block-end", "6px")) },
    { selector = "#system-catalogue-detail summary > span"; properties = list(list("margin-inline-start", "9px"), list("color", "var(--sourcery-muted)")) },
    { selector = "#system-catalogue-detail .catalogue-fields"; properties = list(list("display", "block"), list("margin", "6px 0 0")) },
    { selector = "#system-catalogue-detail summary"; properties = list(list("display", "list-item"), list("list-style", "revert")) },
    { selector = "#system-catalogue-detail .catalogue-fields > div"; properties = list(list("display", "grid"),
      list("grid-template-columns", "minmax(5rem, 1fr) minmax(0, 3fr)"), list("gap", "6px"), list("padding-block", "2px")) },
    { selector = "#system-catalogue-detail :is(dd, h4)"; properties = list(list("margin", "0")) },
    { selector = "#system-catalogue-detail .catalogue-tokens"; properties = list(list("padding", "0"), list("list-style", "none")) },
    { selector = "#system-catalogue-detail .catalogue-tokens > li"; properties = list(list("display", "flex"), list("flex-wrap", "wrap"),
      list("gap", "2px 8px"), list("padding", "5px 4px"), list("border-bottom", "1px solid var(--sourcery-line)")) },
    { selector = ".desktop-scroll-pane:focus-visible"; properties = list(list("outline", "2px dashed var(--navy)"), list("outline-offset", "-3px")) },
    { selector = ".manager-panes:not(.manager-single-pane)"; context = "(max-width: 540px)";
      properties = list(list("grid-template-columns", "minmax(0,1fr)"), list("grid-template-rows", "minmax(0,2fr) minmax(0,3fr)")) },
    { selector = ".desktop-app-window[data-window-type=document] > .manager-banner"; context = "(max-height: 560px)"; properties = list(list("min-height", "0"), list("padding-block", "6px")) },
    { selector = "#start .start-group button.app-link"; properties = list(list("width", "100%"), list("border", "0"), list("background", "transparent"),
      list("font", "inherit"), list("color", "inherit"), list("text-align", "start"), list("cursor", "pointer")) },
    { selector = "#start .start-group .app-link"; properties = list(list("padding", "6px 9px"), list("min-height", "33px")) },
    { selector = "#start .start-group .app-link small"; properties = list(list("display", "none")) },
    { selector = "#start .start-group .app-link:is(:hover, :focus-visible)"; properties = list(list("background", "#dde5ff")) },
    { selector = ".shortcuts > button.app-link"; properties = list(list("background", "transparent"), list("border", "0"),
      list("font-family", "inherit"), list("cursor", "pointer")) },
    { selector = ".desktop:has(>.shortcuts [data-desktop-launch=file-manager])"; context = "(max-width: 360px)";
      properties = list(list("grid-template-rows", "auto minmax(0,1fr)")) },
    { selector = ".desktop > .shortcuts:has(>[data-desktop-launch=file-manager])"; context = "(max-width: 360px)";
      properties = list(list("display", "grid"), list("grid-template-columns", "repeat(2,minmax(0,1fr))")) },
    { selector = ".shortcuts:has(>[data-desktop-launch=file-manager]) > :not(.workspace-shortcut, [data-desktop-launch=file-manager])";
      context = "(max-width: 360px)"; properties = list(list("display", "none")) }
  )
  call windowWidget.desktopSettings
  let backgrounds = map($result.choices, "choice", {
    selector = concat("body[data-desktop-background-", $choice.code, "='true'] main.desktop");
    properties = list(list("--sourcery-desktop", concat("#", $choice.color))) })
  let cssPlan = { imports = list(); tokens = list(); rules = map(append($rules, $backgrounds), "rule", {
    selector = $rule.selector; context = at($rule, "context");
    declarations = map($rule.properties, "pair", { property = at($pair, 0); value = at($pair, 1) })
  }) }
  call css.renderPlan

process desktop.windowSizingStyles:
  let cssRuleSeparator = ""
  let cssRules = list(
    { selector = "#workspace"; declarations = list(
      { property = "block-size"; value = "min(42rem,calc(100dvh - max(44px,clamp(22px,7vh,70px)) - 102px))" }
    ) },
    { selector = "#workspace .program-switcher,#workspace .programs"; declarations = list(
      { property = "flex"; value = "1" }
    ) },
    { selector = "#workspace-maximized:checked~.desktop #workspace"; declarations = list(
      { property = "block-size"; value = "auto" },
      { property = "max-block-size"; value = "none" }
    ) },
    { atRule = "media"; prelude = "(max-width:670px)"; rules = list(
      { selector = "#workspace"; declarations = list(
        { property = "block-size"; value = "100%" },
        { property = "max-block-size"; value = "none" }
      ) }
    ) },
    { selector = "#workspace .statusbar>span"; declarations = list(
      { property = "display"; value = "inline-flex" },
      { property = "align-items"; value = "center" },
      { property = "gap"; value = "4px" }
    ) },
    { selector = "#workspace .statusbar>span>svg"; declarations = list(
      { property = "flex"; value = "none" }
    ) },
    { selector = "#workspace #status,#workspace #launch-sign-in"; declarations = list(
      { property = "white-space"; value = "nowrap" }
    ) },
    { selector = "#workspace-sign-in-text"; declarations = list(
      { property = "font-weight"; value = "inherit" }
    ) },
    { selector = ".workspace-unlocked,body[data-workspace-signed-in=true] .workspace-locked"; declarations = list(
      { property = "display"; value = "none" }
    ) },
    { selector = "body[data-workspace-signed-in=true] .workspace-unlocked"; declarations = list(
      { property = "display"; value = "inline" }
    ) }
  )
  call css.renderCompactRules

process desktop.layoutStyles:
  let cssRuleSeparator = ""
  let cssRules = list(
    { atRule = "media"; prelude = " (hover:hover) and (pointer:fine)"; rules = list(
      { selector = "#start[open] .start-group>summary:hover"; declarations = list(
        { property = "animation"; value = "start-flyout-hover 160ms linear" }
      ) }
    ) },
    { atRule = "keyframes"; prelude = " start-flyout-hover"; rules = list(
      { selector = "from"; declarations = list(
        { property = "--start-flyout-hover-ready"; value = "0" }
      ) },
      { selector = "to"; declarations = list(
        { property = "--start-flyout-hover-ready"; value = "1" }
      ) }
    ) },
    { selector = "#start .start-menu nav:has(>.start-group)"; declarations = list(
      { property = "--start-column-width"; value = "clamp(112px,34vw,180px)" },
      { property = "position"; value = "relative" },
      { property = "inline-size"; value = "var(--start-column-width)" },
      { property = "min-inline-size"; value = "0" },
      { property = "overflow"; value = "visible" }
    ) },
    { selector = "#start .start-group>summary"; declarations = list(
      { property = "display"; value = "flex" },
      { property = "align-items"; value = "center" },
      { property = "justify-content"; value = "space-between" },
      { property = "gap"; value = "8px" },
      { property = "min-block-size"; value = "33px" },
      { property = "padding"; value = "6px 9px" },
      { property = "color"; value = "var(--navy)" },
      { property = "background"; value = "#eeece3" },
      { property = "border-bottom"; value = "1px solid #adabb1" },
      { property = "font-weight"; value = "bold" }
    ) },
    { selector = "#start .start-group>summary::after"; declarations = list(
      { property = "content"; value = "'›'" }
    ) },
    { selector = "#start .start-group[open]>summary,#start .start-group>summary:is(:hover,:focus-visible)"; declarations = list(
      { property = "background"; value = "#dde5ff" }
    ) },
    { selector = "#start .start-flyout"; declarations = list(
      { property = "position"; value = "absolute" },
      { property = "inset-block-end"; value = "0" },
      { property = "inset-inline-start"; value = "calc(100% - 1px)" },
      { property = "z-index"; value = "1" },
      { property = "inline-size"; value = "min(235px,calc(100vw - var(--start-column-width) - 48px))" },
      { property = "min-block-size"; value = "100%" },
      { property = "max-block-size"; value = "calc(100dvh - 55px)" },
      { property = "overflow"; value = "auto" },
      { property = "overscroll-behavior"; value = "contain" },
      { property = "background"; value = "var(--gray)" },
      { property = "box-shadow"; value = "var(--raised),3px 3px #18233f60" },
      { property = "padding"; value = "3px" },
      { property = "overflow-wrap"; value = "anywhere" }
    ) },
    { selector = "#start #start-flyout-account>.start-flyout"; declarations = list(
      { property = "inset-block"; value = "0 auto" },
      { property = "min-block-size"; value = "0" },
      { property = "inline-size"; value = "min(214px,calc(100vw - var(--start-column-width) - 48px))" },
      { property = "padding"; value = "2px" }
    ) },
    { selector = "#start #start-flyout-account #account-state"; declarations = list(
      { property = "margin"; value = "0" },
      { property = "padding"; value = "6px 9px" },
      { property = "background"; value = "#e9ecf4" },
      { property = "border-block-end"; value = "1px solid #adabb1" },
      { property = "color"; value = "#3e4a63" },
      { property = "font-size"; value = ".88em" },
      { property = "line-height"; value = "1.3" },
      { property = "overflow-wrap"; value = "anywhere" }
    ) },
    { selector = "#start #start-flyout-account .app-link"; declarations = list(
      { property = "display"; value = "flex" },
      { property = "align-items"; value = "center" },
      { property = "inline-size"; value = "100%" },
      { property = "min-block-size"; value = "32px" },
      { property = "padding"; value = "5px 9px" },
      { property = "color"; value = "var(--navy)" },
      { property = "font"; value = "inherit" },
      { property = "text-align"; value = "start" }
    ) },
    { selector = "#start #start-flyout-account .app-link[hidden]"; declarations = list(
      { property = "display"; value = "none" }
    ) },
    { selector = "#start #start-flyout-account .app-link:is(:hover,:focus-visible)"; declarations = list(
      { property = "background"; value = "#dde5ff" }
    ) },
    { selector = "header.home-shell-header"; declarations = list(
      { property = "position"; value = "relative" },
      { property = "z-index"; value = "7" },
      { property = "display"; value = "grid" },
      { property = "grid-template-columns"; value = "auto minmax(0,1fr) auto" },
      { property = "gap"; value = "4px 10px" }
    ) },
    { selector = ".home-shell-header>.workspace-switch"; declarations = list(
      { property = "grid-column"; value = "2" },
      { property = "justify-self"; value = "center" }
    ) },
    { selector = ".home-shell-header>.workspace-connection-status"; declarations = list(
      { property = "grid-column"; value = "3" },
      { property = "justify-self"; value = "end" },
      { property = "min-height"; value = "26px" },
      { property = "padding"; value = "0" },
      { property = "gap"; value = "5px" },
      { property = "background"; value = "transparent" },
      { property = "border"; value = "0" },
      { property = "white-space"; value = "nowrap" }
    ) },
    { selector = ".home-shell-header [data-connection-reason]"; declarations = list(
      { property = "left"; value = "auto" },
      { property = "right"; value = "0" },
      { property = "transform"; value = "none" }
    ) },
    { selector = "main.desktop"; declarations = list(
      { property = "padding-block-start"; value = "max(44px,clamp(22px,7vh,70px))" }
    ) },
    { selector = "#workspace-maximized:checked~main.desktop>.window"; declarations = list(
      { property = "inset-block-start"; value = "43px" }
    ) },
    { atRule = "media"; prelude = "(max-width:780px)"; rules = list(
      { selector = ".home-shell-header .connection-name"; declarations = list(
        { property = "position"; value = "absolute" },
        { property = "width"; value = "1px" },
        { property = "height"; value = "1px" },
        { property = "clip-path"; value = "inset(50%)" },
        { property = "overflow"; value = "hidden" }
      ) },
      { selector = "header.home-shell-header:has([data-state=disconnected])"; declarations = list(
        { property = "grid-template-columns"; value = "auto 1fr" }
      ) },
      { selector = ".home-shell-header:has([data-state=disconnected])>.workspace-switch"; declarations = list(
        { property = "grid-column"; value = "2" },
        { property = "justify-self"; value = "end" }
      ) },
      { selector = ".home-shell-header:has([data-state=disconnected])>.workspace-connection-status"; declarations = list(
        { property = "grid-column"; value = "1/-1" },
        { property = "grid-row"; value = "3" }
      ) }
    ) },
    { atRule = "media"; prelude = "(max-width:480px)"; rules = list(
      { selector = "header.home-shell-header"; declarations = list(
        { property = "padding-inline"; value = "6px" },
        { property = "gap"; value = "4px" },
        { property = "font-size"; value = "12px" }
      ) },
      { selector = ".home-shell-header>.workspace-switch"; declarations = list(
        { property = "gap"; value = "2px" }
      ) },
      { selector = ".home-shell-header>.workspace-switch>a"; declarations = list(
        { property = "padding-inline"; value = "6px" }
      ) },
      { selector = ".home-shell-header>.workspace-connection-status"; declarations = list(
        { property = "font-size"; value = "11px" }

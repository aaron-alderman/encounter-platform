  )
  call css.renderCompactRules

process desktop.compilerStyles:
  let cssRuleSeparator = ""
  let cssRules = list(
    { selector = "#semantic-compiler-detail"; declarations = list(
      { property = "overflow-wrap"; value = "anywhere" }
    ) },
    { selector = "#semantic-compiler-detail .compiler-case"; declarations = list(
      { property = "border-bottom"; value = "1px solid var(--gray)" },
      { property = "padding-bottom"; value = "8px" }
    ) },
    { selector = "#semantic-compiler-detail :is(h3,h4,p)"; declarations = list(
      { property = "margin"; value = "0 0 8px" }
    ) },
    { selector = "#semantic-compiler-detail h4"; declarations = list(
      { property = "margin-top"; value = "14px" }
    ) },
    { selector = "#semantic-compiler-detail .compiler-views"; declarations = list(
      { property = "position"; value = "relative" }
    ) },
    { selector = "#semantic-compiler-detail input[name=compiler-view]"; declarations = list(
      { property = "position"; value = "absolute" },
      { property = "opacity"; value = "0" },
      { property = "inline-size"; value = "1px" },
      { property = "block-size"; value = "1px" }
    ) },
    { selector = "#semantic-compiler-detail .manager-tabs label"; declarations = list(
      { property = "cursor"; value = "pointer" }
    ) },
    { selector = "#semantic-compiler-detail [data-compiler-view]"; declarations = list(
      { property = "display"; value = "none" }
    ) },
    { selector = "#compiler-facts:checked~[data-compiler-view=facts],#compiler-contracts:checked~[data-compiler-view=contracts],#compiler-coverage:checked~[data-compiler-view=coverage],#compiler-dry-run:checked~[data-compiler-view=dry-run]"; declarations = list(
      { property = "display"; value = "block" }
    ) },
    { selector = "#compiler-facts:checked~.manager-tabs [for=compiler-facts],#compiler-contracts:checked~.manager-tabs [for=compiler-contracts],#compiler-coverage:checked~.manager-tabs [for=compiler-coverage],#compiler-dry-run:checked~.manager-tabs [for=compiler-dry-run]"; declarations = list(
      { property = "background"; value = "var(--paper)" },
      { property = "font-weight"; value = "bold" }
    ) },
    { selector = "#compiler-facts:focus-visible~.manager-tabs [for=compiler-facts],#compiler-contracts:focus-visible~.manager-tabs [for=compiler-contracts],#compiler-coverage:focus-visible~.manager-tabs [for=compiler-coverage],#compiler-dry-run:focus-visible~.manager-tabs [for=compiler-dry-run]"; declarations = list(
      { property = "outline"; value = "2px dashed var(--navy)" },
      { property = "outline-offset"; value = "-3px" }
    ) },
    { selector = "#semantic-compiler-detail .compiler-group"; declarations = list(
      { property = "border-bottom"; value = "1px solid var(--gray)" },
      { property = "padding"; value = "7px 0" }
    ) },
    { selector = "#semantic-compiler-detail .compiler-group summary"; declarations = list(
      { property = "cursor"; value = "pointer" },
      { property = "font-weight"; value = "bold" }
    ) },
    { selector = "#semantic-compiler-detail .compiler-group>p"; declarations = list(
      { property = "margin-top"; value = "8px" }
    ) },
    { selector = "#semantic-compiler-detail .compiler-references"; declarations = list(
      { property = "padding-inline-start"; value = "20px" }
    ) },
    { selector = "#semantic-compiler-detail .compiler-references li"; declarations = list(
      { property = "margin-block"; value = "6px" }
    ) },
    { selector = "#semantic-compiler-detail .compiler-references p"; declarations = list(
      { property = "margin-block"; value = "3px" }
    ) },
    { selector = "#semantic-compiler-detail table"; declarations = list(
      { property = "width"; value = "100%" },
      { property = "table-layout"; value = "fixed" }
    ) },
    { selector = "#semantic-compiler-detail .compiler-evidence"; declarations = list(
      { property = "white-space"; value = "pre-wrap" },
      { property = "overflow-wrap"; value = "anywhere" },
      { property = "margin"; value = "8px 0" }
    ) },
    { selector = "#compiler-route-form"; declarations = list(
      { property = "display"; value = "flex" },
      { property = "align-items"; value = "center" },
      { property = "flex-wrap"; value = "wrap" },
      { property = "gap"; value = "8px" },
      { property = "margin-block"; value = "12px" }
    ) },
    { selector = "#compiler-route-form input"; declarations = list(
      { property = "flex"; value = "1 1 15rem" },
      { property = "min-width"; value = "0" }
    ) },
    { selector = "#compiler-route-result [role=alert]"; declarations = list(
      { property = "font-weight"; value = "bold" }
    ) }
  )
  call css.renderCompactRules
  let result = concat("/* Semantic Compiler */", $result, "")

process desktop.environmentStyles:
  let cssRuleSeparator = ""
  let cssRules = list(
    { selector = "#environments-dialog>.dialog-body"; declarations = list(
      { property = "overflow-y"; value = "auto" },
      { property = "overscroll-behavior"; value = "contain" },
      { property = "scroll-padding-top"; value = "8rem" }
    ) },
    { selector = "#environments-dialog>.dialog-actions"; declarations = list(
      { property = "border-top"; value = "1px solid #808080" },
      { property = "background"; value = "var(--gray)" }
    ) },
    { selector = ".environments-summary"; declarations = list(
      { property = "position"; value = "sticky" },
      { property = "top"; value = "0" },
      { property = "z-index"; value = "1" },
      { property = "background"; value = "var(--gray)" },
      { property = "padding"; value = "0 0 6px" },
      { property = "margin-bottom"; value = "6px" }
    ) },
    { selector = ".environments-summary .handover-banner"; declarations = list(
      { property = "margin"; value = "0 0 5px" }
    ) },
    { selector = ".environments-summary p"; declarations = list(
      { property = "margin"; value = "4px 0" }
    ) },
    { selector = ".environments-indicators"; declarations = list(
      { property = "display"; value = "flex" },
      { property = "gap"; value = "5px" },
      { property = "flex-wrap"; value = "wrap" }
    ) },
    { selector = ".environments-indicators strong"; declarations = list(
      { property = "padding"; value = "2px 6px" },
      { property = "background"; value = "var(--paper)" },
      { property = "border"; value = "1px solid #808080" }
    ) },
    { selector = ".environments-roles"; declarations = list(
      { property = "display"; value = "flex" },
      { property = "flex-wrap"; value = "wrap" },
      { property = "gap"; value = "6px" },
      { property = "margin"; value = "0 0 10px" }
    ) },
    { selector = "#environments-dialog button[aria-pressed=true]"; declarations = list(

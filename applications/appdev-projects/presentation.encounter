    { selector = "#environments-dialog figure img"; declarations = list(
      { property = "max-width"; value = "100%" },
      { property = "height"; value = "auto" },
      { property = "image-rendering"; value = "pixelated" }
    ) }
  )
  call css.renderCompactRules
  let result = concat("/* Environments demo */", $result, "/* End environments demo */")

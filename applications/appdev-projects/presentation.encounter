process-module "temple/surface-process-module/1"

process desktop.styles:
  call desktop.documentStyles
  let documentStyles = $result
  call files.styles
  let fileStyles = $result
  call appCard.styles
  let appCardStyles = $result
  call sourcery.presentation.tokens
  let presentationTokens = $result
  call sourcery.presentation.feedbackStyles
  let feedbackStyles = $result
  call sourcery.compact.home
  let compactStyles = $result
  call tray.styles
  let trayStyles = $result
  call desktop.windowSizingStyles
  let windowSizingStyles = $result
  call desktop.layoutStyles
  let layoutStyles = $result
  let input = list(
    $trayStyles,
    $windowSizingStyles,
    $presentationTokens,
    $feedbackStyles,
    $shellStyles,
    $documentStyles,
    $fileStyles,
    $appCardStyles,
    $layoutStyles,
    $compactStyles
  )
  call html.cssText
  let styles = $result
  call workspace.connectionStyles
  let connectionStyles = $result
  call onboarding.styles
  let onboardingStyles = $result
  call design.workspaceFrameStyles
  let designStyles = $result
  call customization.styles
  let customizationStyles = $result
  call managers.densityStyles
  let densityStyles = $result
  call store.desktopStyles
  let storeStyles = $result
  call game.desktopStyles
  let gameStyles = $result
  call frontGate.styles
  let frontGateStyles = $result
  call inbox.styles
  let inboxStyles = $result
  call desktop.compilerStyles
  let compilerStyles = $result
  call desktop.environmentStyles
  let environmentStyles = $result
  let css = concat($styles, $connectionStyles, $onboardingStyles, $designStyles, $customizationStyles, $densityStyles,
    $storeStyles, $gameStyles, $frontGateStyles, $inboxStyles, $compilerStyles, $environmentStyles)
  let marker = "SOURCERY-GENERATED-DESKTOP-CSS"
  let input = { tag = "style"; children = list($marker) }
  call html.serialize
  port text.replaceAll { value = $result; search = $marker; replacement = $css } → result

process managers.densityStyles:
  let cssRuleSeparator = ""
  let cssRules = list(
    { selector = ".manager-location-controls"; declarations = list(
      { property = "display"; value = "flex" },
      { property = "align-items"; value = "center" },
      { property = "flex-wrap"; value = "wrap" },
      { property = "gap"; value = "4px 8px" }
    ) },
    { selector = ".manager-location-controls .manager-density-control"; declarations = list(
      { property = "display"; value = "flex" },
      { property = "align-items"; value = "center" },
      { property = "gap"; value = "5px" }
    ) },
    { selector = ".manager-density-control select"; declarations = list(
      { property = "font"; value = "inherit" },
      { property = "max-inline-size"; value = "100%" }
    ) },
    { selector = ".custom-service-item"; declarations = list(
      { property = "display"; value = "block" },
      { property = "overflow-wrap"; value = "anywhere" }
    ) },
    { selector = ".custom-service-item[aria-current=true]"; declarations = list(
      { property = "background"; value = "var(--sourcery-selected)" }
    ) },
    { selector = ":is(.custom-preview[data-density],.manager-panel[data-density-control])"; declarations = list(
      { property = "--density-padding"; value = "8px" },
      { property = "--density-gutter-adjustment"; value = "-4px" },
      { property = "--density-row-padding"; value = "4px" },
      { property = "--density-leading"; value = "1.35" },
      { property = "--density-cell-adjustment"; value = "-2px" },
      { property = "--density-cell-padding"; value = "4px" }
    ) },
    { selector = ":is(.custom-preview[data-density=roomier],.manager-panel[data-density-roomier=true])"; declarations = list(
      { property = "--density-padding"; value = "clamp(12px,3vw,24px)" },
      { property = "--density-gutter-adjustment"; value = "8px" },
      { property = "--density-row-padding"; value = "7px" },
      { property = "--density-leading"; value = "1.6" },
      { property = "--density-cell-adjustment"; value = "3px" },
      { property = "--density-cell-padding"; value = "9px" }
    ) },
    { selector = ":is(.custom-preview[data-density],.manager-panel[data-density-control]) :is(.manager-main,.custom-reading)"; declarations = list(
      { property = "padding"; value = "var(--density-padding)" },
      { property = "line-height"; value = "var(--density-leading)" }
    ) },
    { selector = ".custom-preview[data-density] :is(.manager-main,.custom-reading)"; declarations = list(
      { property = "padding"; value = "max(2px,calc(var(--custom-reader-padding,12px) + var(--density-gutter-adjustment)))" }
    ) },
    { selector = ":is(.custom-preview[data-density],.manager-panel[data-density-control]) .manager-tree :is(button,.custom-service-item)"; declarations = list(
      { property = "padding"; value = "var(--density-row-padding) 5px" }
    ) },
    { selector = ".service-observations"; declarations = list(
      { property = "margin-block-end"; value = "10px" },
      { property = "--sourcery-table-font-size"; value = "inherit" },
      { property = "--sourcery-table-cell-padding"; value = "var(--density-cell-padding,6px)" }
    ) },
    { selector = ".service-observations tbody th[scope=row]"; declarations = list(
      { property = "inline-size"; value = "28%" },
      { property = "min-inline-size"; value = "5rem" }
    ) },
    { selector = ".service-observation-with-action"; declarations = list(
      { property = "display"; value = "flex" },
      { property = "align-items"; value = "center" },
      { property = "justify-content"; value = "space-between" },
      { property = "flex-wrap"; value = "wrap" },
      { property = "gap"; value = "4px 10px" }
    ) },
    { selector = ".service-observation-with-action>.button[data-manager-action]"; declarations = list(
      { property = "margin"; value = "0" },
      { property = "padding"; value = "3px 7px" },
      { property = "max-inline-size"; value = "100%" },
      { property = "text-align"; value = "start" }
    ) },
    { selector = ".service-observations [data-observation-tone]"; declarations = list(
      { property = "background"; value = "var(--observation-paper)" },
      { property = "color"; value = "var(--observation-ink)" }
    ) },
    { selector = ".service-observations [data-observation-tone=success]"; declarations = list(
      { property = "--observation-paper"; value = "var(--sourcery-success-paper)" },
      { property = "--observation-ink"; value = "var(--sourcery-success-ink)" }
    ) },
    { selector = ".service-observations [data-observation-tone=warning]"; declarations = list(
      { property = "--observation-paper"; value = "var(--sourcery-warning-paper)" },
      { property = "--observation-ink"; value = "var(--sourcery-warning-ink)" }
    ) },
    { selector = ".service-observations [data-observation-tone=error]"; declarations = list(
      { property = "--observation-paper"; value = "var(--sourcery-error-paper)" },
      { property = "--observation-ink"; value = "var(--sourcery-error-ink)" }
    ) },
    { selector = ".service-observations [data-observation-tone=muted]"; declarations = list(
      { property = "--observation-paper"; value = "var(--sourcery-panel)" },
      { property = "--observation-ink"; value = "var(--sourcery-muted)" }
    ) },
    { selector = ".service-observations [data-observation-role=next]"; declarations = list(
      { property = "color"; value = "var(--sourcery-info-ink)" }
    ) },
    { selector = ".service-observations [data-observation-role=context]"; declarations = list(
      { property = "color"; value = "var(--sourcery-muted)" }
    ) },
    { selector = ".custom-preview[data-density] .manager-main .sourcery-data-table"; declarations = list(
      { property = "--sourcery-table-cell-padding"; value = "max(1px,calc(var(--custom-cell-padding,6px) + var(--density-cell-adjustment)))" }
    ) },
    { selector = ":is(.custom-preview[data-density=roomier],.manager-panel[data-density-roomier=true]) .manager-panes:not(.manager-single-pane)"; declarations = list(
      { property = "grid-template-columns"; value = "minmax(0,1fr)" },
      { property = "grid-template-rows"; value = "fit-content(8.5rem) minmax(0,1fr)" }
    ) },
    { selector = ":is(.custom-preview[data-density=roomier],.manager-panel[data-density-roomier=true]) .manager-tree"; declarations = list(
      { property = "border-inline-end"; value = "0" },
      { property = "border-block-end"; value = "1px solid var(--sourcery-line)" }
    ) },
    { selector = ":is(.custom-preview[data-density=roomier],.manager-panel[data-density-roomier=true]) .manager-tree>section>ul"; declarations = list(
      { property = "display"; value = "flex" },
      { property = "flex-wrap"; value = "wrap" },
      { property = "gap"; value = "2px 6px" }
    ) },
    { selector = ":is(.custom-preview[data-density=roomier],.manager-panel[data-density-roomier=true]) .manager-tree>section>ul>li"; declarations = list(
      { property = "min-inline-size"; value = "0" },
      { property = "max-inline-size"; value = "100%" }
    ) },
    { selector = ":is(.custom-preview[data-density=roomier],.manager-panel[data-density-roomier=true]) .manager-main>p"; declarations = list(
      { property = "max-inline-size"; value = "62ch" },
      { property = "margin-block"; value = "8px 14px" }
    ) },
    { selector = ".manager-panel[data-density-roomier=true] .manager-main>h3"; declarations = list(
      { property = "font-size"; value = "1.25em" }
    ) },
    { atRule = "media"; prelude = "(max-height:560px)"; rules = list(
      { selector = ".manager-panel[data-density-roomier=true] .manager-panes:not(.manager-single-pane)"; declarations = list(
        { property = "grid-template-rows"; value = "fit-content(5rem) minmax(0,1fr)" }
      ) }
    ) }
  )
  call css.renderCompactRules


process files.styles:
  let cssRuleSeparator = ""
  let cssRules = list(
    { selector = "#file-viewer-window.desktop-app-window:not([data-manager-maximized=true])"; declarations = list(
      { property = "width"; value = "min(64rem,calc(100% - 24px))" },
      { property = "height"; value = "min(46rem,100%)" }
    ) },
    { selector = ".file-viewer-link"; declarations = list(
      { property = "display"; value = "block" },
      { property = "border"; value = "0" },
      { property = "background"; value = "transparent" },
      { property = "color"; value = "var(--sourcery-accent)" },
      { property = "font"; value = "inherit" },
      { property = "font-size"; value = ".85em" },
      { property = "text-decoration"; value = "underline" },
      { property = "padding"; value = "3px 0" },
      { property = "cursor"; value = "pointer" }
    ) },
    { selector = ".file-viewer-video"; declarations = list(
      { property = "display"; value = "block" },
      { property = "max-width"; value = "100%" },
      { property = "max-height"; value = "60vh" },
      { property = "margin-inline"; value = "auto" }
    ) },
    { selector = ".file-viewer-video:focus-visible"; declarations = list(
      { property = "outline"; value = "2px solid currentColor" }
    ) },
    { selector = "#file-manager-detail [data-file-type=image]"; declarations = list(
      { property = "--file-type-color"; value = "#1b628a" }
    ) },
    { selector = ".file-list-hint"; declarations = list(
      { property = "color"; value = "var(--sourcery-muted)" }
    ) },
    { selector = ".file-image-preview"; declarations = list(
      { property = "margin-block"; value = "8px 16px" }
    ) },
    { selector = ".file-image-preview img"; declarations = list(
      { property = "display"; value = "block" },
      { property = "max-inline-size"; value = "100%" },
      { property = "max-block-size"; value = "min(60vh,36rem)" },
      { property = "inline-size"; value = "auto" },
      { property = "block-size"; value = "auto" },
      { property = "object-fit"; value = "contain" },
      { property = "margin-inline"; value = "auto" }
    ) },
    { selector = "#file-manager-detail [data-file-type=encounter]"; declarations = list(
      { property = "--file-type-color"; value = "#61458e" }
    ) },
    { selector = "#file-manager-detail [data-file-type=rel]"; declarations = list(
      { property = "--file-type-color"; value = "#1b6455" }
    ) },
    { selector = "#file-manager-detail [data-file-type=receipt]"; declarations = list(
      { property = "--file-type-color"; value = "#885015" }
    ) },
    { selector = "#file-manager-detail td[data-file-type]"; declarations = list(
      { property = "color"; value = "var(--file-type-color)" },
      { property = "font-weight"; value = "600" }
    ) },
    { selector = "#file-manager-detail .file-entry-name[data-file-type]"; declarations = list(
      { property = "border-inline-start"; value = "3px solid var(--file-type-color)" },
      { property = "padding-inline-start"; value = "5px" }
    ) },
    { selector = ".file-encounter-viewer"; declarations = list(
      { property = "min-width"; value = "0" }
    ) },
    { selector = ".file-encounter-viewer pre"; declarations = list(
      { property = "overflow"; value = "auto" },
      { property = "tab-size"; value = "2" }
    ) },
    { selector = ".file-rel-viewer form"; declarations = list(
      { property = "display"; value = "flex" },
      { property = "flex-wrap"; value = "wrap" },
      { property = "align-items"; value = "center" },
      { property = "gap"; value = "8px" }
    ) },
    { selector = ".file-rel-viewer input"; declarations = list(
      { property = "flex"; value = "1 1 10rem" },
      { property = "min-width"; value = "0" }
    ) },
    { selector = ".file-rel-viewer table"; declarations = list(
      { property = "table-layout"; value = "fixed" }
    ) },
    { selector = ".file-rel-viewer th:last-child"; declarations = list(
      { property = "width"; value = "5.5em" }
    ) },
    { selector = ".file-rel-viewer :is(td,th)"; declarations = list(
      { property = "overflow-wrap"; value = "anywhere" }
    ) },
    { selector = ".file-rel-viewer details"; declarations = list(
      { property = "margin-block"; value = "12px" }
    ) },
    { selector = ".file-rel-viewer summary"; declarations = list(
      { property = "width"; value = "fit-content" },
      { property = "cursor"; value = "pointer" }
    ) },
    { selector = "#file-manager-window.desktop-app-window:not([data-manager-maximized=true])"; declarations = list(
      { property = "width"; value = "min(64rem,calc(100% - 24px))" },
      { property = "height"; value = "min(46rem,100%)" }
    ) },
    { selector = "#file-manager-index .file-tree ul"; declarations = list(
      { property = "margin-inline-start"; value = "10px" },
      { property = "padding-inline-start"; value = "12px" },
      { property = "border-inline-start"; value = "1px solid var(--sourcery-line)" }
    ) },
    { selector = ".file-tree ul > li"; declarations = list(
      { property = "position"; value = "relative" }
    ) },
    { selector = ".file-tree ul > li::before"; declarations = list(
      { property = "content"; value = "''" },
      { property = "position"; value = "absolute" },
      { property = "inset-inline-start"; value = "-12px" },
      { property = "inset-block-start"; value = "17px" },
      { property = "width"; value = "10px" },
      { property = "border-block-start"; value = "1px solid var(--sourcery-line)" },
      { property = "pointer-events"; value = "none" }
    ) },
    { selector = ".file-tree ul > li:last-child::after"; declarations = list(
      { property = "content"; value = "''" },
      { property = "position"; value = "absolute" },
      { property = "inset-inline-start"; value = "-13px" },
      { property = "inset-block"; value = "18px 0" },
      { property = "width"; value = "1px" },
      { property = "background"; value = "var(--sourcery-panel)" },
      { property = "pointer-events"; value = "none" }
    ) },
    { selector = "#file-manager-index .file-tree summary"; declarations = list(
      { property = "list-style"; value = "none" },
      { property = "cursor"; value = "pointer" },
      { property = "display"; value = "flex" },
      { property = "align-items"; value = "center" },
      { property = "gap"; value = "6px" },
      { property = "min-height"; value = "34px" },
      { property = "padding"; value = "0" }
    ) },
    { selector = "#file-manager-index .file-tree summary::-webkit-details-marker"; declarations = list(
      { property = "display"; value = "none" }
    ) },
    { selector = "#file-manager-index .file-tree summary::before"; declarations = list(
      { property = "content"; value = "'+'" },
      { property = "display"; value = "inline-grid" },
      { property = "place-items"; value = "center" },
      { property = "flex"; value = "0 0 14px" },
      { property = "height"; value = "14px" },
      { property = "border"; value = "1px solid var(--sourcery-line)" },
      { property = "background"; value = "var(--sourcery-paper)" },
      { property = "font"; value = "bold 12px monospace" }
    ) },
    { selector = "#file-manager-index .file-tree details[open] > summary::before"; declarations = list(
      { property = "content"; value = "'−'" }
    ) },
    { selector = "#file-manager-index .file-tree-label"; declarations = list(
      { property = "min-width"; value = "0" },
      { property = "min-height"; value = "34px" },
      { property = "overflow"; value = "hidden" },
      { property = "text-overflow"; value = "ellipsis" },
      { property = "white-space"; value = "nowrap" }
    ) },
    { selector = ".file-breadcrumbs"; declarations = list(
      { property = "margin-block-end"; value = "8px" },
      { property = "color"; value = "var(--sourcery-muted)" }
    ) },
    { selector = ".file-breadcrumbs ol"; declarations = list(
      { property = "display"; value = "flex" },
      { property = "flex-wrap"; value = "wrap" },
      { property = "gap"; value = "2px 7px" },
      { property = "padding"; value = "0" },
      { property = "margin"; value = "0" },
      { property = "list-style"; value = "none" }
    ) },
    { selector = ".file-breadcrumbs li"; declarations = list(
      { property = "display"; value = "flex" },
      { property = "align-items"; value = "center" },
      { property = "min-width"; value = "0" },
      { property = "max-width"; value = "100%" },
      { property = "gap"; value = "7px" }
    ) },
    { selector = ".file-breadcrumbs li + li::before"; declarations = list(
      { property = "content"; value = "'›'" },
      { property = "flex"; value = "none" }
    ) },
    { selector = "#file-manager-detail .file-breadcrumbs button, #file-manager-detail .file-breadcrumbs span"; declarations = list(
      { property = "overflow"; value = "hidden" },
      { property = "text-overflow"; value = "ellipsis" },
      { property = "white-space"; value = "nowrap" },
      { property = "margin"; value = "0" }
    ) },
    { selector = "#file-manager-detail .file-breadcrumbs button"; declarations = list(
      { property = "color"; value = "var(--sourcery-accent)" },
      { property = "border"; value = "0" },
      { property = "background"; value = "transparent" },
      { property = "font"; value = "inherit" },
      { property = "padding"; value = "3px 0" },
      { property = "cursor"; value = "pointer" },
      { property = "text-decoration"; value = "underline" }
    ) },
    { selector = "#file-manager-detail .file-contents-table"; declarations = list(
      { property = "table-layout"; value = "fixed" },
      { property = "--sourcery-table-cell-padding"; value = "9px 8px" }
    ) },
    { selector = "#file-manager-detail .file-contents-table :is(th,td), #file-manager-detail .file-entry-name"; declarations = list(
      { property = "overflow"; value = "hidden" },
      { property = "text-overflow"; value = "ellipsis" },
      { property = "white-space"; value = "nowrap" }
    ) },
    { selector = "#file-manager-detail .file-contents-table th:nth-child(2)"; declarations = list(
      { property = "width"; value = "14%" }
    ) },
    { selector = "#file-manager-detail .file-contents-table th:nth-child(3)"; declarations = list(
      { property = "width"; value = "16%" }
    ) },
    { selector = "#file-manager-detail .file-contents-table th:nth-child(4)"; declarations = list(
      { property = "width"; value = "17%" }
    ) },
    { selector = "#file-manager-detail .file-contents-table th:nth-child(5)"; declarations = list(
      { property = "width"; value = "21%" }
    ) },
    { selector = "#file-manager-detail .file-contents-table .file-size, #file-manager-detail .file-contents-table th:nth-child(3)"; declarations = list(
      { property = "text-align"; value = "end" },
      { property = "font-variant-numeric"; value = "tabular-nums" }
    ) },
    { selector = "#file-manager-detail .file-entry-name"; declarations = list(
      { property = "display"; value = "block" },
      { property = "width"; value = "100%" },
      { property = "margin"; value = "0" },
      { property = "padding"; value = "2px 0" },
      { property = "border"; value = "0" },
      { property = "background"; value = "transparent" },
      { property = "color"; value = "var(--sourcery-accent)" },
      { property = "font"; value = "inherit" },
      { property = "text-align"; value = "start" },
      { property = "cursor"; value = "pointer" }
    ) },
    { selector = "#file-manager-detail .file-entry-name:is(:hover,:focus-visible)"; declarations = list(
      { property = "text-decoration"; value = "underline" }
    ) },
    { atRule = "media"; prelude = "(max-width: 740px)"; rules = list(
      { selector = "#file-manager-detail .file-contents-table :is(th,td):nth-child(n+4)"; declarations = list(
        { property = "display"; value = "none" }
      ) }
    ) },
    { atRule = "media"; prelude = "(max-width: 540px)"; rules = list(
      { selector = "#file-manager-detail .file-contents-table :is(th,td):nth-child(2)"; declarations = list(
        { property = "display"; value = "none" }
      ) }
    ) },
    { atRule = "media"; prelude = "(max-width: 540px)"; rules = list(
      { selector = "#file-manager-detail .file-contents-table th:nth-child(3)"; declarations = list(
        { property = "width"; value = "26%" }
      ) }
    ) }
  )
  call css.renderCompactRules
  let result = concat("/* File Manager */", $result, "/* End File Manager */")


process desktop.symbols:
  let result = concat(
    "<svg class=\"symbols\" xmlns=\"http://www.w3.org/2000/svg\" aria-hidden=\"true\"><defs>",
    "<symbol id=\"icon-workspace\" viewBox=\"0 0 32 32\"><path fill=\"#1b2040\" d=\"M5 3h22v3h2v22H4v-3H2V7h3z\"/><path fill=\"#a96b20\" d=\"M6 7h21v19H6z\"/><path fill=\"#ffce42\" d=\"M5 5h20v18H5z\"/><path fill=\"#fff0a5\" d=\"M5 5h20v2H7v16H5z\"/><path fill=\"#263575\" d=\"M10 10h3l5 7v-7h3v11h-3l-5-7v7h-3z\"/><path fill=\"#6f4d31\" d=\"M8 24h18v2H8z\"/></symbol>",
    "<symbol id=\"icon-life-board\" viewBox=\"0 0 16 16\"><path fill=\"#283452\" d=\"M3 1h10v2h2v12H1V3h2z\"/><path fill=\"#6eb3a9\" d=\"M2 4h12v10H2z\"/><path fill=\"#f3c752\" d=\"M5 2h6v3H5z\"/><path fill=\"#edf4dd\" d=\"M4 7h3v5H4zm5 0h3v2H9zm0 3h3v2H9z\"/></symbol>",
    "<symbol id=\"icon-notes\" viewBox=\"0 0 32 32\"><path fill=\"#24243c\" d=\"M5 3h22v25H5z\"/><path fill=\"#f5d25d\" d=\"M7 5h18v21H7z\"/><path fill=\"#fff1b0\" d=\"M10 6h14v18H10z\"/><path fill=\"#534c75\" d=\"M12 9h9v2h-9zm0 5h9v2h-9zm0 5h6v2h-6z\"/></symbol>",

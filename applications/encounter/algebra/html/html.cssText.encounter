process-module "temple/surface-process-module/1"
profile "encounter/reconstituted-source/1"

process html.cssText:
  port value.describe { value = $input } → cssInputKind
  assert $cssInputKind.array
    otherwise "Style content must be text children."
  each $input as cssPart:
    port value.type { value = $cssPart } → cssPartType
    assert eq($cssPartType, "string")
      otherwise "Style content must contain text only."
  port text.join { values = $input; separator = "" } → cssInput
  port text.replaceAll { value = $cssInput; search = "<"; replacement = "\\3C " } → result

process-module "temple/surface-process-module/1"
profile "encounter/reconstituted-source/1"

process lower.expression:
  port value.describe { value = $input } → kind
  let result = { value = $input; context = $context }
  when if(
    eq($kind.type, "object"),
    if(
      if($kind.array, false, true),
      if(if(eq($input, null), false, true), true, false),
      false
    ),
    false
  ):
    port record.entries { value = $input } → entries
    fold $entries as entry; built starts { value = list(); context = $context }:
      let context = $built.context
      let input = at($entry, 1)
      fold list(null) as callFrame; frameResult starts null:
        call lower.expression
        yield $result → result
      yield {
      value = append($built.value, list(list(at($entry, 0), $result.value)));
      context = $result.context
    } → built
    port record.fromEntries { entries = $built.value } → value
    let result = { value = $value; context = $built.context }
  when if($kind.array, if(count($input), true, false), false):
    let operation = at($input, 0)
    let rule = at($definitions.operators, $operation)
    let primitive = includes($primitives, $operation)
    assert if($primitive, $primitive, $rule)
      otherwise "Unknown algebra operation [TEMPLE-L001]. Boundary: authored operator vocabulary. Correct the spelling or supply a derived law in algebra/operators.expression.values.rel; do not add a native fallback. Rerun the isolated bootstrap proof."
    fold range(add(count($input), -1)) as index; arguments starts []:
      yield append($arguments, list(at($input, $index))) → arguments
    when if($primitive, false, true):
      assert if(includes($ancestry, $operation), false, true)
        otherwise "Cyclic operator definition [TEMPLE-L002]. Boundary: finite operator lowering. Break the dependency cycle in the authored laws; do not increase the execution budget. Rerun the isolated bootstrap proof."
      let arity = at($rule, "arity")
      port value.describe { value = $arity } → arityKind
      assert if(
        eq($arityKind.type, "number"),
        eq(count($arguments), $arity),
        includes(range(add(count($arguments), 1)), add(at($rule, "minimumArity"), 1))
      )
        otherwise "Invalid derived operator arity [TEMPLE-L003]. Boundary: operator call contract. Match the call arguments to the authored arity; preserve lazy argument semantics. Rerun the isolated bootstrap proof."
    fold $arguments as argument; built starts { value = list(); context = $context }:
      let context = $built.context
      let input = $argument
      fold list(null) as callFrame; frameResult starts null:
        call lower.expression
        yield $result → result
      yield { value = append($built.value, list($result.value)); context = $result.context } → built
    when $primitive:
      let result = { value = append(list($operation), $built.value); context = $built.context }
    when if($primitive, false, true):
      fold list(at($rule, "body")) as invokeInput; invokeAcc starts null:
        let input = $invokeInput
        let context = { used = $built.context.used; serial = $built.context.serial; locals = {  } }
        let arguments = $built.value
        let terms = {  }
        fold list(null) as callFrame; frameResult starts null:
          call lower.template
          yield $result → result
        yield $result → expanded
      fold list($expanded.value) as invokeInput; invokeAcc starts null:
        let input = $invokeInput
        let context = $expanded.context
        let ancestry = append($ancestry, list($operation))
        fold list(null) as callFrame; frameResult starts null:
          call lower.expression
          yield $result → result
        yield $result → result

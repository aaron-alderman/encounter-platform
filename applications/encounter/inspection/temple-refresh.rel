// Refresh relationships and source evidence. The surface nodes come from the Home renderers.
("case", "flow", "binding dispatch process read data render")
("binding", "label", "Click binding")
("binding", "kind", "Event")
("binding", "type", "Delegated browser click")
("binding", "description", "The Temple Manager window delegates clicks from the Refresh selector. The binding passes the action and app key to desktop.event.")
("binding", "relation", "Dispatches to")
("binding", "target", "dispatch")
("binding", "source", "applications/appdev-projects/browser-desktop.encounter")
("binding", "lines", "41–42")
("binding", "excerpt", "        if(eq($app.key, \"temple-manager\"), { ref = $window; event = \"click\"; delegate = \"button[data-document-command=temple-refresh]\"; query = \"desktop.event\";\n          input = { action = \"temple-refresh\"; key = $app.key }; dispatchLabel = \"Refresh saved records · Temple Manager\" }, null),")
("binding", "shape", "{ action: \"temple-refresh\", key: \"temple-manager\" }")
("dispatch", "label", "desktop.event")
("dispatch", "kind", "Dispatch")
("dispatch", "type", "Encounter process branch")
("dispatch", "description", "Both the app key and the action must match for this branch to call desktop.templeRecords.")
("dispatch", "relation", "Calls")
("dispatch", "target", "process")
("dispatch", "source", "applications/appdev-projects/browser-desktop.encounter")
("dispatch", "lines", "175–176")
("dispatch", "excerpt", "    when and(eq($key, \"temple-manager\"), eq($action, \"temple-refresh\")):\n      call desktop.templeRecords")
("process", "label", "desktop.templeRecords")
("process", "kind", "Process")
("process", "type", "Encounter process")
("process", "description", "Render the loading state, load the records, then render with the returned state.")
("process", "relation", "Calls")
("process", "target", "read")
("process", "source", "applications/appdev-projects/browser-desktop.encounter")
("process", "lines", "418–423")
("process", "excerpt", "process desktop.templeRecords:\n  let custody = { mode = \"loading\" }\n  call desktop.renderTempleRecords\n  call formation.loadRecords\n  let custody = $result\n  call desktop.renderTempleRecords")
("read", "label", "formation.loadRecords")
("read", "kind", "Read")
("read", "type", "Browser request port")
("read", "description", "GET /workspace/formation/records. A valid 200 response becomes signed-in state. A 401 becomes browser state. Other statuses, invalid responses, and request faults leave the records unavailable.")
("read", "relation", "Reads")
("read", "target", "data")
("read", "source", "applications/appdev-projects/first-run.encounter")
("read", "lines", "33–47")
("read", "excerpt", "process formation.loadRecords:\n  let result = { mode = \"unavailable\"; owner = null; records = {} }\n  try:\n    port browser.request { path = \"/workspace/formation/records\" } → response\n    when eq($response.status, 200):\n      port json.parse { text = $response.body } → data\n      port text.matches { value = or(at($data, \"owner\"), \"\"); pattern = \"^[a-f0-9]{64}$\" } → owner\n      port value.type { value = at($data, \"records\") } → recordsKind\n      assert and($owner, $data.records, eq($recordsKind, \"object\"), eq(at($data, \"outcome\"), \"read\"))\n        otherwise \"Invalid saved records response.\"\n      let result = { mode = \"signed-in\"; owner = $data.owner; records = $data.records }\n    when eq($response.status, 401):\n      let result = { mode = \"browser\"; owner = null; records = {} }\n  catch fault:\n    let result = { mode = \"unavailable\"; owner = null; records = {} }")
("read", "shape", "mode: \"signed-in\" | \"browser\" | \"unavailable\"\nowner: Text | Null\nrecords: Record")
("data", "label", "Saved records")
("data", "kind", "Data")
("data", "type", "Record response")
("data", "description", "The read response is scoped to the signed-in user. Memory uses the note key and Journal uses project. This shape is inferred from the read, save, and render source.")
("data", "relation", "Supplies")
("data", "target", "render")
("data", "source", "applications/appdev-projects/formation/records.encounter")
("data", "lines", "3–8")
("data", "excerpt", "process formation.records:\n  let request = $eventInput\n  let state = or($request.state, {})\n  let fields = $request.fields\n  let body = { owner = $request.owner; records = $state; outcome = \"read\" }\n  let result = { status = 200; body = $body }")
("data", "shape", "owner: Text (64 lowercase hex characters)\noutcome: \"read\"\nrecords: { note?: SavedRecord, project?: SavedRecord }\nSavedRecord: { text: Text, revision: Text }")
("render", "label", "desktop.renderTempleRecords")
("render", "kind", "Render")
("render", "type", "Encounter process with browser content effect")
("render", "description", "Build and serialize the Temple records surface, then replace #temple-manager-detail. The same renderer is called for loading and again for the result.")
("render", "relation", "Updates")
("render", "target", "surface")
("render", "source", "applications/appdev-projects/browser-desktop.encounter")
("render", "lines", "425–429")
("render", "excerpt", "process desktop.renderTempleRecords:\n  call managers.templeDetails\n  let input = $result\n  call html.serialize\n  port browser.content { ref = \"#temple-manager-detail\"; html = $result } → result")

("viewer-event", "lines", "66–77")
("viewer-event", "excerpt", "    when eq($managerAction, \"open-viewer\"):\n      let key = \"file-viewer\"\n      let app = at(filter($apps, \"entry\", eq($entry.key, $key)), 0)\n      let returned = false\n      let managerHandoff = true\n      call desktop.open\n      let fileId = $managerItem\n      let relFilter = \"\"\n      let sourcePath = null\n      let sourceProcess = null\n      let sourceName = null\n      call managers.showViewer")

("close-binding", "lines", "53–61")
("close-binding", "excerpt", "        if($app.maximize, { ref = $window; event = \"click\"; delegate = \"button[data-desktop-close]\"; query = \"desktop.event\";\n          input = { action = \"close\"; key = $app.key }; dispatchLabel = concat(\"close · \", $app.title) }, null),\n        if($app.maximize, { ref = concat(\"#\", $app.maximize); event = \"click\"; query = \"desktop.event\";\n          input = { action = \"maximize\"; key = $app.key }; dispatchLabel = concat(\"maximize · \", $app.title) }, null),\n        if(eq($app.key, \"certificates\"), { ref = $window; event = \"submit\"; delegate = \"form[data-certificate-renewal]\"; preventDefault = true; query = \"desktop.event\";\n          input = { action = \"certificate-submit\"; key = $app.key }; dispatchLabel = concat(\"certificate-submit · \", $app.title) }, null),\n        { ref = concat(\"#\", $app.task); event = \"click\"; query = \"desktop.event\"; input = $open; dispatchLabel = $label; timing = $timing; reveal = $window },\n        { ref = concat(\"#\", $app.minimize); event = \"click\"; query = \"desktop.event\"; input = { action = \"minimize\"; key = $app.key }; dispatchLabel = concat(\"minimize · \", $app.title) },\n        { ref = concat(\"#\", $app.close); event = \"click\"; query = \"desktop.event\"; input = { action = \"close\"; key = $app.key }; dispatchLabel = concat(\"close · \", $app.title) }")
("close-binding", "flow", "close-case")
("close-event", "label", "Close window")
("close-event", "kind", "Process")
("close-event", "type", "Desktop window action")
("close-event", "description", "Applies the action to the File Manager window.")
("close-event", "shape", "action: \"close\"\nkey: selected desktop app key")
("close-event", "source", "applications/appdev-projects/browser-desktop.encounter")
("close-event", "lines", "187–207")
("close-event", "excerpt", "    when and(eq($key, \"temple-manager\"), eq($action, \"temple-refresh\")):\n      call desktop.templeRecords\n    when and(eq($key, \"temple-manager\"), eq($action, \"temple-editor-closed\")):\n      port dom.exists { selector = \"#temple-manager-window:not([hidden])\" } → visible\n      when $visible:\n        call desktop.templeRecords\n    when and(eq($key, \"certificates\"), eq($action, \"certificate-submit\")):\n      let form = $eventInput.matched.ref\n      call inventory.open\n    when eq($action, $app.defaultAction):\n      let returned = false\n      call desktop.open\n    when includes(list(\"minimize\", \"close\"), $action):\n      let task = concat(\"#\", $app.task)\n      port browser.write { ref = concat(\"#\", $app.window); name = \"hidden\"; value = true } → _\n      when eq($key, \"file-manager\"):\n        call managers.clearFiles\n      when eq($key, \"file-viewer\"):\n        port browser.content { ref = \"#file-viewer-detail\"; html = \"\" } → _\n      when eq($action, \"minimize\"):\n        port browser.focus { ref = $task } → _")
("close-event", "flow", "close-case")
("close-case", "label", "Close window flow")
("close-case", "flow", "close-binding close-event")
("viewer-data", "label", "File Viewer selected file")
("viewer-data", "kind", "Data")
("viewer-data", "type", "Authorized file-index row with viewer")
("viewer-data", "description", "The row must match the handed-off file ID and have a viewer. App inspector uses the same published example as File Manager.")
("viewer-data", "relation", "Renders through")
("viewer-data", "target", "viewer-render")
("viewer-data", "source", "applications/appdev-projects/browser-managers.encounter")
("viewer-data", "lines", "275–280")
("viewer-data", "excerpt", "    when not($sourcePath):\n      call managers.readFiles\n      let snapshot = $result\n      call files.catalogue\n      let file = at(filter($result, \"node\", and(eq($node.id, $fileId), at($node, \"viewer\"))), 0)\n    let input = { tag = \"p\"; attrs = { role = \"status\" }; children = list($unavailable) }")
("viewer-render", "label", "Render File Viewer preview")
("viewer-render", "kind", "Render")
("viewer-render", "type", "File Viewer detail renderer")
("viewer-render", "description", "The File Viewer window renders the selected file location and chooses the preview with files.content.")
("viewer-render", "relation", "Displays")
("viewer-render", "target", "file-source")
("viewer-render", "source", "applications/appdev-projects/browser-managers.encounter")
("viewer-render", "lines", "298–311")
("viewer-render", "excerpt", "      let previewScope = \"viewer\"\n      let folders = list()\n      let node = $file\n      call files.location\n      let location = $result\n      call files.content\n      let missing = if(and($sourceProcess, not(at($file, \"sourceLine\"))), { tag = \"p\"; attrs = { role = \"status\" };\n        children = list(\"Process \", $sourceProcess, \" was not found in the indexed file.\") }, null)\n      let preview = $result\n      call files.draftLink\n      let editor = $result\n      let input = append($location, list($missing, $editor, if($preview, $preview, { tag = \"p\"; children = list(\"The preview is unavailable.\") })))\n    call html.serialize\n    port browser.content { ref = $target; html = $result } → _")
("viewer-detail-case", "label", "File Viewer preview flow")
("viewer-detail-case", "flow", "viewer-read viewer-data viewer-render file-source")
("viewer-open-event", "label", "Open File Manager to choose a file")
("viewer-open-event", "kind", "Event")
("viewer-open-event", "type", "File Viewer document command")
("viewer-open-event", "description", "File → Open… opens File Manager and focuses its search field.")
("viewer-open-event", "source", "applications/appdev-projects/browser-managers.encounter")
("viewer-open-event", "lines", "90–102")
("viewer-open-event", "excerpt", "    when eq($managerAction, \"viewer-open\"):\n      let key = \"file-manager\"\n      let app = at(filter($apps, \"entry\", eq($entry.key, $key)), 0)\n      let returned = false\n      let managerHandoff = true\n      call desktop.open\n      port state.set { key = \"file-manager-search\"; value = null } → _\n      let folderId = null\n      let fileId = null\n      let relFilter = \"\"\n      let returnToRun = false\n      call managers.showFiles\n      port browser.focus { ref = \"#file-search-query\" } → _")
("viewer-open-event", "surfaceApp", "file-manager")
("viewer-open-event", "surfaceMode", "home-folder")
("viewer-open-event", "surface", "id-file-manager-index")
("viewer-open-event", "surfaceLabel", "File Manager surface tree")
("viewer-reload-event", "label", "Reload the selected file")
("viewer-reload-event", "kind", "Event")
("viewer-reload-event", "type", "File Viewer document command")
("viewer-reload-event", "description", "File → Reload file reads the current File Viewer selection again.")
("viewer-reload-event", "relation", "Calls")
("viewer-reload-event", "target", "viewer-read")
("viewer-reload-event", "source", "applications/appdev-projects/browser-managers.encounter")
("viewer-reload-event", "lines", "78–89")
("viewer-reload-event", "excerpt", "  when eq($managerKey, \"file-viewer\"):\n    port state.get { key = \"file-viewer-selection\" } → selection\n    let fileId = at($selection, \"file\")\n    let sourcePath = at($selection, \"sourcePath\")\n    let sourceProcess = at($selection, \"sourceProcess\")\n    let sourceName = at($selection, \"sourceName\")\n    let relFilter = or(at($selection, \"relFilter\"), \"\")\n    when and($fileId, eq($managerAction, \"rel-filter\")):\n      port browser.formFields { ref = \"#viewer-rel-filter\" } → fields\n      port text.trim { value = or(at($fields, \"filter\"), \"\") } → relFilter\n    when includes(list(\"viewer-refresh\", \"rel-filter\"), $managerAction):\n      call managers.showViewer")

("file-binding", "source", "applications/appdev-projects/browser-desktop.encounter")
("file-binding", "lines", "38–40")
("file-binding", "excerpt", "        if(includes(list(\"file-manager\", \"file-viewer\", \"service-manager\"), $app.key),\n          { ref = $window; event = \"click\"; delegate = \"button:is([data-manager-action], [data-document-command])\"; query = \"desktop.event\";\n            input = { action = \"manager\"; key = $app.key }; dispatchLabel = concat(\"manager · \", $app.title) }, null),")

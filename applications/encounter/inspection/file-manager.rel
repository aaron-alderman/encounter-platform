("file-source", "label", "Workspace policy source")
("file-source", "kind", "Source")
("file-source", "type", "Published Encounter excerpt")
("file-source", "description", "The packaged excerpt carries original file line coordinates.")
("file-source", "source", "applications/appdev-projects/workspace.encounter")
("file-source", "lines", "137–173")
("file-source", "excerpt", "  when eq($request.store, true):\n    let roots = append($roots, list(\"Apps/Game Hub/Store/Published assets\"))\n  when eq($request.north, true):\n    let roots = append($roots, list(\"Apps/North River/Source\", \"Apps/North River/Receipts\"))\n  let result = { platform = $platform; roots = $roots }\n\nprocess workspace.environmentPolicy:\n  let request = $eventInput\n  call workspace.platformAllowed\n  let platform = and(eq($request.signedIn, true), $result)\n  let choices = list(\n    { path = \"/workspace/home\"; label = \"Home\" },\n    { path = \"/workspace/work\"; label = \"Work\" },\n    { path = \"/workspace/mobile\"; label = \"Mobile\" })\n  when $platform:\n    let choices = append($choices, list({ path = \"/workspace/platform\"; label = \"Platform\" }))\n  let paths = map($choices, \"choice\", $choice.path)\n  let destination = if(and(eq($request.signedIn, true), includes($paths, $request.saved)), $request.saved, \"/workspace/home\")\n  let save = and(eq($request.signedIn, true), includes($paths, $request.submitted))\n  let picker = \"\"\n  when and(eq($request.signedIn, true), eq($request.picker, true)):\n    let options = map($choices, \"choice\", { tag = \"option\"; attrs = {\n      value = $choice.path; selected = eq($choice.path, $destination) }; children = list($choice.label) })\n    let input = { tag = \"form\"; attrs = { class = \"workspace-preference\"; method = \"post\"; action = \"/workspace/default\" }; children = list(\n      { tag = \"label\"; children = list(\"Default environment \", { tag = \"select\"; attrs = { name = \"environment\" }; children = $options }) },\n      { tag = \"button\"; attrs = { type = \"submit\" }; children = list(\"Save\") },\n      { tag = \"span\"; attrs = { role = \"status\" } }) }\n    call html.serialize\n    let picker = $result\n  let result = { destination = $destination; save = $save; platform = $platform; picker = $picker }\n\nprocess workspace.claimipediaAdmission:\n  let request = $eventInput\n  let result = \"gateway-refused\"\n  when eq($request.gatewayAuthenticated, true):\n    let result = \"method-refused\"\n    when includes(list(\"GET\", \"POST\"), $request.method):")
("file-source", "flow", "file-case")
("source-window", "source", "applications/appdev-projects/desktop-launch.encounter")
("source-window", "lines", "148–185")
("source-window", "excerpt", "process desktop.appWindow:\n  let windowTypeId = $app.layout\n  call windowShell.typeById\n  when not($result):\n    let layoutApp = $app.key\n    call desktop.refuseLayout\n  let windowType = $result\n  let documentWindow = eq($windowType.id, \"document\")\n  call desktop.appContent\n  let content = $result\n  let menu = null\n  let banner = null\n  when $documentWindow:\n    let content = { tag = $content.tag; attrs = $content.attrs; children = list($documentSlots.content) }\n    let menu = $documentSlots.menu\n    let banner = $documentSlots.banner\n  let actions = null\n  when eq($app.key, \"acting-as\"):\n    let actions = { tag = \"footer\"; attrs = { class = \"dialog-actions\" }; children = list(\n      { tag = \"a\"; attrs = { class = \"button\"; href = \"/settings/identity/\"; \"data-open-identity-management\" = true; \"data-identity-page\" = true }; children = list(\"Identity Management\") },\n      { tag = \"a\"; attrs = { class = \"button\"; href = \"/workspace/home#handover-demo\"; \"data-open-handover-demo\" = true }; children = list(\"Try the handover demo\") }\n    ) }\n  let controlTarget = $app.title\n  let controlBindings = {\n    maximize = if($app.maximize, { tag = \"button\"; attrs = { id = $app.maximize; type = \"button\"; \"aria-pressed\" = \"false\" } }, null);\n    minimize = { tag = \"button\"; attrs = { id = $app.minimize; type = \"button\" } };\n    close = { tag = \"button\"; attrs = { id = $app.close; type = \"button\" } }\n  }\n  call windowShell.titleControls\n  let title = { tag = \"header\"; attrs = { class = \"titlebar\" }; children = list(\n    { tag = \"svg\"; attrs = { class = \"icon\"; viewBox = \"0 0 32 32\"; \"aria-hidden\" = \"true\" }; children = list({ tag = \"use\"; attrs = { href = concat(\"#icon-\", $app.icon) } }) },\n    { tag = \"h2\"; attrs = { id = $app.heading; tabindex = \"-1\" }; children = list($app.title) },\n    $result\n  ) }\n  let slots = if($documentWindow, { title = $title; menu = $menu; banner = $banner; content = $content; actions = $actions },\n    { title = $title; content = $content; actions = $actions })\n  let frame = { tag = \"section\"; attrs = { id = $app.window; class = \"desktop-app-window\"; hidden = true; \"data-desktop-layout\" = $app.layout; \"aria-labelledby\" = $app.heading } }\n  call windowShell.frame")
("source-title", "source", "applications/appdev-projects/desktop-launch.encounter")
("source-title", "lines", "148–185")
("source-title", "excerpt", "process desktop.appWindow:\n  let windowTypeId = $app.layout\n  call windowShell.typeById\n  when not($result):\n    let layoutApp = $app.key\n    call desktop.refuseLayout\n  let windowType = $result\n  let documentWindow = eq($windowType.id, \"document\")\n  call desktop.appContent\n  let content = $result\n  let menu = null\n  let banner = null\n  when $documentWindow:\n    let content = { tag = $content.tag; attrs = $content.attrs; children = list($documentSlots.content) }\n    let menu = $documentSlots.menu\n    let banner = $documentSlots.banner\n  let actions = null\n  when eq($app.key, \"acting-as\"):\n    let actions = { tag = \"footer\"; attrs = { class = \"dialog-actions\" }; children = list(\n      { tag = \"a\"; attrs = { class = \"button\"; href = \"/settings/identity/\"; \"data-open-identity-management\" = true; \"data-identity-page\" = true }; children = list(\"Identity Management\") },\n      { tag = \"a\"; attrs = { class = \"button\"; href = \"/workspace/home#handover-demo\"; \"data-open-handover-demo\" = true }; children = list(\"Try the handover demo\") }\n    ) }\n  let controlTarget = $app.title\n  let controlBindings = {\n    maximize = if($app.maximize, { tag = \"button\"; attrs = { id = $app.maximize; type = \"button\"; \"aria-pressed\" = \"false\" } }, null);\n    minimize = { tag = \"button\"; attrs = { id = $app.minimize; type = \"button\" } };\n    close = { tag = \"button\"; attrs = { id = $app.close; type = \"button\" } }\n  }\n  call windowShell.titleControls\n  let title = { tag = \"header\"; attrs = { class = \"titlebar\" }; children = list(\n    { tag = \"svg\"; attrs = { class = \"icon\"; viewBox = \"0 0 32 32\"; \"aria-hidden\" = \"true\" }; children = list({ tag = \"use\"; attrs = { href = concat(\"#icon-\", $app.icon) } }) },\n    { tag = \"h2\"; attrs = { id = $app.heading; tabindex = \"-1\" }; children = list($app.title) },\n    $result\n  ) }\n  let slots = if($documentWindow, { title = $title; menu = $menu; banner = $banner; content = $content; actions = $actions },\n    { title = $title; content = $content; actions = $actions })\n  let frame = { tag = \"section\"; attrs = { id = $app.window; class = \"desktop-app-window\"; hidden = true; \"data-desktop-layout\" = $app.layout; \"aria-labelledby\" = $app.heading } }\n  call windowShell.frame")
("source-title-controls", "source", "applications/encounter-libraries/window-shell.encounter")
("source-title-controls", "lines", "22–32")
("source-title-controls", "excerpt", "process windowShell.titleControls:\n  call windowShell.controlDefinitions\n  let controls = filter($result, \"control\", at($controlBindings, $control.id))\n  fold $controls as control; nodes starts list():\n    let binding = at($controlBindings, $control.id)\n    let label = concat($control.verb, \" \", $controlTarget)\n    port record.put { record = $binding.attrs; key = \"aria-label\"; value = $label } → attrs\n    port record.put { record = $attrs; key = \"title\"; value = $label } → attrs\n    port record.put { record = $attrs; key = \"data-window-control\"; value = $control.id } → attrs\n    yield append($nodes, list({ tag = $binding.tag; attrs = $attrs; children = list($control.glyph) })) → nodes\n  let result = if(count($nodes), { tag = \"div\"; attrs = { class = \"window-controls\" }; children = $nodes }, null)")
("source-menu-bar", "source", "applications/appdev-projects/desktop-launch.encounter")
("source-menu-bar", "lines", "250–257")
("source-menu-bar", "excerpt", "process desktop.documentMenus:\n  let fileCommands = append(or(at($document, \"fileCommands\"), list()), list({ id = \"close\"; label = concat(\"Close \", $app.title) }))\n  let menus = list({ id = \"file\"; label = \"File\"; commands = $fileCommands; content = list() },\n    { id = \"help\"; label = \"Help\"; commands = list(); content = list({ tag = \"p\"; children = list($document.help) }) })\n  fold $menus as menu; children starts list():\n    call desktop.documentMenu\n    yield append($children, $result) → children\n  let result = { tag = \"nav\"; attrs = { class = \"menu-bar document-menu-bar\"; \"aria-label\" = concat($app.title, \" menus\") }; children = $children }")
("source-menus", "source", "applications/appdev-projects/desktop-launch.encounter")
("source-menus", "lines", "237–248")
("source-menus", "excerpt", "process desktop.documentMenu:\n  let menuId = concat($app.key, \"-menu-\", $menu.id)\n  let result = list(\n    { tag = \"button\"; attrs = { type = \"button\"; popovertarget = $menuId; \"aria-controls\" = $menuId };\n      children = list($menu.label) },\n    { tag = \"div\"; attrs = { id = $menuId; class = \"document-menu-panel\"; popover = \"auto\"; role = \"group\"; \"aria-label\" = $menu.label };\n      children = append(map($menu.commands, \"entry\", { tag = \"button\"; attrs = {\n        type = \"button\"; popovertarget = $menuId; popovertargetaction = \"hide\";\n        \"data-desktop-close\" = if(and(not(at($document, \"preview\")), eq($entry.id, \"close\")), \"true\", null);\n        \"data-document-command\" = if(or(at($document, \"preview\"), eq($entry.id, \"close\")), null, $entry.id)\n      }; children = list($entry.label) }), $menu.content) }\n  )")
("source-banner", "source", "applications/appdev-projects/desktop-launch.encounter")
("source-banner", "lines", "292–301")
("source-banner", "excerpt", "process desktop.documentBanner:\n  let glyph = { tag = \"svg\"; attrs = { class = \"icon\"; viewBox = \"0 0 32 32\"; \"aria-hidden\" = \"true\" };\n    children = list({ tag = \"use\"; attrs = { href = concat(\"#icon-\", $app.icon) } }) }\n  let result = { tag = \"header\"; attrs = { class = \"banner manager-banner\" }; children = list(\n    { tag = \"div\"; attrs = { class = \"banner-icon\" }; children = list($glyph) },\n    { tag = \"div\"; children = list({ tag = \"p\"; children = list(\"SOURCERY OS / HOME\") },\n      { tag = \"h3\"; attrs = { class = \"manager-title\" }; children = list($app.title) }, { tag = \"span\"; children = list($document.description) }) },\n    { tag = \"div\"; attrs = { class = \"edition\" }; children = list({ tag = \"span\"; children = list(\"BUILD\") },\n      { tag = \"b\"; children = list(or(at($document, \"build\"), \"Development\")) }) }\n  ) }")
("source-content-slot", "source", "applications/appdev-projects/desktop-launch.encounter")
("source-content-slot", "lines", "145–146")
("source-content-slot", "excerpt", "process desktop.appContent:\n  let result = { tag = \"div\"; attrs = { id = $app.content; class = \"desktop-app-content\"; \"data-window-slot\" = \"content\" } }")
("source-content", "source", "applications/appdev-projects/desktop-launch.encounter")
("source-content", "lines", "263–282")
("source-content", "excerpt", "process desktop.documentBody:\n  let indexLabel = at($document, \"indexLabel\")\n  let pane = { id = concat($app.key, \"-detail\"); class = \"manager-main\"; label = $document.detailLabel; children = or(at($document, \"detail\"), list()) }\n  call desktop.documentPane\n  let detailPane = $result\n  let indexPane = null\n  when $indexLabel:\n    let pane = { id = concat($app.key, \"-index\"); class = \"manager-tree\"; label = $indexLabel; children = or(at($document, \"index\"), list()) }\n    call desktop.documentPane\n    let indexPane = $result\n  let result = { tag = \"div\"; attrs = { id = concat($app.key, \"-panel\"); class = \"manager-panel\"; \"data-density-control\" = if(at($document, \"density\"), \"true\", null) }; children = list(\n    if($indexLabel, { tag = \"div\"; attrs = { id = concat($app.key, \"-tabs\"); class = \"manager-tabs\";\n      role = \"group\"; \"aria-label\" = concat($app.title, \" views\") }; children = or(at($document, \"tabs\"), list()) }, null),\n    if(and($indexLabel, not(eq(at($document, \"showLocation\"), false))), { tag = \"div\"; attrs = { id = concat($app.key, \"-location\"); class = \"manager-location\" }; children = list(\n      { tag = \"span\"; attrs = { id = concat($app.key, \"-status\"); role = \"status\"; \"aria-live\" = \"polite\" }; children = list(or(at($document, \"status\"), \"Opening…\")) },\n      at($document, \"locationAction\")\n    ) }, null),\n    { tag = \"div\"; attrs = { class = if($indexLabel, \"manager-panes\", \"manager-panes manager-single-pane\") };\n      children = list($indexPane, $detailPane) }\n  ) }")
("source-pane", "source", "applications/appdev-projects/desktop-launch.encounter")
("source-pane", "lines", "259–261")
("source-pane", "excerpt", "process desktop.documentPane:\n  let result = { tag = \"section\"; attrs = { id = $pane.id; class = concat(\"desktop-scroll-pane \", $pane.class);\n    \"aria-label\" = $pane.label; tabindex = \"0\" }; children = $pane.children }")
("source-files-tree", "source", "applications/appdev-projects/managers.encounter")
("source-files-tree", "lines", "132–160")
("source-files-tree", "excerpt", "process files.tree:\n  let roots = filter($folders, \"node\", not(at($node, \"parent\")))\n  # Folder rows arrive in path order within each collection. Build the\n  # children first so a branch can be rendered with a single pass.\n  fold $folders as node; reversed starts list():\n    yield append(list($node), $reversed) → reversed\n  fold $reversed as node; tree starts { nodes = {}; children = {} }:\n    let children = or(at($tree.children, $node.id), list())\n    call files.treeFolder\n    let rendered = $result\n    port record.put { record = $tree.nodes; key = $node.id; value = $rendered } → nodes\n    let byParent = $tree.children\n    let parent = at($node, \"parent\")\n    when $parent:\n      let siblings = or(at($byParent, $parent), list())\n      port record.put { record = $byParent; key = $parent; value = append(list($rendered), $siblings) } → byParent\n    yield { nodes = $nodes; children = $byParent } → tree\n  let platform = list({ label = \"Releases\"; paths = list(\"Platform/Releases/Home\") },\n    { label = \"Kernel\"; paths = list(\"Platform/Kernel/Releases\") }, { label = \"Receipts\"; paths = list(\"Platform/Receipts\") })\n  let apps = list({ label = \"Game Hub\"; paths = list(\"Apps/Game Hub/Assets\", \"Apps/Game Hub/Store/Published assets\") },\n    { label = \"North River\"; paths = list(\"Apps/North River/Source\", \"Apps/North River/Receipts\") })\n  fold list({ label = \"Platform\"; branches = $platform }, { label = \"Apps\"; branches = $apps }) as group; sections starts list():\n    fold $group.branches as branch; branches starts list():\n      call files.branch\n      yield if($result, append($branches, list($result)), $branches) → branches\n    let section = { tag = \"li\"; children = list({ tag = \"details\"; attrs = { open = true }; children = list(\n      { tag = \"summary\"; children = list($group.label) }, { tag = \"ul\"; children = $branches }) }) }\n    yield if(count($branches), append($sections, list($section)), $sections) → sections\n  let result = { tag = \"ul\"; attrs = { class = \"file-tree\" }; children = $sections }")
("source-file-search", "source", "applications/appdev-projects/managers.encounter")
("source-file-search", "lines", "282–292")
("source-file-search", "excerpt", "process files.searchForm:\n  let options = map($scopes, \"root\", { tag = \"option\"; attrs = { value = $root.id;\n    selected = eq($searchScope, $root.id) }; children = list($root.path) })\n  let result = { tag = \"form\"; attrs = { id = \"file-search\"; method = \"post\"; \"data-manager-action\" = \"file-search\" }; children = list(\n    { tag = \"label\"; attrs = { for = \"file-search-query\" }; children = list(\"Search files\") },\n    { tag = \"input\"; attrs = { id = \"file-search-query\"; type = \"search\"; name = \"query\"; maxlength = \"120\"; value = $searchQuery } },\n    { tag = \"label\"; attrs = { for = \"file-search-scope\" }; children = list(\"Collection\") },\n    { tag = \"select\"; attrs = { id = \"file-search-scope\"; name = \"scope\" }; children = append(\n      list({ tag = \"option\"; attrs = { value = \"\" }; children = list(\"All available collections\") }), $options) },\n    { tag = \"button\"; attrs = { type = \"submit\"; class = \"button\" }; children = list(\"Search\") }\n  ) }")
("source-file-row", "source", "applications/appdev-projects/managers.encounter")
("source-file-row", "lines", "208–226")
("source-file-row", "excerpt", "process files.entryRow:\n  let command = if(eq($node.kind, \"Folder\"), \"folder\", \"file\")\n  call files.type\n  let type = $result\n  let button = { tag = \"button\"; attrs = { type = \"button\"; class = \"file-entry-name\"; title = $node.name;\n    \"data-file-type\" = $type.id; \"data-manager-action\" = $command; \"data-manager-item\" = $node.id }; children = list($node.name) }\n  call files.viewerLink\n  let viewerLink = $result\n  call files.owner\n  let owner = $result\n  let bytes = at($node, \"bytes\")\n  call files.size\n  let size = $result\n  let result = { tag = \"tr\"; children = list(\n    { tag = \"td\"; children = list($button, $viewerLink) },\n    { tag = \"td\"; attrs = { title = $type.label; \"data-file-type\" = $type.id }; children = list($type.label) },\n    { tag = \"td\"; attrs = { class = \"file-size\"; title = $size.long }; children = list($size.short) },\n    { tag = \"td\"; attrs = { title = $owner }; children = list($owner) },\n    { tag = \"td\"; attrs = { title = $node.permission }; children = list($node.permission) }) }")
("source-file-list", "source", "applications/appdev-projects/managers.encounter")
("source-file-list", "lines", "449–459")
("source-file-list", "excerpt", "      let entries = filter($rows, \"node\", eq(at($node, \"parent\"), $folder.id))\n      fold $entries as node; children starts list():\n        call files.entryRow\n        yield append($children, list($result)) → children\n      let columns = map(list(\"Name\", \"Type\", \"Size\", \"Owner\", \"Permissions\"), \"column\",\n        { tag = \"th\"; attrs = { scope = \"col\" }; children = list($column) })\n      let table = { tag = \"table\"; attrs = { class = \"sourcery-data-table file-contents-table\"; \"aria-label\" = \"Folder contents\" }; children = list(\n        { tag = \"thead\"; children = list({ tag = \"tr\"; children = $columns }) }, { tag = \"tbody\"; children = $children }) }\n      let empty = { tag = \"p\"; attrs = { class = \"sourcery-feedback\"; \"data-feedback\" = \"info\" }; children = list(\"This folder is empty.\") }\n      let hint = { tag = \"p\"; attrs = { class = \"file-list-hint\" }; children = list(\"Click a filename to open its preview or details.\") }\n      let result = append($result, if(count($children), list($hint, $table), list($empty)))")
("source-file-breadcrumbs", "source", "applications/appdev-projects/managers.encounter")
("source-file-breadcrumbs", "lines", "228–240")
("source-file-breadcrumbs", "excerpt", "process files.breadcrumbs:\n  port text.split { value = $node.path; pattern = \"/\" } → segments\n  fold $segments as segment; trail starts { path = \"\"; items = list() }:\n    let path = if($trail.path, concat($trail.path, \"/\", $segment), $segment)\n    let current = eq($path, $node.path)\n    let destination = at(filter($folders, \"candidate\", eq($candidate.path, $path)), 0)\n    let crumb = { tag = \"span\"; attrs = { \"aria-current\" = if($current, \"page\", null) }; children = list($segment) }\n    when and($destination, not($current)):\n      let crumb = { tag = \"button\"; attrs = { type = \"button\"; \"data-manager-action\" = \"folder\"; \"data-manager-item\" = $destination.id }; children = list($segment) }\n    let item = { tag = \"li\"; attrs = { title = $segment }; children = list($crumb) }\n    yield { path = $path; items = append($trail.items, list($item)) } → trail\n  let result = { tag = \"nav\"; attrs = { class = \"file-breadcrumbs\"; \"aria-label\" = \"File location\" }; children = list(\n    { tag = \"ol\"; children = $trail.items }) }")
("source-file-tree-folder", "source", "applications/appdev-projects/managers.encounter")
("source-file-tree-folder", "lines", "110–122")
("source-file-tree-folder", "excerpt", "process files.treeFolder:\n  let selected = eq(at($folder, \"id\"), $node.id)\n  let button = { tag = \"button\"; attrs = { type = \"button\"; class = \"file-tree-label\"; title = $node.name;\n    \"data-manager-action\" = \"folder\"; \"data-manager-item\" = $node.id;\n    \"aria-pressed\" = if($selected, \"true\", \"false\") }; children = list($node.name) }\n  let result = { tag = \"li\"; children = list($button) }\n  when count($children):\n    let selectedPath = if($folder, $folder.path, \"\")\n    port text.indexOf { value = $selectedPath; search = concat($node.path, \"/\") } → descendant\n    let result = { tag = \"li\"; children = list({ tag = \"details\"; attrs = { open = or($selected, eq($descendant, 0)) }; children = list(\n      { tag = \"summary\"; attrs = { \"aria-label\" = concat(\"Subfolders of \", $node.name) }; children = list($button) },\n      { tag = \"ul\"; children = $children }\n    ) }) }")
("source-file-viewer-link", "source", "applications/appdev-projects/managers.encounter")
("source-file-viewer-link", "lines", "203–206")
("source-file-viewer-link", "excerpt", "process files.viewerLink:\n  let result = if(at($node, \"viewer\"), { tag = \"button\"; attrs = { type = \"button\"; class = \"file-viewer-link\";\n    \"data-manager-action\" = \"open-viewer\"; \"data-manager-item\" = $node.id;\n    \"aria-label\" = concat(\"Open \", $node.name, \" in File Viewer\") }; children = list(\"Open in File Viewer\") }, null)")
("source-file-metadata", "source", "applications/appdev-projects/managers.encounter")
("source-file-metadata", "lines", "172–190")
("source-file-metadata", "excerpt", "process files.metadata:\n  call files.owner\n  let owner = $result\n  let bytes = at($node, \"bytes\")\n  call files.size\n  let size = $result.long\n  let unique = at($node, \"uniqueBytes\")\n  let showUnique = and(eq($node.kind, \"Folder\"), not(eq($unique, null)))\n  let bytes = $unique\n  call files.size\n  let result = { tag = \"dl\"; attrs = { class = \"file-index-properties\" }; children = list(\n    { tag = \"dt\"; children = list(\"Size\") }, { tag = \"dd\"; children = list($size) },\n    if($showUnique, { tag = \"dt\"; attrs = { title = \"Total size after counting identical file contents once\" }; children = list(\"Unique content\") }, null),\n    if($showUnique, { tag = \"dd\"; children = list($result.long) }, null),\n    { tag = \"dt\"; children = list(\"Owner\") }, { tag = \"dd\"; children = list($owner) },\n    { tag = \"dt\"; children = list(\"Permissions\") }, { tag = \"dd\"; children = list($node.permission, \" · Read only\") },\n    if(not(eq(at($node, \"fileCount\"), null)), { tag = \"dt\"; children = list(\"Files\") }, null),\n    if(not(eq(at($node, \"fileCount\"), null)), { tag = \"dd\"; children = list($node.fileCount) }, null)\n  ) }")
("source-file-preview", "source", "applications/appdev-projects/managers.encounter")
("source-file-preview", "lines", "415–459")
("source-file-preview", "excerpt", "process files.preview:\n  let unavailable = { tag = \"p\"; attrs = { class = \"sourcery-feedback\"; \"data-feedback\" = \"warning\"; role = \"status\" }; children = list(\"No indexed location is available. Sign in to a provider and refresh the index.\") }\n  let command = \"back-run\"\n  let item = null\n  let label = \"Back to Service Manager\"\n  let buttonClass = \"button\"\n  let pressed = null\n  call managers.button\n  let returnButton = if($returnToRun, $result, null)\n  let result = list($unavailable, $returnButton)\n  when $folder:\n    let node = or($file, $folder)\n    call files.location\n    let location = $result\n    let parent = if($file, $folder.id, at($folder, \"parent\"))\n    let command = \"folder\"\n    let item = $parent\n    let label = if($file, \"Back to folder\", \"Up one folder\")\n    let buttonClass = \"button\"\n    let pressed = null\n    call managers.button\n    let back = if($parent, $result, null)\n    call files.metadata\n    let properties = $result\n    let result = append($location, list($back, $returnButton, $properties))\n    when $file:\n      let previewScope = \"file\"\n      call files.viewerLink\n      let viewerLink = $result\n      call files.content\n      let preview = $result\n      let unavailable = if(or($viewerLink, $preview), null, { tag = \"p\"; children = list(\"No inline preview is available for this file.\") })\n      let result = append($location, list($back, $returnButton, $viewerLink, $preview, $properties, $unavailable))\n    when not($file):\n      let entries = filter($rows, \"node\", eq(at($node, \"parent\"), $folder.id))\n      fold $entries as node; children starts list():\n        call files.entryRow\n        yield append($children, list($result)) → children\n      let columns = map(list(\"Name\", \"Type\", \"Size\", \"Owner\", \"Permissions\"), \"column\",\n        { tag = \"th\"; attrs = { scope = \"col\" }; children = list($column) })\n      let table = { tag = \"table\"; attrs = { class = \"sourcery-data-table file-contents-table\"; \"aria-label\" = \"Folder contents\" }; children = list(\n        { tag = \"thead\"; children = list({ tag = \"tr\"; children = $columns }) }, { tag = \"tbody\"; children = $children }) }\n      let empty = { tag = \"p\"; attrs = { class = \"sourcery-feedback\"; \"data-feedback\" = \"info\" }; children = list(\"This folder is empty.\") }\n      let hint = { tag = \"p\"; attrs = { class = \"file-list-hint\" }; children = list(\"Click a filename to open its preview or details.\") }\n      let result = append($result, if(count($children), list($hint, $table), list($empty)))")
("source-file-search-results", "source", "applications/appdev-projects/managers.encounter")
("source-file-search-results", "lines", "294–333")
("source-file-search-results", "excerpt", "process files.searchResults:\n  let scope = at(filter($scopes, \"root\", eq($root.id, $searchScope)), 0)\n  let message = \"Enter a file name or path.\"\n  let hits = list()\n  when and($searchScope, not($scope)):\n    let message = \"This collection is unavailable to your session.\"\n  when and($searchQuery, or(not($searchScope), $scope)):\n    port text.lowerCase { value = $searchQuery } → term\n    let candidates = filter($rows, \"row\", and(not(eq($row.kind, \"Folder\")), at($row, \"permission\")))\n    fold $candidates as node; matches starts { count = 0; entries = list() }:\n      port text.lowerCase { value = $node.path } → path\n      port text.indexOf { value = $path; search = $term } → found\n      let inScope = not($scope)\n      when $scope:\n        port text.indexOf { value = $node.path; search = concat($scope.path, \"/\") } → start\n        let inScope = eq($start, 0)\n        when at($scope, \"roots\"):\n          fold $scope.roots as root; scoped starts false:\n            port text.indexOf { value = $node.path; search = concat($root, \"/\") } → matched\n            yield or($scoped, eq($matched, 0)) → scoped\n          let inScope = $scoped\n      let accepted = and($inScope, not(eq($found, -1)), not(eq($found, null)))\n      let next = $matches\n      when $accepted:\n        let entries = $matches.entries\n        when not(eq(count($entries), 30)):\n          call files.viewerLink\n          let viewer = $result\n          call files.draftLink\n          let entries = append($entries, list({ tag = \"li\"; children = list(\n            { tag = \"button\"; attrs = { type = \"button\"; \"data-manager-action\" = \"search-detail\";\n              \"data-manager-item\" = $node.id; \"data-manager-folder\" = $node.parent }; children = list($node.path) }, $viewer, $result) }))\n        let next = { count = add($matches.count, 1); entries = $entries }\n      yield $next → matches\n    let hits = $matches.entries\n    let message = if($matches.count, concat(\"Showing \", count($hits), \" of \", $matches.count, \" matching files.\"), \"No matching files.\")\n  let input = list(\n    { tag = \"h3\"; attrs = { id = \"file-search-results\"; tabindex = \"-1\" }; children = list(\"File search results\") },\n    { tag = \"p\"; attrs = { role = \"status\" }; children = list($message) },\n    if(count($hits), { tag = \"ul\"; children = $hits }, null))")
("source-file-location", "source", "applications/appdev-projects/managers.encounter")
("source-file-location", "lines", "387–389")
("source-file-location", "excerpt", "process files.location:\n  call files.breadcrumbs\n  let result = list($result, { tag = \"h3\"; attrs = { tabindex = \"-1\" }; children = list($node.name) })")
("source-encounter-viewer", "source", "applications/appdev-projects/managers.encounter")
("source-encounter-viewer", "lines", "366–385")
("source-encounter-viewer", "excerpt", "process files.encounterViewer:\n  let selectedLine = at($file, \"sourceLine\")\n  let sourceText = $file.text\n  let firstLine = or(at($file, \"sourceFirstLine\"), 1)\n  let context = if(at($file, \"sourceFirstLine\"), { tag = \"p\"; children = list(\"Release source excerpt\") }, null)\n  let source = { tag = \"pre\"; children = list($sourceText) }\n  try:\n    call source.encounterLightPolicy\n    let spPolicy = $result.presentation\n    let lexPolicy = $result.lexical\n    let lexGrammar = $result.grammar\n    port digest.sha256 { text = $sourceText } → hash\n    port kernel.invoke { query = \"sp.present\"; input = { text = $sourceText; expectedHash = $hash;\n      file = $file.name; language = \"encounter\"; theme = \"light\"; lineNumbers = true;\n      selectedLine = $selectedLine; sourceFirstLine = $firstLine } } → presented\n    let source = { tag = \"pre\"; children = list($presented.tree) }\n  catch fault:\n    let source = { tag = \"pre\"; children = list($sourceText) }\n  let result = { tag = \"section\"; attrs = { class = \"file-encounter-viewer\"; \"aria-label\" = \"Encounter source\" }; children = list(\n    { tag = \"h4\"; children = list(\"Encounter source\") }, $context, $source) }")
("file-content", "label", "files.content")
("file-content", "kind", "Render")
("file-content", "type", "Inline Encounter source dispatch")
("file-content", "description", "Text with the Encounter file type is passed to files.encounterViewer and the platform source presenter.")
("file-content", "relation", "Displays")
("file-content", "target", "file-source")
("file-content", "source", "applications/appdev-projects/managers.encounter")
("file-content", "lines", "391–413")
("file-content", "excerpt", "process files.content:\n  let result = null\n  let image = at($file, \"imagePreview\")\n  when $image:\n    let result = { tag = \"section\"; attrs = { class = \"file-image-preview\"; \"aria-label\" = \"Image preview\" }; children = list(\n      { tag = \"h4\"; children = list(\"Image preview\") },\n      { tag = \"img\"; attrs = { src = $image; alt = $file.name; decoding = \"async\" } }\n    ) }\n  when at($file, \"text\"):\n    let viewer = at($file, \"rel\")\n    let result = { tag = \"pre\"; children = list($file.text) }\n    when $viewer:\n      call files.relViewer\n    when not($viewer):\n      let plain = $result\n      call files.type\n      let encounter = eq($result.id, \"encounter\")\n      let result = $plain\n      when $encounter:\n        call files.encounterViewer\n  when and(eq($previewScope, \"viewer\"), eq(at($file, \"viewer\"), \"video\")):\n    let result = { tag = \"video\"; attrs = { class = \"file-viewer-video\"; controls = true; preload = \"metadata\";\n      src = concat(\"/workspace/file-media?file=\", $file.id); \"aria-label\" = $file.name }; children = list(\"This browser cannot play this movie.\") }")
("file-content", "flow", "file-case")

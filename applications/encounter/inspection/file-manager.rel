("folder-event", "target", "folder-read")
("folder-event", "source", "applications/appdev-projects/browser-managers.encounter")
("folder-event", "lines", "40–63")
("folder-event", "excerpt", "process managers.event:\n  let managerKey = $key\n  let managerAction = or(at($eventInput.matched.attributes, \"data-manager-action\"), at($eventInput.matched.attributes, \"data-document-command\"))\n  let managerItem = at($eventInput.matched.attributes, \"data-manager-item\")\n  when eq($managerKey, \"file-manager\"):\n    port state.get { key = \"file-manager-selection\" } → previous\n    let folderId = if(eq($managerAction, \"folder\"), $managerItem, at($previous, \"folder\"))\n    when eq($managerAction, \"search-detail\"):\n      let folderId = at($eventInput.matched.attributes, \"data-manager-folder\")\n    let retained = includes(list(\"refresh\", \"rel-filter\"), $managerAction)\n    let fileId = if(includes(list(\"file\", \"search-detail\"), $managerAction), $managerItem, if($retained, at($previous, \"file\"), null))\n    let relFilter = if($retained, or(at($previous, \"relFilter\"), \"\"), \"\")\n    when and(eq($managerAction, \"rel-filter\"), $fileId):\n      port browser.formFields { ref = \"#file-rel-filter\" } → fields\n      port text.trim { value = or(at($fields, \"filter\"), \"\") } → relFilter\n    let returnToRun = at($previous, \"returnToRun\")\n    when eq($managerAction, \"file-search\"):\n      port browser.formFields { ref = \"#file-search\" } → fields\n      port text.trim { value = or(at($fields, \"query\"), \"\") } → query\n      port state.set { key = \"file-manager-search\"; value = { query = $query; scope = at($fields, \"scope\") } } → _\n    when includes(list(\"folder\", \"file\", \"search-detail\"), $managerAction):\n      port state.set { key = \"file-manager-search\"; value = null } → _\n    when includes(list(\"folder\", \"file\", \"search-detail\", \"refresh\", \"rel-filter\", \"file-search\"), $managerAction):\n      call managers.showFiles")
("folder-event", "flow", "folder-case")
("folder-read", "label", "managers.showFiles")
("folder-read", "kind", "Read")
("folder-read", "type", "Scoped file index")
("folder-read", "description", "Reads the index without a selected file and locates the destination among the returned folder rows.")
("folder-read", "relation", "Selects")
("folder-read", "target", "folder-data")
("folder-read", "shape", "GET /workspace/files\nfolderId: destination ID resolved against the returned Folder rows")
("folder-read", "source", "applications/appdev-projects/browser-managers.encounter")
("folder-read", "lines", "177–198")
("folder-read", "excerpt", "process managers.showFiles:\n  port state.get { key = \"file-manager-location\" } → previousLocation\n  let input = { tag = \"p\"; attrs = { role = \"status\" }; children = list(\"Checking access…\") }\n  call html.serialize\n  port browser.content { ref = \"#file-manager-detail\"; html = concat(if($previousLocation, $previousLocation, \"\"), $result) } → _\n  call managers.readFiles\n  let snapshot = $result\n  call files.catalogue\n  let rows = $result\n  let folders = filter($rows, \"node\", eq($node.kind, \"Folder\"))\n  let roots = filter($folders, \"node\", and(not(at($node, \"parent\")), at($node, \"permission\")))\n  port state.get { key = \"file-manager-context\" } → context\n  let scopedRoots = list()\n  when $context:\n    let scopedRoots = filter($roots, \"root\", includes($context.roots, $root.path))\n  let scopes = if($context, append(list({ id = $context.id; path = $context.path; roots = $context.roots }), $roots), $roots)\n  port state.get { key = \"file-manager-search\" } → search\n  let searchScope = if($search, at($search, \"scope\"), if($context, $context.id, \"\"))\n  let searchQuery = or(at($search, \"query\"), \"\")\n  let defaultFolder = at(if($context, $scopedRoots, $roots), 0)\n  let folder = if($folderId, at(filter($folders, \"node\", eq($node.id, $folderId)), 0), $defaultFolder)\n  let file = at(filter($rows, \"node\", and($folder, $fileId, not(eq($node.kind, \"Folder\")), eq($node.id, $fileId), eq(at($node, \"parent\"), at($folder, \"id\")))), 0)")
("folder-read", "flow", "folder-case")
("folder-data", "label", "Selected folder")
("folder-data", "kind", "Data")
("folder-data", "type", "Authorized folder-index row")

("file-event", "label", "managers.event")
("file-event", "kind", "Process")
("file-event", "type", "File selection branch")
("file-event", "description", "Reads the selected row’s ID, keeps the current folder and clears search before refreshing the detail pane.")
("file-event", "relation", "Reads via")
("file-event", "target", "file-read")
("file-event", "source", "applications/appdev-projects/browser-managers.encounter")
("file-event", "lines", "40–63")
("file-event", "excerpt", "process managers.event:\n  let managerKey = $key\n  let managerAction = or(at($eventInput.matched.attributes, \"data-manager-action\"), at($eventInput.matched.attributes, \"data-document-command\"))\n  let managerItem = at($eventInput.matched.attributes, \"data-manager-item\")\n  when eq($managerKey, \"file-manager\"):\n    port state.get { key = \"file-manager-selection\" } → previous\n    let folderId = if(eq($managerAction, \"folder\"), $managerItem, at($previous, \"folder\"))\n    when eq($managerAction, \"search-detail\"):\n      let folderId = at($eventInput.matched.attributes, \"data-manager-folder\")\n    let retained = includes(list(\"refresh\", \"rel-filter\"), $managerAction)\n    let fileId = if(includes(list(\"file\", \"search-detail\"), $managerAction), $managerItem, if($retained, at($previous, \"file\"), null))\n    let relFilter = if($retained, or(at($previous, \"relFilter\"), \"\"), \"\")\n    when and(eq($managerAction, \"rel-filter\"), $fileId):\n      port browser.formFields { ref = \"#file-rel-filter\" } → fields\n      port text.trim { value = or(at($fields, \"filter\"), \"\") } → relFilter\n    let returnToRun = at($previous, \"returnToRun\")\n    when eq($managerAction, \"file-search\"):\n      port browser.formFields { ref = \"#file-search\" } → fields\n      port text.trim { value = or(at($fields, \"query\"), \"\") } → query\n      port state.set { key = \"file-manager-search\"; value = { query = $query; scope = at($fields, \"scope\") } } → _\n    when includes(list(\"folder\", \"file\", \"search-detail\"), $managerAction):\n      port state.set { key = \"file-manager-search\"; value = null } → _\n    when includes(list(\"folder\", \"file\", \"search-detail\", \"refresh\", \"rel-filter\", \"file-search\"), $managerAction):\n      call managers.showFiles")
("file-event", "flow", "file-case")
("file-read", "label", "managers.readFiles")
("file-read", "kind", "Read")
("file-read", "type", "Scoped index request")
("file-read", "description", "The real app requests the selected file from the caller’s authorized index. This inspector uses a captured published example.")
("file-read", "relation", "Returns")
("file-read", "target", "file-data")
("file-read", "shape", "GET /workspace/files?file=<file ID>\n200 → collection rows\nOther outcomes → no snapshot")
("file-read", "source", "applications/appdev-projects/browser-managers.encounter")
("file-read", "lines", "162–175")
("file-read", "excerpt", "process managers.readFiles:\n  let fileSnapshot = null\n  try:\n    call files.publishedReceipts\n    let localReceipt = some($result, \"receipt\", eq($receipt.file.id, $fileId))\n    let query = if(and($fileId, not($localReceipt)), { file = $fileId }, null)\n    when and($query, $relFilter):\n      port record.put { record = $query; key = \"rel-filter\"; value = $relFilter } → query\n    port browser.request { path = \"/workspace/files\"; query = $query } → response\n    when eq($response.status, 200):\n      port json.parse { text = $response.body } → fileSnapshot\n  catch fault:\n    let fileSnapshot = null\n  let result = $fileSnapshot")
("file-read", "flow", "file-case")
("file-data", "label", "Selected file")
("file-data", "kind", "Data")
("file-data", "type", "Authorized file-index row")
("file-data", "description", "The file must match the selected ID and belong to the current folder. The sample row comes from a published Home source artifact.")
("file-data", "relation", "Renders through")

("folder-render", "source", "applications/appdev-projects/managers.encounter")
("folder-render", "lines", "425–459")
("folder-render", "excerpt", "  when $folder:\n    let node = or($file, $folder)\n    call files.location\n    let location = $result\n    let parent = if($file, $folder.id, at($folder, \"parent\"))\n    let command = \"folder\"\n    let item = $parent\n    let label = if($file, \"Back to folder\", \"Up one folder\")\n    let buttonClass = \"button\"\n    let pressed = null\n    call managers.button\n    let back = if($parent, $result, null)\n    call files.metadata\n    let properties = $result\n    let result = append($location, list($back, $returnButton, $properties))\n    when $file:\n      let previewScope = \"file\"\n      call files.viewerLink\n      let viewerLink = $result\n      call files.content\n      let preview = $result\n      let unavailable = if(or($viewerLink, $preview), null, { tag = \"p\"; children = list(\"No inline preview is available for this file.\") })\n      let result = append($location, list($back, $returnButton, $viewerLink, $preview, $properties, $unavailable))\n    when not($file):\n      let entries = filter($rows, \"node\", eq(at($node, \"parent\"), $folder.id))\n      fold $entries as node; children starts list():\n        call files.entryRow\n        yield append($children, list($result)) → children\n      let columns = map(list(\"Name\", \"Type\", \"Size\", \"Owner\", \"Permissions\"), \"column\",\n        { tag = \"th\"; attrs = { scope = \"col\" }; children = list($column) })\n      let table = { tag = \"table\"; attrs = { class = \"sourcery-data-table file-contents-table\"; \"aria-label\" = \"Folder contents\" }; children = list(\n        { tag = \"thead\"; children = list({ tag = \"tr\"; children = $columns }) }, { tag = \"tbody\"; children = $children }) }\n      let empty = { tag = \"p\"; attrs = { class = \"sourcery-feedback\"; \"data-feedback\" = \"info\" }; children = list(\"This folder is empty.\") }\n      let hint = { tag = \"p\"; attrs = { class = \"file-list-hint\" }; children = list(\"Click a filename to open its preview or details.\") }\n      let result = append($result, if(count($children), list($hint, $table), list($empty)))")

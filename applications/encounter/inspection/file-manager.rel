("search-event", "source", "applications/appdev-projects/browser-managers.encounter")
("search-event", "lines", "56–63")
("search-event", "excerpt", "    when eq($managerAction, \"file-search\"):\n      port browser.formFields { ref = \"#file-search\" } → fields\n      port text.trim { value = or(at($fields, \"query\"), \"\") } → query\n      port state.set { key = \"file-manager-search\"; value = { query = $query; scope = at($fields, \"scope\") } } → _\n    when includes(list(\"folder\", \"file\", \"search-detail\"), $managerAction):\n      port state.set { key = \"file-manager-search\"; value = null } → _\n    when includes(list(\"folder\", \"file\", \"search-detail\", \"refresh\", \"rel-filter\", \"file-search\"), $managerAction):\n      call managers.showFiles")
("search-event", "flow", "search-case")
("search-data", "label", "Search query and scope")
("search-data", "kind", "Data")
("search-data", "type", "File Manager search state")
("search-data", "description", "The query is matched against authorized paths in the chosen collection.")
("search-data", "relation", "Renders through")
("search-data", "target", "search-render")
("search-data", "shape", "query: Text\nscope: collection ID or empty for all available collections")
("search-data", "source", "applications/appdev-projects/managers.encounter")
("search-data", "lines", "294–315")
("search-data", "excerpt", "process files.searchResults:\n  let scope = at(filter($scopes, \"root\", eq($root.id, $searchScope)), 0)\n  let message = \"Enter a file name or path.\"\n  let hits = list()\n  when and($searchScope, not($scope)):\n    let message = \"This collection is unavailable to your session.\"\n  when and($searchQuery, or(not($searchScope), $scope)):\n    port text.lowerCase { value = $searchQuery } → term\n    let candidates = filter($rows, \"row\", and(not(eq($row.kind, \"Folder\")), at($row, \"permission\")))\n    fold $candidates as node; matches starts { count = 0; entries = list() }:\n      port text.lowerCase { value = $node.path } → path\n      port text.indexOf { value = $path; search = $term } → found\n      let inScope = not($scope)\n      when $scope:\n        port text.indexOf { value = $node.path; search = concat($scope.path, \"/\") } → start\n        let inScope = eq($start, 0)\n        when at($scope, \"roots\"):\n          fold $scope.roots as root; scoped starts false:\n            port text.indexOf { value = $node.path; search = concat($root, \"/\") } → matched\n            yield or($scoped, eq($matched, 0)) → scoped\n          let inScope = $scoped\n      let accepted = and($inScope, not(eq($found, -1)), not(eq($found, null)))")
("search-data", "flow", "search-case")
("search-render", "label", "files.searchResults")
("search-render", "kind", "Render")
("search-render", "type", "Matching files")
("search-render", "description", "The result button carries both the matching file ID and its parent folder ID.")
("search-render", "source", "applications/appdev-projects/managers.encounter")
("search-render", "lines", "316–333")
("search-render", "excerpt", "      let next = $matches\n      when $accepted:\n        let entries = $matches.entries\n        when not(eq(count($entries), 30)):\n          call files.viewerLink\n          let viewer = $result\n          call files.draftLink\n          let entries = append($entries, list({ tag = \"li\"; children = list(\n            { tag = \"button\"; attrs = { type = \"button\"; \"data-manager-action\" = \"search-detail\";\n              \"data-manager-item\" = $node.id; \"data-manager-folder\" = $node.parent }; children = list($node.path) }, $viewer, $result) }))\n        let next = { count = add($matches.count, 1); entries = $entries }\n      yield $next → matches\n    let hits = $matches.entries\n    let message = if($matches.count, concat(\"Showing \", count($hits), \" of \", $matches.count, \" matching files.\"), \"No matching files.\")\n  let input = list(\n    { tag = \"h3\"; attrs = { id = \"file-search-results\"; tabindex = \"-1\" }; children = list(\"File search results\") },\n    { tag = \"p\"; attrs = { role = \"status\" }; children = list($message) },\n    if(count($hits), { tag = \"ul\"; children = $hits }, null))")

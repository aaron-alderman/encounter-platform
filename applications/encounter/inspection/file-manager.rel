("file-data", "shape", "name: workspace.environmentPolicy.encounter\npath: Platform/Releases/Home/spec/catalogue-source/version-programme/applications/appdev-projects/workspace.encounter/workspace.environmentPolicy.encounter\nid: 729358ddc56d6c5eb12a9d47422ac08cf7fa9793220cf1663e479ebb16b4a63c\nkind: release-artifact\nbytes: 2094\npermission: Platform steward\nviewer: text\ntext: selected source excerpt")
("file-data", "source", "applications/appdev-projects/browser-managers.encounter")
("file-data", "lines", "197–198")
("file-data", "excerpt", "  let folder = if($folderId, at(filter($folders, \"node\", eq($node.id, $folderId)), 0), $defaultFolder)\n  let file = at(filter($rows, \"node\", and($folder, $fileId, not(eq($node.kind, \"Folder\")), eq($node.id, $fileId), eq(at($node, \"parent\"), at($folder, \"id\")))), 0)")

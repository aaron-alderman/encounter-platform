("minimize-binding", "lines", "58–58")
("minimize-binding", "excerpt", "        { ref = concat(\"#\", $app.minimize); event = \"click\"; query = \"desktop.event\"; input = { action = \"minimize\"; key = $app.key }; dispatchLabel = concat(\"minimize · \", $app.title) },")
("close-binding", "label", "Window close click")
("close-binding", "kind", "Event")
("close-binding", "type", "Browser click → desktop.event")
("close-binding", "description", "The desktop binds this action to the window control.")
("close-binding", "relation", "Dispatches to")
("close-binding", "target", "close-event")
("close-binding", "source", "applications/appdev-projects/browser-desktop.encounter")
("close-binding", "lines", "51–59")
("close-binding", "excerpt", "        if($app.maximize, { ref = $window; event = \"click\"; delegate = \"button[data-desktop-close]\"; query = \"desktop.event\";\n          input = { action = \"close\"; key = $app.key }; dispatchLabel = concat(\"close · \", $app.title) }, null),\n        if($app.maximize, { ref = concat(\"#\", $app.maximize); event = \"click\"; query = \"desktop.event\";\n          input = { action = \"maximize\"; key = $app.key }; dispatchLabel = concat(\"maximize · \", $app.title) }, null),\n        if(eq($app.key, \"certificates\"), { ref = $window; event = \"submit\"; delegate = \"form[data-certificate-renewal]\"; preventDefault = true; query = \"desktop.event\";\n          input = { action = \"certificate-submit\"; key = $app.key }; dispatchLabel = concat(\"certificate-submit · \", $app.title) }, null),\n        { ref = concat(\"#\", $app.task); event = \"click\"; query = \"desktop.event\"; input = $open; dispatchLabel = $label; timing = $timing; reveal = $window },\n        { ref = concat(\"#\", $app.minimize); event = \"click\"; query = \"desktop.event\"; input = { action = \"minimize\"; key = $app.key }; dispatchLabel = concat(\"minimize · \", $app.title) },\n        { ref = concat(\"#\", $app.close); event = \"click\"; query = \"desktop.event\"; input = { action = \"close\"; key = $app.key }; dispatchLabel = concat(\"close · \", $app.title) }")
("source-menu-bar", "source", "applications/appdev-projects/desktop-launch.encounter")
("source-menu-bar", "lines", "231–238")
("source-menu-bar", "excerpt", "process desktop.documentMenus:\n  let fileCommands = append(or(at($document, \"fileCommands\"), list()), list({ id = \"close\"; label = concat(\"Close \", $app.title) }))\n  let menus = list({ id = \"file\"; label = \"File\"; commands = $fileCommands; content = list() },\n    { id = \"help\"; label = \"Help\"; commands = list(); content = list({ tag = \"p\"; children = list($document.help) }) })\n  fold $menus as menu; children starts list():\n    call desktop.documentMenu\n    yield append($children, $result) → children\n  let result = { tag = \"nav\"; attrs = { class = \"menu-bar document-menu-bar\"; \"aria-label\" = concat($app.title, \" menus\") }; children = $children }")
("source-pane", "source", "applications/appdev-projects/desktop-launch.encounter")
("source-pane", "lines", "240–242")
("source-pane", "excerpt", "process desktop.documentPane:\n  let result = { tag = \"section\"; attrs = { id = $pane.id; class = concat(\"desktop-scroll-pane \", $pane.class);\n    \"aria-label\" = $pane.label; tabindex = \"0\" }; children = $pane.children }")
("source-content-slot", "source", "applications/appdev-projects/desktop-launch.encounter")
("source-content-slot", "lines", "126–127")
("source-content-slot", "excerpt", "process desktop.appContent:\n  let result = { tag = \"div\"; attrs = { id = $app.content; class = \"desktop-app-content\"; \"data-window-slot\" = \"content\" } }")
("source-title-controls", "source", "applications/encounter-libraries/window-shell.encounter")
("source-title-controls", "lines", "22–32")
("source-title-controls", "excerpt", "process windowShell.titleControls:\n  call windowShell.controlDefinitions\n  let controls = filter($result, \"control\", at($controlBindings, $control.id))\n  fold $controls as control; nodes starts list():\n    let binding = at($controlBindings, $control.id)\n    let label = concat($control.verb, \" \", $controlTarget)\n    port record.put { record = $binding.attrs; key = \"aria-label\"; value = $label } → attrs\n    port record.put { record = $attrs; key = \"title\"; value = $label } → attrs\n    port record.put { record = $attrs; key = \"data-window-control\"; value = $control.id } → attrs\n    yield append($nodes, list({ tag = $binding.tag; attrs = $attrs; children = list($control.glyph) })) → nodes\n  let result = if(count($nodes), { tag = \"div\"; attrs = { class = \"window-controls\" }; children = $nodes }, null)")

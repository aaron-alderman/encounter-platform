("maximize-binding", "kind", "Event")
("maximize-binding", "type", "Browser click → desktop.event")
("maximize-binding", "description", "The desktop binds this action to the window control.")
("maximize-binding", "relation", "Dispatches to")
("maximize-binding", "target", "maximize-event")
("maximize-binding", "source", "applications/appdev-projects/browser-desktop.encounter")
("maximize-binding", "lines", "53–54")
("maximize-binding", "excerpt", "        if($app.maximize, { ref = concat(\"#\", $app.maximize); event = \"click\"; query = \"desktop.event\";\n          input = { action = \"maximize\"; key = $app.key }; dispatchLabel = concat(\"maximize · \", $app.title) }, null),")

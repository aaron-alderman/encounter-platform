("minimize-event", "kind", "Event")
("minimize-event", "type", "Click → desktop.event")
("minimize-event", "description", "Hides the window and moves focus to its taskbar entry.")
("minimize-event", "shape", "action: \"minimize\"\nkey: \"temple-manager\"\nwindow.hidden: true\ntask: retained")
("close-binding", "source", "applications/appdev-projects/browser-desktop.encounter")
("close-binding", "lines", "51–59")
("close-binding", "excerpt", "        if($app.maximize, { ref = $window; event = \"click\"; delegate = \"button[data-desktop-close]\"; query = \"desktop.event\";\n          input = { action = \"close\"; key = $app.key }; dispatchLabel = concat(\"close · \", $app.title) }, null),\n        if($app.maximize, { ref = concat(\"#\", $app.maximize); event = \"click\"; query = \"desktop.event\";\n          input = { action = \"maximize\"; key = $app.key }; dispatchLabel = concat(\"maximize · \", $app.title) }, null),\n        if(eq($app.key, \"certificates\"), { ref = $window; event = \"submit\"; delegate = \"form[data-certificate-renewal]\"; preventDefault = true; query = \"desktop.event\";\n          input = { action = \"certificate-submit\"; key = $app.key }; dispatchLabel = concat(\"certificate-submit · \", $app.title) }, null),\n        { ref = concat(\"#\", $app.task); event = \"click\"; query = \"desktop.event\"; input = $open; dispatchLabel = $label; timing = $timing; reveal = $window },\n        { ref = concat(\"#\", $app.minimize); event = \"click\"; query = \"desktop.event\"; input = { action = \"minimize\"; key = $app.key }; dispatchLabel = concat(\"minimize · \", $app.title) },\n        { ref = concat(\"#\", $app.close); event = \"click\"; query = \"desktop.event\"; input = { action = \"close\"; key = $app.key }; dispatchLabel = concat(\"close · \", $app.title) }")
("close-binding", "label", "Window close click")
("close-binding", "kind", "Event")
("close-binding", "type", "Browser click → desktop.event")
("close-binding", "description", "The desktop binds this action to the window control.")
("close-binding", "relation", "Dispatches to")
("close-binding", "target", "close-event")
("close-event", "source", "applications/appdev-projects/browser-desktop.encounter")
("close-event", "lines", "187–207")
("close-event", "excerpt", "    when includes(list(\"minimize\", \"close\"), $action):\n      let task = concat(\"#\", $app.task)\n      port browser.write { ref = concat(\"#\", $app.window); name = \"hidden\"; value = true } → _\n      when eq($key, \"file-manager\"):\n        call managers.clearFiles\n      when eq($key, \"file-viewer\"):\n        port browser.content { ref = \"#file-viewer-detail\"; html = \"\" } → _\n      when eq($action, \"minimize\"):\n        port browser.focus { ref = $task } → _\n      when eq($action, \"close\"):\n        when eq($key, \"store\"):\n          call store.cancelIntent\n        when or($app.inventory, eq($key, \"acting-as\")):\n          port browser.content { ref = concat(\"#\", $app.content); html = \"\" } → _\n        port browser.write { ref = $task; name = \"hidden\"; value = true } → _\n        let shortcut = includes(list(\"hosted\", \"desktop\"), $app.group)\n        let launch = if($shortcut, concat(\"main.desktop .shortcuts [data-desktop-launch=\", $app.key, \"]\"), concat(\"#\", $app.id))\n        let visible = if($shortcut, concat(\"main.desktop:not([hidden]) .shortcuts [data-desktop-launch=\", $app.key, \"]\"),\n          concat(\"#workspace-open:checked ~ main.desktop:not([hidden]) #tab-operations:checked ~ .programs \", $launch))\n        when eq($app.group, \"banner\"):\n          let visible = concat(\"#workspace-open:checked ~ main.desktop:not([hidden]) \", $launch)")
("close-event", "label", "Close window")
("close-event", "kind", "Event")
("close-event", "type", "Click → desktop.event")
("close-event", "description", "Hides the window and task, then restores focus to the launcher or Start.")
("close-event", "shape", "action: \"close\"\nkey: \"temple-manager\"\nwindow.hidden: true\ntask.hidden: true")
("about-case", "release", "CATALOGUE-APP-INSPECTOR")

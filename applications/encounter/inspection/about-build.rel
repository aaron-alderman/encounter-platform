// About this build surface and event evidence.
("source-about-body", "source", "applications/appdev-projects/desktop-launch.encounter")
("source-about-body", "lines", "131–143")
("source-about-body", "excerpt", "process desktop.aboutBody:\n  let result = list(\n    { tag = \"div\"; attrs = { class = \"build-about-heading\" }; children = list(\n      { tag = \"svg\"; attrs = { class = \"icon\"; viewBox = \"0 0 32 32\"; \"aria-hidden\" = \"true\" }; children = list({ tag = \"use\"; attrs = { href = \"#icon-workspace\" } }) },\n      { tag = \"div\"; children = list({ tag = \"span\"; children = list(\"Home\") }, { tag = \"h3\"; children = list(\"Sourcery Workspace\") }) }\n    ) },\n    { tag = \"dl\"; attrs = { class = \"build-details\" }; children = list(\n      { tag = \"div\"; children = list({ tag = \"dt\"; children = list(\"Build ID\") },\n        { tag = \"dd\"; children = list({ tag = \"code\"; attrs = { id = \"about-build-id\" }; children = list($build) }) }) },\n      { tag = \"div\"; children = list({ tag = \"dt\"; children = list(\"Home fingerprint \", { tag = \"span\"; children = list(\"SHA-256\") }) },\n        { tag = \"dd\"; children = list({ tag = \"code\"; attrs = { id = \"about-build-fingerprint\" }; children = list(\"sourcery-home-full-build-placeholder\") }) }) }\n    ) }\n  )")
("about-case", "flow", "about-binding about-event about-open about-data")
("about-binding", "label", "About launcher click")
("about-binding", "kind", "Event")
("about-binding", "type", "Browser click → desktop.event")
("about-binding", "description", "The banner launcher sends the registered default action with the About app key.")
("about-binding", "target", "about-event")
("about-binding", "relation", "Dispatches to")
("about-binding", "shape", "{ action: \"open\", key: \"about\" }")
("about-binding", "source", "applications/appdev-projects/browser-desktop.encounter")
("about-binding", "lines", "30–37")
("about-binding", "excerpt", "      let open = { action = $app.defaultAction; key = $app.key }\n      let window = concat(\"#\", $app.window)\n      let timing = if(eq($app.key, \"performance\"), null, $app.title)\n      let shortcut = includes(list(\"hosted\", \"desktop\"), $app.group)\n      let label = concat($app.defaultAction, \" · \", $app.title)\n      let bindings = list(\n        if(or($shortcut, $app.start), { ref = \"document\"; event = \"click\"; delegate = concat(\"button[data-desktop-launch=\", $app.key, \"]\"); query = \"desktop.event\"; input = $open; dispatchLabel = $label; timing = $timing; reveal = $window }, null),\n        if(not($shortcut), { ref = concat(\"#\", $app.id); event = \"click\"; query = \"desktop.event\"; input = $open; dispatchLabel = $label; timing = $timing; reveal = $window }, null),")
("about-event", "label", "desktop.event")
("about-event", "kind", "Dispatch")
("about-event", "type", "Encounter process branch")
("about-event", "description", "The dispatcher compares the action with the registered default action and opens the app.")
("about-event", "target", "about-open")
("about-event", "relation", "Calls")
("about-event", "source", "applications/appdev-projects/browser-desktop.encounter")
("about-event", "lines", "184–186")
("about-event", "excerpt", "    when eq($action, $app.defaultAction):\n      let returned = false\n      call desktop.open")
("about-open", "label", "desktop.open")
("about-open", "kind", "Process")
("about-open", "type", "Window activation")
("about-open", "description", "Reveals the existing window and task, activates the window and focuses its heading. The build values are already part of the rendered Home page.")
("about-open", "target", "about-data")
("about-open", "relation", "Shows")
("about-open", "source", "applications/appdev-projects/browser-desktop.encounter")
("about-open", "lines", "357–383")
("about-open", "excerpt", "process desktop.open:\n  call desktop.defaultAction\n  let key = $app.key\n  let window = concat(\"#\", $app.window)\n  let task = concat(\"#\", $app.task)\n  let heading = concat(\"#\", $app.heading)\n  let readWindow = list(\n    { port = \"browser.property\"; args = { ref = $task; name = \"hidden\" }; save = \"closed\" },\n    { port = \"browser.property\"; args = { ref = $window; name = \"hidden\" }; save = \"minimized\" }\n  )\n  let closeStart = and(eq(at($eventInput, \"action\"), $app.defaultAction), eq(at($eventInput, \"key\"), $key))\n  let prepare = append(if($closeStart, list({ port = \"browser.write\"; args = { ref = \"#start\"; name = \"open\"; value = false } }), list()), $readWindow)\n  let prior = null\n  when eq($key, \"design\"):\n    port browser.batch { steps = $prepare; diagnosticLabel = \"Read window state\" } → prior\n    let prepare = list()\n    call design.workspacePrepare\n  let steps = append(append($prepare, list(\n    { port = \"browser.write\"; args = { ref = $task; name = \"hidden\"; value = false } },\n    { port = \"browser.write\"; args = { ref = $window; name = \"hidden\"; value = false } },\n    { port = \"browser.activate\"; args = { group = \"main.desktop\"; member = $window } }\n  )), list(\n    { port = \"browser.focus\"; args = { ref = $heading } },\n    { port = \"dom.exists\"; args = { selector = concat(\"main.desktop > \", $window, \":not([hidden])[data-active=true] \", $heading, \":focus\") }; save = \"focused\" },\n    { port = \"dom.exists\"; args = { selector = concat(\".taskbar > \", $task, \":not([hidden])\") }; save = \"listed\" }\n  ))\n  port browser.batch { steps = $steps; diagnosticLabel = \"Open and raise window\" } → opened")
("about-data", "label", "Home build identity")
("about-data", "kind", "Data")
("about-data", "type", "Published build metadata")
("about-data", "description", "Home renders the release ID and replaces the fingerprint placeholder with the SHA-256 of the checked page before substituting its hash markers.")
("about-data", "shape", "Build ID: Text (release argument)\nHome fingerprint: Text (64 hexadecimal characters)")
("about-data", "source", "applications/appdev-projects/projects.encounter")
("about-data", "lines", "533–536")
("about-data", "excerpt", "  port digest.sha256 { text = $result } → digest\n  port text.slice { value = $digest; start = 0; end = 12 } → fingerprint\n  port text.replaceAll { value = $result; search = \"sourcery-home-build-placeholder\"; replacement = $fingerprint } → pageWithShortHash\n  port text.replaceAll { value = $pageWithShortHash; search = \"sourcery-home-full-build-placeholder\"; replacement = $digest } → result")
("source-window", "source", "applications/appdev-projects/desktop-launch.encounter")
("source-window", "lines", "148–185")
("source-window", "excerpt", "process desktop.appWindow:\n  let windowTypeId = $app.layout\n  call windowShell.typeById\n  when not($result):\n    let layoutApp = $app.key\n    call desktop.refuseLayout\n  let windowType = $result\n  let documentWindow = eq($windowType.id, \"document\")\n  call desktop.appContent\n  let content = $result\n  let menu = null\n  let banner = null\n  when $documentWindow:\n    let content = { tag = $content.tag; attrs = $content.attrs; children = list($documentSlots.content) }\n    let menu = $documentSlots.menu\n    let banner = $documentSlots.banner\n  let actions = null\n  when eq($app.key, \"acting-as\"):\n    let actions = { tag = \"footer\"; attrs = { class = \"dialog-actions\" }; children = list(\n      { tag = \"a\"; attrs = { class = \"button\"; href = \"/settings/identity/\"; \"data-open-identity-management\" = true; \"data-identity-page\" = true }; children = list(\"Identity Management\") },\n      { tag = \"a\"; attrs = { class = \"button\"; href = \"/workspace/home#handover-demo\"; \"data-open-handover-demo\" = true }; children = list(\"Try the handover demo\") }\n    ) }\n  let controlTarget = $app.title\n  let controlBindings = {\n    maximize = if($app.maximize, { tag = \"button\"; attrs = { id = $app.maximize; type = \"button\"; \"aria-pressed\" = \"false\" } }, null);\n    minimize = { tag = \"button\"; attrs = { id = $app.minimize; type = \"button\" } };\n    close = { tag = \"button\"; attrs = { id = $app.close; type = \"button\" } }\n  }\n  call windowShell.titleControls\n  let title = { tag = \"header\"; attrs = { class = \"titlebar\" }; children = list(\n    { tag = \"svg\"; attrs = { class = \"icon\"; viewBox = \"0 0 32 32\"; \"aria-hidden\" = \"true\" }; children = list({ tag = \"use\"; attrs = { href = concat(\"#icon-\", $app.icon) } }) },\n    { tag = \"h2\"; attrs = { id = $app.heading; tabindex = \"-1\" }; children = list($app.title) },\n    $result\n  ) }\n  let slots = if($documentWindow, { title = $title; menu = $menu; banner = $banner; content = $content; actions = $actions },\n    { title = $title; content = $content; actions = $actions })\n  let frame = { tag = \"section\"; attrs = { id = $app.window; class = \"desktop-app-window\"; hidden = true; \"data-desktop-layout\" = $app.layout; \"aria-labelledby\" = $app.heading } }\n  call windowShell.frame")
("source-title", "source", "applications/appdev-projects/desktop-launch.encounter")
("source-title", "lines", "148–185")
("source-title", "excerpt", "process desktop.appWindow:\n  let windowTypeId = $app.layout\n  call windowShell.typeById\n  when not($result):\n    let layoutApp = $app.key\n    call desktop.refuseLayout\n  let windowType = $result\n  let documentWindow = eq($windowType.id, \"document\")\n  call desktop.appContent\n  let content = $result\n  let menu = null\n  let banner = null\n  when $documentWindow:\n    let content = { tag = $content.tag; attrs = $content.attrs; children = list($documentSlots.content) }\n    let menu = $documentSlots.menu\n    let banner = $documentSlots.banner\n  let actions = null\n  when eq($app.key, \"acting-as\"):\n    let actions = { tag = \"footer\"; attrs = { class = \"dialog-actions\" }; children = list(\n      { tag = \"a\"; attrs = { class = \"button\"; href = \"/settings/identity/\"; \"data-open-identity-management\" = true; \"data-identity-page\" = true }; children = list(\"Identity Management\") },\n      { tag = \"a\"; attrs = { class = \"button\"; href = \"/workspace/home#handover-demo\"; \"data-open-handover-demo\" = true }; children = list(\"Try the handover demo\") }\n    ) }\n  let controlTarget = $app.title\n  let controlBindings = {\n    maximize = if($app.maximize, { tag = \"button\"; attrs = { id = $app.maximize; type = \"button\"; \"aria-pressed\" = \"false\" } }, null);\n    minimize = { tag = \"button\"; attrs = { id = $app.minimize; type = \"button\" } };\n    close = { tag = \"button\"; attrs = { id = $app.close; type = \"button\" } }\n  }\n  call windowShell.titleControls\n  let title = { tag = \"header\"; attrs = { class = \"titlebar\" }; children = list(\n    { tag = \"svg\"; attrs = { class = \"icon\"; viewBox = \"0 0 32 32\"; \"aria-hidden\" = \"true\" }; children = list({ tag = \"use\"; attrs = { href = concat(\"#icon-\", $app.icon) } }) },\n    { tag = \"h2\"; attrs = { id = $app.heading; tabindex = \"-1\" }; children = list($app.title) },\n    $result\n  ) }\n  let slots = if($documentWindow, { title = $title; menu = $menu; banner = $banner; content = $content; actions = $actions },\n    { title = $title; content = $content; actions = $actions })\n  let frame = { tag = \"section\"; attrs = { id = $app.window; class = \"desktop-app-window\"; hidden = true; \"data-desktop-layout\" = $app.layout; \"aria-labelledby\" = $app.heading } }\n  call windowShell.frame")
("source-title-controls", "source", "applications/encounter-libraries/window-shell.encounter")
("source-title-controls", "lines", "22–32")
("source-title-controls", "excerpt", "process windowShell.titleControls:\n  call windowShell.controlDefinitions\n  let controls = filter($result, \"control\", at($controlBindings, $control.id))\n  fold $controls as control; nodes starts list():\n    let binding = at($controlBindings, $control.id)\n    let label = concat($control.verb, \" \", $controlTarget)\n    port record.put { record = $binding.attrs; key = \"aria-label\"; value = $label } → attrs\n    port record.put { record = $attrs; key = \"title\"; value = $label } → attrs\n    port record.put { record = $attrs; key = \"data-window-control\"; value = $control.id } → attrs\n    yield append($nodes, list({ tag = $binding.tag; attrs = $attrs; children = list($control.glyph) })) → nodes\n  let result = if(count($nodes), { tag = \"div\"; attrs = { class = \"window-controls\" }; children = $nodes }, null)")
("source-content-slot", "source", "applications/appdev-projects/desktop-launch.encounter")
("source-content-slot", "lines", "145–146")
("source-content-slot", "excerpt", "process desktop.appContent:\n  let result = { tag = \"div\"; attrs = { id = $app.content; class = \"desktop-app-content\"; \"data-window-slot\" = \"content\" } }")
("minimize-binding", "source", "applications/appdev-projects/browser-desktop.encounter")
("minimize-binding", "lines", "58–58")
("minimize-binding", "excerpt", "        { ref = concat(\"#\", $app.minimize); event = \"click\"; query = \"desktop.event\"; input = { action = \"minimize\"; key = $app.key }; dispatchLabel = concat(\"minimize · \", $app.title) },")
("minimize-binding", "label", "Window minimize click")
("minimize-binding", "kind", "Event")
("minimize-binding", "type", "Browser click → desktop.event")
("minimize-binding", "description", "The desktop binds this action to the window control.")
("minimize-binding", "relation", "Dispatches to")
("minimize-binding", "target", "minimize-event")
("minimize-event", "source", "applications/appdev-projects/browser-desktop.encounter")
("minimize-event", "lines", "187–195")
("minimize-event", "excerpt", "    when includes(list(\"minimize\", \"close\"), $action):\n      let task = concat(\"#\", $app.task)\n      port browser.write { ref = concat(\"#\", $app.window); name = \"hidden\"; value = true } → _\n      when eq($key, \"file-manager\"):\n        call managers.clearFiles\n      when eq($key, \"file-viewer\"):\n        port browser.content { ref = \"#file-viewer-detail\"; html = \"\" } → _\n      when eq($action, \"minimize\"):\n        port browser.focus { ref = $task } → _")

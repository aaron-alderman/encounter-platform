  B.focus: source.N.focus
  B.filmIn: source.N.filmIn
  B.sprite: source.N.sprite
  B.text: source.N.text
  B.reason: source.N.reason
  show as NarratedBeat

view bts.breathing of @voice.breathing isa Beat:
  B.title: source.N.title
  B.scene: source.N.scene
  B.focus: source.N.focus
  B.filmIn: source.N.filmIn
  B.sprite: source.N.sprite
  B.text: source.N.text
  B.reason: source.N.reason
  show as NarratedBeat

representation NarratedBeat:
  given navigation as Beat
  return Beat:
    B.title: navigation.B.title
    B.scene: navigation.B.scene
    B.focus: navigation.B.focus
    B.filmIn: navigation.B.filmIn
    B.sprite: navigation.B.sprite
    B.text: navigation.B.text
    B.reason: navigation.B.reason
  render:
    tag: "article"
    children:
      - navigation.B.title
      - navigation.B.text
      - navigation.B.reason


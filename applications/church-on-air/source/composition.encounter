# Typed broadcast projections; direct edits return to these REL facts.
module broadcast

view broadcast.signal of @signal isa Cut:
  C.title: source.S.title
  C.clip: source.S.clip
  C.in: source.S.in
  C.duration: source.S.duration
  C.layout: source.S.layout
  C.transition: source.S.transition
  C.tracking: source.S.tracking
  C.caption: source.S.caption
  C.reason: source.S.reason
  edit C.title through source.S.title
  edit C.in through source.S.in
  edit C.duration through source.S.duration
  edit C.layout through source.S.layout
  edit C.transition through source.S.transition
  edit C.tracking through source.S.tracking
  edit C.caption through source.S.caption
  show as TimelineShot


representation TimelineShot:
  given navigation as Cut
  return Cut:
    C.title: navigation.C.title
    C.clip: navigation.C.clip
    C.in: navigation.C.in
    C.duration: navigation.C.duration
    C.layout: navigation.C.layout
    C.transition: navigation.C.transition
    C.tracking: navigation.C.tracking
    C.caption: navigation.C.caption
    C.reason: navigation.C.reason
  render:
    tag: "article"
    children:
      - navigation.C.title
      - navigation.C.reason

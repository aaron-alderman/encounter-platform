process-module "temple/surface-process-module/1"

process cli.main:
  let result = ""
  when eq(at($eventInput, 0), "appdev"):
    let result = concat(
      "location = /store { return 308 /store/; }\n",
      "location = /game/store/ { return 308 /store/$is_args$args; }\n",
      "location ^~ /store/ {\n",
      "  access_log off;\n",
      "  proxy_pass http://127.0.0.1:24462;\n",
      "  proxy_http_version 1.1;\n",
      "  proxy_set_header Host $host;\n",
      "  proxy_set_header Upgrade $http_upgrade;\n",
      "  proxy_set_header Connection $encounter_pilot_connection;\n",
      "  proxy_read_timeout 3700s;\n",
      "  client_max_body_size 16k;\n",
      "}\n"
    )
  when eq(at($eventInput, 0), "broker"):
    let result = concat(
      "location = /store/identity {\n",
      "  access_log off;\n",
      "  limit_req zone=sourcery_identity_login burst=5 nodelay;\n",
      "  client_max_body_size 1k;\n",
      "  proxy_pass http://127.0.0.1:24462;\n",
      "  proxy_http_version 1.1;\n",
      "  proxy_set_header Host $host;\n",
      "  proxy_set_header Connection \"\";\n",
      "}\n"
    )

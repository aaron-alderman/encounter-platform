// Recorded scheduled execution inspection
("source-last-execution", "source", "applications/appdev-projects/managers.encounter")
("source-last-execution", "lines", "613–619")
("source-last-execution", "excerpt", "    let command = \"invocation\"\n    let item = $invocation\n    let label = \"View last service execution\"\n    let buttonClass = \"button\"\n    let pressed = null\n    call managers.button\n    let invocationButton = $result")
("source-rel-receipt", "source", "applications/appdev-projects/managers.encounter")
("source-rel-receipt", "lines", "336–364")
("source-rel-receipt", "excerpt", "process files.relViewer:\n  let facts = $viewer.rows\n  let countText = if($viewer.filter,\n    concat(\"Showing \", count($facts), \" of \", $viewer.matches, \" matching facts (\", $viewer.total, \" total)\"),\n    concat(\"Showing \", count($facts), \" of \", $viewer.total, \" facts\"))\n  let headers = map(list(\"Subject\", \"Predicate\", \"Object\", \"Polarity\"), \"column\",\n    { tag = \"th\"; attrs = { scope = \"col\" }; children = list($column) })\n  let rows = map($facts, \"fact\", { tag = \"tr\"; children = list(\n    { tag = \"td\"; children = list($fact.subject) },\n    { tag = \"td\"; children = list($fact.predicate) },\n    { tag = \"td\"; children = list($fact.object) },\n    { tag = \"td\"; children = list($fact.polarity) }\n  ) })\n  let table = { tag = \"table\"; attrs = { class = \"sourcery-data-table\"; \"aria-label\" = \"REL facts\" }; children = list(\n    { tag = \"thead\"; children = list({ tag = \"tr\"; children = $headers }) },\n    { tag = \"tbody\"; children = $rows }) }\n  let result = { tag = \"section\"; attrs = { class = \"file-rel-viewer\"; \"aria-label\" = \"REL viewer\" }; children = list(\n    { tag = \"h4\"; children = list(\"REL facts\") },\n    { tag = \"form\"; attrs = { id = concat($previewScope, \"-rel-filter\"); method = \"post\"; \"data-manager-action\" = \"rel-filter\" }; children = list(\n      { tag = \"label\"; attrs = { for = concat($previewScope, \"-rel-query\") }; children = list(\"Search facts\") },\n      { tag = \"input\"; attrs = { id = concat($previewScope, \"-rel-query\"); name = \"filter\"; type = \"search\"; maxlength = \"120\";\n        autocomplete = \"off\"; value = $viewer.filter } },\n      { tag = \"button\"; attrs = { type = \"submit\"; class = \"button\" }; children = list(\"Search\") }\n    ) },\n    { tag = \"p\"; attrs = { role = \"status\" }; children = list($countText) },\n    if(count($facts), $table, { tag = \"p\"; children = list(\"No matching facts.\") }),\n    { tag = \"details\"; children = list(\n      { tag = \"summary\"; children = list(\"REL source preview\") }, { tag = \"pre\"; children = list($file.text) }) }\n  ) }")

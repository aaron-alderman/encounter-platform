("source-service-status", "source", "applications/appdev-projects/managers.encounter")
("source-service-status", "lines", "547–568")
("source-service-status", "excerpt", "process services.observationTable:\n  fold $facts as fact; rows starts list():\n    let role = at($fact, \"role\")\n    let value = if(includes(list(\"state\", \"next\"), $role), { tag = \"strong\"; children = list($fact.value) },\n      if(eq($role, \"context\"), { tag = \"em\"; children = list($fact.value) }, $fact.value))\n    let action = at($fact, \"action\")\n    when $action:\n      let value = { tag = \"div\"; attrs = { class = \"service-observation-with-action\" }; children = list(\n        { tag = \"span\"; children = list($value) }, $action) }\n    let row = { tag = \"tr\"; children = list(\n      { tag = \"th\"; attrs = { scope = \"row\" }; children = list($fact.label) },\n      { tag = \"td\"; attrs = { \"data-observation-role\" = $role; \"data-observation-tone\" = at($fact, \"tone\") }; children = list($value) }\n    ) }\n    yield append($rows, list($row)) → rows\n  let result = { tag = \"table\"; attrs = { class = \"sourcery-data-table service-observations\"; \"data-table-layout\" = $tableLayout;\n    \"aria-label\" = \"Service observations\" }; children = list(\n    { tag = \"thead\"; children = list({ tag = \"tr\"; children = list(\n      { tag = \"th\"; attrs = { scope = \"col\" }; children = list(\"Field\") },\n      { tag = \"th\"; attrs = { scope = \"col\" }; children = list(\"Observation\") }\n    ) }) },\n    { tag = \"tbody\"; children = $rows }\n  ) }")
("services-view-event", "label", "Open Services view")
("services-view-event", "kind", "Event")
("services-view-event", "type", "Service Manager view change")
("services-view-event", "description", "The Services tab switches views and clears the previous selection.")

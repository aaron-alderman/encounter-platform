// Published run receipt inspection
("source-service-panel", "source", "applications/appdev-projects/managers.encounter")
("source-service-panel", "lines", "570–595")
("source-service-panel", "excerpt", "process services.panel:\n  call services.groups\n  let groups = $result\n  fold $groups as group; items starts list():\n    yield append($items, $group.items) → items\n  let entry = at(filter($items, \"entry\", eq($entry.id, $selected)), 0)\n  when not($entry):\n    let entry = at($items, 0)\n  let selected = at($entry, \"id\")\n  call services.views\n  fold $result as tab; tabs starts list():\n    let command = \"service-view\"\n    let item = $tab.id\n    let label = $tab.name\n    let buttonClass = null\n    let pressed = if(eq($view, $tab.id), \"true\", \"false\")\n    call managers.button\n    yield append($tabs, list($result)) → tabs\n  fold $groups as group; sections starts list():\n    fold $group.items as entry; rows starts list():\n      call services.entryButton\n      yield append($rows, list({ tag = \"li\"; children = list($result) })) → rows\n    yield append($sections, list({ tag = \"section\"; children = list(\n      { tag = \"h4\"; children = list($group.label) },\n      if(count($rows), { tag = \"ul\"; children = $rows }, { tag = \"p\"; children = list($group.empty) })\n    ) })) → sections")
("source-run-row", "source", "applications/appdev-projects/managers.encounter")
("source-run-row", "lines", "479–485")
("source-run-row", "excerpt", "process services.entryButton:\n  let command = \"service-item\"\n  let item = $entry.id\n  let label = concat($entry.name, \" · \", $entry.state)\n  let pressed = if(eq($item, $selected), \"true\", \"false\")\n  let buttonClass = null\n  call managers.button")
("source-service-receipt-button", "source", "applications/appdev-projects/managers.encounter")
("source-service-receipt-button", "lines", "620–640")
("source-service-receipt-button", "excerpt", "    let command = \"receipt\"\n    let item = $receipt\n    let label = \"Open receipt in File Manager\"\n    let buttonClass = \"button\"\n    let pressed = null\n    call managers.button\n    let runOutcomeAction = if($receipt, $result, null)\n    let lastTriggerAction = if($invocation, $invocationButton, null)\n    let observationView = $view\n    call services.observationFacts\n    let facts = $result\n    let tableLayout = \"grid\"\n    call services.observationTable\n    let detail = list(\n      { tag = \"h3\"; children = list($entry.name) },\n      $result,\n      if(at($entry, \"href\"), { tag = \"p\"; children = list({ tag = \"a\"; attrs = { href = $entry.href; target = \"_blank\"; rel = \"noopener\" }; children = list(\"Open app\") }) }, null),\n      if($receipt, { tag = \"section\"; children = list({ tag = \"h4\"; children = list(\"Run receipt\") },\n        { tag = \"p\"; children = list($entry.receiptPath) }) },\n        if(eq($view, \"runs\"), { tag = \"p\"; children = list(\"No published receipt for this execution.\") }, null))\n    )")
("run-selection", "label", "Select published run")
("run-selection", "kind", "Event")
("run-selection", "type", "Delegated Service Manager click")
("run-selection", "description", "The Runs view selects an entry by run ID and refreshes the Service Manager panes.")
("run-selection", "target", "run-data")
("run-selection", "relation", "Selects")
("run-selection", "shape", "data-manager-action: \"service-item\"\ndata-manager-item: run ID")
("run-selection", "source", "applications/appdev-projects/browser-managers.encounter")
("run-selection", "lines", "108–119")
("run-selection", "excerpt", "  when and(eq($managerKey, \"service-manager\"), not(eq($managerAction, \"density\"))):\n    port state.get { key = \"service-manager-selection\" } → previous\n    let view = if(eq($managerAction, \"service-view\"), $managerItem, $previous.view)\n    let selected = if(eq($managerAction, \"service-view\"), null, if(eq($managerAction, \"service-item\"), $managerItem, $previous.selected))\n    when eq($managerAction, \"invocation\"):\n      let view = \"runs\"\n      let selected = $managerItem\n    when eq($managerAction, \"refresh\"):\n      call managers.refreshServices\n    when includes(list(\"service-view\", \"service-item\", \"invocation\"), $managerAction):\n      port state.get { key = \"service-manager-observations\" } → snapshot\n      call managers.showServices")
("run-data", "label", "Selected run")
("run-data", "kind", "Data")
("run-data", "type", "Published run with receipt reference")
("run-data", "description", "The published run carries its receipt ID, folder and path.")
("run-data", "target", "run-receipt-binding")
("run-data", "relation", "Opens via")
("run-data", "source", "applications/appdev-projects/managers.encounter")
("run-data", "lines", "466–477")
("run-data", "excerpt", "process services.runs:\n  call files.publishedReceipts\n  let published = map($result, \"receipt\", $receipt.run)\n  let indexed = filter($receiptFiles, \"file\", at($file, \"execution\"))\n  let scheduled = map($indexed, \"file\", {\n    id = concat(\"systemd-invocation:\", $file.execution.invocationId);\n    name = $file.execution.service; state = if(eq($file.execution.result, \"success\"), \"Succeeded\", concat(\"Failed · \", $file.execution.result));\n    detail = \"Published receipt for a scheduled systemd execution.\";\n    started = concat($file.execution.started, \" AWST\"); duration = concat($file.execution.duration, \" seconds\");\n    receipt = $file.id; receiptFolder = $file.parent; receiptPath = $file.path\n  })\n  let result = append($published, $scheduled)")

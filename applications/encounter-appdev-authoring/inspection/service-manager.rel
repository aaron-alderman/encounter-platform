("run-receipt-binding", "shape", "data-manager-action: \"receipt\"\ndata-manager-item: receipt ID")
("run-receipt-binding", "source", "applications/appdev-projects/browser-desktop.encounter")
("run-receipt-binding", "lines", "38–40")
("run-receipt-binding", "excerpt", "        if(includes(list(\"file-manager\", \"file-viewer\", \"service-manager\"), $app.key),\n          { ref = $window; event = \"click\"; delegate = \"button:is([data-manager-action], [data-document-command])\"; query = \"desktop.event\";\n            input = { action = \"manager\"; key = $app.key }; dispatchLabel = concat(\"manager · \", $app.title) }, null),")
("run-open", "label", "Open run receipt")
("run-open", "kind", "Process")
("run-open", "type", "Service Manager → File Manager handoff")
("run-open", "description", "The dispatcher checks both the selected run ID and the requested receipt ID. It opens File Manager on that folder and file and keeps the return context.")
("run-open", "source", "applications/appdev-projects/browser-managers.encounter")
("run-open", "lines", "120–140")
("run-open", "excerpt", "    when eq($managerAction, \"receipt\"):\n      call managers.openRunReceipt\n\nprocess managers.openRunReceipt:\n  port state.get { key = \"service-manager-selection\" } → current\n  call managers.scheduledReceiptFiles\n  let receiptFiles = $result\n  call services.runs\n  let run = at(filter($result, \"run\", and(eq($run.id, at($current, \"selected\")), eq($run.receipt, $managerItem))), 0)\n  when $run:\n    port state.set { key = \"manager-return-run\"; value = $run } → _\n    let key = \"file-manager\"\n    let app = at(filter($apps, \"entry\", eq($entry.key, $key)), 0)\n    let returned = false\n    let managerHandoff = true\n    call desktop.open\n    let folderId = $run.receiptFolder\n    let fileId = $run.receipt\n    let relFilter = \"\"\n    let returnToRun = true\n    call managers.showFiles")
("run-open", "surfaceApp", "file-manager")
("run-open", "surfaceMode", "run-receipt")
("run-open", "surface", "receipt-preview")
("run-open", "surfaceLabel", "File Manager receipt surface")
("receipt-file", "label", "Selected receipt file")
("receipt-file", "kind", "Data")
("receipt-file", "type", "Published run receipt · text viewer")
("receipt-file", "description", "Both file surfaces inspect the same published receipt. Home includes the receipt row when the index reports Platform steward access.")
("receipt-file", "target", "receipt-source")
("receipt-file", "relation", "Defined by")
("receipt-file", "source", "applications/appdev-projects/managers.encounter")
("receipt-file", "lines", "94–108")
("receipt-file", "excerpt", "process files.catalogue:\n  let collections = or(at($snapshot, \"collections\"), {})\n  let sources = list(\"Platform/Releases/Home\", \"Platform/Kernel/Releases\", \"Platform/Scheduled run receipts\", \"Apps/Game Hub/Assets\",\n    \"Apps/Game Hub/Store/Published assets\", \"Apps/North River/Source\", \"Apps/North River/Receipts\")\n  fold $sources as source; rows starts list():\n    yield append($rows, or(at($collections, $source), list())) → rows\n  when at($snapshot, \"platform\"):\n    call files.publishedReceipts\n    let receipts = map($result, \"receipt\", $receipt.file)\n    fold $receipts as receipt; total starts 0:\n      yield add($total, $receipt.bytes) → bytes\n    let folder = { id = \"platform-receipts\"; name = \"Receipts\"; path = \"Platform/Receipts\"; kind = \"Folder\";\n      permission = \"Platform steward\"; bytes = $bytes; uniqueBytes = $bytes; fileCount = count($receipts) }\n    let rows = append($rows, append(list($folder), $receipts))\n  let result = $rows")
("receipt-source", "label", "Published receipt definition")
("receipt-source", "kind", "Source")
("receipt-source", "type", "Encounter published receipt declaration")
("receipt-source", "description", "The Encounter declaration contains the published plain-text qualification receipt and constructs its file and run records.")
("receipt-source", "source", "applications/appdev-projects/managers.encounter")
("receipt-source", "lines", "80–92")
("receipt-source", "excerpt", "process files.publishedReceipts:\n  let published = list(\n    { id = \"standalone-release\"; run = \"qualification\"; name = \"Encounter 0.1.7 qualification\"; state = \"Passed\";\n      detail = \"Standalone platform release verification\"; started = \"9 Nov 2026, 15:46:12 AWST\"; duration = \"66 seconds\";\n      text = \"Run: 20261109T074612193955Z-encounter-standalone-release-bc2a8e91\\nResult: Passed\\nStarted: 9 Nov 2026, 15:46:12 AWST\\nFinished: 9 Nov 2026, 15:47:18 AWST\\nExit code: 0\\n\\nThe standalone Linux release passed the manifest pin checks, native contracts, and installed browser workflows.\" }\n  )\n  fold $published as receipt; receipts starts list():\n    port text.utf8Length { value = $receipt.text } → bytes\n    let file = { id = $receipt.id; parent = \"platform-receipts\"; name = $receipt.name; kind = \"Run receipt\";\n      path = concat(\"Platform/Receipts/\", $receipt.name); permission = \"Platform steward\"; text = $receipt.text; bytes = $bytes; viewer = \"text\" }\n    yield append($receipts, list({ file = $file; run = { id = $receipt.run; name = $receipt.name; state = $receipt.state;\n      detail = $receipt.detail; started = $receipt.started; duration = $receipt.duration; receipt = $receipt.id;\n      receiptFolder = $file.parent; receiptPath = $file.path } })) → result")

("service-selection", "excerpt", "  when and(eq($managerKey, \"service-manager\"), not(eq($managerAction, \"density\"))):\n    port state.get { key = \"service-manager-selection\" } → previous\n    let view = if(eq($managerAction, \"service-view\"), $managerItem, $previous.view)\n    let selected = if(eq($managerAction, \"service-view\"), null, if(eq($managerAction, \"service-item\"), $managerItem, $previous.selected))\n    when eq($managerAction, \"invocation\"):\n      let view = \"runs\"\n      let selected = $managerItem\n    when eq($managerAction, \"refresh\"):\n      call managers.refreshServices\n    when includes(list(\"service-view\", \"service-item\", \"invocation\"), $managerAction):\n      port state.get { key = \"service-manager-observations\" } → snapshot\n      call managers.showServices")
("service-observation-read", "label", "Front Gate snapshot read")
("service-observation-read", "kind", "Read")
("service-observation-read", "type", "Service Manager observation state")
("service-observation-read", "description", "Selecting a row reads the cached observation. Refresh is the path that requests a new reading and stores it.")
("service-observation-read", "target", "front-gate-observation")
("service-observation-read", "relation", "Supplies")
("service-observation-read", "source", "applications/appdev-projects/browser-managers.encounter")
("service-observation-read", "lines", "117–119")
("service-observation-read", "excerpt", "    when includes(list(\"service-view\", \"service-item\", \"invocation\"), $managerAction):\n      port state.get { key = \"service-manager-observations\" } → snapshot\n      call managers.showServices")
("front-gate-observation", "label", "Front Gate observation")
("front-gate-observation", "kind", "Data")
("front-gate-observation", "type", "Front Gate status reading")
("front-gate-observation", "description", "The displayed fields come from a sample status reading. Home validates the response before projecting registered apps and scoped units.")
("front-gate-observation", "target", "app-status-projection")
("front-gate-observation", "relation", "Projects through")
("front-gate-observation", "source", "applications/appdev-projects/front-gate-desktop.encounter")
("front-gate-observation", "lines", "143–162")
("front-gate-observation", "excerpt", "process frontGate.snapshot:\n  port json.parse { text = $body } → status\n  port text.matches { value = $status.time; pattern = \"^[0-9]{2}:[0-9]{2}:[0-9]{2}$\" } → checkedTime\n  assert and(eq($status.schema, \"encounter/front-gate-status/1\"), $checkedTime, isArray($status.services), isArray($status.timers))\n    otherwise \"The gateway did not return a live Front Gate reading.\"\n  assert and(isArray($status.units), eq(count($status.units), 2),\n    some($status.units, \"group\", eq($group.scope, \"system\")), some($status.units, \"group\", eq($group.scope, \"user\")))\n    otherwise \"The Front Gate host-unit readings were incomplete.\"\n  let pilot = { group = \"Encounter platform\"; name = \"North River\"; detail = \"Open the Encounter pilot and sign in with your approved account.\";\n    status = \"HTTPS pilot\"; href = \"https://appdev.sourcerytech.com.au/encounter-pilot/\" }\n  fold $status.services as service; services starts list($pilot):\n    port text.matches { value = $service.id; pattern = \"^[a-z][a-z0-9-]*$\" } → validId\n    port value.type { value = $service.online } → onlineType\n    assert and($validId, eq($onlineType, \"boolean\"))\n      otherwise \"The gateway returned an invalid Front Gate service.\"\n    let href = if($service.online, concat(\"http://\", $service.id, \".localhost:\", $port, \"/\"), null)\n    yield append($services, list({ group = $service.group; name = $service.name; detail = $service.detail;\n      status = if($service.online, \"Listening\", \"Offline\"); href = $href })) → services\n  let units = map($status.units, \"group\", { scope = $group.scope; names = or($group.names, list());\n    empty = if(eq($group.names, null), \"Status unavailable.\", \"No running units.\") })")
("app-status-projection", "label", "Registered app status")
("app-status-projection", "kind", "Process")
("app-status-projection", "type", "Listener availability mapping")
("app-status-projection", "description", "Front Gate maps online to Listening or Offline. Service Manager copies that status onto the registered app row.")
("app-status-projection", "target", "service-status-render")
("app-status-projection", "relation", "Renders through")
("app-status-projection", "source", "applications/appdev-projects/front-gate-desktop.encounter")
("app-status-projection", "lines", "153–160")
("app-status-projection", "excerpt", "  fold $status.services as service; services starts list($pilot):\n    port text.matches { value = $service.id; pattern = \"^[a-z][a-z0-9-]*$\" } → validId\n    port value.type { value = $service.online } → onlineType\n    assert and($validId, eq($onlineType, \"boolean\"))\n      otherwise \"The gateway returned an invalid Front Gate service.\"\n    let href = if($service.online, concat(\"http://\", $service.id, \".localhost:\", $port, \"/\"), null)\n    yield append($services, list({ group = $service.group; name = $service.name; detail = $service.detail;\n      status = if($service.online, \"Listening\", \"Offline\"); href = $href })) → services")
("unit-status-projection", "label", "Systemd service status")
("unit-status-projection", "kind", "Process")
("unit-status-projection", "type", "Scoped running-unit mapping")
("unit-status-projection", "description", "Service Manager turns membership in a scope’s running-unit list into a Running row with a scope-qualified ID.")
("unit-status-projection", "target", "service-status-render")
("unit-status-projection", "relation", "Renders through")
("unit-status-projection", "source", "applications/appdev-projects/managers.encounter")
("unit-status-projection", "lines", "497–502")
("unit-status-projection", "excerpt", "    let units = list()\n    when $snapshot:\n      fold $snapshot.units as scope; units starts list():\n        yield append($units, map($scope.names, \"name\", {\n          id = concat($scope.scope, \"-\", $name); name = $name; state = \"Running\"; detail = concat(\"Observed systemd \", $scope.scope, \" service unit.\")\n        })) → units")
("service-status-render", "label", "Render service status")
("service-status-render", "kind", "Render")
("service-status-render", "type", "Service Manager observation table")
("service-status-render", "description", "The State row displays the selected entry’s projected status and assigns the corresponding tone.")
("service-status-render", "source", "applications/appdev-projects/managers.encounter")
("service-status-render", "lines", "532–545")
("service-status-render", "excerpt", "process services.observationFacts:\n  let state = $entry.state\n  port text.indexOf { value = $state; search = \"Failed · \" } → failure\n  let tone = if(eq($failure, 0), \"error\", if(eq($state, \"Offline\"), \"warning\",\n    if(includes(list(\"Listening\", \"Running\", \"Connected\", \"Succeeded\", \"Passed\"), $state), \"success\",\n      if(eq($state, \"Not observed\"), \"muted\", null))))\n  let result = filter(list(\n    { label = if(eq($observationView, \"runs\"), \"Outcome\", \"State\"); value = $state; role = if(eq($state, \"Timer\"), null, \"state\"); tone = $tone; action = $runOutcomeAction },\n    { label = \"Next trigger\"; value = at($entry, \"next\"); role = \"next\" },\n    { label = \"Last trigger\"; value = or(at($entry, \"last\"), if($lastTriggerAction, \"Not reported\", null)); action = $lastTriggerAction },\n    { label = \"Started\"; value = at($entry, \"started\") },\n    { label = \"Duration\"; value = at($entry, \"duration\") },\n    { label = \"Description\"; value = at($entry, \"detail\"); role = \"context\" }\n  ), \"fact\", $fact.value)")
("front-gate-refresh", "label", "Refresh Front Gate observations")
("front-gate-refresh", "kind", "Process")
("front-gate-refresh", "type", "Front Gate browser read and snapshot update")
("front-gate-refresh", "description", "Refresh requests a new reading and stores the validated snapshot for later service selections.")
("front-gate-refresh", "target", "front-gate-observation")
("front-gate-refresh", "relation", "Supplies")
("front-gate-refresh", "source", "applications/appdev-projects/browser-managers.encounter")
("front-gate-refresh", "lines", "322–337")
("front-gate-refresh", "excerpt", "process managers.refreshServices:\n  let snapshot = null\n  port browser.write { ref = \"#service-manager-status\"; name = \"textContent\"; value = \"Checking Front Gate…\" } → _\n  port browser.write { ref = \"#service-manager-refresh\"; name = \"disabled\"; value = true } → _\n  try:\n    call frontGate.browserPort\n    let port = $result\n    port browser.frontGateStatus {} → response\n    when eq($response.status, 200):\n      let body = $response.body\n      call frontGate.snapshot\n      let snapshot = $result\n  catch fault:\n    let snapshot = null\n  port state.set { key = \"service-manager-observations\"; value = $snapshot } → _\n  call managers.showServices")
("source-service-slots", "source", "applications/appdev-projects/managers.encounter")
("source-service-slots", "lines", "17–27")
("source-service-slots", "excerpt", "process managers.slots:\n  let service = eq($app.key, \"service-manager\")\n  let locationAction = null\n  when $service:\n    let density = \"compact\"\n    let densityLabel = \"Density\"\n    let densityAttrs = { id = \"service-manager-density\"; \"data-manager-action\" = \"density\" }\n    call managers.densityControl\n    let locationAction = { tag = \"div\"; attrs = { class = \"manager-location-controls\" }; children = list($result,\n      { tag = \"button\"; attrs = { type = \"button\"; class = \"button\"; \"data-manager-action\" = \"refresh\"; id = \"service-manager-refresh\" };\n        children = list(\"Refresh observations\") }) }")
("service-status-render", "surfaceMode", "services")
("service-status-render", "surface", "service-state")
("service-status-render", "surfaceLabel", "Service status surface")

("invocation-match", "target", "invocation-click")
("invocation-match", "relation", "Binds")
("invocation-match", "source", "applications/appdev-projects/managers.encounter")
("invocation-match", "lines", "599–612")
("invocation-match", "excerpt", "    let observed = or(at($snapshot, \"runs\"), list())\n    let service = at($entry, \"service\")\n    let scope = at($entry, \"scope\")\n    let execution = at(filter($observed, \"run\", and($service, eq($run.name, $service), eq($run.scope, $scope))), 0)\n    let invocation = at($execution, \"id\")\n    when $service:\n      let matched = filter($receiptFiles, \"file\", and(\n        eq(at(at($file, \"execution\"), \"scope\"), $scope),\n        eq(at(at($file, \"execution\"), \"service\"), $service),\n        eq(at(at($file, \"execution\"), \"timer\"), $entry.name),\n        eq(at(at($file, \"execution\"), \"lastTrigger\"), at($entry, \"last\"))))\n      when eq(count($matched), 1):\n        let receiptExecution = at(at($matched, 0), \"execution\")\n        let invocation = concat(\"systemd-invocation:\", $receiptExecution.invocationId)")
("invocation-click", "label", "Last execution click")
("invocation-click", "kind", "Event")
("invocation-click", "type", "Delegated click → desktop.event")
("invocation-click", "description", "The Last trigger action carries the matching systemd invocation ID.")
("invocation-click", "target", "invocation-event")
("invocation-click", "relation", "Dispatches to")
("invocation-click", "source", "applications/appdev-projects/browser-desktop.encounter")
("invocation-click", "lines", "38–40")
("invocation-click", "excerpt", "        if(includes(list(\"file-manager\", \"file-viewer\", \"service-manager\"), $app.key),\n          { ref = $window; event = \"click\"; delegate = \"button:is([data-manager-action], [data-document-command])\"; query = \"desktop.event\";\n            input = { action = \"manager\"; key = $app.key }; dispatchLabel = concat(\"manager · \", $app.title) }, null),")
("invocation-event", "label", "Open last execution")
("invocation-event", "kind", "Process")
("invocation-event", "type", "Schedules → Runs transition")
("invocation-event", "description", "The invocation action switches to Runs and selects the execution ID from the button.")
("invocation-event", "source", "applications/appdev-projects/browser-managers.encounter")
("invocation-event", "lines", "108–119")
("invocation-event", "excerpt", "  when and(eq($managerKey, \"service-manager\"), not(eq($managerAction, \"density\"))):\n    port state.get { key = \"service-manager-selection\" } → previous\n    let view = if(eq($managerAction, \"service-view\"), $managerItem, $previous.view)\n    let selected = if(eq($managerAction, \"service-view\"), null, if(eq($managerAction, \"service-item\"), $managerItem, $previous.selected))\n    when eq($managerAction, \"invocation\"):\n      let view = \"runs\"\n      let selected = $managerItem\n    when eq($managerAction, \"refresh\"):\n      call managers.refreshServices\n    when includes(list(\"service-view\", \"service-item\", \"invocation\"), $managerAction):\n      port state.get { key = \"service-manager-observations\" } → snapshot\n      call managers.showServices")
("invocation-event", "surfaceMode", "scheduled-run")
("invocation-event", "surface", "scheduled-run-row")
("invocation-event", "surfaceLabel", "Selected execution in Runs")
("scheduled-run-data", "label", "Selected scheduled execution")
("scheduled-run-data", "kind", "Data")
("scheduled-run-data", "type", "Published invocation with receipt reference")
("scheduled-run-data", "description", "The indexed receipt supplies the invocation ID, outcome and receipt file coordinates for this run.")
("scheduled-run-data", "target", "run-receipt-binding")
("scheduled-run-data", "relation", "Opens via")
("scheduled-run-data", "source", "applications/appdev-projects/managers.encounter")
("scheduled-run-data", "lines", "466–477")
("scheduled-run-data", "excerpt", "process services.runs:\n  call files.publishedReceipts\n  let published = map($result, \"receipt\", $receipt.run)\n  let indexed = filter($receiptFiles, \"file\", at($file, \"execution\"))\n  let scheduled = map($indexed, \"file\", {\n    id = concat(\"systemd-invocation:\", $file.execution.invocationId);\n    name = $file.execution.service; state = if(eq($file.execution.result, \"success\"), \"Succeeded\", concat(\"Failed · \", $file.execution.result));\n    detail = \"Published receipt for a scheduled systemd execution.\";\n    started = concat($file.execution.started, \" AWST\"); duration = concat($file.execution.duration, \" seconds\");\n    receipt = $file.id; receiptFolder = $file.parent; receiptPath = $file.path\n  })\n  let result = append($published, $scheduled)")
("scheduled-receipt-source", "label", "Scheduled receipt rendering")
("scheduled-receipt-source", "kind", "Source")
("scheduled-receipt-source", "type", "Encounter REL receipt renderer")
("scheduled-receipt-source", "description", "The receipt is REL data. The Encounter renderer chooses the REL viewer and displays the receipt facts.")
("scheduled-receipt-source", "source", "applications/appdev-projects/managers.encounter")
("scheduled-receipt-source", "lines", "391–410")
("scheduled-receipt-source", "excerpt", "process files.content:\n  let result = null\n  let image = at($file, \"imagePreview\")\n  when $image:\n    let result = { tag = \"section\"; attrs = { class = \"file-image-preview\"; \"aria-label\" = \"Image preview\" }; children = list(\n      { tag = \"h4\"; children = list(\"Image preview\") },\n      { tag = \"img\"; attrs = { src = $image; alt = $file.name; decoding = \"async\" } }\n    ) }\n  when at($file, \"text\"):\n    let viewer = at($file, \"rel\")\n    let result = { tag = \"pre\"; children = list($file.text) }\n    when $viewer:\n      call files.relViewer\n    when not($viewer):\n      let plain = $result\n      call files.type\n      let encounter = eq($result.id, \"encounter\")\n      let result = $plain\n      when $encounter:\n        call files.encounterViewer")
("schedule-case", "label", "Last execution flow")
("schedule-case", "flow", "timer-selection timer-data invocation-match invocation-click invocation-event")
("scheduled-run-case", "label", "Scheduled run receipt flow")
("scheduled-run-case", "flow", "scheduled-run-data run-receipt-binding run-open")


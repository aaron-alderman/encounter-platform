process-module "temple/surface-process-module/1"

process ui.styles:
  let styles = list(
    { selector = "*"; declarations = { "box-sizing" = "border-box" } },
    { selector = "body"; declarations = { margin = "0"; "font-family" = "system-ui,sans-serif"; "line-height" = "1.5" } },
    { selector = "h1,h2,h3"; declarations = { "line-height" = "1.25"; "overflow-wrap" = "anywhere" } },
    { selector = ".links"; declarations = { display = "flex"; "flex-wrap" = "wrap"; gap = "6px 16px" } },
    { selector = ".field"; declarations = { margin = "12px 0" } },
    { selector = ".field label"; declarations = { margin = "0 0 4px" } },
    { selector = "label"; declarations = { display = "grid"; gap = "4px"; "font-weight" = "600" } },
    { selector = "input,textarea,select,button"; declarations = { font = "inherit"; "max-width" = "100%"; "min-width" = "0" } },
    { selector = "input:not([type=checkbox]),textarea,select"; declarations = { width = "100%"; padding = "7px 9px" } },
    { selector = "input[type=checkbox]"; declarations = { width = "20px"; height = "20px"; "vertical-align" = "middle" } },
    { selector = "textarea,pre,code"; declarations = { "font-family" = "ui-monospace,monospace"; "font-size" = ".875rem"; "overflow-wrap" = "anywhere"; "tab-size" = "2" } },
    { selector = "textarea,pre"; declarations = { "white-space" = "pre-wrap" } },
    { selector = "textarea"; declarations = { resize = "vertical" } },
    { selector = "summary"; declarations = { cursor = "pointer"; padding = "8px 0"; "font-weight" = "600"; "overflow-wrap" = "anywhere" } },
    { selector = "table"; declarations = { "table-layout" = "fixed" } },
    { selector = "th,td"; declarations = { "overflow-wrap" = "anywhere"; "white-space" = "pre-wrap" } },
    { selector = "caption"; declarations = { "font-weight" = "bold" } },
    { selector = ".skip"; declarations = { position = "absolute"; left = "12px"; top = "8px"; transform = "translateY(-180%)"; "z-index" = "2"; background = "white"; padding = "8px" } },
    { selector = ".skip:focus"; declarations = { transform = "none" } },
    { selector = ":focus-visible"; declarations = { outline = "2px dashed var(--sourcery-accent)"; "outline-offset" = "2px" } },

    { selector = ".authoring"; declarations = { "--authoring-gutter" = "clamp(10px,2vw,24px)"; display = "grid"; "grid-template-rows" = "auto auto minmax(min-content,1fr) auto"; "min-height" = "calc(100dvh - 2 * var(--authoring-gutter))"; "max-width" = "88rem"; margin = "var(--authoring-gutter) auto"; width = "calc(100% - 2 * var(--authoring-gutter))"; border = "var(--sourcery-window-frame-width) solid var(--sourcery-frame)"; background = "var(--sourcery-frame)"; color = "var(--sourcery-ink)"; font = "14px/1.5 var(--sourcery-font)"; "accent-color" = "var(--sourcery-accent)"; "box-shadow" = "var(--sourcery-raised),var(--sourcery-window-shadow)" } },
    { selector = "html:has(>body.authoring)"; declarations = { "background-color" = "#225b6e"; "background-image" = "var(--sourcery-desktop)" } },
    { selector = ".workspace-titlebar"; declarations = { color = "var(--sourcery-title-ink)"; background = "var(--sourcery-title)"; padding = "5px 9px"; "font-size" = "1rem"; "line-height" = "1.35" } },
    { selector = ".authoring .workspace-toolbar"; declarations = { display = "flex"; "flex-wrap" = "wrap"; gap = "3px"; padding = "4px 2px"; "align-items" = "center" } },
    { selector = ".authoring .workspace-toolbar a,.authoring button"; declarations = { display = "inline-flex"; "align-items" = "center"; "min-height" = "32px"; padding = "4px 9px"; color = "var(--sourcery-ink)"; background = "var(--sourcery-frame)"; "box-shadow" = "var(--sourcery-raised)"; border = "0"; "border-radius" = "0"; "text-decoration" = "none" } },
    { selector = ".authoring .workspace-toolbar a:hover,.authoring button:hover"; declarations = { background = "var(--sourcery-selected)" } },
    { selector = ".authoring .workspace-toolbar a[aria-current]"; declarations = { color = "var(--sourcery-accent)"; background = "var(--sourcery-selected)"; "box-shadow" = "var(--sourcery-inset)"; "font-weight" = "700" } },
    { selector = ".authoring a"; declarations = { color = "var(--sourcery-accent)"; "text-underline-offset" = ".18em" } },
    { selector = ".authoring main"; declarations = { "min-width" = "0"; padding = "clamp(10px,2vw,22px)"; background = "var(--sourcery-paper)"; "box-shadow" = "var(--sourcery-inset)"; "overflow-wrap" = "anywhere" } },
    { selector = ".authoring h1"; declarations = { "font-size" = "clamp(1.35rem,3vw,1.85rem)"; margin = "12px 0 8px" } },
    { selector = ".authoring h2"; declarations = { "font-size" = "1.12rem"; color = "var(--sourcery-accent)"; margin = "0 0 8px" } },
    { selector = ".authoring h3"; declarations = { "font-size" = "1rem"; margin = "12px 0 6px" } },
    { selector = ".authoring form,.authoring section,.authoring blockquote"; declarations = { "min-width" = "0"; background = "var(--sourcery-panel)"; border = "1px solid var(--sourcery-line)"; padding = "clamp(10px,1.6vw,18px)"; margin = "12px 0" } },
    { selector = ".authoring .notice"; declarations = { margin = "0 0 12px" } },
    { selector = ".authoring .hint,.authoring small"; declarations = { color = "var(--sourcery-muted)" } },
    { selector = ".authoring .purpose"; declarations = { "min-width" = "0"; border = "1px solid var(--sourcery-line)"; padding = "8px 10px"; margin = "12px 0 6px" } },
    { selector = ".authoring input:not([type=checkbox]),.authoring textarea,.authoring select"; declarations = { border = "0"; background = "var(--sourcery-paper)"; "box-shadow" = "var(--sourcery-inset)"; color = "var(--sourcery-ink)" } },
    { selector = ".authoring button"; declarations = { cursor = "pointer"; "font-weight" = "700"; margin = "8px 8px 0 0" } },
    { selector = ".authoring button:disabled"; declarations = { cursor = "default"; color = "var(--sourcery-muted)" } },
    { selector = ".authoring button.secondary"; declarations = { "font-weight" = "400" } },
    { selector = ".authoring pre"; declarations = { margin = "6px 0 10px"; padding = "10px"; background = "var(--sourcery-paper)"; "box-shadow" = "var(--sourcery-inset)" } },
    { selector = ".workspace-statusbar"; declarations = { margin = "3px 0 0"; padding = "3px 8px"; "box-shadow" = "var(--sourcery-inset)"; color = "var(--sourcery-muted)"; "font-size" = ".8rem" } },
    { selector = ".workspace-statusbar .revision"; declarations = { margin = "0" } },

    { selector = ".authoring-inspector"; declarations = { height = "calc(100dvh - 2 * var(--authoring-gutter))"; "min-height" = "0"; "grid-template-rows" = "auto auto minmax(0,1fr) auto" } },
    { selector = ".authoring-inspector main"; declarations = { display = "flex"; "flex-direction" = "column"; "min-height" = "0"; overflow = "hidden"; padding = "clamp(6px,1.2vw,16px)" } },
    { selector = ".inspector-workbench"; declarations = { flex = "1"; display = "grid"; "grid-template-rows" = "auto minmax(0,1fr)"; "min-height" = "0"; "min-width" = "0"; gap = "6px" } },
    { selector = ".inspection-heading"; declarations = { display = "flex"; "align-items" = "baseline"; "flex-wrap" = "wrap"; gap = "0 12px" } },
    { selector = ".inspection-heading h1,.inspection-heading p"; declarations = { margin = "0" } },
    { selector = ".inspection-apps"; declarations = { "margin-inline-start" = "auto"; gap = "4px 10px" } },
    { selector = ".inspection-apps [aria-current]"; declarations = { "font-weight" = "700"; "border-bottom" = "2px solid currentColor" } },
    { context = " (max-width: 42rem)"; selector = ".inspection-apps"; declarations = { "flex-basis" = "100%"; "margin-inline-start" = "0" } },
    { selector = ".inspection-heading p"; declarations = { color = "var(--sourcery-muted)"; "font-size" = ".85rem" } },
    { selector = ".inspection-layout"; declarations = { display = "grid"; "grid-template-columns" = "minmax(13rem,30%) minmax(0,1fr)"; "min-height" = "0"; "min-width" = "0"; gap = "6px"; padding = "4px"; background = "var(--sourcery-frame)" } },
    { selector = ".authoring .inspection-layout > section"; declarations = { margin = "0"; padding = "8px"; "min-height" = "0"; background = "var(--sourcery-paper)"; "box-shadow" = "var(--sourcery-inset)" } },
    { selector = ".inspection-navigation"; declarations = { display = "grid"; "grid-template-rows" = "auto auto minmax(0,1fr)" } },
    { selector = ".inspection-tree-scroll,.inspection-detail"; declarations = { "min-height" = "0"; "min-width" = "0"; overflow = "auto"; "overscroll-behavior" = "contain"; "scrollbar-gutter" = "stable" } },
    { selector = ".inspection-tree-scroll"; declarations = { "grid-row" = "3"; "padding-inline" = "4px"; "padding-block" = "4px" } },
    { selector = ".inspection-layout h2"; declarations = { background = "var(--sourcery-panel)"; "border-bottom" = "1px solid var(--sourcery-line)"; padding = "4px 6px" } },
    { selector = ".inspection-layout dt"; declarations = { "font-weight" = "600" } },
    { selector = ".inspection-layout dd"; declarations = { margin = "0 0 8px" } },
    { selector = ".inspection-flow ol"; declarations = { "padding-inline-start" = "1.25rem" } },
    { selector = ".inspection-variants"; declarations = { gap = "4px 10px"; "padding-block-end" = "4px" } },
    { selector = ".inspection-variants [aria-current]"; declarations = { "border-bottom" = "2px solid currentColor" } },
    { selector = ".inspection-layout a[aria-current]"; declarations = { background = "var(--sourcery-selected)"; "font-weight" = "700" } },
    { selector = ".inspection-branches,.inspection-branches ul"; declarations = { "list-style" = "none"; padding = "0"; margin = "0" } },
    { selector = ".inspection-branches ul"; declarations = { "padding-inline-start" = ".85rem"; "margin-inline-start" = ".5rem"; "border-inline-start" = "1px dotted var(--sourcery-muted)" } },
    { selector = ".inspection-branches li"; declarations = { position = "relative"; "margin-block" = "2px" } },
    { selector = ".inspection-branches ul > li::before"; declarations = { content = "''"; position = "absolute"; "inset-inline-start" = "-.85rem"; "inset-block-start" = ".8rem"; width = ".7rem"; "border-block-start" = "1px dotted var(--sourcery-muted)"; "pointer-events" = "none" } },
    { selector = ".inspection-branches summary"; declarations = { display = "flex"; "align-items" = "baseline"; gap = "4px"; padding = "2px 0"; "list-style" = "none"; "font-weight" = "400" } },
    { selector = ".inspection-branches summary::-webkit-details-marker"; declarations = { display = "none" } },
    { selector = ".inspection-toggle"; declarations = { display = "inline-grid"; "place-items" = "center"; flex = "0 0 1rem"; height = "1rem"; border = "1px solid var(--sourcery-table-frame)"; color = "var(--sourcery-accent)"; background = "var(--sourcery-panel)"; font = "bold .85rem/1 monospace" } },
    { selector = ".inspection-toggle::before"; declarations = { content = "'+'" } },
    { selector = ".inspection-branches details[open] > summary .inspection-toggle::before"; declarations = { content = "'−'" } },
    { selector = ".inspection-branches a"; declarations = { "overflow-wrap" = "anywhere" } },
    { selector = ".inspection-source-location"; declarations = { "margin-block-end" = "4px"; "overflow-wrap" = "anywhere" } },
    { selector = ".authoring .inspection-detail .source-widget-read"; declarations = { margin = "4px 0 0"; padding = "0"; "box-shadow" = "none"; "white-space" = "pre"; "max-width" = "100%"; "overflow-x" = "auto"; "overscroll-behavior-x" = "contain"; font = "13px/1.55 monospace"; "tab-size" = "2" } },
    { context = " (max-width: 42rem)"; selector = ".inspection-layout"; declarations = { "grid-template-columns" = "minmax(0,1fr)"; "grid-template-rows" = "minmax(0,9fr) minmax(0,11fr)" } },
    { context = " (max-width: 42rem)"; selector = ".authoring .workspace-toolbar a,.authoring button"; declarations = { "min-height" = "40px" } },
    { context = " (max-width: 42rem)"; selector = ".authoring-inspector"; declarations = { "--authoring-gutter" = "6px" } },
    { context = " (max-width: 42rem)"; selector = ".authoring-inspector .workspace-toolbar a"; declarations = { "min-height" = "34px"; padding = "3px 7px" } },
    { context = " (max-width: 42rem)"; selector = ".inspection-variants"; declarations = { gap = "2px 7px"; "font-size" = ".85rem" } },
    { context = " (max-height: 32rem)"; selector = ".inspection-heading h1"; declarations = { "font-size" = "1.1rem" } },

    { selector = ".harbour-guide header,.harbour-guide main,.harbour-guide footer"; declarations = { "max-width" = "1100px"; margin = "auto"; padding = "24px clamp(18px,4vw,48px)" } },
    { selector = ".harbour-guide nav"; declarations = { display = "flex"; "flex-wrap" = "wrap" } },
    { selector = ".harbour-guide a"; declarations = { color = "#205b53" } },
    { selector = ".harbour-guide form,.harbour-guide section"; declarations = { padding = "clamp(16px,3vw,28px)"; margin = "20px 0" } },
    { selector = ".harbour-guide button"; declarations = { color = "white"; border = "0"; padding = "11px 18px"; cursor = "pointer"; "font-weight" = "600"; margin = "8px 8px 0 0" } },
    { selector = ".harbour-guide input,.harbour-guide select,.harbour-guide textarea"; declarations = { border = "1px solid #718880"; "border-radius" = "6px" } },
    { selector = ".harbour-guide"; declarations = { "background" = "#eef3f3"; "color" = "#172e35"; "line-height" = "1.45" } },
    { selector = ".harbour-guide header"; declarations = { "max-width" = "none"; "background" = "#10333d"; "color" = "#f4fbf7"; "padding" = "20px max(24px, calc((100% - 1080px)/2)) 0"; "border" = "0" } },
    { selector = ".harbour-guide .brand"; declarations = { "font" = "700 20px/1.2 system-ui,sans-serif"; "letter-spacing" = "-.03em" } },
    { selector = ".harbour-guide header p"; declarations = { "color" = "#abe2d3"; "font-size" = "11px"; "font-weight" = "700"; "letter-spacing" = ".12em"; "margin" = "5px 0" } },
    { selector = ".harbour-guide header nav"; declarations = { "gap" = "4px 12px"; "margin-top" = "12px" } },
    { selector = ".harbour-guide header a"; declarations = { "color" = "#dcecea"; "padding" = "10px 12px"; "border-radius" = "7px 7px 0 0"; "text-decoration" = "none"; "font-size" = "14px" } },
    { selector = ".harbour-guide header [aria-current=page]"; declarations = { "background" = "#eef3f3"; "color" = "#123d43" } },
    { selector = ".harbour-guide main"; declarations = { "max-width" = "1128px"; "padding" = "18px clamp(16px,3vw,30px) 22px" } },
    { selector = ".harbour-guide h1"; declarations = { "font" = "700 clamp(32px,5vw,57px)/1.05 Georgia,serif"; "letter-spacing" = "-.045em"; "margin" = "6px 0 10px" } },
    { selector = ".harbour-guide h2"; declarations = { "font" = "650 clamp(21px,3vw,30px)/1.14 Georgia,serif"; "margin" = "5px 0 10px" } },
    { selector = ".harbour-guide h3"; declarations = { "margin" = "0 0 5px"; "font-size" = "18px" } },
    { selector = ".harbour-guide .notice"; declarations = { "border-left" = "3px solid #007362"; "background" = "#dbeee9"; "padding" = "8px 12px"; "margin" = "0 0 5px"; "font-size" = "14px" } },
    { selector = ".harbour-guide .guide-notice-warning"; declarations = { "background" = "#fff0d8"; "color" = "#6b4119"; "border-left-color" = "#a26931" } },
    { selector = ".harbour-guide .revision"; declarations = { "margin" = "0 0 16px"; "font-size" = "12px" } },
    { selector = ".guide-kicker"; declarations = { "color" = "#4c646a"; "font-size" = "12px"; "font-weight" = "750"; "letter-spacing" = ".105em"; "text-transform" = "uppercase"; "margin" = "0" } },
    { selector = ".guide-intro p:last-child"; declarations = { "margin" = "0 0 20px"; "color" = "#4a6167" } },
    { selector = ".guide-metrics,.guide-columns"; declarations = { "display" = "grid"; "gap" = "12px"; "grid-template-columns" = "repeat(auto-fit,minmax(min(100%,240px),1fr))"; "align-items" = "start" } },
    { selector = ".guide-columns"; declarations = { "margin-top" = "14px"; "grid-template-columns" = "repeat(auto-fit,minmax(min(100%,345px),1fr))" } },
    { selector = ".guide-metric"; declarations = { "background" = "#fcfefd"; "border" = "1px solid #cbd9d7"; "border-radius" = "10px"; "padding" = "13px 16px"; "display" = "grid"; "gap" = "4px" } },
    { selector = ".guide-metric strong"; declarations = { "font-size" = "22px" } },
    { selector = ".guide-metric[data-tone=wait],.guide-gate[data-tone=wait]"; declarations = { "background" = "#fff0d8"; "border-color" = "#e3c89d"; "color" = "#6b4119" } },
    { selector = ".guide-metric[data-tone=good],.guide-gate[data-tone=good]"; declarations = { "background" = "#e0f3eb"; "border-color" = "#add8c9"; "color" = "#075a47" } },
    { selector = ".guide-card"; declarations = { "border" = "1px solid #cbd9d7"; "background" = "#fcfefd"; "border-radius" = "12px"; "padding" = "clamp(14px,2.4vw,23px)"; "margin" = "0"; "min-width" = "0" } },
    { selector = ".guide-preview"; declarations = { "background" = "#10333d"; "border-color" = "#10333d"; "color" = "#f4fbf7" } },
    { selector = ".guide-preview h2"; declarations = { "font-size" = "clamp(25px,4vw,38px)"; "letter-spacing" = "-.025em"; "text-wrap" = "pretty" } },
    { selector = ".guide-preview .guide-kicker,.guide-preview a"; declarations = { "color" = "#abe2d3" } },
    { selector = ".guide-link"; declarations = { "display" = "block"; "margin-top" = "8px"; "font-weight" = "600" } },
    { selector = ".guide-gate"; declarations = { "padding" = "9px 11px"; "border-radius" = "7px"; "border" = "1px solid transparent"; "margin" = "8px 0 12px"; "font-weight" = "650" } },
    { selector = ".harbour-guide .guide-publish form"; declarations = { "background" = "transparent"; "border" = "0"; "padding" = "0"; "margin" = "10px 0" } },
    { selector = ".harbour-guide .guide-publish form>.hint,.harbour-guide .guide-publish form>.field:has([readonly])"; declarations = { "display" = "none" } },
    { selector = ".harbour-guide .purpose"; declarations = { "padding-top" = "8px"; "margin" = "8px 0 4px" } },
    { selector = ".harbour-guide .purpose .field"; declarations = { "margin" = "7px 0" } },
    { selector = ".harbour-guide .purpose input"; declarations = { "padding" = "5px 8px"; "font-size" = "14px" } },
    { selector = ".harbour-guide .purpose label"; declarations = { "margin-bottom" = "3px" } },
    { selector = ".harbour-guide button"; declarations = { "background" = "#087362"; "border-radius" = "8px" } },
    { selector = ".harbour-guide textarea[name=code],.harbour-guide pre"; declarations = { "background" = "#102933"; "color" = "#d7f8eb"; "font-size" = "clamp(13px,1.65vw,18px)"; "padding" = "15px"; "border-radius" = "9px" } },
    { selector = ".harbour-guide form[data-operation=action]"; declarations = { "background" = "#fcfefd"; "padding" = "14px 20px"; "margin" = "12px 0" } },
    { selector = ".harbour-guide form[data-operation=action]>.field:has(input[name=id]),.harbour-guide form[data-operation=action]>.field:has(input[name=label])"; declarations = { "display" = "inline-block"; "width" = "min(100%,240px)"; "margin" = "0 10px 0 0" } },
    { selector = ".harbour-guide form[data-operation=action]>.field:has(select)"; declarations = { "display" = "inline-block"; "width" = "min(100%,130px)"; "margin" = "0 10px 0 0" } }
  )
  fold $styles as style; rules starts list():
    port record.entries { value = $style.declarations } → entries
    let declarations = map($entries, "entry", { property = at($entry, 0); value = at($entry, 1) })
    yield append($rules, list({ selector = $style.selector; context = $style.context; declarations = $declarations })) → rules
  let cssPlan = { imports = list(); tokens = list(); rules = $rules }
  call css.renderPlan
  let applicationStyles = $result
  call sourcery.presentation.tokens
  let platformTokens = $result
  call sourcery.presentation.feedbackStyles
  let feedbackStyles = $result
  call sourcery.presentation.dataTableStyles
  let dataTableStyles = $result
  call source.encounterLightPolicy
  let spPolicy = $result.presentation
  call sp.style
  let result = concat($platformTokens, $feedbackStyles, $dataTableStyles, $result, $applicationStyles)

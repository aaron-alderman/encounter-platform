("claim.claimipedia.radicalKenosis.costFork", "isa", "Claim", "is")
("claim.claimipedia.radicalKenosis.costFork", "identifier", "clm_RADICAL_KENOSIS_COST_FORK", "is")
("claim.claimipedia.radicalKenosis.costFork", "currentVersion", "claimVersion.claimipedia.radicalKenosis.costFork.v1", "is")
("claim.claimipedia.radicalKenosis.costFork", "status", "active", "is")
("claimVersion.claimipedia.radicalKenosis.costFork.v1", "isa", "ClaimVersion", "is")
("claimVersion.claimipedia.radicalKenosis.costFork.v1", "claim", "claim.claimipedia.radicalKenosis.costFork", "is")
("claimVersion.claimipedia.radicalKenosis.costFork.v1", "version", "1", "is")
("claimVersion.claimipedia.radicalKenosis.costFork.v1", "expression", "After we have done all we can to prevent or repair a loss, the remaining cost is either carried or pushed onto someone else.", "is")
("claimVersion.claimipedia.radicalKenosis.costFork.v1", "claimType", "Definitional", "is")
("claimVersion.claimipedia.radicalKenosis.costFork.v1", "scope", "The claim concerns the cost left at the end. It does not deny that prevention, sharing, repair, or deep change can reduce the cost first.", "is")
("claimVersion.claimipedia.radicalKenosis.costFork.v1", "immutable", "true", "is")
("claimVersion.claimipedia.radicalKenosis.costFork.v1", "changeKind", "Initial", "is")
("claimVersion.claimipedia.radicalKenosis.costFork.v1", "createdAt", "2026-10-06T04:00:00.000Z", "is")
("claimVersion.claimipedia.radicalKenosis.costFork.v1", "createdBy", "actor.claimipedia.author", "is")
("claim.claimipedia.radicalKenosis.trustTradeoff", "isa", "Claim", "is")
("claim.claimipedia.radicalKenosis.trustTradeoff", "identifier", "clm_RADICAL_KENOSIS_TRUST_TRADEOFF", "is")
("claim.claimipedia.radicalKenosis.trustTradeoff", "currentVersion", "claimVersion.claimipedia.radicalKenosis.trustTradeoff.v1", "is")
("claim.claimipedia.radicalKenosis.trustTradeoff", "status", "active", "is")
("claimVersion.claimipedia.radicalKenosis.trustTradeoff.v1", "isa", "ClaimVersion", "is")
("claimVersion.claimipedia.radicalKenosis.trustTradeoff.v1", "claim", "claim.claimipedia.radicalKenosis.trustTradeoff", "is")
("claimVersion.claimipedia.radicalKenosis.trustTradeoff.v1", "version", "1", "is")
("claimVersion.claimipedia.radicalKenosis.trustTradeoff.v1", "expression", "Passing cost to others may protect our control, but it harms trust. Freely carrying cost can protect trust, but it limits our control.", "is")
("claimVersion.claimipedia.radicalKenosis.trustTradeoff.v1", "claimType", "Causal", "is")
("claimVersion.claimipedia.radicalKenosis.trustTradeoff.v1", "scope", "This describes a general pattern. Evidence is needed to show when and how strongly it applies in relationships, institutions, and societies.", "is")
("claimVersion.claimipedia.radicalKenosis.trustTradeoff.v1", "immutable", "true", "is")
("claimVersion.claimipedia.radicalKenosis.trustTradeoff.v1", "changeKind", "Initial", "is")

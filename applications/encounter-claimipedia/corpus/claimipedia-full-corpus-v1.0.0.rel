("claimVersion.claimipedia.radicalKenosis.alternativeTypeFailure.v1", "createdBy", "actor.claimipedia.author", "is")
("claim.claimipedia.radicalKenosis.jesusConvergence", "isa", "Claim", "is")
("claim.claimipedia.radicalKenosis.jesusConvergence", "identifier", "clm_RADICAL_KENOSIS_JESUS_CONVERGENCE", "is")
("claim.claimipedia.radicalKenosis.jesusConvergence", "currentVersion", "claimVersion.claimipedia.radicalKenosis.jesusConvergence.v1", "is")
("claim.claimipedia.radicalKenosis.jesusConvergence", "status", "active", "is")
("claimVersion.claimipedia.radicalKenosis.jesusConvergence.v1", "isa", "ClaimVersion", "is")
("claimVersion.claimipedia.radicalKenosis.jesusConvergence.v1", "claim", "claim.claimipedia.radicalKenosis.jesusConvergence", "is")
("claimVersion.claimipedia.radicalKenosis.jesusConvergence.v1", "version", "1", "is")
("claimVersion.claimipedia.radicalKenosis.jesusConvergence.v1", "expression", "Jesus matches the test in a striking way: he enters human life, refuses control and revenge, freely carries violence, dies, and is claimed to rise.", "is")
("claimVersion.claimipedia.radicalKenosis.jesusConvergence.v1", "claimType", "Descriptive", "is")
("claimVersion.claimipedia.radicalKenosis.jesusConvergence.v1", "scope", "This claim identifies Jesus as a strong match. The match does not prove that the Gospel accounts are true or that no other candidate has been missed.", "is")
("claimVersion.claimipedia.radicalKenosis.jesusConvergence.v1", "immutable", "true", "is")
("claimVersion.claimipedia.radicalKenosis.jesusConvergence.v1", "changeKind", "Initial", "is")
("claimVersion.claimipedia.radicalKenosis.jesusConvergence.v1", "createdAt", "2026-10-06T04:00:00.000Z", "is")
("claimVersion.claimipedia.radicalKenosis.jesusConvergence.v1", "createdBy", "actor.claimipedia.author", "is")
("claim.claimipedia.radicalKenosis.historicalQuestion", "isa", "Claim", "is")
("claim.claimipedia.radicalKenosis.historicalQuestion", "identifier", "clm_RADICAL_KENOSIS_HISTORICAL_QUESTION", "is")
("claim.claimipedia.radicalKenosis.historicalQuestion", "currentVersion", "claimVersion.claimipedia.radicalKenosis.historicalQuestion.v1", "is")
("claim.claimipedia.radicalKenosis.historicalQuestion", "status", "active", "is")
("claimVersion.claimipedia.radicalKenosis.historicalQuestion.v1", "isa", "ClaimVersion", "is")
("claimVersion.claimipedia.radicalKenosis.historicalQuestion.v1", "claim", "claim.claimipedia.radicalKenosis.historicalQuestion", "is")
("claimVersion.claimipedia.radicalKenosis.historicalQuestion.v1", "version", "1", "is")
("claimVersion.claimipedia.radicalKenosis.historicalQuestion.v1", "expression", "The argument gives us a reason to ask, 'Did this happen?' It cannot answer the question. The life of Jesus and the resurrection claim need their own historical study.", "is")
("claimVersion.claimipedia.radicalKenosis.historicalQuestion.v1", "claimType", "Procedural", "is")
("claimVersion.claimipedia.radicalKenosis.historicalQuestion.v1", "scope", "This rule keeps the logical test separate from historical evidence, and historical judgment separate from personal faith.", "is")
("claimVersion.claimipedia.radicalKenosis.historicalQuestion.v1", "immutable", "true", "is")
("claimVersion.claimipedia.radicalKenosis.historicalQuestion.v1", "changeKind", "Initial", "is")

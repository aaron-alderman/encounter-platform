("claimVersion.claimipedia.games.restorativePotential.v1", "version", "1", "is")
("claimVersion.claimipedia.games.restorativePotential.v1", "expression", "Enjoyable games can sometimes support rest, psychological detachment, recovery, mastery, and social connection; the benefit is conditional on the player, game, timing, context, and relation between play and the rest of life.", "is")
("claimVersion.claimipedia.games.restorativePotential.v1", "claimType", "Descriptive", "is")
("claimVersion.claimipedia.games.restorativePotential.v1", "scope", "Evidence-backed conditional claim; not a claim that all games, players, durations, or outcomes are beneficial.", "is")
("claimVersion.claimipedia.games.restorativePotential.v1", "immutable", "true", "is")
("claimVersion.claimipedia.games.restorativePotential.v1", "changeKind", "Initial", "is")

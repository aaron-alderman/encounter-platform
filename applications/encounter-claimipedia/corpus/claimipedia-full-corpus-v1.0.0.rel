("claim.claimipedia.radicalKenosis.alternativeTypeFailure", "isa", "Claim", "is")
("claim.claimipedia.radicalKenosis.alternativeTypeFailure", "identifier", "clm_RADICAL_KENOSIS_ALTERNATIVE_TYPE_FAILURE", "is")
("claim.claimipedia.radicalKenosis.alternativeTypeFailure", "currentVersion", "claimVersion.claimipedia.radicalKenosis.alternativeTypeFailure.v1", "is")
("claim.claimipedia.radicalKenosis.alternativeTypeFailure", "status", "active", "is")
("claimVersion.claimipedia.radicalKenosis.alternativeTypeFailure.v1", "isa", "ClaimVersion", "is")
("claimVersion.claimipedia.radicalKenosis.alternativeTypeFailure.v1", "claim", "claim.claimipedia.radicalKenosis.alternativeTypeFailure", "is")
("claimVersion.claimipedia.radicalKenosis.alternativeTypeFailure.v1", "version", "1", "is")
("claimVersion.claimipedia.radicalKenosis.alternativeTypeFailure.v1", "expression", "Ethics, rules, markets, institutions, AI, and impersonal ideas about reality can all help with sacrifice, but the argument says none meets every part of the test.", "is")
("claimVersion.claimipedia.radicalKenosis.alternativeTypeFailure.v1", "claimType", "Descriptive", "is")
("claimVersion.claimipedia.radicalKenosis.alternativeTypeFailure.v1", "scope", "This comparison does not dismiss the real good done by human or non-Christian practices. It asks whether any one of them can meet the whole test.", "is")
("claimVersion.claimipedia.radicalKenosis.alternativeTypeFailure.v1", "immutable", "true", "is")
("claimVersion.claimipedia.radicalKenosis.alternativeTypeFailure.v1", "changeKind", "Initial", "is")

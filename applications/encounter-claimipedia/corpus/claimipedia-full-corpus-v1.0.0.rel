("claim.claimipedia.radicalKenosis.aiCannotSacrifice", "currentVersion", "claimVersion.claimipedia.radicalKenosis.aiCannotSacrifice.v1", "is")
("claim.claimipedia.radicalKenosis.aiCannotSacrifice", "status", "active", "is")
("claimVersion.claimipedia.radicalKenosis.aiCannotSacrifice.v1", "isa", "ClaimVersion", "is")
("claimVersion.claimipedia.radicalKenosis.aiCannotSacrifice.v1", "claim", "claim.claimipedia.radicalKenosis.aiCannotSacrifice", "is")
("claimVersion.claimipedia.radicalKenosis.aiCannotSacrifice.v1", "version", "1", "is")
("claimVersion.claimipedia.radicalKenosis.aiCannotSacrifice.v1", "expression", "AI can move, reduce, or hide visible costs. It cannot freely suffer or take moral responsibility. A named person or institution must still answer for what an AI system does.", "is")
("claimVersion.claimipedia.radicalKenosis.aiCannotSacrifice.v1", "claimType", "Normative", "is")
("claimVersion.claimipedia.radicalKenosis.aiCannotSacrifice.v1", "scope", "This claim concerns today's AI systems and moral responsibility. It does not settle what every possible future machine could become.", "is")
("claimVersion.claimipedia.radicalKenosis.aiCannotSacrifice.v1", "immutable", "true", "is")
("claimVersion.claimipedia.radicalKenosis.aiCannotSacrifice.v1", "changeKind", "Initial", "is")
("claimVersion.claimipedia.radicalKenosis.aiCannotSacrifice.v1", "createdAt", "2026-10-06T04:00:00.000Z", "is")
("claimVersion.claimipedia.radicalKenosis.aiCannotSacrifice.v1", "createdBy", "actor.claimipedia.author", "is")
("claim.claimipedia.radicalKenosis.trajectory", "isa", "Claim", "is")
("claim.claimipedia.radicalKenosis.trajectory", "identifier", "clm_RADICAL_KENOSIS_TRAJECTORY", "is")
("claim.claimipedia.radicalKenosis.trajectory", "currentVersion", "claimVersion.claimipedia.radicalKenosis.trajectory.v1", "is")
("claim.claimipedia.radicalKenosis.trajectory", "status", "active", "is")
("claimVersion.claimipedia.radicalKenosis.trajectory.v1", "isa", "ClaimVersion", "is")
("claimVersion.claimipedia.radicalKenosis.trajectory.v1", "claim", "claim.claimipedia.radicalKenosis.trajectory", "is")
("claimVersion.claimipedia.radicalKenosis.trajectory.v1", "version", "1", "is")
("claimVersion.claimipedia.radicalKenosis.trajectory.v1", "expression", "Heaven and hell can be understood as directions that begin now. Freely carrying cost can grow our ability to love, while repeatedly pushing cost onto others can close us around self-protection.", "is")
("claimVersion.claimipedia.radicalKenosis.trajectory.v1", "claimType", "Descriptive", "is")
("claimVersion.claimipedia.radicalKenosis.trajectory.v1", "scope", "This is one way to understand heaven and hell in present life. It does not settle every Christian claim about judgment, resurrection, or the renewal of creation.", "is")
("claimVersion.claimipedia.radicalKenosis.trajectory.v1", "immutable", "true", "is")
("claimVersion.claimipedia.radicalKenosis.trajectory.v1", "changeKind", "Initial", "is")
("claimVersion.claimipedia.radicalKenosis.trajectory.v1", "createdAt", "2026-10-06T04:00:00.000Z", "is")
("claimVersion.claimipedia.radicalKenosis.trajectory.v1", "createdBy", "actor.claimipedia.author", "is")
("claim.claimipedia.radicalKenosis.challengeFalseDichotomy", "isa", "Claim", "is")
("claim.claimipedia.radicalKenosis.challengeFalseDichotomy", "identifier", "clm_RADICAL_KENOSIS_CHALLENGE_FALSE_DICHOTOMY", "is")
("claim.claimipedia.radicalKenosis.challengeFalseDichotomy", "currentVersion", "claimVersion.claimipedia.radicalKenosis.challengeFalseDichotomy.v1", "is")
("claim.claimipedia.radicalKenosis.challengeFalseDichotomy", "status", "active", "is")
("claimVersion.claimipedia.radicalKenosis.challengeFalseDichotomy.v1", "isa", "ClaimVersion", "is")
("claimVersion.claimipedia.radicalKenosis.challengeFalseDichotomy.v1", "claim", "claim.claimipedia.radicalKenosis.challengeFalseDichotomy", "is")
("claimVersion.claimipedia.radicalKenosis.challengeFalseDichotomy.v1", "version", "1", "is")
("claimVersion.claimipedia.radicalKenosis.challengeFalseDichotomy.v1", "expression", "There may be more than two choices. Repair, sharing, delay, or deep change may remove a cost instead of merely moving it to someone else.", "is")
("claimVersion.claimipedia.radicalKenosis.challengeFalseDichotomy.v1", "claimType", "Descriptive", "is")
("claimVersion.claimipedia.radicalKenosis.challengeFalseDichotomy.v1", "scope", "This challenges the argument's starting point. The framework replies that when a truly unavoidable cost remains, someone still has to carry it.", "is")
("claimVersion.claimipedia.radicalKenosis.challengeFalseDichotomy.v1", "immutable", "true", "is")
("claimVersion.claimipedia.radicalKenosis.challengeFalseDichotomy.v1", "changeKind", "Initial", "is")
("claimVersion.claimipedia.radicalKenosis.challengeFalseDichotomy.v1", "createdAt", "2026-10-06T04:00:00.000Z", "is")
("claimVersion.claimipedia.radicalKenosis.challengeFalseDichotomy.v1", "createdBy", "actor.claimipedia.author", "is")
("claim.claimipedia.radicalKenosis.challengeFiniteSources", "isa", "Claim", "is")
("claim.claimipedia.radicalKenosis.challengeFiniteSources", "identifier", "clm_RADICAL_KENOSIS_CHALLENGE_FINITE_SOURCES", "is")
("claim.claimipedia.radicalKenosis.challengeFiniteSources", "currentVersion", "claimVersion.claimipedia.radicalKenosis.challengeFiniteSources.v1", "is")
("claim.claimipedia.radicalKenosis.challengeFiniteSources", "status", "active", "is")
("claimVersion.claimipedia.radicalKenosis.challengeFiniteSources.v1", "isa", "ClaimVersion", "is")
("claimVersion.claimipedia.radicalKenosis.challengeFiniteSources.v1", "claim", "claim.claimipedia.radicalKenosis.challengeFiniteSources", "is")
("claimVersion.claimipedia.radicalKenosis.challengeFiniteSources.v1", "version", "1", "is")
("claimVersion.claimipedia.radicalKenosis.challengeFiniteSources.v1", "expression", "Therapy, Stoic practice, friendship, community, moral training, and strong institutions may support sacrifice well enough without an infinite source beyond the world.", "is")
("claimVersion.claimipedia.radicalKenosis.challengeFiniteSources.v1", "claimType", "Descriptive", "is")
("claimVersion.claimipedia.radicalKenosis.challengeFiniteSources.v1", "scope", "This questions the move from the fact that people grow tired to the claim that an infinite source must exist.", "is")
("claimVersion.claimipedia.radicalKenosis.challengeFiniteSources.v1", "immutable", "true", "is")
("claimVersion.claimipedia.radicalKenosis.challengeFiniteSources.v1", "changeKind", "Initial", "is")

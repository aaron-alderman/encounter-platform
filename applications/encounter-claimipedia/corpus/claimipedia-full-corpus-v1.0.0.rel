("challenge.claimipedia.process.20261006.markdownOutsideCorpus", "challengeType", "ProcessFailure", "is")
("challenge.claimipedia.process.20261006.markdownOutsideCorpus", "proposition", "The first implementation stored the lightning analysis in a Markdown document outside Claimipedia's governed claim, evidence, relationship, challenge, and correction structures. That violated the requested product boundary. Correction: delete the document, retain the knowledge as canonical Claimipedia records, expose it through native claim and application surfaces, and test the live server state.", "is")
("challenge.claimipedia.process.20261006.markdownOutsideCorpus", "submittedBy", "actor.claimipedia.author", "is")

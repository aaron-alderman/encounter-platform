("claim.claimipedia.simulation.counterfactualExploration", "isa", "Claim", "is")
("claim.claimipedia.simulation.counterfactualExploration", "identifier", "clm_SIMULATION_COUNTERFACTUAL_EXPLORATION", "is")
("claim.claimipedia.simulation.counterfactualExploration", "currentVersion", "claimVersion.claimipedia.simulation.counterfactualExploration.v1", "is")
("claim.claimipedia.simulation.counterfactualExploration", "status", "active", "is")
("claim.claimipedia.simulation.counterfactualExploration", "route", "/claim/simulations-as-bounded-worlds", "is")
("claimVersion.claimipedia.simulation.counterfactualExploration.v1", "isa", "ClaimVersion", "is")
("claimVersion.claimipedia.simulation.counterfactualExploration.v1", "claim", "claim.claimipedia.simulation.counterfactualExploration", "is")
("claimVersion.claimipedia.simulation.counterfactualExploration.v1", "version", "1", "is")
("claimVersion.claimipedia.simulation.counterfactualExploration.v1", "expression", "A simulation makes a bounded world of assumptions, mechanisms, state transitions, interventions, and possible consequences inspectable; its value lies in disciplined counterfactual exploration rather than in pretending to reproduce the whole world.", "is")
("claimVersion.claimipedia.simulation.counterfactualExploration.v1", "claimType", "Definitional", "is")
("claimVersion.claimipedia.simulation.counterfactualExploration.v1", "scope", "Applies to governed analytical, educational, and game-like simulations whose rules, inputs, omissions, outputs, and version identity can be inspected.", "is")
("claimVersion.claimipedia.simulation.counterfactualExploration.v1", "standingPrinciple", "People represented, affected, absent, or simplified by a model retain equal standing and may challenge its categories and consequences.", "is")
("claimVersion.claimipedia.simulation.counterfactualExploration.v1", "boundaryPrinciple", "Observed, reconciled, forecast, scenario, proposed, and control states remain separate epistemic lanes.", "is")
("claimVersion.claimipedia.simulation.counterfactualExploration.v1", "agencyPrinciple", "A participant can inspect assumptions, vary parameters, compare branches, refuse the frame, and leave without the simulation deciding reality for them.", "is")
("claimVersion.claimipedia.simulation.counterfactualExploration.v1", "telosPrinciple", "Simulation serves understanding, preparation, play, and accountable judgement; continued engagement and model victory are not overriding ends.", "is")
("claimVersion.claimipedia.simulation.counterfactualExploration.v1", "correctionPrinciple", "Failed mechanisms, discrepant observations, omitted parties, and rival models must remain able to revise or retire the model.", "is")
("claimVersion.claimipedia.simulation.counterfactualExploration.v1", "nonEntailment", "A coherent or compelling run does not establish prediction, truth, policy authority, moral rank, or fitness for real-world control.", "is")
("claimVersion.claimipedia.simulation.counterfactualExploration.v1", "immutable", "true", "is")
("claimVersion.claimipedia.simulation.counterfactualExploration.v1", "changeKind", "Initial", "is")
("claimVersion.claimipedia.simulation.counterfactualExploration.v1", "createdAt", "2026-10-06T07:00:00.000Z", "is")
("claimVersion.claimipedia.simulation.counterfactualExploration.v1", "createdBy", "actor.claimipedia.author", "is")
("claim.claimipedia.simulation.modelWorldBoundary", "isa", "Claim", "is")
("claim.claimipedia.simulation.modelWorldBoundary", "identifier", "clm_SIMULATION_MODEL_WORLD_BOUNDARY", "is")
("claim.claimipedia.simulation.modelWorldBoundary", "currentVersion", "claimVersion.claimipedia.simulation.modelWorldBoundary.v1", "is")
("claim.claimipedia.simulation.modelWorldBoundary", "status", "active", "is")
("claim.claimipedia.simulation.modelWorldBoundary", "route", "/claim/simulation-is-not-reality", "is")
("claimVersion.claimipedia.simulation.modelWorldBoundary.v1", "isa", "ClaimVersion", "is")
("claimVersion.claimipedia.simulation.modelWorldBoundary.v1", "claim", "claim.claimipedia.simulation.modelWorldBoundary", "is")
("claimVersion.claimipedia.simulation.modelWorldBoundary.v1", "version", "1", "is")
("claimVersion.claimipedia.simulation.modelWorldBoundary.v1", "expression", "Simulation results are generated consequences within a declared model, not observations of reality; they may inform inquiry only through retained provenance, calibration, uncertainty, comparison, and a separate human authority boundary.", "is")
("claimVersion.claimipedia.simulation.modelWorldBoundary.v1", "claimType", "Procedural", "is")
("claimVersion.claimipedia.simulation.modelWorldBoundary.v1", "scope", "Epistemic and authority boundary for Sourcery simulations, digital twins, scenario workspaces, gamified projections, and games that share simulation architecture.", "is")
("claimVersion.claimipedia.simulation.modelWorldBoundary.v1", "authorityBoundary", "No simulation output authorizes a real-world intervention or returns to the fact space as observation without new evidence and admission.", "is")
("claimVersion.claimipedia.simulation.modelWorldBoundary.v1", "standingPrinciple", "A model cannot reduce human worth to a score, cohort, capability, risk, or player state.", "is")
("claimVersion.claimipedia.simulation.modelWorldBoundary.v1", "boundaryPrinciple", "Fact, interpretation, parameter, rule, generated state, recommendation, and authorized effect remain addressably distinct.", "is")
("claimVersion.claimipedia.simulation.modelWorldBoundary.v1", "agencyPrinciple", "Affected people may inspect, contest, refuse, appeal, and demand a non-simulated route to judgement.", "is")
("claimVersion.claimipedia.simulation.modelWorldBoundary.v1", "telosPrinciple", "The model serves persons and shared reality; persons do not become inputs serving model completion.", "is")
("claimVersion.claimipedia.simulation.modelWorldBoundary.v1", "correctionPrinciple", "Correction preserves the failed run and its basis, records what changed, and produces a traceable successor rather than rewriting history.", "is")
("claimVersion.claimipedia.simulation.modelWorldBoundary.v1", "nonEntailment", "The phrase 'Jesus broke the simulation' remains a disclosed theological analogy; adjacency does not establish computational cosmology or make model output theological evidence.", "is")
("claimVersion.claimipedia.simulation.modelWorldBoundary.v1", "immutable", "true", "is")
("claimVersion.claimipedia.simulation.modelWorldBoundary.v1", "changeKind", "Initial", "is")
("claimVersion.claimipedia.simulation.modelWorldBoundary.v1", "createdAt", "2026-10-06T07:01:00.000Z", "is")
("claimVersion.claimipedia.simulation.modelWorldBoundary.v1", "createdBy", "actor.claimipedia.author", "is")

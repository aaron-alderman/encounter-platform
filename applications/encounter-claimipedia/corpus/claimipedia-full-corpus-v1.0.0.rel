("claim.claimipedia.games.problematicDisplacement", "isa", "Claim", "is")
("claim.claimipedia.games.problematicDisplacement", "identifier", "clm_GAMES_PROBLEMATIC_DISPLACEMENT", "is")
("claim.claimipedia.games.problematicDisplacement", "currentVersion", "claimVersion.claimipedia.games.problematicDisplacement.v1", "is")
("claim.claimipedia.games.problematicDisplacement", "status", "active", "is")
("claimVersion.claimipedia.games.problematicDisplacement.v1", "isa", "ClaimVersion", "is")
("claimVersion.claimipedia.games.problematicDisplacement.v1", "claim", "claim.claimipedia.games.problematicDisplacement", "is")
("claimVersion.claimipedia.games.problematicDisplacement.v1", "version", "1", "is")
("claimVersion.claimipedia.games.problematicDisplacement.v1", "expression", "Gaming becomes harmful when impaired control or escalating priority persistently displaces sleep, health, relationships, education, work, vocation, or other ordinary responsibilities despite negative consequences.", "is")
("claimVersion.claimipedia.games.problematicDisplacement.v1", "claimType", "Descriptive", "is")
("claimVersion.claimipedia.games.problematicDisplacement.v1", "scope", "Uses the WHO gaming-disorder boundary and sleep-review evidence; it does not diagnose a particular person or reduce intense but non-impairing play to addiction.", "is")
("claimVersion.claimipedia.games.problematicDisplacement.v1", "immutable", "true", "is")
("claimVersion.claimipedia.games.problematicDisplacement.v1", "changeKind", "Initial", "is")
("claimVersion.claimipedia.games.problematicDisplacement.v1", "createdAt", "2026-10-06T06:01:00.000Z", "is")
("claimVersion.claimipedia.games.problematicDisplacement.v1", "createdBy", "actor.claimipedia.author", "is")
("claim.claimipedia.games.heroicRehearsalAndSubstitution", "isa", "Claim", "is")
("claim.claimipedia.games.heroicRehearsalAndSubstitution", "identifier", "clm_GAMES_HEROIC_REHEARSAL_SUBSTITUTION", "is")
("claim.claimipedia.games.heroicRehearsalAndSubstitution", "currentVersion", "claimVersion.claimipedia.games.heroicRehearsalAndSubstitution.v1", "is")
("claim.claimipedia.games.heroicRehearsalAndSubstitution", "status", "active", "is")
("claimVersion.claimipedia.games.heroicRehearsalAndSubstitution.v1", "isa", "ClaimVersion", "is")
("claimVersion.claimipedia.games.heroicRehearsalAndSubstitution.v1", "claim", "claim.claimipedia.games.heroicRehearsalAndSubstitution", "is")
("claimVersion.claimipedia.games.heroicRehearsalAndSubstitution.v1", "version", "1", "is")
("claimVersion.claimipedia.games.heroicRehearsalAndSubstitution.v1", "expression", "Games can rehearse hero-shaped agency through risk, constraint, sacrifice, mastery, cooperation, failure, and return; the same symbolic mastery can become a substitute for accepting costly responsibility in embodied life when the player ceases to return.", "is")
("claimVersion.claimipedia.games.heroicRehearsalAndSubstitution.v1", "claimType", "Descriptive", "is")
("claimVersion.claimipedia.games.heroicRehearsalAndSubstitution.v1", "scope", "Synthetic hero's-journey interpretation and failure mode; it is not a universal psychological law or a diagnosis of players.", "is")
("claimVersion.claimipedia.games.heroicRehearsalAndSubstitution.v1", "immutable", "true", "is")
("claimVersion.claimipedia.games.heroicRehearsalAndSubstitution.v1", "changeKind", "Initial", "is")

("claimVersion.claimipedia.radicalKenosis.challengeFiniteSources.v1", "createdBy", "actor.claimipedia.author", "is")
("claim.claimipedia.radicalKenosis.challengeConvergence", "isa", "Claim", "is")
("claim.claimipedia.radicalKenosis.challengeConvergence", "identifier", "clm_RADICAL_KENOSIS_CHALLENGE_CONVERGENCE", "is")
("claim.claimipedia.radicalKenosis.challengeConvergence", "currentVersion", "claimVersion.claimipedia.radicalKenosis.challengeConvergence.v1", "is")

("claim.claimipedia.games.restorativePotential", "isa", "Claim", "is")
("claim.claimipedia.games.restorativePotential", "identifier", "clm_GAMES_RESTORATIVE_POTENTIAL", "is")
("claim.claimipedia.games.restorativePotential", "currentVersion", "claimVersion.claimipedia.games.restorativePotential.v1", "is")
("claim.claimipedia.games.restorativePotential", "status", "active", "is")

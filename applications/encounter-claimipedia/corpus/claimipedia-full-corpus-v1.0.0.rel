("claim.biblicalResurrection.relationalFieldRupture", "isa", "Claim", "is")
("claim.biblicalResurrection.relationalFieldRupture", "identifier", "clm_BIBLICAL_RESURRECTION_RELATIONAL_FIELD_RUPTURE", "is")
("claim.biblicalResurrection.relationalFieldRupture", "currentVersion", "claimVersion.biblicalResurrection.relationalFieldRupture.1", "is")
("claim.biblicalResurrection.relationalFieldRupture", "status", "active", "is")
("claimVersion.biblicalResurrection.relationalFieldRupture.1", "isa", "ClaimVersion", "is")
("claimVersion.biblicalResurrection.relationalFieldRupture.1", "claim", "claim.biblicalResurrection.relationalFieldRupture", "is")
("claimVersion.biblicalResurrection.relationalFieldRupture.1", "version", "1", "is")
("claimVersion.biblicalResurrection.relationalFieldRupture.1", "expression", "A strongest-case reading of 'Jesus broke the simulation' may treat Jesus as a pole in an ontological relational field: through death and resurrection the field's death-closed pattern is ruptured, making repair newly possible by third-order influence on the landscape of relation and action.", "is")
("claimVersion.biblicalResurrection.relationalFieldRupture.1", "claimType", "Descriptive", "is")
("claimVersion.biblicalResurrection.relationalFieldRupture.1", "scope", "Speculative Christian metaphysics and relational ontology; pole, field, 1/x, singularity, and black-hole language are analogies, not mathematical identity or physical mechanism; repair is made available, not asserted to be automatic or coercive", "is")
("claimVersion.biblicalResurrection.relationalFieldRupture.1", "changeKind", "Initial", "is")
("claimVersion.biblicalResurrection.relationalFieldRupture.1", "createdBy", "actor.claimipedia.aaronAlderman", "is")
("claimVersion.biblicalResurrection.relationalFieldRupture.1", "createdAt", "2026-10-05T00:04:00.000Z", "is")
("claimVersion.biblicalResurrection.relationalFieldRupture.1", "immutable", "true", "is")
("claim.biblicalResurrection.kenoticRelationalFieldRupture", "isa", "Claim", "is")
("claim.biblicalResurrection.kenoticRelationalFieldRupture", "identifier", "clm_BIBLICAL_RESURRECTION_KENOTIC_RELATIONAL_FIELD_RUPTURE", "is")
("claim.biblicalResurrection.kenoticRelationalFieldRupture", "currentVersion", "claimVersion.biblicalResurrection.kenoticRelationalFieldRupture.1", "is")
("claim.biblicalResurrection.kenoticRelationalFieldRupture", "status", "active", "is")
("claimVersion.biblicalResurrection.kenoticRelationalFieldRupture.1", "isa", "ClaimVersion", "is")
("claimVersion.biblicalResurrection.kenoticRelationalFieldRupture.1", "claim", "claim.biblicalResurrection.kenoticRelationalFieldRupture", "is")
("claimVersion.biblicalResurrection.kenoticRelationalFieldRupture.1", "version", "1", "is")
("claimVersion.biblicalResurrection.kenoticRelationalFieldRupture.1", "expression", "On the Radical Kenosis reading, a non-depletable, non-coercive source enters the relational field of finitude, freely receives irreducible cost without assigning it to another or returning it as violence, passes through total loss without depletion, and thereby ruptures the death-closed pattern by making non-displacing participation and repair newly possible.", "is")
("claimVersion.biblicalResurrection.kenoticRelationalFieldRupture.1", "claimType", "Causal", "is")
("claimVersion.biblicalResurrection.kenoticRelationalFieldRupture.1", "scope", "Speculative Christian metaphysics and relational ontology incorporating the complete Radical Kenosis thesis: irreducible cost, the residual cost fork, trust, non-assignable sacrifice, finite depletion, source specification, Jesus convergence, the independent historical question, Christian confessional development, Pentecostal plurality, practical consequence, and four live challenges. Structural fit does not prove the resurrection; field and rupture remain analogies rather than mathematical or physical mechanisms; repair becomes possible rather than automatic.", "is")
("claimVersion.biblicalResurrection.kenoticRelationalFieldRupture.1", "authorityBoundary", "This distinct successor claim does not compel belief, turn structural convergence into historical evidence, authorize assigned suffering, erase alternative sources of sacrificial capacity, or silence the false-dichotomy, finite-source, convergence, and weaponization challenges.", "is")
("claimVersion.biblicalResurrection.kenoticRelationalFieldRupture.1", "changeKind", "Initial", "is")
("claimVersion.biblicalResurrection.kenoticRelationalFieldRupture.1", "createdBy", "actor.claimipedia.aaronAlderman", "is")
("claimVersion.biblicalResurrection.kenoticRelationalFieldRupture.1", "createdAt", "2026-10-06T10:00:00.000Z", "is")
("claimVersion.biblicalResurrection.kenoticRelationalFieldRupture.1", "immutable", "true", "is")

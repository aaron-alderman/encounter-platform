("claim.claimipedia.radicalKenosis.sacrificeNonAssignable", "isa", "Claim", "is")
("claim.claimipedia.radicalKenosis.sacrificeNonAssignable", "identifier", "clm_RADICAL_KENOSIS_SACRIFICE_NON_ASSIGNABLE", "is")
("claim.claimipedia.radicalKenosis.sacrificeNonAssignable", "currentVersion", "claimVersion.claimipedia.radicalKenosis.sacrificeNonAssignable.v1", "is")
("claim.claimipedia.radicalKenosis.sacrificeNonAssignable", "status", "active", "is")
("claimVersion.claimipedia.radicalKenosis.sacrificeNonAssignable.v1", "isa", "ClaimVersion", "is")
("claimVersion.claimipedia.radicalKenosis.sacrificeNonAssignable.v1", "claim", "claim.claimipedia.radicalKenosis.sacrificeNonAssignable", "is")
("claimVersion.claimipedia.radicalKenosis.sacrificeNonAssignable.v1", "version", "1", "is")
("claimVersion.claimipedia.radicalKenosis.sacrificeNonAssignable.v1", "expression", "Sacrifice must be freely chosen. When a person in power makes someone else carry the cost, it is not sacrifice; it is harm dressed up as virtue.", "is")
("claimVersion.claimipedia.radicalKenosis.sacrificeNonAssignable.v1", "claimType", "Definitional", "is")
("claimVersion.claimipedia.radicalKenosis.sacrificeNonAssignable.v1", "scope", "This safety rule protects consent, choice, refusal, exit, self-defence, and fair boundaries, especially for people with less power.", "is")
("claimVersion.claimipedia.radicalKenosis.sacrificeNonAssignable.v1", "immutable", "true", "is")
("claimVersion.claimipedia.radicalKenosis.sacrificeNonAssignable.v1", "changeKind", "Initial", "is")
("claimVersion.claimipedia.radicalKenosis.sacrificeNonAssignable.v1", "createdAt", "2026-10-06T04:00:00.000Z", "is")
("claimVersion.claimipedia.radicalKenosis.sacrificeNonAssignable.v1", "createdBy", "actor.claimipedia.author", "is")
("claim.claimipedia.radicalKenosis.finiteDepletion", "isa", "Claim", "is")
("claim.claimipedia.radicalKenosis.finiteDepletion", "identifier", "clm_RADICAL_KENOSIS_FINITE_DEPLETION", "is")
("claim.claimipedia.radicalKenosis.finiteDepletion", "currentVersion", "claimVersion.claimipedia.radicalKenosis.finiteDepletion.v1", "is")
("claim.claimipedia.radicalKenosis.finiteDepletion", "status", "active", "is")
("claimVersion.claimipedia.radicalKenosis.finiteDepletion.v1", "isa", "ClaimVersion", "is")
("claimVersion.claimipedia.radicalKenosis.finiteDepletion.v1", "claim", "claim.claimipedia.radicalKenosis.finiteDepletion", "is")
("claimVersion.claimipedia.radicalKenosis.finiteDepletion.v1", "version", "1", "is")
("claimVersion.claimipedia.radicalKenosis.finiteDepletion.v1", "expression", "People, communities, good reputations, rules, and institutions cannot create an endless supply of the inner security needed to keep carrying cost freely.", "is")
("claimVersion.claimipedia.radicalKenosis.finiteDepletion.v1", "claimType", "Predictive", "is")
("claimVersion.claimipedia.radicalKenosis.finiteDepletion.v1", "scope", "This claim concerns long and extreme pressure. Therapy, community, moral practice, and institutions can still give real and lasting help.", "is")
("claimVersion.claimipedia.radicalKenosis.finiteDepletion.v1", "immutable", "true", "is")
("claimVersion.claimipedia.radicalKenosis.finiteDepletion.v1", "changeKind", "Initial", "is")

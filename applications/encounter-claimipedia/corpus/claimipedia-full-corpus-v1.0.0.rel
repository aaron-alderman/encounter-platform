("relationship.claimipedia.kingdom.pro", "relationType", "Supports", "is")
("relationship.claimipedia.kingdom.pro", "assertedBy", "actor.claimipedia.author", "is")
("relationship.claimipedia.kingdom.pro", "immutable", "true", "is")

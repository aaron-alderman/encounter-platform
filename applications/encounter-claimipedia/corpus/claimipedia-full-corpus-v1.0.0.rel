("claim.claimipedia.loadBearing.followMeThirdOrder", "isa", "Claim", "is")
("claim.claimipedia.loadBearing.followMeThirdOrder", "identifier", "clm_CLAIMIPEDIA_LOAD_BEARING_FOLLOW_ME_THIRD_ORDER", "is")
("claim.claimipedia.loadBearing.followMeThirdOrder", "currentVersion", "claimVersion.claimipedia.loadBearing.followMeThirdOrder.v1", "is")
("claim.claimipedia.loadBearing.followMeThirdOrder", "status", "active", "is")
("claim.claimipedia.loadBearing.followMeThirdOrder", "weight", "load-bearing", "is")
("claim.claimipedia.loadBearing.followMeThirdOrder", "inquiryPosture", "proposed-and-contested", "is")
("claim.claimipedia.loadBearing.followMeThirdOrder", "proValence", "claim.claimipedia.loadBearing.followMeThirdOrder.pro", "is")
("claim.claimipedia.loadBearing.followMeThirdOrder", "conValence", "claim.claimipedia.loadBearing.followMeThirdOrder.con", "is")
("claim.claimipedia.loadBearing.followMeThirdOrder", "route", "/claim/follow-me-third-order-influence", "is")
("claimVersion.claimipedia.loadBearing.followMeThirdOrder.v1", "isa", "ClaimVersion", "is")
("claimVersion.claimipedia.loadBearing.followMeThirdOrder.v1", "claim", "claim.claimipedia.loadBearing.followMeThirdOrder", "is")
("claimVersion.claimipedia.loadBearing.followMeThirdOrder.v1", "version", "1", "is")
("claimVersion.claimipedia.loadBearing.followMeThirdOrder.v1", "expression", "Third-order influence shapes the possibility landscape. It is legitimate when every person retains unconditional standing, predation is bounded, the affected retain meaningful agency, power serves their Good, and errors remain repairable through corrigible agents and correctable structures.", "is")
("claimVersion.claimipedia.loadBearing.followMeThirdOrder.v1", "claimType", "Normative", "is")
("claimVersion.claimipedia.loadBearing.followMeThirdOrder.v1", "scope", "Load-bearing Christian ethical and architectural claim: Jesus' invitation to 'Follow me' is read as an enacted pattern for forming possibility landscapes through love, boundaries, agency, other-oriented power, and repair; the framework remains contestable and may also be evaluated in secular terms.", "is")
("claimVersion.claimipedia.loadBearing.followMeThirdOrder.v1", "authorityBoundary", "Authored Christian interpretation, not automatic biblical entailment, compulsory discipleship, direct policy mandate, or permission for a steward to define another person's Good without their voice. Participation and standing do not require assent.", "is")
("claimVersion.claimipedia.loadBearing.followMeThirdOrder.v1", "invitation", "Follow me", "is")
("claimVersion.claimipedia.loadBearing.followMeThirdOrder.v1", "standingPrinciple", "Unconditional love for the person: dignity and belonging are not earned by agreement, usefulness, purity, or compliance.", "is")
("claimVersion.claimipedia.loadBearing.followMeThirdOrder.v1", "boundaryPrinciple", "Boundaries against predation: love does not grant unconditional access, trust, office, proximity, or freedom from consequence.", "is")
("claimVersion.claimipedia.loadBearing.followMeThirdOrder.v1", "agencyPrinciple", "Meaningful agency: affected persons retain voice, participation, contestability, and meaningful exit wherever exit is possible.", "is")
("claimVersion.claimipedia.loadBearing.followMeThirdOrder.v1", "telosPrinciple", "Power serves the Good of the other: authority is fiduciary and kenotic rather than possessive or self-enlarging.", "is")
("claimVersion.claimipedia.loadBearing.followMeThirdOrder.v1", "correctionPrinciple", "Errors remain repairable through corrigible agents within correctable structures.", "is")
("claimVersion.claimipedia.loadBearing.followMeThirdOrder.v1", "nonEntailment", "An asserted good intention does not establish the other's Good, excuse coercion, guarantee competence, erase disagreement, or make every influence legitimate; legitimacy requires the full constitutional test and remains answerable to consequences.", "is")
("claimVersion.claimipedia.loadBearing.followMeThirdOrder.v1", "immutable", "true", "is")
("claimVersion.claimipedia.loadBearing.followMeThirdOrder.v1", "createdAt", "2026-10-06T00:00:00.000Z", "is")
("claimVersion.claimipedia.loadBearing.followMeThirdOrder.v1", "createdBy", "actor.claimipedia.author", "is")
("claim.claimipedia.loadBearing.followMeThirdOrder.pro", "isa", "Claim", "is")
("claim.claimipedia.loadBearing.followMeThirdOrder.pro", "identifier", "clm_CLAIMIPEDIA_FOLLOW_ME_THIRD_ORDER_PRO", "is")
("claim.claimipedia.loadBearing.followMeThirdOrder.pro", "currentVersion", "claimVersion.claimipedia.loadBearing.followMeThirdOrder.pro.v1", "is")
("claim.claimipedia.loadBearing.followMeThirdOrder.pro", "status", "active", "is")
("claimVersion.claimipedia.loadBearing.followMeThirdOrder.pro.v1", "isa", "ClaimVersion", "is")
("claimVersion.claimipedia.loadBearing.followMeThirdOrder.pro.v1", "claim", "claim.claimipedia.loadBearing.followMeThirdOrder.pro", "is")
("claimVersion.claimipedia.loadBearing.followMeThirdOrder.pro.v1", "version", "1", "is")
("claimVersion.claimipedia.loadBearing.followMeThirdOrder.pro.v1", "expression", "Jesus teaches how to live not only through commands but by forming a participatory field: persons receive standing before conformity, predators meet boundaries, disciples are invited rather than possessed, power bears cost for the other, and failure can return through truth, forgiveness, restitution, and renewed vocation.", "is")
("claimVersion.claimipedia.loadBearing.followMeThirdOrder.pro.v1", "claimType", "Normative", "is")
("claimVersion.claimipedia.loadBearing.followMeThirdOrder.pro.v1", "scope", "Strongest admitted pro valence; a synthetic Christian reading of the Gospel pattern, not self-authenticating historical, exegetical, or metaphysical proof.", "is")
("claimVersion.claimipedia.loadBearing.followMeThirdOrder.pro.v1", "immutable", "true", "is")
("claimVersion.claimipedia.loadBearing.followMeThirdOrder.pro.v1", "createdAt", "2026-10-06T00:01:00.000Z", "is")
("claimVersion.claimipedia.loadBearing.followMeThirdOrder.pro.v1", "createdBy", "actor.claimipedia.author", "is")
("claim.claimipedia.loadBearing.followMeThirdOrder.con", "isa", "Claim", "is")
("claim.claimipedia.loadBearing.followMeThirdOrder.con", "identifier", "clm_CLAIMIPEDIA_FOLLOW_ME_THIRD_ORDER_CON", "is")
("claim.claimipedia.loadBearing.followMeThirdOrder.con", "currentVersion", "claimVersion.claimipedia.loadBearing.followMeThirdOrder.con.v1", "is")
("claim.claimipedia.loadBearing.followMeThirdOrder.con", "status", "active", "is")
("claimVersion.claimipedia.loadBearing.followMeThirdOrder.con.v1", "isa", "ClaimVersion", "is")
("claimVersion.claimipedia.loadBearing.followMeThirdOrder.con.v1", "claim", "claim.claimipedia.loadBearing.followMeThirdOrder.con", "is")
("claimVersion.claimipedia.loadBearing.followMeThirdOrder.con.v1", "version", "1", "is")
("claimVersion.claimipedia.loadBearing.followMeThirdOrder.con.v1", "expression", "The modern category of third-order influence is not explicit in the Gospel texts; 'Follow me' can be used to sanctify hierarchy, unconditional love can conceal unsafe access, boundaries can encode exclusion, and claims to serve another's Good can become paternalism unless affected persons hold real voice and correction has material force.", "is")
("claimVersion.claimipedia.loadBearing.followMeThirdOrder.con.v1", "claimType", "Normative", "is")
("claimVersion.claimipedia.loadBearing.followMeThirdOrder.con.v1", "scope", "Strongest admitted con valence; guards against anachronism, coercive discipleship, benevolent domination, empty participation, and correction mechanisms controlled by the power they purport to constrain.", "is")
("claimVersion.claimipedia.loadBearing.followMeThirdOrder.con.v1", "immutable", "true", "is")
("claimVersion.claimipedia.loadBearing.followMeThirdOrder.con.v1", "createdAt", "2026-10-06T00:02:00.000Z", "is")
("claimVersion.claimipedia.loadBearing.followMeThirdOrder.con.v1", "createdBy", "actor.claimipedia.author", "is")
("relationship.claimipedia.followMeThirdOrder.pro", "isa", "Relationship", "is")
("relationship.claimipedia.followMeThirdOrder.pro", "source", "claim.claimipedia.loadBearing.followMeThirdOrder.pro", "is")
("relationship.claimipedia.followMeThirdOrder.pro", "target", "claim.claimipedia.loadBearing.followMeThirdOrder", "is")
("relationship.claimipedia.followMeThirdOrder.pro", "relationType", "Supports", "is")
("relationship.claimipedia.followMeThirdOrder.pro", "provenance", "Authored strongest-form pro valence; relationship admits the argument for inspection and does not establish its theological or historical premises.", "is")
("relationship.claimipedia.followMeThirdOrder.con", "isa", "Relationship", "is")
("relationship.claimipedia.followMeThirdOrder.con", "source", "claim.claimipedia.loadBearing.followMeThirdOrder.con", "is")
("relationship.claimipedia.followMeThirdOrder.con", "target", "claim.claimipedia.loadBearing.followMeThirdOrder", "is")
("relationship.claimipedia.followMeThirdOrder.con", "relationType", "Challenges", "is")
("relationship.claimipedia.followMeThirdOrder.con", "provenance", "Authored strongest-form con valence; relationship protects affected-person agency and does not automatically falsify the main claim.", "is")
("relationship.claimipedia.followMeThirdOrder.jesusIsKing", "isa", "Relationship", "is")
("relationship.claimipedia.followMeThirdOrder.jesusIsKing", "source", "claim.claimipedia.loadBearing.followMeThirdOrder", "is")
("relationship.claimipedia.followMeThirdOrder.jesusIsKing", "target", "claim.claimipedia.loadBearing.jesusIsKing", "is")
("relationship.claimipedia.followMeThirdOrder.jesusIsKing", "relationType", "Qualifies", "is")
("relationship.claimipedia.followMeThirdOrder.jesusIsKing", "provenance", "Peer load-bearing relation: 'Jesus is king' names ultimate allegiance and the interpretation of authority; 'Follow me' names the lived pattern by which that authority forms persons and possibility landscapes.", "is")
("relationship.claimipedia.followMeThirdOrder.kenosis", "isa", "Relationship", "is")
("relationship.claimipedia.followMeThirdOrder.kenosis", "source", "claim.claimipedia.loadBearing.followMeThirdOrder", "is")
("relationship.claimipedia.followMeThirdOrder.kenosis", "target", "claim.grandThesis.christianity-kenosis", "is")
("relationship.claimipedia.followMeThirdOrder.kenosis", "relationType", "DependsOn", "is")
("relationship.claimipedia.followMeThirdOrder.kenosis", "provenance", "The Christian pro valence depends on a kenotic reading of power as self-giving, cost-bearing, bounded, and non-possessive; secular evaluation of the governance test remains possible.", "is")
("relationship.claimipedia.followMeThirdOrder.orders", "isa", "Relationship", "is")
("relationship.claimipedia.followMeThirdOrder.orders", "source", "claim.claimipedia.loadBearing.followMeThirdOrder", "is")
("relationship.claimipedia.followMeThirdOrder.orders", "target", "claim.aiInquiry.orders-of-authority", "is")
("relationship.claimipedia.followMeThirdOrder.orders", "relationType", "Qualifies", "is")
("relationship.claimipedia.followMeThirdOrder.orders", "provenance", "Applies the existing first-, second-, and third-order authority distinction to a Christian ethical account of formative influence; cross-domain application is synthetic and contestable.", "is")
("relationship.claimipedia.followMeThirdOrder.groundedGovernance", "isa", "Relationship", "is")
("relationship.claimipedia.followMeThirdOrder.groundedGovernance", "source", "claim.claimipedia.loadBearing.followMeThirdOrder", "is")
("relationship.claimipedia.followMeThirdOrder.groundedGovernance", "target", "claim.claimipedia.governance.groundedContract", "is")
("relationship.claimipedia.followMeThirdOrder.groundedGovernance", "relationType", "Supports", "is")
("relationship.claimipedia.followMeThirdOrder.groundedGovernance", "provenance", "The five-part legitimacy test supplies a normative reason for governance to retain voice, contestability, consequences, appeal, exit, and repair close to affected persons.", "is")
("claim.claimipedia.loadBearing.kingdom", "isa", "Claim", "is")
("claim.claimipedia.loadBearing.kingdom", "identifier", "clm_CLAIMIPEDIA_LOAD_BEARING_KINGDOM", "is")
("claim.claimipedia.loadBearing.kingdom", "currentVersion", "claimVersion.claimipedia.loadBearing.kingdom.v1", "is")
("claim.claimipedia.loadBearing.kingdom", "status", "active", "is")
("claim.claimipedia.loadBearing.kingdom", "weight", "load-bearing", "is")
("claim.claimipedia.loadBearing.kingdom", "inquiryPosture", "proposed-and-contested", "is")
("claim.claimipedia.loadBearing.kingdom", "proValence", "claim.claimipedia.loadBearing.kingdom.pro", "is")
("claim.claimipedia.loadBearing.kingdom", "conValence", "claim.claimipedia.loadBearing.kingdom.con", "is")
("claim.claimipedia.loadBearing.kingdom", "route", "/claim/the-kingdom", "is")
("claimVersion.claimipedia.loadBearing.kingdom.v1", "isa", "ClaimVersion", "is")
("claimVersion.claimipedia.loadBearing.kingdom.v1", "claim", "claim.claimipedia.loadBearing.kingdom", "is")
("claimVersion.claimipedia.loadBearing.kingdom.v1", "version", "1", "is")
("claimVersion.claimipedia.loadBearing.kingdom.v1", "changeKind", "Initial", "is")
("claimVersion.claimipedia.loadBearing.kingdom.v1", "expression", "The Kingdom is the communal horizon of life under the self-giving reign of Jesus: a common life in which unconditional standing is joined to boundaries against predation, meaningful agency, power ordered toward the Good of the other, and practices of truth, correction, restitution, forgiveness, and repair.", "is")
("claimVersion.claimipedia.loadBearing.kingdom.v1", "claimType", "Normative", "is")
("claimVersion.claimipedia.loadBearing.kingdom.v1", "scope", "Collective and communal movement in the King-Way-Kingdom architecture; it names an eschatological and practical horizon rather than identifying any present institution with the Kingdom in full.", "is")
("claimVersion.claimipedia.loadBearing.kingdom.v1", "authorityBoundary", "Authored Christian social thesis, not a coercive theocracy, state programme, compulsory creed, institutional self-identification, or permission to sacrifice persons to an imagined collective Good. Participation and standing do not require assent.", "is")
("claimVersion.claimipedia.loadBearing.kingdom.v1", "standingPrinciple", "Every person retains unconditional standing within and beyond the community's agreement.", "is")
("claimVersion.claimipedia.loadBearing.kingdom.v1", "boundaryPrinciple", "Common life actively restrains predation and never renames unsafe access as reconciliation.", "is")
("claimVersion.claimipedia.loadBearing.kingdom.v1", "agencyPrinciple", "Shared direction preserves voice, contribution, contestability, plural vocation, and practical exit.", "is")
("claimVersion.claimipedia.loadBearing.kingdom.v1", "telosPrinciple", "Institutions and offices serve the flourishing of persons and creation rather than their own perpetuation.", "is")
("claimVersion.claimipedia.loadBearing.kingdom.v1", "correctionPrinciple", "Communal memory, judgment, appeal, restitution, forgiveness, and repair remain materially capable of changing the common life.", "is")
("claimVersion.claimipedia.loadBearing.kingdom.v1", "workedCaseTitle", "When a trusted church leader is accused of abusing a child", "is")
("claimVersion.claimipedia.loadBearing.kingdom.v1", "workedCaseContext", "A credible disclosure concerns a charismatic leader whose ministry is central to the community's identity. Leaders fear harm to the reporter, other children, the accused, the congregation, and the institution. The five principles operate as independent obligations; spiritual reputation, institutional survival, forgiveness, or aggregate good cannot cancel any one of them.", "is")
("claimVersion.claimipedia.loadBearing.kingdom.v1", "workedCaseStanding", "The child and reporter retain unconditional human standing whether the allegation is believed immediately, contested, incomplete, or institutionally costly. The accused also retains human standing without retaining access, office, credibility, or control of the process.", "is")
("claimVersion.claimipedia.loadBearing.kingdom.v1", "workedCaseBoundary", "Create immediate protective distance, follow mandatory reporting duties, preserve evidence, prevent contact or retaliation, and use investigators independent of the accused and their chain of loyalty. Forgiveness is never a substitute for safety or consequence.", "is")
("claimVersion.claimipedia.loadBearing.kingdom.v1", "workedCaseAgency", "Give the affected person developmentally appropriate information, advocacy, privacy choices, a voice in support and repair, and routes outside the institution. Do not make disclosure, participation, confrontation, reconciliation, or public testimony the price of care.", "is")
("claimVersion.claimipedia.loadBearing.kingdom.v1", "workedCaseTelos", "Power serves the life and recovery of affected people and the protection of others, not the preservation of ministry, reputation, donations, unity, or a leader's vocation. The institution bears the cost of interruption rather than displacing it onto the vulnerable.", "is")
("claimVersion.claimipedia.loadBearing.kingdom.v1", "workedCaseCorrection", "Retain records, commission independent review, disclose substantiated institutional failures, provide appeal and survivor-centred remedy, make restitution where owed, change governance and supervision, and verify over time that the reforms alter actual conditions.", "is")
("claimVersion.claimipedia.loadBearing.kingdom.v1", "workedCaseVerdict", "The framework rejects both abandonment and premature reconciliation. Love preserves every person's standing; boundaries remove unsafe access; agency keeps affected people from becoming objects of institutional management; telos directs power toward their Good; correction requires truth to change structure and consequence.", "is")
("claimVersion.claimipedia.loadBearing.kingdom.v1", "immutable", "true", "is")
("claimVersion.claimipedia.loadBearing.kingdom.v1", "createdAt", "2026-10-06T01:00:00.000Z", "is")
("claimVersion.claimipedia.loadBearing.kingdom.v1", "createdBy", "actor.claimipedia.author", "is")
("claim.claimipedia.loadBearing.kingdom.pro", "isa", "Claim", "is")
("claim.claimipedia.loadBearing.kingdom.pro", "identifier", "clm_CLAIMIPEDIA_LOAD_BEARING_KINGDOM_PRO", "is")
("claim.claimipedia.loadBearing.kingdom.pro", "currentVersion", "claimVersion.claimipedia.loadBearing.kingdom.pro.v1", "is")
("claim.claimipedia.loadBearing.kingdom.pro", "status", "active", "is")
("claimVersion.claimipedia.loadBearing.kingdom.pro.v1", "isa", "ClaimVersion", "is")
("claimVersion.claimipedia.loadBearing.kingdom.pro.v1", "claim", "claim.claimipedia.loadBearing.kingdom.pro", "is")
("claimVersion.claimipedia.loadBearing.kingdom.pro.v1", "version", "1", "is")
("claimVersion.claimipedia.loadBearing.kingdom.pro.v1", "changeKind", "Initial", "is")
("claimVersion.claimipedia.loadBearing.kingdom.pro.v1", "expression", "The biblical Kingdom can coherently orient common life without becoming a coercive state: Jesus identifies rule with service, gathers a plural body, announces release and good news to the poor, and places the Kingdom's completion beyond the possession of any present institution.", "is")
("claimVersion.claimipedia.loadBearing.kingdom.pro.v1", "claimType", "Normative", "is")
("claimVersion.claimipedia.loadBearing.kingdom.pro.v1", "scope", "Strongest admitted pro valence joining scriptural, ecclesial, ethical, and eschatological dimensions; it does not prove that a particular institution embodies the Kingdom.", "is")
("claimVersion.claimipedia.loadBearing.kingdom.pro.v1", "immutable", "true", "is")
("claimVersion.claimipedia.loadBearing.kingdom.pro.v1", "createdAt", "2026-10-06T01:01:00.000Z", "is")
("claimVersion.claimipedia.loadBearing.kingdom.pro.v1", "createdBy", "actor.claimipedia.author", "is")
("claim.claimipedia.loadBearing.kingdom.con", "isa", "Claim", "is")
("claim.claimipedia.loadBearing.kingdom.con", "identifier", "clm_CLAIMIPEDIA_LOAD_BEARING_KINGDOM_CON", "is")
("claim.claimipedia.loadBearing.kingdom.con", "currentVersion", "claimVersion.claimipedia.loadBearing.kingdom.con.v1", "is")
("claim.claimipedia.loadBearing.kingdom.con", "status", "active", "is")
("claimVersion.claimipedia.loadBearing.kingdom.con.v1", "isa", "ClaimVersion", "is")
("claimVersion.claimipedia.loadBearing.kingdom.con.v1", "claim", "claim.claimipedia.loadBearing.kingdom.con", "is")
("claimVersion.claimipedia.loadBearing.kingdom.con.v1", "version", "1", "is")
("claimVersion.claimipedia.loadBearing.kingdom.con.v1", "changeKind", "Initial", "is")
("claimVersion.claimipedia.loadBearing.kingdom.con.v1", "expression", "Kingdom language is eschatological, internally diverse, and historically vulnerable to imperial capture; translating it into a social architecture can baptize one community's preferences, suppress dissent, obscure abuse, and confuse a provisional institution with the reign of God.", "is")
("claimVersion.claimipedia.loadBearing.kingdom.con.v1", "claimType", "Normative", "is")
("claimVersion.claimipedia.loadBearing.kingdom.con.v1", "scope", "Strongest admitted con valence drawing on interpretive plurality, histories of coercion, institutional abuse, and the danger of supersessionism or theological monopoly.", "is")
("claimVersion.claimipedia.loadBearing.kingdom.con.v1", "immutable", "true", "is")
("claimVersion.claimipedia.loadBearing.kingdom.con.v1", "createdAt", "2026-10-06T01:02:00.000Z", "is")
("claimVersion.claimipedia.loadBearing.kingdom.con.v1", "createdBy", "actor.claimipedia.author", "is")

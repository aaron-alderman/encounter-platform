("claim.claimipedia.radicalKenosis.trinitarianMinimum", "isa", "Claim", "is")
("claim.claimipedia.radicalKenosis.trinitarianMinimum", "identifier", "clm_RADICAL_KENOSIS_TRINITARIAN_MINIMUM", "is")
("claim.claimipedia.radicalKenosis.trinitarianMinimum", "currentVersion", "claimVersion.claimipedia.radicalKenosis.trinitarianMinimum.v1", "is")
("claim.claimipedia.radicalKenosis.trinitarianMinimum", "status", "active", "is")
("claimVersion.claimipedia.radicalKenosis.trinitarianMinimum.v1", "isa", "ClaimVersion", "is")
("claimVersion.claimipedia.radicalKenosis.trinitarianMinimum.v1", "claim", "claim.claimipedia.radicalKenosis.trinitarianMinimum", "is")
("claimVersion.claimipedia.radicalKenosis.trinitarianMinimum.v1", "version", "1", "is")
("claimVersion.claimipedia.radicalKenosis.trinitarianMinimum.v1", "expression", "Radical Kenosis says the Trinity is the simplest account of a God whose love is eternal, freely given, free from rivalry, and able to create new life.", "is")
("claimVersion.claimipedia.radicalKenosis.trinitarianMinimum.v1", "claimType", "Descriptive", "is")
("claimVersion.claimipedia.radicalKenosis.trinitarianMinimum.v1", "scope", "This is a later Christian and philosophical claim. The move from one, to two, to three divine persons—and the claim that this matches the Trinity—can be strongly challenged.", "is")
("claimVersion.claimipedia.radicalKenosis.trinitarianMinimum.v1", "immutable", "true", "is")
("claimVersion.claimipedia.radicalKenosis.trinitarianMinimum.v1", "changeKind", "Initial", "is")
("claimVersion.claimipedia.radicalKenosis.trinitarianMinimum.v1", "createdAt", "2026-10-06T04:00:00.000Z", "is")
("claimVersion.claimipedia.radicalKenosis.trinitarianMinimum.v1", "createdBy", "actor.claimipedia.author", "is")
("claim.claimipedia.radicalKenosis.kenoticMonarchy", "isa", "Claim", "is")
("claim.claimipedia.radicalKenosis.kenoticMonarchy", "identifier", "clm_RADICAL_KENOSIS_KENOTIC_MONARCHY", "is")
("claim.claimipedia.radicalKenosis.kenoticMonarchy", "currentVersion", "claimVersion.claimipedia.radicalKenosis.kenoticMonarchy.v1", "is")
("claim.claimipedia.radicalKenosis.kenoticMonarchy", "status", "active", "is")
("claimVersion.claimipedia.radicalKenosis.kenoticMonarchy.v1", "isa", "ClaimVersion", "is")
("claimVersion.claimipedia.radicalKenosis.kenoticMonarchy.v1", "claim", "claim.claimipedia.radicalKenosis.kenoticMonarchy", "is")
("claimVersion.claimipedia.radicalKenosis.kenoticMonarchy.v1", "version", "1", "is")
("claimVersion.claimipedia.radicalKenosis.kenoticMonarchy.v1", "expression", "God's authority fits Radical Kenosis only if the Father gives all that he is, rather than keeping the power to dominate and merely choosing not to use it.", "is")
("claimVersion.claimipedia.radicalKenosis.kenoticMonarchy.v1", "claimType", "Descriptive", "is")
("claimVersion.claimipedia.radicalKenosis.kenoticMonarchy.v1", "scope", "This is one reading of the Trinity. It does not settle long-running Christian debates about the Father as source, divine simplicity, the Son's generation, the Spirit's procession, or the Filioque.", "is")
("claimVersion.claimipedia.radicalKenosis.kenoticMonarchy.v1", "immutable", "true", "is")
("claimVersion.claimipedia.radicalKenosis.kenoticMonarchy.v1", "changeKind", "Initial", "is")
("claimVersion.claimipedia.radicalKenosis.kenoticMonarchy.v1", "createdAt", "2026-10-06T04:00:00.000Z", "is")
("claimVersion.claimipedia.radicalKenosis.kenoticMonarchy.v1", "createdBy", "actor.claimipedia.author", "is")
("claim.claimipedia.radicalKenosis.crossTriuneAbsorption", "isa", "Claim", "is")
("claim.claimipedia.radicalKenosis.crossTriuneAbsorption", "identifier", "clm_RADICAL_KENOSIS_CROSS_TRIUNE_ABSORPTION", "is")
("claim.claimipedia.radicalKenosis.crossTriuneAbsorption", "currentVersion", "claimVersion.claimipedia.radicalKenosis.crossTriuneAbsorption.v1", "is")
("claim.claimipedia.radicalKenosis.crossTriuneAbsorption", "status", "active", "is")
("claimVersion.claimipedia.radicalKenosis.crossTriuneAbsorption.v1", "isa", "ClaimVersion", "is")
("claimVersion.claimipedia.radicalKenosis.crossTriuneAbsorption.v1", "claim", "claim.claimipedia.radicalKenosis.crossTriuneAbsorption", "is")
("claimVersion.claimipedia.radicalKenosis.crossTriuneAbsorption.v1", "version", "1", "is")
("claimVersion.claimipedia.radicalKenosis.crossTriuneAbsorption.v1", "expression", "On this reading, the Cross is not the Father punishing an unwilling Son. Father, Son, and Spirit face the cost together, without force, revenge, or choosing another victim.", "is")
("claimVersion.claimipedia.radicalKenosis.crossTriuneAbsorption.v1", "claimType", "Descriptive", "is")
("claimVersion.claimipedia.radicalKenosis.crossTriuneAbsorption.v1", "scope", "This is one Christian account of the Cross. Other accounts of how the Cross saves remain open for comparison and challenge.", "is")
("claimVersion.claimipedia.radicalKenosis.crossTriuneAbsorption.v1", "immutable", "true", "is")
("claimVersion.claimipedia.radicalKenosis.crossTriuneAbsorption.v1", "changeKind", "Initial", "is")
("claimVersion.claimipedia.radicalKenosis.crossTriuneAbsorption.v1", "createdAt", "2026-10-06T04:00:00.000Z", "is")
("claimVersion.claimipedia.radicalKenosis.crossTriuneAbsorption.v1", "createdBy", "actor.claimipedia.author", "is")
("claim.claimipedia.radicalKenosis.pentecostWitness", "isa", "Claim", "is")
("claim.claimipedia.radicalKenosis.pentecostWitness", "identifier", "clm_RADICAL_KENOSIS_PENTECOST_WITNESS", "is")
("claim.claimipedia.radicalKenosis.pentecostWitness", "currentVersion", "claimVersion.claimipedia.radicalKenosis.pentecostWitness.v1", "is")
("claim.claimipedia.radicalKenosis.pentecostWitness", "status", "active", "is")
("claimVersion.claimipedia.radicalKenosis.pentecostWitness.v1", "isa", "ClaimVersion", "is")
("claimVersion.claimipedia.radicalKenosis.pentecostWitness.v1", "claim", "claim.claimipedia.radicalKenosis.pentecostWitness", "is")
("claimVersion.claimipedia.radicalKenosis.pentecostWitness.v1", "version", "1", "is")
("claimVersion.claimipedia.radicalKenosis.pentecostWitness.v1", "expression", "After Jesus is claimed to carry the central burden, Pentecost shares witness, vulnerability, and responsibility. It does not share the work of salvation or create a new privileged ruling group.", "is")
("claimVersion.claimipedia.radicalKenosis.pentecostWitness.v1", "claimType", "Descriptive", "is")
("claimVersion.claimipedia.radicalKenosis.pentecostWitness.v1", "scope", "This is one reading of Acts 2 and what it means to be chosen by God. Its fit with the text and history remains open to challenge.", "is")
("claimVersion.claimipedia.radicalKenosis.pentecostWitness.v1", "immutable", "true", "is")
("claimVersion.claimipedia.radicalKenosis.pentecostWitness.v1", "changeKind", "Initial", "is")
("claimVersion.claimipedia.radicalKenosis.pentecostWitness.v1", "createdAt", "2026-10-06T04:00:00.000Z", "is")
("claimVersion.claimipedia.radicalKenosis.pentecostWitness.v1", "createdBy", "actor.claimipedia.author", "is")
("claim.claimipedia.radicalKenosis.pentecostPlurality", "isa", "Claim", "is")
("claim.claimipedia.radicalKenosis.pentecostPlurality", "identifier", "clm_RADICAL_KENOSIS_PENTECOST_PLURALITY", "is")
("claim.claimipedia.radicalKenosis.pentecostPlurality", "currentVersion", "claimVersion.claimipedia.radicalKenosis.pentecostPlurality.v1", "is")
("claim.claimipedia.radicalKenosis.pentecostPlurality", "status", "active", "is")
("claimVersion.claimipedia.radicalKenosis.pentecostPlurality.v1", "isa", "ClaimVersion", "is")
("claimVersion.claimipedia.radicalKenosis.pentecostPlurality.v1", "claim", "claim.claimipedia.radicalKenosis.pentecostPlurality", "is")
("claimVersion.claimipedia.radicalKenosis.pentecostPlurality.v1", "version", "1", "is")
("claimVersion.claimipedia.radicalKenosis.pentecostPlurality.v1", "expression", "The many languages at Pentecost show a unity that does not erase difference. Translation, misunderstanding, effort, and free response remain.", "is")
("claimVersion.claimipedia.radicalKenosis.pentecostPlurality.v1", "claimType", "Descriptive", "is")
("claimVersion.claimipedia.radicalKenosis.pentecostPlurality.v1", "scope", "This is a Christian reading of the many languages in Acts 2. It does not prove a complete theory of how different groups should live together.", "is")
("claimVersion.claimipedia.radicalKenosis.pentecostPlurality.v1", "immutable", "true", "is")
("claimVersion.claimipedia.radicalKenosis.pentecostPlurality.v1", "changeKind", "Initial", "is")

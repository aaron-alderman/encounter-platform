("claimVersion.claimipedia.governance.ungroundedCompression.v1", "version", "1", "is")
("claimVersion.claimipedia.governance.ungroundedCompression.v1", "expression", "When person, context, authority, consequence, and recourse disappear through successive compression into roles, metrics, models, and automated decisions, governance becomes unstable because the abstraction can act while the burden is displaced onto people it can no longer hear.", "is")
("claimVersion.claimipedia.governance.ungroundedCompression.v1", "claimType", "Causal", "is")
("claimVersion.claimipedia.governance.ungroundedCompression.v1", "scope", "Corpus-supported architectural diagnosis illustrated by AI-mediated decisions and other burden-shifting regimes; not represented here as completed general empirical proof across all institutions.", "is")
("claimVersion.claimipedia.governance.ungroundedCompression.v1", "immutable", "true", "is")
("claimVersion.claimipedia.governance.ungroundedCompression.v1", "createdAt", "2026-10-05T12:30:00.000Z", "is")

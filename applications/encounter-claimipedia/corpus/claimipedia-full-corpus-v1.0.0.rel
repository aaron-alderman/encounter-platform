("claimVersion.claimipedia.radicalKenosis.challengeConvergence.v1", "version", "1", "is")
("claimVersion.claimipedia.radicalKenosis.challengeConvergence.v1", "expression", "The test may have been built to fit Christianity. The argument may overlook other faiths, make uncertain history sound clearer than it is, or ignore other ways to understand sacrifice.", "is")
("claimVersion.claimipedia.radicalKenosis.challengeConvergence.v1", "claimType", "Descriptive", "is")
("claimVersion.claimipedia.radicalKenosis.challengeConvergence.v1", "scope", "This challenge concerns method, other religions, and history. It remains open until the test and its comparison with other candidates are checked independently.", "is")
("claimVersion.claimipedia.radicalKenosis.challengeConvergence.v1", "immutable", "true", "is")

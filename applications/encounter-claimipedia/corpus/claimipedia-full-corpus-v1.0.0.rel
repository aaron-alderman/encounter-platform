("claimVersion.claimipedia.radicalKenosis.challengeWeaponization.v1", "version", "1", "is")
("claimVersion.claimipedia.radicalKenosis.challengeWeaponization.v1", "expression", "Language about self-giving becomes dangerous when powerful people use it to make vulnerable people endure abuse, stay available to an abuser, forgive without repair, or feel guilty for saying no.", "is")
("claimVersion.claimipedia.radicalKenosis.challengeWeaponization.v1", "claimType", "Normative", "is")
("claimVersion.claimipedia.radicalKenosis.challengeWeaponization.v1", "scope", "This is a standing real-world test. Any use that forces sacrifice breaks the framework's own safety rule.", "is")

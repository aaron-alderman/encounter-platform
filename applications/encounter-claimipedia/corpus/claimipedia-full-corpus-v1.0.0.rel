("claimVersion.claimipedia.radicalKenosis.nonDepletableSource.v1", "expression", "To keep carrying unavoidable costs freely, without passing them to others, people need support from a source that never runs out, never uses force, and can face even death without choosing a victim or striking back.", "is")
("claimVersion.claimipedia.radicalKenosis.nonDepletableSource.v1", "claimType", "Causal", "is")
("claimVersion.claimipedia.radicalKenosis.nonDepletableSource.v1", "scope", "This is the main claim of Radical Kenosis. It concerns freely carrying cost for a long time and under extreme pressure, not every ordinary act of care or courage.", "is")
("claimVersion.claimipedia.radicalKenosis.nonDepletableSource.v1", "authorityBoundary", "This is an argued Christian and philosophical claim. Recording it does not prove Christianity, force belief, permit forced sacrifice, or turn a match with Jesus into historical proof.", "is")

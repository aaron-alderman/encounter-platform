("claimVersion.claimipedia.radicalKenosis.irreducibleCost.v1", "version", "1", "is")
("claimVersion.claimipedia.radicalKenosis.irreducibleCost.v1", "expression", "A limited world produces some losses that we cannot prevent, remove, or fully repair.", "is")
("claimVersion.claimipedia.radicalKenosis.irreducibleCost.v1", "claimType", "Descriptive", "is")
("claimVersion.claimipedia.radicalKenosis.irreducibleCost.v1", "scope", "This is the argument's starting point. Evidence is still needed to show how much unavoidable cost exists and who carries it in each real case.", "is")
("claimVersion.claimipedia.radicalKenosis.irreducibleCost.v1", "immutable", "true", "is")
("claimVersion.claimipedia.radicalKenosis.irreducibleCost.v1", "changeKind", "Initial", "is")

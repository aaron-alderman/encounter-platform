("claim.claimipedia.games.sharedFactSpaceProjection", "identifier", "clm_GAMES_SHARED_FACT_SPACE_PROJECTION", "is")
("claim.claimipedia.games.sharedFactSpaceProjection", "currentVersion", "claimVersion.claimipedia.games.sharedFactSpaceProjection.v1", "is")
("claim.claimipedia.games.sharedFactSpaceProjection", "status", "active", "is")
("claimVersion.claimipedia.games.sharedFactSpaceProjection.v1", "isa", "ClaimVersion", "is")
("claimVersion.claimipedia.games.sharedFactSpaceProjection.v1", "claim", "claim.claimipedia.games.sharedFactSpaceProjection", "is")
("claimVersion.claimipedia.games.sharedFactSpaceProjection.v1", "version", "1", "is")
("claimVersion.claimipedia.games.sharedFactSpaceProjection.v1", "expression", "One governed fact space can support factual views, deliberate simplifications, simulations, gamified explanations, and games through shared state-transition and projection architecture while preserving their different epistemic statuses.", "is")
("claimVersion.claimipedia.games.sharedFactSpaceProjection.v1", "claimType", "Descriptive", "is")
("claimVersion.claimipedia.games.sharedFactSpaceProjection.v1", "scope", "A generated game or simulation outcome is not an observation and cannot return to the fact space without a new provenance, evidence, and admission boundary.", "is")
("claimVersion.claimipedia.games.sharedFactSpaceProjection.v1", "immutable", "true", "is")
("claimVersion.claimipedia.games.sharedFactSpaceProjection.v1", "changeKind", "Initial", "is")

("claimVersion.claimipedia.governance.groundedContract.v1", "version", "1", "is")
("claimVersion.claimipedia.governance.groundedContract.v1", "expression", "Governance remains legitimate only while it stays grounded in living contract with the real people who grant authority, carry responsibility, endure consequences, and retain practical powers of contest, appeal, exit, withdrawal, and repair.", "is")
("claimVersion.claimipedia.governance.groundedContract.v1", "claimType", "Normative", "is")
("claimVersion.claimipedia.governance.groundedContract.v1", "scope", "Anti-establishment does not mean anti-institution: institutions provide memory, expertise, delegation, and coordination, but remain answerable to persons rather than substituting representations for them.", "is")
("claimVersion.claimipedia.governance.groundedContract.v1", "immutable", "true", "is")
("claimVersion.claimipedia.governance.groundedContract.v1", "createdAt", "2026-10-05T12:30:00.000Z", "is")

("claimVersion.claimipedia.loadBearing.jesusIsKing.pro.v1", "expression", "The person and pattern of Jesus disclose ultimate authority as crucified and risen self-giving love: power that remains truthful and agentic while bearing cost, protecting the vulnerable, making room for the other, and refusing possession.", "is")
("claimVersion.claimipedia.loadBearing.jesusIsKing.pro.v1", "claimType", "Normative", "is")
("claimVersion.claimipedia.loadBearing.jesusIsKing.pro.v1", "scope", "Strongest admitted pro valence; proclamation and supporting interpretation, not independently completed historical or metaphysical proof.", "is")

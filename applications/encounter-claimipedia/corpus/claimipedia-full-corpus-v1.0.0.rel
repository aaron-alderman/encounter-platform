("claimVersion.claimipedia.games.creationToolsRemainDistinct.v1", "claim", "claim.claimipedia.games.creationToolsRemainDistinct", "is")
("claimVersion.claimipedia.games.creationToolsRemainDistinct.v1", "version", "1", "is")
("claimVersion.claimipedia.games.creationToolsRemainDistinct.v1", "expression", "Asset Foundry and Landscape Foundry are game creation tools: they author, validate, package, and publish assets or landscapes that games and simulations may consume, but they are not themselves games.", "is")
("claimVersion.claimipedia.games.creationToolsRemainDistinct.v1", "claimType", "Definitional", "is")
("claimVersion.claimipedia.games.creationToolsRemainDistinct.v1", "scope", "Classification boundary for Sourcery Game production infrastructure. A tool, generated artifact, test fixture, reference image, or successful build is not gameplay evidence and does not inherit the maturity of a consuming game.", "is")
("claimVersion.claimipedia.games.creationToolsRemainDistinct.v1", "authorityBoundary", "Build and validation success grants neither publication authority nor authority over a game, represented place, creator, player, or real-world system.", "is")
("claimVersion.claimipedia.games.creationToolsRemainDistinct.v1", "nonEntailment", "The presence of foundry source, tests, generated assets, workbench code, or visual references does not establish a finished game, deployment, usability, licence completeness, artistic quality, or player benefit.", "is")
("claimVersion.claimipedia.games.creationToolsRemainDistinct.v1", "immutable", "true", "is")
("claimVersion.claimipedia.games.creationToolsRemainDistinct.v1", "changeKind", "Initial", "is")

("claimVersion.claimipedia.radicalKenosis.finiteDepletion.v1", "createdBy", "actor.claimipedia.author", "is")
("claim.claimipedia.radicalKenosis.sourceSpecification", "isa", "Claim", "is")
("claim.claimipedia.radicalKenosis.sourceSpecification", "identifier", "clm_RADICAL_KENOSIS_SOURCE_SPECIFICATION", "is")
("claim.claimipedia.radicalKenosis.sourceSpecification", "currentVersion", "claimVersion.claimipedia.radicalKenosis.sourceSpecification.v1", "is")
("claim.claimipedia.radicalKenosis.sourceSpecification", "status", "active", "is")
("claimVersion.claimipedia.radicalKenosis.sourceSpecification.v1", "isa", "ClaimVersion", "is")
("claimVersion.claimipedia.radicalKenosis.sourceSpecification.v1", "claim", "claim.claimipedia.radicalKenosis.sourceSpecification", "is")
("claimVersion.claimipedia.radicalKenosis.sourceSpecification.v1", "version", "1", "is")
("claimVersion.claimipedia.radicalKenosis.sourceSpecification.v1", "expression", "A sufficient source must be beyond our limits yet present with us. It must be personal, never force or choose a victim, never strike back, face death, be known in relationship, and never run out.", "is")
("claimVersion.claimipedia.radicalKenosis.sourceSpecification.v1", "claimType", "Definitional", "is")
("claimVersion.claimipedia.radicalKenosis.sourceSpecification.v1", "scope", "The argument says every item on this list is needed. Readers may challenge whether each item follows or whether the list is complete.", "is")
("claimVersion.claimipedia.radicalKenosis.sourceSpecification.v1", "immutable", "true", "is")
("claimVersion.claimipedia.radicalKenosis.sourceSpecification.v1", "changeKind", "Initial", "is")

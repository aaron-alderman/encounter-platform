("claimVersion.claimipedia.loadBearing.jesusIsKing.v1", "isa", "ClaimVersion", "is")
("claimVersion.claimipedia.loadBearing.jesusIsKing.v1", "claim", "claim.claimipedia.loadBearing.jesusIsKing", "is")
("claimVersion.claimipedia.loadBearing.jesusIsKing.v1", "version", "1", "is")
("claimVersion.claimipedia.loadBearing.jesusIsKing.v1", "expression", "You can make the leap of faith: freely admit Jesus as king while retaining reason, conscience, agency, and the right to contest what that admission means.", "is")
("claimVersion.claimipedia.loadBearing.jesusIsKing.v1", "claimType", "Normative", "is")
("claimVersion.claimipedia.loadBearing.jesusIsKing.v1", "scope", "A theological, historical, existential, and normative claim at the disclosed root of Claimipedia's account of kenosis, bounded authority, redemptive correction, and power oriented toward the good of the other.", "is")
("claimVersion.claimipedia.loadBearing.jesusIsKing.v1", "authorityBoundary", "Authored Christian thesis; it is not a navigation default, compulsory creed, state programme, direct policy mandate, or substitute for conscience. Participation, dignity, and procedural standing do not require assent.", "is")
("claimVersion.claimipedia.loadBearing.jesusIsKing.v1", "proclamation", "Jesus is king!", "is")
("claimVersion.claimipedia.loadBearing.jesusIsKing.v1", "nonEntailment", "The possibility of making the leap does not entail that the leap is rationally compulsory, historically proved, psychologically available on demand, institutionally enforceable, or beyond later examination.", "is")

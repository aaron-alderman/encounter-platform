("v2", "scalar", "{\n  \"protocol\": \"spin23-srp10-srp12/v1\",\n  \"identifier\": \"SRP10-SRP12\",\n  \"title\": \"External selector and invariant-robustness tournament\",\n  \"status\": \"executed-scoped-awaiting-synthesis\",\n  \"predecessorPosition\": \"LIFT-MULTIPLE / ORIGIN-UNFIXED / EMP-ANALOGUE\",\n  \"sourceIntake\": \"../../../research intake/openai-math-2026-10-06/inquiry-work-pack-v1.json\",\n  \"sourceSnapshot\": \"openai/math@adc7f1241b42e322a6451854ab7e4b4c146bf78a\",\n  \"sourceReferences\": [\n    \"https://github.com/openai/math/blob/adc7f1241b42e322a6451854ab7e4b4c146bf78a/preprints/A-boundary-field-gap-for-the-spin-one-Heisenberg-chain-September-24-2026/paper.pdf\",\n    \"https://github.com/openai/math/blob/adc7f1241b42e322a6451854ab7e4b4c146bf78a/preprints/Spontaneous-magnetization-in-the-quantum-Heisenberg-ferromagnet-September-24-2026/paper.pdf\",\n    \"https://github.com/openai/math/blob/adc7f1241b42e322a6451854ab7e4b4c146bf78a/preprints/A-C1-Counterexample-to-the-Entropy-Conjecture-September-25-2026/article.pdf\",\n    \"https://github.com/openai/math/blob/adc7f1241b42e322a6451854ab7e4b4c146bf78a/preprints/Uniform-Stability-of-the-Spherical-Laughlin-Gap-October-5-2026/uniform-stability-spherical-laughlin-gap.pdf\",\n    \"https://github.com/openai/math/blob/adc7f1241b42e322a6451854ab7e4b4c146bf78a/lean/docs/269.md\",\n    \"https://github.com/openai/math/blob/adc7f1241b42e322a6451854ab7e4b4c146bf78a/lean/docs/271.md\"\n  ],\n  \"localSourceInspection\": {\n    \"method\": \"sparse checkout of source and repository scope documents\",\n    \"leanRebuild\": false,\n    \"paperProofReconstruction\": false,\n    \"claim\": \"source-scoped theorem and transfer audit, not independent proof verification\"\n  },\n  \"srp10\": {\n    \"question\": \"Does an external mathematical example supply a non-circular selector for the residual Spin(2,3) orientation?\",\n    \"classificationRule\": \"Classify by the earliest independently specified datum that is odd under reversal; do not count a label, a branch multiplicity, or a calibration convention as a physical selector.\",\n    \"meceBranches\": [\n      {\n        \"id\": \"S10-B0\",\n        \"class\": \"no-selector\",\n        \"outcome\": \"NONE\",\n        \"finding\": \"An invariant state or rotation average has zero odd expectation; symmetric evolution does not choose a sign.\"\n      },\n      {\n        \"id\": \"S10-B1\",\n        \"class\": \"infinitesimal-bulk-source\",\n        \"outcome\": \"CONDITIONAL-SOURCE\",\n        \"finding\": \"Family 271 constructs a positively magnetized zero-field KMS state by first using h_N=N^(-1/2)>0 in finite boxes and then taking a subsequential thermodynamic limit. The source fixes direction; the theorem establishes a nonzero magnitude lower bound in the selected state.\"\n      },\n      {\n        \"id\": \"S10-B2\",\n        \"class\": \"boundary-field-or-condition\",\n        \"outcome\": \"CONDITIONAL-SOURCE\",\n        \"finding\": \"Family 268 uses equal positive endpoint fields h=3/5 on odd open chains. The field yields a unique finite-volume ground state, a uniform gap above it for L>=960, and index -1 for every subsequential local limit. The boundary datum is explicit and is not derived by the bulk symmetry.\"\n      },\n      {\n        \"id\": \"S10-B3\",\n        \"class\": \"topological-sector-label\",\n        \"outcome\": \"SECTOR-CERTIFICATE-NOT-ORIENTATION-CAUSE\",\n        \"finding\": \"The family-268 index certifies the boundary-selected state after selection. No typed transfer identifies that index with the Spin(2,3) residual orientation or shows that an index value chooses a physical sign.\"\n      },\n      {\n        \"id\": \"S10-B4\",\n        \"class\": \"initial-state-asymmetry\",\n        \"outcome\": \"CONDITIONAL-SOURCE\",\n        \"finding\": \"An asymmetric state can transmit a sign, but neither family derives the state choice from exchange-symmetric premises.\"\n      },\n      {\n        \"id\": \"S10-B5\",\n        \"class\": \"environmental-asymmetry\",\n        \"outcome\": \"CONDITIONAL-SOURCE\",\n        \"finding\": \"An oriented environment acts like a source or boundary condition; the earliest odd environmental datum remains the selector.\"\n      },\n      {\n        \"id\": \"S10-B6\",\n        \"class\": \"measurement-or-calibration\",\n        \"outcome\": \"OPERATIONAL-LABEL-ONLY\",\n        \"finding\": \"Calibration fixes reported sign but does not alter or select the underlying state.\"\n      }\n    ],\n    \"sourceScopedResults\": {\n      \"family268\": {\n        \"carrier\": \"odd open spin-one antiferromagnetic Heisenberg chain\",\n        \"selector\": \"same positive endpoint magnetic field h=3/5\",\n        \"finiteVolumeConclusion\": \"gap greater than log(10)/392 for every L>=960 and unique finite-volume ground line\",\n        \"limitConclusion\": \"each subsequential local limit is locally unique and gapped, with Tasaki index -1\",\n        \"limits\": \"does not establish convergence or global uniqueness of the infinite-volume state; does not identify the Tasaki index with Spin(2,3) orientation\"\n      },\n      \"family271\": {\n        \"carrier\": \"nearest-neighbor isotropic quantum Heisenberg ferromagnet on Z^d, d>=3\",\n        \"selector\": \"positive homogeneous field h_N=N^(-1/2) before the thermodynamic limit\",\n        \"conclusion\": \"a translation-invariant zero-field beta-KMS subsequential limit with omega(S_z)>=S/4 at sufficiently low positive temperature\",\n        \"limits\": \"constructs an ordered branch, not a unique direction selected by the rotation-invariant law; rotation averaging may erase the one-point magnetization\"\n      }\n    },\n    \"orderOfLimits\": [\n      \"fixed finite volume then h=0: no source-selected direction follows\",\n      \"finite volume with positive h_N then N to infinity while h_N to zero: positive branch is selected\",\n      \"reverse or rotate the source before the limit: the corresponding reversed or rotated branch is selected\",\n      \"average the orbit of selected states: the odd one-point expectation vanishes\"\n    ],\n    \"candidateOddObservables\": [\n      \"Spin(2,3) residual population difference m=p_plus-p_minus\",\n      \"projector difference Tr[rho(P_plus-P_minus)]\",\n      \"Heisenberg one-site magnetization omega(S_z)\",\n      \"boundary-source sign sign(h)\",\n      \"oriented response difference O(control)-O(reversed-control)\"\n    ],\n    \"antiCircularityTest\": \"Delete or reverse the earliest odd datum. If the claimed unique sign disappears or reverses, the mechanism transmits that datum and does not derive orientation intrinsically.\",\n    \"result\": \"EXTERNAL-SELECTORS-CONDITIONAL; ORIGIN-STILL-UNFIXED\"\n  },\n  \"srp12\": {\n    \"question\": \"Which topological or spectral statements survive declared perturbations, and which topology-to-dynamics implications fail?\",\n    \"meceBranches\": [\n      {\n        \"id\": \"S12-R0\",\n        \"class\": \"invariant-without-gap\",\n        \"outcome\": \"INSUFFICIENT-FOR-DYNAMICAL-ROBUSTNESS\",\n        \"finding\": \"A homotopy or homology invariant alone supplies no relaxation, entropy, transport, or open-system theorem.\"\n      },\n      {\n        \"id\": \"S12-R1\",\n        \"class\": \"uniform-gap-without-perturbation-theorem\",\n        \"outcome\": \"UNPERTURBED-ONLY\",\n        \"finding\": \"The family-269 Lean scope proves unperturbed Laughlin gap inequalities; it does not formalize disorder stability or perturbed-ground-state uniqueness.\"\n      },\n      {\n        \"id\": \"S12-R2\",\n        \"class\": \"uniform-gap-stable-in-declared-class\",\n        \"outcome\": \"ROBUST-IN-SOURCE-DOMAIN\",\n        \"finding\": \"The family-269 paper proves a uniform gap and unique perturbed ground state for sufficiently large spherical filling-1/3 systems under sufficiently weak bounded real scalar potentials projected to the lowest Landau level.\"\n      },\n      {\n        \"id\": \"S12-R3\",\n        \"class\": \"topological-action-without-dynamical-complexity\",\n        \"outcome\": \"COUNTERMODEL\",\n        \"finding\": \"Family 151 constructs a noninvertible C1 self-map of a compact smooth manifold with zero topological entropy while the induced H_2 map has eigenvalue 2. Homological growth therefore does not imply orbit complexity in that class.\"\n      },\n      {\n        \"id\": \"S12-R4\",\n        \"class\": \"dynamical-change-without-topological-change\",\n        \"outcome\": \"COUNTERMODEL\",\n        \"finding\": \"Paper 3 keeps the QWZ Hamiltonian and its closed-system Chern number fixed while its proposed dephasing parameter continuously changes the effective Hall response. Thus response dynamics can change without changing the Hamiltonian invariant.\"\n      },\n      {\n        \"id\": \"S12-R5\",\n        \"class\": \"finite-size-or-regularization-artifact\",\n        \"outcome\": \"REQUIRES-CONVERGENCE-AUDIT\",\n        \"finding\": \"Finite-grid Chern and cusp calculations are evidence for the implemented model only; exact gap closures are regularized and small-gamma claims require grid and limit checks.\"\n      }\n    ],\n    \"family269Contract\": {\n      \"carrier\": \"antisymmetric N-particle lowest-Landau-level space on a sphere with q=3(N-1)\",\n      \"parentHamiltonian\": \"full V1 Haldane pseudopotential with coefficient one per pair\",\n      \"unperturbedKernel\": \"one-dimensional cubic Laughlin line at filling 1/3 with spherical shift\",\n      \"perturbation\": \"lambda times the sum of lowest-Landau-level Toeplitz operators of a real bounded scalar potential with sup norm at most one\",\n      \"uniformity\": \"constants lambda_*, Delta_* and N_* independent of N and of the allowed potential\",\n      \"paperConclusion\": \"for N>=N_* and |lambda|<=lambda_*, the first spectral gap is at least Delta_* and the perturbed ground state is unique\",\n      \"leanScope\": \"unperturbed gap inequalities only\",\n      \"nonTransfers\": [\n        \"not a theorem about Lindblad generators or non-Hermitian self-energies\",\n        \"not a theorem about the two-band QWZ lattice carrier\",\n        \"not a theorem that Hall response remains quantized under dephasing\",\n        \"not a generic consequence of a Chern or winding number alone\"\n      ]\n    },\n    \"topologyDynamicsMatrix\": [\n      {\n        \"antecedent\": \"nonzero DIII/AIII winding of the gapped S3 family in paper 2\",\n        \"conclusion\": \"the map has |W3|=1\",\n        \"status\": \"SUPPORTED-BY-EXPLICIT-COMPUTATION\"\n      },\n      {\n        \"antecedent\": \"nonzero winding\",\n        \"conclusion\": \"the massless equator is physically realized as a transition\",\n        \"status\": \"PROPOSAL-ONLY\"\n      },\n      {\n        \"antecedent\": \"nonzero winding\",\n        \"conclusion\": \"specified dissipative or transport dynamics follows\",\n        \"status\": \"REJECTED-WITHOUT-ADDITIONAL-MAP\"\n      },\n      {\n        \"antecedent\": \"QWZ band gap stays open under a Hamiltonian perturbation\",\n        \"conclusion\": \"closed-system Chern number is unchanged\",\n        \"status\": \"STANDARD-MODEL-LOCAL-CLAIM; NOT-REPROVED-HERE\"\n      },\n      {\n        \"antecedent\": \"QWZ Chern number unchanged\",\n        \"conclusion\": \"paper-3 open-system Hall response is unchanged\",\n        \"status\": \"FALSE-IN-PAPER-3-MODEL\"\n      },\n      {\n        \"antecedent\": \"Laughlin parent gap and local estimates in family 269\",\n        \"conclusion\": \"gap persists for the source-declared scalar-potential class\",\n        \"status\": \"SOURCE-PAPER-THEOREM; LEAN-SCOPE-UNPERTURBED-ONLY\"\n      }\n    ],\n    \"revisedAuthority\": {\n      \"paper2\": {\n        \"windingComputation\": \"scoped-mathematical-result\",\n        \"sign\": \"convention-dependent\",\n        \"nontriviality\": \"convention-independent within the declared family\",\n        \"physicalTransitionInterpretation\": \"proposal-only\",\n        \"dynamicsOrMaterialRealization\": \"not-established\"\n      },\n      \"paper3\": {\n        \"closedQWZChernMap\": \"model-local\",\n        \"dephasingFormula\": \"model-assumption-requiring-independent-open-system-derivation\",\n        \"doubledCusp\": \"numerical-model-prediction\",\n        \"LaughlinStabilityTransfer\": \"not-applicable\",\n        \"Spin23Dependence\": \"none\"\n      }\n    },\n    \"result\": \"TOPOLOGY-DOES-NOT-DETERMINE-DYNAMICS; ROBUSTNESS-IS-CARRIER-AND-PERTURBATION-CLASS-SPECIFIC\"\n  },\n  \"synthesis\": {\n    \"orientationPosition\": \"External fields and boundary conditions provide operationally testable conditional selectors, but no source closes the origin problem.\",\n    \"robustnessPosition\": \"Paper 2's winding computation survives as a scoped invariant calculation; paper 3's response claims remain model-local. Family 269 supplies a proof template, not a transfer theorem.\",\n    \"newFalsifier\": \"Any claimed intrinsic selector must retain a unique physical sign after deletion or reversal of every source, boundary, initial-state, environment, conditioning, and calibration odd datum.\",\n    \"newAdmissionRule\": \"A robustness claim must name the carrier, Hamiltonian or generator, gap notion, system-size quantifier, perturbation norm and observable; matching only the word topological is inadmissible.\",\n    \"authorityBoundary\": \"Proposal-only integration; no theorem was independently reconstructed and no canonical scientific admission is granted.\"\n  }\n}\n")

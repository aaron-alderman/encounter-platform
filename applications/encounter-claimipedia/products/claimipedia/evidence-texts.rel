("v6", "scalar", "{\n  \"protocol\": \"rio-022-prospective-neutrino-lock/1\",\n  \"id\": \"RIO-022-W3-RECEIPT\",\n  \"lockedAt\": \"2026-10-09\",\n  \"target\": 0.029179606750063085,\n  \"rung\": 2,\n  \"ordering\": \"normal\",\n  \"lightestMassBoundary\": \"m1=0\",\n  \"observable\": \"Delta m^2_21 / Delta m^2_31\",\n  \"oneSidedKillZ\": 3,\n  \"oneSidedKillP\": 0.00135,\n  \"requiresJointProfileOrCovariance\": true,\n  \"missingDataOutcome\": \"not-evaluable\",\n  \"allowsRungMigration\": false,\n  \"survivalMeansConfirmation\": false\n}\n")

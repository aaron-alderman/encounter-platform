("v89", "scalar", "theorem BookProof.ChapterPauliLorentz.spinorMap_preserves_mink (T : Matrix (Fin 2) (Fin 2) ℂ) (hT : T.det = 1)\n    (x : Fin 4 → ℝ) :\n    mink (vecOfMat (Tᴴ * hermMat x * T)) = mink x")
("v88", "value", "v89")

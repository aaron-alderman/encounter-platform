("v6485", "key", "attributedClaim")
("v6486", "type", "String")
("v6486", "scalar", "Computational irreducibility makes explicit execution indispensable because some rule outcomes cannot be obtained by a substantially shorter predictive procedure and infinite-time questions may be undecidable.")

("v6628", "key", "attributedClaim")
("v6629", "type", "String")
("v6629", "scalar", "Lifted-product constructions over non-abelian groups yield asymptotically good quantum LDPC codes and asymptotically good locally testable classical LDPC codes.")
("v6628", "value", "v6629")
("v6621", "entry", "v6630")
("v6630", "type", "Entry")
("v6630", "key", "steelman")
("v6631", "type", "String")
("v6631", "scalar", "This is a rigorous local-to-global result: bounded-weight local checks can define code families with nonvanishing rate and relative distance, while the classical family also has constant-query local testability. It provides a mathematically serious analogue for global sectors stabilized by distributed constraints.")
("v6630", "value", "v6631")

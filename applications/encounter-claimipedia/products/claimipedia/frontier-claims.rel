("v5793", "key", "steelman")
("v5794", "type", "String")
("v5794", "scalar", "The construction offers a tractable route from a background containing open-string sectors to families of D-brane configurations without demanding that D-branes arise as ordinary closed-string solitons. Its scope is charge-neutral configurations plus compensated charges and deformations that preserve the required periodic structure.")
("v5793", "value", "v5794")

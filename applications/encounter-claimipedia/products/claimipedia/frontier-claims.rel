("v5419", "type", "String")
("v5419", "scalar", "The scope correction is valid: a neighboring experimental bound is not automatically a direct exclusion of a differently defined field. Yet any viable enlarged connection must still reproduce the tested long-distance subalgebra, and its explicit currents, ranges and residues determine which existing bounds transfer.")
("v5418", "value", "v5419")

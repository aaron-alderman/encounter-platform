("v5747", "entry", "v5754")
("v5754", "type", "Entry")
("v5754", "key", "attributedClaim")
("v5755", "type", "String")
("v5755", "scalar", "The zero-energy rolling-tachyon vacuum is represented after Euclidean continuation by periodic imaginary-time arrays of D-instantons or Euclidean D-branes, while usual perturbative closed-string amplitudes remain unchanged.")
("v5754", "value", "v5755")
("v5747", "entry", "v5756")
("v5756", "type", "Entry")
("v5756", "key", "steelman")
("v5757", "type", "String")
("v5757", "scalar", "Within boundary conformal field theory, an exactly marginal rolling-tachyon deformation reaches a zero-energy configuration whose boundary state vanishes on the real-time contour, while instanton contributions reappear when the integration contour threads the imaginary-time poles. This is a concrete contour-sensitive nonperturbative construction, not a claim that physical time is literally periodic.")
("v5756", "value", "v5757")
("v5747", "entry", "v5758")

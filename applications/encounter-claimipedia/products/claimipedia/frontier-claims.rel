("v5641", "key", "attributedClaim")
("v5642", "type", "String")
("v5642", "scalar", "Maximally localized flat-band Bloch states of Chern number C solve a CP^(N-1) sigma-model instanton equation on the Brillouin torus, where C is the instanton number and ideal bands admit a color-entangled Landau-level representation.")
("v5641", "value", "v5642")
("v5634", "entry", "v5643")
("v5643", "type", "Entry")
("v5643", "key", "steelman")
("v5644", "type", "String")
("v5644", "scalar", "This is potentially the cleanest bridge in the bundle: a variational bound on localization or hopping may be saturated exactly by holomorphic sigma-model configurations, turning a band invariant into a geometric instanton charge. The Landau-level representation would then explain why ideal Chern bands inherit fractional-Hall algebraic structure.")
("v5643", "value", "v5644")

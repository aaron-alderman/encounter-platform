("v8831", "entry", "v8840")
("v8840", "type", "Entry")
("v8840", "key", "steelman")
("v8841", "type", "String")
("v8841", "scalar", "The calculation provides a controlled example in which an ambient graviton couples to the energy carried by a localized gauge field without requiring one-photon vacuum conversion. Expanding the stress tensor around an independently supplied electromagnetic background may create a bilinear fluctuation kernel, but that background-assisted inference is Claimipedia's proposed test, not a result demonstrated by the paper.")
("v8840", "value", "v8841")

process-module "temple/surface-process-module/1"

process check.refused:
  port observe.attempt { operation = $operation; arguments = $arguments } → observation
  assert eq($observation.ok, false)
    otherwise "Expected refusal at the observed boundary."
  port text.matches { value = $observation.message; pattern = $diagnostic } → expected
  assert $expected
    otherwise "The boundary refused for a different reason."

process contract.open:
  port front.open { grants = list("value.describe", "number.calculate", "kernel.invoke", "source.observe", "text.matches", "text.slice", "record.entries", "encounter.execute") } → front
  fold list("source/types.encounter", "source/actions.encounter") as file; candidates starts list():
    port file.text { file = $file } → text
    port front.hydrate { front = $front; file = $file; text = $text } → candidate
    yield append($candidates, list($candidate)) → candidates
  let entries = list("types.named", "action.check", "domain.check")
  port front.link { front = $front; candidates = $candidates; roots = $entries } → linked
  port front.admit { front = $front; linked = $linked; entries = $entries } → admission

process test.contract.closed-types:
  call contract.open
  port front.run { front = $front; admission = $admission; entry = "types.named"; input = { name = "Snapshot"; value = { revision = 0; documents = list() } } } → accepted
  let operation = "front.run"
  let diagnostic = "TYPE:"
  each list({ revision = 0; documents = list(); checked = true }, { revision = 0.5; documents = list() }, { revision = "0"; documents = list() }, { revision = 0 }) as invalid:
    let arguments = { front = $front; admission = $admission; entry = "types.named"; input = { name = "Snapshot"; value = $invalid } }
    call check.refused
  port text.slice { value = "x$eventInput is data"; start = 1 } → literal
  each list(false, 0, $literal) as valid:
    port front.run { front = $front; admission = $admission; entry = "types.named"; input = { name = "Scalar"; value = $valid } } → accepted
  let arguments = { front = $front; admission = $admission; entry = "types.named"; input = { name = "Scalar"; value = null } }
  call check.refused

process test.contract.action-source:
  call contract.open
  let prefix = "process-module \"temple/surface-process-module/1\"\nprocess run:\n"
  let action = { id = "Probe"; label = "Probe"; input = "Text"; output = "Text"; source = "actions/Probe.encounter" }
  let bindings = { documents = list({ path = $action.source; text = concat($prefix, "  let result = concat($eventInput, \"!\")\n") }) }
  port front.run { front = $front; admission = $admission; entry = "action.check"; input = $action; bindings = $bindings } → accepted
  let operation = "front.run"
  let diagnostic = "ACTION:"
  each list("  let result = 42", "  let result = $state.intent", "  let result = if(true, $eventInput, 42)", "  let result = add($eventInput, 1)", "  port storage.cas {} → result", "  let result = $eventInput\nprocess hidden:\n  let result = 1") as code:
    let bindings = { documents = list({ path = $action.source; text = concat($prefix, $code, "\n") }) }
    let arguments = { front = $front; admission = $admission; entry = "action.check"; input = $action; bindings = $bindings }
    call check.refused

process test.contract.nominal-roles:
  call contract.open
  let definitions = list({ id = "A"; label = "A"; fields = list() }, { id = "B"; label = "B"; fields = list() })
  let a = { type = "A"; alias = "X"; values = {} }
  let b = { type = "B"; alias = "Y"; values = {} }
  let domain = { intent = "Disposable contract fixture"; definitions = $definitions; things = list({ id = "both"; label = "Both"; roles = list($a, $b) }); actions = list(); projections = list(); overlays = list(); jobs = list() }
  port front.run { front = $front; admission = $admission; entry = "domain.check"; input = $domain } → accepted
  let operation = "front.run"
  each list({ role = { type = "A"; alias = "Y"; values = {} }; message = "One participation" }, { role = { type = "B"; alias = "X"; values = {} }; message = "distinct explicit aliases" }) as invalid:
    let things = list({ id = "both"; label = "Both"; roles = list($a, $invalid.role) })
    port record.put { record = $domain; key = "things"; value = $things } → input
    let arguments = { front = $front; admission = $admission; entry = "domain.check"; input = $input }
    let diagnostic = $invalid.message
    call check.refused
  let invalidDefinitions = list({ id = "A"; label = "A"; fields = list({ id = "Ref"; label = "Ref"; kind = "Reference"; expects = "Missing" }) }, at($definitions, 1))
  port record.put { record = $domain; key = "definitions"; value = $invalidDefinitions } → input
  let arguments = { front = $front; admission = $admission; entry = "domain.check"; input = $input }
  let diagnostic = "Reference target type is missing"
  call check.refused

process test.contract.compiler-owned-admission:
  port front.open { grants = list() } → front
  port front.open { grants = list() } → otherFront
  let text = "process-module \"temple/surface-process-module/1\"\nprocess run:\n  let result = 1\n"
  port front.hydrate { front = $front; file = "test/probe.encounter"; text = $text } → candidate
  port handle.copy { handle = $candidate } → copied
  port front.hydrate { front = $otherFront; file = "test/probe.encounter"; text = $text } → foreign
  let operation = "front.link"
  let diagnostic = "Foreign or forged Encounter hydration"
  each list({ queries = {} }, $copied, { rel = $copied.rel }, $foreign) as forged:
    let arguments = { front = $front; candidates = list($forged) }
    call check.refused
  let operation = "front.hydrate"
  let arguments = { front = $front; file = "test/bad.encounter"; text = "{\"queries\":{\"run\":[]}}" }
  let diagnostic = "Encounter|SOURCE|module"
  call check.refused
  let operation = "front.admit"
  let arguments = { front = $front; linked = { queries = {} }; entries = list("run") }
  let diagnostic = "Compiler-owned linked hydration"
  call check.refused
  port rel.read { text = $copied.rel; kind = "EncounterHydration" } → hydrated
  port value.describe { value = $hydrated.queries } → description
  assert eq($description.type, "object")
    otherwise "The hydration receipt must contain inspectable query data."
  port front.link { front = $front; candidates = list($candidate); roots = list("run") } → linked
  port front.admit { front = $front; linked = $linked; entries = list("run") } → admission
  port front.run { front = $front; admission = $admission; entry = "run" } → result
  assert eq($result, 1)
    otherwise "A genuine compiler-owned admission must execute."

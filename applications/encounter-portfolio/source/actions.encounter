process-module "temple/surface-process-module/1"

process source.get:
  let found = filter($documents, "document", eq($document.path, $eventInput))
  assert eq(count($found), 1)
    otherwise "SOURCE: The exact source document is missing or ambiguous."
  let result = at(at($found, 0), "text")

process expression.type:
  let expression = $eventInput.expression
  let depth = add($eventInput.depth, 1)
  port number.calculate { operation = "lessEqual"; values = list($depth, 32) } → bounded
  assert $bounded
    otherwise "ACTION: Expression nesting exceeds the supported type-checking bound."
  port value.describe { value = $expression } → shape
  let inferred = ""
  when eq($shape.type, "string"):
    let inferred = "Text"
    port text.slice { value = $expression; start = 0; end = 1 } → prefix
    when eq($prefix, at(" $", 1)):
      assert eq($expression, concat(at(" $", 1), "eventInput"))
        otherwise "ACTION: Only the declared input is available. Ambient bindings are not authored locals."
      let inferred = $eventInput.input
  when eq($shape.type, "number"):
    assert $shape.finite
      otherwise "ACTION: Numbers must be finite."
    let inferred = "Number"
  when eq($shape.type, "boolean"):
    let inferred = "Boolean"
  when $shape.array:
    let operator = at($expression, 0)
    assert includes(list("concat", "add", "if", "eq"), $operator)
      otherwise "ACTION: This expression profile supports input, scalar literals, concat, add, if and eq."
    let children = filter(map($expression, "item", { value = $item }), "item", true)
    fold range(count($expression)) as index; types starts list():
      when not(eq($index, count($expression))):
        port kernel.invoke { query = "expression.type"; input = { expression = at($expression, $index); input = $eventInput.input; depth = $depth } } → inferredChild
        let types = append($types, list($inferredChild))
      yield $types → types
    when eq($operator, "concat"):
      assert every($types, "type", eq($type, "Text"))
        otherwise "ACTION: concat requires Text arguments."
      let inferred = "Text"
    when eq($operator, "add"):
      assert and(eq(count($types), 2), every($types, "type", eq($type, "Number")))
        otherwise "ACTION: add requires exactly two Number arguments."
      let inferred = "Number"
    when eq($operator, "eq"):
      assert and(eq(count($types), 2), eq(at($types, 0), at($types, 1)))
        otherwise "ACTION: eq requires two arguments of the same type."
      let inferred = "Boolean"
    when eq($operator, "if"):
      assert and(eq(count($types), 3), eq(at($types, 0), "Boolean"), eq(at($types, 1), at($types, 2)))
        otherwise "ACTION: if requires a Boolean condition and equally typed branches."
      let inferred = at($types, 1)
  assert not(eq($inferred, ""))
    otherwise "ACTION: Unsupported value or expression."
  let result = $inferred

process action.check:
  let action = $eventInput
  assert and(includes(list("Text", "Number", "Boolean"), $action.input), includes(list("Text", "Number", "Boolean"), $action.output))
    otherwise "ACTION: Declare supported scalar input and output types."
  port kernel.invoke { query = "source.get"; input = $action.source } → code
  port source.observe { file = $action.source; text = $code } → observed
  port record.entries { value = $observed.module.queries } → queries
  assert and(eq(count($queries), 1), eq(at(at($queries, 0), 0), "run"))
    otherwise "ACTION: This first profile requires exactly one process named run."
  let programme = at(at($queries, 0), 1)
  assert and(eq(count($programme), 1), eq(at(at($programme, 0), "let"), "result"))
    otherwise "ACTION: Use one expression-valued result. Larger process forms require a separate typed profile."
  let expression = at(at($programme, 0), "value")
  port kernel.invoke { query = "expression.type"; input = { expression = $expression; input = $action.input; depth = 0 } } → inferred
  assert eq($inferred, $action.output)
    otherwise "ACTION: The inferred result does not match the declared output type."
  let inverse = "none"
  let suffix = ""
  when eq($expression, concat(at(" $", 1), "eventInput")):
    let inverse = "identity"
  port value.describe { value = $expression } → shape
  when and($shape.array, eq(count($expression), 3), eq(at($expression, 0), "concat"), eq(at($expression, 1), concat(at(" $", 1), "eventInput"))):
    let candidate = at($expression, 2)
    port value.describe { value = $candidate } → suffixShape
    port text.slice { value = if(eq($suffixShape.type, "string"), $candidate, ""); start = 0; end = 1 } → prefix
    when and(eq($suffixShape.type, "string"), not(eq($prefix, at(" $", 1)))):
      let inverse = "suffix"
      let suffix = $candidate
  let result = { inverse = $inverse; suffix = $suffix }

process action.run:
  let action = $eventInput.action
  let value = $eventInput.value
  let kind = if(eq($action.input, "Text"), "text", if(eq($action.input, "Number"), "number", "boolean"))
  port kernel.invoke { query = "types.check"; input = { type = { kind = $kind }; value = $value; depth = 0 } } → _
  port kernel.invoke { query = "action.check"; input = $action } → checked
  port kernel.invoke { query = "source.get"; input = $action.source } → code
  port encounter.execute { text = $code; entry = "run"; input = $value } → output
  let kind = if(eq($action.output, "Text"), "text", if(eq($action.output, "Number"), "number", "boolean"))
  port kernel.invoke { query = "types.check"; input = { type = { kind = $kind }; value = $output; depth = 0 } } → _
  let result = $output

process projection.value:
  let projection = $eventInput
  let thing = at(filter($state.things, "thing", eq($thing.id, $projection.thing)), 0)
  let role = at(filter($thing.roles, "role", eq($role.alias, $projection.alias)), 0)
  let sourceValue = at($role.values, $projection.field)
  let value = $sourceValue
  let inverse = "identity"
  let suffix = ""
  let source = concat("thing/", $thing.id, "/", $role.type, " as ", if(eq($role.alias, ""), "unaliased", $role.alias), "/", $projection.field)
  when not(eq($projection.action, "")):
    let action = at(filter($state.actions, "action", eq($action.id, $projection.action)), 0)
    port kernel.invoke { query = "action.check"; input = $action } → mapping
    let inverse = $mapping.inverse
    let suffix = $mapping.suffix
    port kernel.invoke { query = "action.run"; input = { action = $action; value = $value } } → value
    let source = concat($source, " through ", $action.source)
  let overlays = filter($state.overlays, "overlay", eq($overlay.projection, $projection.id))
  when count($overlays):
    let value = at(at($overlays, 0), "value")
    let inverse = "overlay"
    let source = concat("overlay/", $projection.id, "/web-label")
  let result = { value = $value; input = $sourceValue; inverse = $inverse; suffix = $suffix; source = $source }

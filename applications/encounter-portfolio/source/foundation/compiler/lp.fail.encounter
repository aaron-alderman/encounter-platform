process-module "temple/surface-process-module/1"
profile "encounter/reconstituted-source/1"

process lp.fail:
  port rel.encode {
    value = {
      code = at($eventInput, "code");
      phase = "process-text";
      boundary = "encounter-process-text/1";
      summary = at($eventInput, "summary");
      span = {
        file = $lpFile;
        start = at(at($eventInput, "token"), "start");
        end = at(at($eventInput, "token"), "end");
        line = at(at($eventInput, "token"), "line");
        column = at(at($eventInput, "token"), "column")
      };
      correction = "Correct the indicated source and rerun the readable process checks.";
      check = "node --test bootstrap/readable-process.test.cjs"
    }
  } → message
  let result = raise($message)

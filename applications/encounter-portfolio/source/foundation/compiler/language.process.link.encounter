process-module "temple/surface-process-module/1"
profile "encounter/reconstituted-source/1"

process language.process.link:
  port record.entries { value = at(at($eventInput, "surface"), "queries") } → definitions
  fold $definitions as definition; checked starts true:
    port kernel.invoke { query = "lp.linkProgramme"; input = { programme = at($definition, 1) } } → checked
    yield true → checked
  let result = { ok = true; scope = "read-only-core-link-check"; authoredInstallation = false }

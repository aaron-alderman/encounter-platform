("ports", "version", "encounter/ports/1")
("kernel.invoke", "input", "{query:ProcessName,input?:Value}")
("kernel.invoke", "output", "Value")
("kernel.invoke", "effect", "admitted-call")
("kernel.invoke", "failure", "missing-process|recursive-process|meter-exhausted|callee-refusal")
("text.trim", "input", "{value:Text}")
("text.trim", "output", "Text")
("text.trim", "effect", "pure")
("text.trim", "failure", "invalid-arguments")
("text.matches", "input", "{value:Text,pattern:Text}")
("text.matches", "output", "Boolean")
("text.matches", "effect", "pure")
("text.matches", "failure", "invalid-arguments|unsupported-pattern")
("temple.snapshot", "input", "{}")
("temple.snapshot", "output", "{basis:StateRoot,value:Value}")
("temple.snapshot", "effect", "journal-read")
("temple.snapshot", "failure", "invalid-journal|journal-busy")
("temple.submit", "input", "{basis:StateRoot,operation:OperationId,proposal:SignedProposal}")
("temple.submit", "output", "{outcome:accepted|rejected,basis:StateRoot,witness:Witness}")
("temple.submit", "effect", "journal-append")
("temple.submit", "failure", "stale-basis|operation-conflict|invalid-proposal|unknown-write-outcome")
("temple.operation", "input", "{operation:OperationId}")
("temple.operation", "output", "Outcome|Null")
("temple.operation", "effect", "journal-read")
("temple.operation", "failure", "invalid-journal|journal-busy")

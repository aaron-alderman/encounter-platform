("ports", "version", "encounter/application-ports/1")
("application.data", "input", "{name?:Text}")
("application.data", "output", "Value")
("application.data", "effect", "dataset-read")
("application.data", "semantics", "undeclared dataset or invalid arguments")
("digest.sha256", "input", "{text:Text}")
("digest.sha256", "output", "Sha256")
("digest.sha256", "effect", "pure")
("digest.sha256", "semantics", "invalid text; lowercase digest of UTF-8 bytes")
("encounter.execute", "input", "{text:Text,entry:run,input:Value}")
("encounter.execute", "output", "Value")
("encounter.execute", "effect", "bounded-evaluation")
("encounter.execute", "semantics", "unsupported entry, impure or invalid expression, or exhausted meter")
("kernel.invoke", "input", "{query:ProcessName,input?:Value}")
("kernel.invoke", "output", "Value")
("kernel.invoke", "effect", "admitted-call")
("kernel.invoke", "semantics", "callee refusal, undeclared target, recursion or exhausted meter")
("number.calculate", "input", "{operation:Text,values:Sequence}")
("number.calculate", "output", "Number|Boolean")
("number.calculate", "effect", "pure")
("number.calculate", "semantics", "unsupported operation or nonfinite numeric result")
("record.entries", "input", "{value:Record|Sequence}")
("record.entries", "output", "Sequence<Pair<Text,Value>>")
("record.entries", "effect", "pure")
("record.entries", "semantics", "unsupported value; record key enumeration order is host-specific")
("record.fromEntries", "input", "{entries:Sequence<Pair<Text,Value>>}")
("record.fromEntries", "output", "Record")
("record.fromEntries", "effect", "pure")
("record.fromEntries", "semantics", "invalid pairs or reserved keys; last duplicate wins")
("record.get", "input", "{record:Record,key:Text}")
("record.get", "output", "Value|Null")
("record.get", "effect", "pure")
("record.get", "semantics", "invalid key; absent member yields null")
("record.put", "input", "{record:Record,key:Text,value:Value}")
("record.put", "output", "Record")
("record.put", "effect", "pure")
("record.put", "semantics", "invalid record or reserved key; returns a copy")
("rel.decode", "input", "{text:Text,kind:Text}")
("rel.decode", "output", "Value")
("rel.decode", "effect", "pure")
("rel.decode", "semantics", "invalid data document or kind mismatch")
("rel.encode", "input", "{value:Value,kind:Text}")
("rel.encode", "output", "Text")
("rel.encode", "effect", "pure")
("rel.encode", "semantics", "invalid value or kind")
("scalar.quoteValue", "input", "{value:Value}")
("scalar.quoteValue", "output", "Text")
("scalar.quoteValue", "effect", "pure")
("scalar.quoteValue", "semantics", "unsupported value")
("scalar.read", "input", "{text:Text}")
("scalar.read", "output", "Value")
("scalar.read", "effect", "pure")
("scalar.read", "semantics", "invalid value literal or REL data")
("source.catalogue", "input", "{}")
("source.catalogue", "output", "Sequence<{path,text}>")
("source.catalogue", "effect", "source-read")
("source.catalogue", "semantics", "unbound or invalid arguments")
("source.observe", "input", "{file:Text,text:Text}")
("source.observe", "output", "{sourceHash,module}")
("source.observe", "effect", "bounded-inspection")
("source.observe", "semantics", "invalid or unsupported source, or exhausted meter; output is inspection data")
("storage.cas", "input", "{base,operationId,basis,profile,reason,target,goal,source,description,documents}")
("storage.cas", "output", "Receipt")
("storage.cas", "effect", "atomic-append")
("storage.cas", "semantics", "stale basis, operation conflict, invalid binding or document, or storage failure")
("storage.history", "input", "{}")
("storage.history", "output", "Sequence<HistoryEntry>")
("storage.history", "effect", "store-read")
("storage.history", "semantics", "unbound or storage failure; descending revision order")
("storage.operation", "input", "{operationId:Text}")
("storage.operation", "output", "Receipt|Null")
("storage.operation", "effect", "store-read")
("storage.operation", "semantics", "invalid identity or storage failure")
("storage.snapshot", "input", "{revision?:Integer}")
("storage.snapshot", "output", "{revision,documents}")
("storage.snapshot", "effect", "store-read")
("storage.snapshot", "semantics", "unknown revision or storage failure; absent revision selects head")
("text.indexOf", "input", "{value:Text,search:Text}")
("text.indexOf", "output", "Integer")
("text.indexOf", "effect", "pure")
("text.indexOf", "semantics", "invalid arguments; UTF-16 index or -1")
("text.join", "input", "{values:Sequence,separator:Text}")
("text.join", "output", "Text")
("text.join", "effect", "pure")
("text.join", "semantics", "invalid arguments")
("text.lowerCase", "input", "{value:Text}")
("text.lowerCase", "output", "Text")
("text.lowerCase", "effect", "pure")
("text.lowerCase", "semantics", "invalid arguments")
("text.matches", "input", "{value:Text,pattern:Text,flags?:Text}")
("text.matches", "output", "Boolean")
("text.matches", "effect", "pure")
("text.matches", "semantics", "invalid arguments or unsupported pattern; bounded Rust profile")
("text.replaceAll", "input", "{value:Text,search:Text,replacement:Text}")
("text.replaceAll", "output", "Text")
("text.replaceAll", "effect", "pure")
("text.replaceAll", "semantics", "invalid arguments; portable profile uses literal replacements without substitutions")
("text.slice", "input", "{value:Text,start:Integer,end?:Integer}")
("text.slice", "output", "Text")
("text.slice", "effect", "pure")
("text.slice", "semantics", "nonnegative UTF-16 indices on scalar boundaries in the portable profile")
("text.split", "input", "{value:Text,pattern:Text}")
("text.split", "output", "Sequence<Text>")
("text.split", "effect", "pure")
("text.split", "semantics", "portable profile only accepts the LF or CRLF pattern")
("text.trim", "input", "{value:Text}")
("text.trim", "output", "Text")
("text.trim", "effect", "pure")
("text.trim", "semantics", "invalid arguments; ECMAScript whitespace")
("value.describe", "input", "{value:Value}")
("value.describe", "output", "{type,array,null,plain,finite,dataOnly,dense}")
("value.describe", "effect", "pure")
("value.describe", "semantics", "common data values only")
("value.string", "input", "{value:Value}")
("value.string", "output", "Text")
("value.string", "effect", "pure")
("value.string", "semantics", "common data values only; ECMAScript text conversion")
("value.type", "input", "{value:Value}")
("value.type", "output", "Text")
("value.type", "effect", "pure")
("value.type", "semantics", "common data values only; ECMAScript type label")
("number.calculate", "operations", "divide subtract remainder multiply round floor min max less lessEqual greater greaterEqual")
("text.matches", "patternProfile", "identifier, HTML name and policy checks, lowercase hex token, HTTP URL, bounded lengths, date and decimal form checks")
("source.observe", "profile", "single pure scalar result expression, entry run")
("encounter.execute", "profile", "single pure scalar result expression, entry run")

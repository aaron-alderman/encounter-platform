// Shared application host contract. The original Temple3 journal bootstrap
// remains pinned separately because its bytes are part of the journal basis.
("platform", "version", "encounter/platform/1")
("platform", "bootstrap", "encounter/application-bootstrap/1")
("platform", "declaration", "encounter/application-declaration/1")
("platform", "ports", "encounter/application-ports/1")
("platform", "launch", "encounter/launch/1")
("platform", "image", "encounter/application-image/2")
("platform", "store", "encounter/sqlite-revisions/1")
("platform", "journal", "encounter/source-command/1")
("bootstrap", "source", "temple/surface-process-module/1")
("bootstrap", "meter", "shared-source-and-evaluation-steps/1")
("bootstrap", "limit", "20000000")
("declaration", "syntax", "REL triples; application subject; ordered module and entry facts; named data.NAME subjects")
("declaration", "required", "stateProfile; at least one module and one entry")
("declaration", "optional", "contract; grant; dataSource; dataFormat; dataSha256; dataset")
("declaration", "defaultContract", "encounter/application-declaration/1")
("declaration", "data", "relative source; optional format and SHA-256; default or named dataset")
("declaration", "admission", "contained paths; verify data pins; link admitted entries; restrict ports to grants")
("declaration", "browser", "app.newSession Null -> Value; app.request Request -> {html,session}; ui.styles Null -> Text")
("declaration", "request", "{method,path,fields,session,snapshot,csrf,nonce,basis,profile,attachments}")
("declaration", "attachment", "optional app.attachment Text -> {path,bytes,sha256}|Null; only application.data and kernel.invoke grants")
("image", "identity", "external file SHA-256; exact executable SHA-256; application basis; embedded file and programme SHA-256")
("image", "compatibility", "a changed executable requires newly pinned images; serving validates pins and admits instructions before opening the store")
("store", "identity", "SQLite workspace.sqlite; stateProfile determines admissibility; basis records the application which made each revision")
("store", "compatibility", "same state profile and readable document schema; a state-profile change requires an explicit migration")
("store", "head", "zero for an empty store; positive safe integer revisions; single immutable parent chain")
("store", "write", "one transaction validates profile and basis, checks operation identity and compare-and-swap head, appends revision and its complete document snapshot")
("store", "retry", "same operation identity, base, document bytes and metadata returns the prior receipt; reuse with different data or a stale base refuses")
("store", "backup", "SQLite online backup or a closed and checkpointed database; never copy a running main database file alone")
("store", "rollback", "reopen current state with the old executable and matching old image only where document compatibility was qualified; restore earlier backup separately")
("launch", "syntax", "REL triples with launch subject; version, mode and unsigned 16-bit port")
("launch", "image", "image, sha256, store, optional attachmentRoot; serve")
("attachment", "route", "GET /attachments/ID; requires an operator mount and the declared app.attachment entry")
("attachment", "identity", "opaque ID selected by Encounter; relative path, exact byte count and lowercase SHA-256 from the application")
("attachment", "bounds", "single regular file; at most 16777216 bytes; refuse changed, missing, symlinked or unpinned content")
("attachment", "response", "application/octet-stream with encoded attachment filename; no cache; refusal does not return file bytes")
("launch", "workgarden-journal", "runtimeRoot, journal; serve, run, test")
("launch", "paths", "absolute or relative to the resolved configuration file; test uses its own temporary journal")
("launch", "lifecycle", "loopback bind; emit bound origin; close on SIGTERM, SIGINT or stdin close command")

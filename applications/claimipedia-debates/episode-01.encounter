# Worked reference for the Claimipedia Debates broadcast template.
# Copy this file, rename the process and replace the episode record for a new cut.
# Use source frames at 25 fps. Set revealFrame = inFrame for an immediate picture reveal.
# Measure narration holds including the head and tail padding. Review picture order and conduct cues against the source.
# Keep summaries and assessment prose specific to individual arguments. Review neutral wording before export.
process-module "temple/surface-process-module/1"
profile "usewords/process/1"

process debates.episode01:
  let result = {
    label = "EP 01";
    title = "Can work and family life coexist?";
    topic = "Work / motherhood / the economy";
    source = {

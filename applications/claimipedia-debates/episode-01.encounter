    intro = { frames = 253; narration = "This is Claimipedia Debates. Rachel Wilson and Kyla Turner, known as Not So Erudite, discuss work, motherhood, and the economy." };
    claims = list(
      {
        id = "claim-01";
        sourceFrame = 1169;
        holdFrames = 233;
        speakers = list("right");
        claimIds = list("R01");
        title = "Future military manpower";
        copy = "Wilson asks what a society should prioritize if it needs more future recruits. That comparison needs a forecast of recruitment as well as births.";
        narration = "Wilson asks what a society should prioritize if it needs more future recruits. That comparison needs a forecast of recruitment as well as births."
      },
      {
        id = "claim-02";
        sourceFrame = 1374;
        holdFrames = 356;
        speakers = list("right");
        claimIds = list("R02", "R03");
        title = "45 million more workers?";
        copy = "The closest source match estimates a hypothetical working-age population. To get from that to workers, we need birth and survival assumptions and a model of who would actually join the labor force. The one-third figure also needs a denominator.";
        narration = "The closest source match estimates a hypothetical working-age population. To get from that to workers, we need birth and survival assumptions and a model of who would actually join the labor force. The one-third figure also needs a denominator."
      },
      {
        id = "claim-03";
        sourceFrame = 1626;
        holdFrames = 279;
        speakers = list("left");
        claimIds = list("N01");
        title = "Who bears the near-term cost?";
        copy = "NotSoErudite raises public assistance and single parenthood. Assistance belongs in a net comparison. Her broader claim about who would parent alone needs separate evidence.";

        holdFrames = 322;
        speakers = list("left");
        claimIds = list("N04");
        title = "The opportunity cost of exclusion";
        copy = "NotSoErudite introduces a real counterweight to the future labor supply argument. To quantify it, we need to know who would work fewer hours, who would leave paid work, and what arrangement is being proposed.";
        narration = "NotSoErudite introduces a real counterweight to the future labor supply argument. To quantify it, we need to know who would work fewer hours, who would leave paid work, and what arrangement is being proposed."
      },

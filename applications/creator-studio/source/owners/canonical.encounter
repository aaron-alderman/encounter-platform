  )
  let contractTextPart4 = list(
    "(\"iface.experiment.Context\", \"mode\", \"closed\")",
    "(\"iface.experiment.Context\", \"slot\", \"slot.experiment.Context.C.view\")",
    "(\"slot.experiment.Context.C.view\", \"isa\", \"Slot\")",
    "(\"slot.experiment.Context.C.view\", \"predicate\", \"C.view\")",
    "(\"slot.experiment.Context.C.view\", \"valueType\", \"string\")",
    "(\"slot.experiment.Context.C.view\", \"cardinality\", \"one\")",
    "",
    "(\"slot.experiment.Story.S.Content\", \"storage\", \"entries\")",
    "(\"slot.experiment.Story.S.Content\", \"entryType\", \"TextEntry\")",
    "(\"slot.experiment.Story.S.Content\", \"entryField\", \"E.value\")",
    "(\"iface.experiment.TextEntry\", \"isa\", \"Interface\")",
    "(\"iface.experiment.TextEntry\", \"type\", \"TextEntry\")",
    "(\"iface.experiment.TextEntry\", \"mode\", \"closed\")",
    "(\"iface.experiment.TextEntry\", \"slot\", \"slot.experiment.TextEntry.E.value\")",
    "(\"slot.experiment.TextEntry.E.value\", \"isa\", \"Slot\")",
    "(\"slot.experiment.TextEntry.E.value\", \"predicate\", \"E.value\")",
    "(\"slot.experiment.TextEntry.E.value\", \"valueType\", \"string\")",
    "(\"slot.experiment.TextEntry.E.value\", \"cardinality\", \"one\")",
    "",
    "(\"slot.experiment.Story.S.Title\", \"nonempty\", \"true\")",
    "(\"slot.experiment.NavigationItem.N.label\", \"nonempty\", \"true\")",
    "(\"slot.experiment.Page.P.route\", \"pattern\", \"^encounter-[a-z0-9-]+\\\\.html$\")",

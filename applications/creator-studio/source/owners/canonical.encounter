    "(\"slot.experiment.StoryPanel.P.paragraphs\", \"valueType\", \"string\")",
    "(\"slot.experiment.StoryPanel.P.paragraphs\", \"cardinality\", \"many\")",
    "(\"iface.experiment.StoryPanelAction\", \"isa\", \"Interface\")",
    "(\"iface.experiment.StoryPanelAction\", \"type\", \"StoryPanelAction\")",
    "(\"iface.experiment.StoryPanelAction\", \"mode\", \"closed\")",
    "(\"iface.experiment.StoryPanelAction\", \"slot\", \"slot.experiment.StoryPanelAction.A.process\")",
    "(\"slot.experiment.StoryPanelAction.A.process\", \"isa\", \"Slot\")",

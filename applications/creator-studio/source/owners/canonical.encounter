    "(\"slot.experiment.StoryPanelAction.A.process\", \"cardinality\", \"one\")",
    "(\"slot.experiment.StoryPanelAction.A.process\", \"allowed\", \"OpenStory\")",
    "(\"iface.experiment.StoryPanelAction\", \"slot\", \"slot.experiment.StoryPanelAction.A.accepts\")",
    "(\"slot.experiment.StoryPanelAction.A.accepts\", \"isa\", \"Slot\")",

process-module "temple/surface-process-module/1"
profile "usewords/process/1"

# Representation, REL contracts and compiler definitions for the retained example.

process owner.canonical:
  port text.slice { value = " $"; start = 1; end = 2 } → sigil
  let codeTextPart1 = list(
    "# Experimental syntax: facts and type contracts stay in REL.",
    "module story",
    "",
    "view experiment.page.story of @TheStory isa Page:",
    "  P.subject: source",
    "  P.title: source.S.Title",
    "  P.paragraphs: source.S.Content",
    "  P.route: \"encounter-story.html\"",
    "  edit P.title through source.S.Title",
    "  show as StoryPage",
    "",
    "view experiment.nav.story of @TheStory isa NavigationItem:",
    "  N.label: source.S.Title",
    "  N.target: source",
    "  edit N.label through source.S.Title",
    "",
    "  in @experiment.WebMainMenu:",
    "    N.label: \"The story\"",
    "    edit N.label here",
    "    show as WebLink:",
    "      page: @experiment.page.story",
    "",
    "  in @experiment.MainframeStories:",
    "    show as MainframeRow:",
    "      option: \"01\"",
    "      open: @experiment.openStory",
    "",
    "representation WebLink:",
    "  given navigation as NavigationItem",
    "  given page as Page",
    "  require page.P.subject equals navigation.N.target",
    "  return WebLink:",
    "    W.text: navigation.N.label",
    "    W.href: page.P.route",
    "  render:",
    "    tag: \"a\"",
    "    attrs:",
    "      id: \"experiment-web-link\"",
    "      href: result.W.href",
    "    children:"
  )
  let codeTextPart2 = list(
    "      - result.W.text",
    "  events:",
    "    - selector: \"#experiment-web-link\"",
    "      open: page",
    "",
    "representation MainframeRow:",
    "  given navigation as NavigationItem",
    "  given option as text",
    "  given open as StoryPanelAction",
    "  return MainframeRow:",
    "    R.option: option",
    "    R.label: navigation.N.label",
    "    R.target: navigation.N.target",
    "  render:",
    "    tag: \"table\"",
    "    attrs:",
    "      class: \"experiment-row\"",
    "    children:",
    "      - tag: \"tbody\"",
    "        children:",
    "          - tag: \"tr\"",
    "            children:",
    "              - tag: \"td\"",
    "                children:",
    "                  - result.R.option",
    "              - tag: \"td\"",
    "                children:",
    "                  - tag: \"button\"",
    "                    attrs:",
    "                      id: \"experiment-mainframe-row\"",
    "                      type: \"button\"",
    "                    children:",
    "                      - result.R.label",
    "  events:",
    "    - selector: \"#experiment-mainframe-row\"",
    "      run: open.A.process",
    "      arguments:",
    "        story: navigation.N.target",
    "",
    "representation StoryPage:"
  )
  let codeTextPart3 = list(
    "  given navigation as Page",
    "  return Page:",
    "    P.subject: navigation.P.subject",
    "    P.title: navigation.P.title",
    "    P.paragraphs: navigation.P.paragraphs",
    "    P.route: navigation.P.route",
    "  render:",
    "    tag: \"article\"",
    "    children:",
    "      - tag: \"h2\"",
    "        children:",
    "          - result.P.title",
    "      - each paragraph in result.P.paragraphs:",
    "        tag: \"p\"",
    "        children:",
    "          - paragraph",
    "",
    "representation OpenStory:",
    "  given story as Story",
    "  return StoryPanel:",
    "    P.title: story.S.Title",
    "    P.paragraphs: story.S.Content",
    "  render:",
    "    tag: \"article\"",
    "    children:",
    "      - tag: \"h2\"",
    "        children:",
    "          - result.P.title",
    "      - each paragraph in result.P.paragraphs:",
    "        tag: \"p\"",
    "        children:",
    "          - paragraph",
    ""
  )
  port text.join { values = append(append($codeTextPart1, $codeTextPart2), $codeTextPart3); separator = "\n" } → codeText
  let factTextLines = list(
    "// Story data and explicitly addressed contexts. Facts remain REL.",
    "(\"TheStory\", \"isa\", \"Story\")",
    "(\"TheStory\", \"S.Title\", \"What happened\")",
    "(\"TheStory\", \"S.Content\", \"TheStory.first\")",
    "(\"TheStory\", \"S.Content\", \"TheStory.second\")",
    "(\"experiment.WebMainMenu\", \"isa\", \"Context\")",
    "(\"experiment.WebMainMenu\", \"C.view\", \"experiment.nav.story\")",
    "(\"experiment.MainframeStories\", \"isa\", \"Context\")",
    "(\"experiment.MainframeStories\", \"C.view\", \"experiment.nav.story\")",
    "(\"experiment.openStory\", \"isa\", \"StoryPanelAction\")",
    "(\"experiment.openStory\", \"A.process\", \"OpenStory\")",
    "(\"experiment.openStory\", \"A.accepts\", \"Story\")",
    "(\"experiment.openStory\", \"A.effect\", \"local-navigation\")",
    "",
    "(\"TheStory.first\", \"isa\", \"TextEntry\")",
    "(\"TheStory.first\", \"E.value\", \"The story is long and complicated\")",
    "(\"TheStory.second\", \"isa\", \"TextEntry\")",
    "(\"TheStory.second\", \"E.value\", \"It started 150 years ago\")",
    ""
  )
  port text.join { values = $factTextLines; separator = "\n" } → factText
  let contractTextPart1 = list(
    "// Experimental, closed contract profile. Vocabulary recovered from Sourcery; scope is this slice.",
    "(\"iface.experiment.Story\", \"isa\", \"Interface\")",
    "(\"iface.experiment.Story\", \"type\", \"Story\")",
    "(\"iface.experiment.Story\", \"mode\", \"closed\")",
    "(\"iface.experiment.Story\", \"slot\", \"slot.experiment.Story.S.Title\")",
    "(\"slot.experiment.Story.S.Title\", \"isa\", \"Slot\")",
    "(\"slot.experiment.Story.S.Title\", \"predicate\", \"S.Title\")",
    "(\"slot.experiment.Story.S.Title\", \"valueType\", \"string\")",
    "(\"slot.experiment.Story.S.Title\", \"cardinality\", \"one\")",
    "(\"iface.experiment.Story\", \"slot\", \"slot.experiment.Story.S.Content\")",
    "(\"slot.experiment.Story.S.Content\", \"isa\", \"Slot\")",
    "(\"slot.experiment.Story.S.Content\", \"predicate\", \"S.Content\")",
    "(\"slot.experiment.Story.S.Content\", \"valueType\", \"string\")",
    "(\"slot.experiment.Story.S.Content\", \"cardinality\", \"many\")",
    "(\"iface.experiment.NavigationItem\", \"isa\", \"Interface\")",
    "(\"iface.experiment.NavigationItem\", \"type\", \"NavigationItem\")",
    "(\"iface.experiment.NavigationItem\", \"mode\", \"closed\")",
    "(\"iface.experiment.NavigationItem\", \"slot\", \"slot.experiment.NavigationItem.N.label\")",
    "(\"slot.experiment.NavigationItem.N.label\", \"isa\", \"Slot\")",
    "(\"slot.experiment.NavigationItem.N.label\", \"predicate\", \"N.label\")",
    "(\"slot.experiment.NavigationItem.N.label\", \"valueType\", \"string\")",
    "(\"slot.experiment.NavigationItem.N.label\", \"cardinality\", \"one\")",
    "(\"iface.experiment.NavigationItem\", \"slot\", \"slot.experiment.NavigationItem.N.target\")",
    "(\"slot.experiment.NavigationItem.N.target\", \"isa\", \"Slot\")",
    "(\"slot.experiment.NavigationItem.N.target\", \"predicate\", \"N.target\")",
    "(\"slot.experiment.NavigationItem.N.target\", \"valueType\", \"ref\")",
    "(\"slot.experiment.NavigationItem.N.target\", \"cardinality\", \"one\")",
    "(\"slot.experiment.NavigationItem.N.target\", \"expects\", \"Story\")",
    "(\"iface.experiment.Page\", \"isa\", \"Interface\")",
    "(\"iface.experiment.Page\", \"type\", \"Page\")",
    "(\"iface.experiment.Page\", \"mode\", \"closed\")",
    "(\"iface.experiment.Page\", \"slot\", \"slot.experiment.Page.P.subject\")",
    "(\"slot.experiment.Page.P.subject\", \"isa\", \"Slot\")",
    "(\"slot.experiment.Page.P.subject\", \"predicate\", \"P.subject\")",
    "(\"slot.experiment.Page.P.subject\", \"valueType\", \"ref\")",
    "(\"slot.experiment.Page.P.subject\", \"cardinality\", \"one\")",
    "(\"slot.experiment.Page.P.subject\", \"expects\", \"Story\")",
    "(\"iface.experiment.Page\", \"slot\", \"slot.experiment.Page.P.title\")",
    "(\"slot.experiment.Page.P.title\", \"isa\", \"Slot\")",
    "(\"slot.experiment.Page.P.title\", \"predicate\", \"P.title\")"
  )
  let contractTextPart2 = list(
    "(\"slot.experiment.Page.P.title\", \"valueType\", \"string\")",
    "(\"slot.experiment.Page.P.title\", \"cardinality\", \"one\")",
    "(\"iface.experiment.Page\", \"slot\", \"slot.experiment.Page.P.paragraphs\")",
    "(\"slot.experiment.Page.P.paragraphs\", \"isa\", \"Slot\")",
    "(\"slot.experiment.Page.P.paragraphs\", \"predicate\", \"P.paragraphs\")",
    "(\"slot.experiment.Page.P.paragraphs\", \"valueType\", \"string\")",
    "(\"slot.experiment.Page.P.paragraphs\", \"cardinality\", \"many\")",
    "(\"iface.experiment.Page\", \"slot\", \"slot.experiment.Page.P.route\")",
    "(\"slot.experiment.Page.P.route\", \"isa\", \"Slot\")",
    "(\"slot.experiment.Page.P.route\", \"predicate\", \"P.route\")",
    "(\"slot.experiment.Page.P.route\", \"valueType\", \"string\")",
    "(\"slot.experiment.Page.P.route\", \"cardinality\", \"one\")",
    "(\"iface.experiment.WebLink\", \"isa\", \"Interface\")",
    "(\"iface.experiment.WebLink\", \"type\", \"WebLink\")",
    "(\"iface.experiment.WebLink\", \"mode\", \"closed\")",
    "(\"iface.experiment.WebLink\", \"slot\", \"slot.experiment.WebLink.W.text\")",
    "(\"slot.experiment.WebLink.W.text\", \"isa\", \"Slot\")",
    "(\"slot.experiment.WebLink.W.text\", \"predicate\", \"W.text\")",
    "(\"slot.experiment.WebLink.W.text\", \"valueType\", \"string\")",
    "(\"slot.experiment.WebLink.W.text\", \"cardinality\", \"one\")",

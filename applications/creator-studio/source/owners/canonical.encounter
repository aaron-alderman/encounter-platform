    "(\"slot.experiment.WebLink.W.href\", \"valueType\", \"string\")",
    "(\"slot.experiment.WebLink.W.href\", \"cardinality\", \"one\")",
    "(\"iface.experiment.MainframeRow\", \"isa\", \"Interface\")",
    "(\"iface.experiment.MainframeRow\", \"type\", \"MainframeRow\")",
    "(\"iface.experiment.MainframeRow\", \"mode\", \"closed\")",
    "(\"iface.experiment.MainframeRow\", \"slot\", \"slot.experiment.MainframeRow.R.option\")",
    "(\"slot.experiment.MainframeRow.R.option\", \"isa\", \"Slot\")",

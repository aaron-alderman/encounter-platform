          { tag = "p"; attrs = { class = "eyebrow" }; children = list("COLLABORATE") },
          { tag = "h2"; attrs = {}; children = list("Propose a change. Understand it together.") },
          {
            tag = "p";
            attrs = { class = "muted" };
            children = list(
              "Local simulation: Alice and Bob can propose, review and accept. Casey can observe. These personas are not authenticated people."
            )
          },
          {
            tag = "div";
            attrs = { class = "cw-controls" };
            children = list(
              {
                tag = "label";
                attrs = {};
                children = list(
                  "Title for your next proposal",
                  {
                    tag = "input";
                    attrs = { id = "cw-title"; type = "text"; maxlength = 160; placeholder = "Optional — describe the intention" };
                    children = list()
                  }
                )
              }
            )
          },
          {
            tag = "p";
            attrs = {};
            children = list(
              "Use the encounter, journey and construct forms below. They create proposals; accepted material changes only after independent review and acceptance."
            )
          },
          { tag = "p"; attrs = { id = "cw-revision"; class = "muted" }; children = list("Starting…") },
          {
            tag = "label";
            attrs = {};
            children = list("Proposal to inspect", { tag = "select"; attrs = { id = "cw-selection" }; children = list() })

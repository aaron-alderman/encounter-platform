            )
          },
          {
            tag = "div";
            attrs = { class = "ws-toolbar" };
            children = list(
              { tag = "button"; attrs = { id = "cw-review"; type = "button" }; children = list("Record review") },
              {
                tag = "button";
                attrs = { id = "cw-accept"; type = "button"; class = "primary" };
                children = list("Accept selected proposal")

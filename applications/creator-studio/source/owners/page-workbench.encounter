                      { tag = "option"; attrs = { value = "approve" }; children = list("Approve") },
                      { tag = "option"; attrs = { value = "request-changes" }; children = list("Request changes") }
                    )
                  }
                )
              },
              {
                tag = "label";
                attrs = {};
                children = list(
                  "Review or rejection comment",
                  { tag = "textarea"; attrs = { id = "cw-comment"; rows = 2; maxlength = 1000 }; children = list() }

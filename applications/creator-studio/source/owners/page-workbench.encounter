                      { tag = "button"; attrs = { id = "inspect-facts"; type = "button" }; children = list("Shared facts") },
                      { tag = "button"; attrs = { id = "inspect-contract"; type = "button" }; children = list("Type contracts") },
                      { tag = "button"; attrs = { id = "inspect-process"; type = "button" }; children = list("Encounter process") },
                      { tag = "button"; attrs = { id = "inspect-generated"; type = "button" }; children = list("Generated JSON") },
                      { tag = "button"; attrs = { id = "inspect-map"; type = "button" }; children = list("Source map") },
                      { tag = "button"; attrs = { id = "inspect-languages"; type = "button" }; children = list("Languages") },
                      { tag = "button"; attrs = { id = "inspect-receipt"; type = "button" }; children = list("Edit events") }
                    )
                  },
                  {
                    tag = "div";
                    attrs = { class = "source-caption" };
                    children = list(
                      { tag = "strong"; attrs = { id = "inspection-file" }; children = list("Loading…") },
                      { tag = "code"; attrs = { id = "inspection-hash" }; children = list("") }
                    )
                  },
                  {
                    tag = "pre";
                    attrs = { id = "inspection-source"; "aria-label" = "Exact inspected source"; tabindex = 0 };
                    children = list()
                  },
                  {
                    tag = "p";
                    attrs = { id = "presentation-status"; class = "hint"; role = "status" };
                    children = list("Shared Worldwright presenter")
                  },
                  {
                    tag = "p";
                    attrs = { class = "hint" };
                    children = list(
                      "Definitions describe the programme. Edit events record performed changes. Hashes identify exact text; they do not establish human identity."
                    )
                  },
                  {
                    tag = "details";
                    attrs = {};
                    children = list(
                      { tag = "summary"; attrs = {}; children = list("Current identities and edit history") },
                      { tag = "p"; attrs = {}; children = list("Source identity") },
                      { tag = "code"; attrs = { id = "source-hash" }; children = list("") },
                      { tag = "p"; attrs = {}; children = list("Projection identity") },
                      { tag = "code"; attrs = { id = "projection-hash" }; children = list("") },

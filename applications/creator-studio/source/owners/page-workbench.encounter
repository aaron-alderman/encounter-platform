process-module "temple/surface-process-module/1"
profile "usewords/process/1"

# Editing and inspection controls in the retained document.

process owner.workbench:
  let workbench = {
    tag = "details";
    attrs = { id = "mw-workbench"; class = "ws-panel" };
    children = list(
      { tag = "summary"; attrs = {}; children = list("Review changes, encounters and language definitions") },
      {
        tag = "div";
        attrs = { class = "ws-toolbar" };
        children = list(
          { tag = "span"; attrs = { id = "ws-revision" }; children = list("Starting…") },
          {
            tag = "button";
            attrs = { id = "ws-accept"; type = "button"; class = "primary" };
            children = list("Verify history & save")
          },
          {
            tag = "button";
            attrs = { id = "ws-segment"; type = "button"; class = ""; hidden = "hidden" };
            children = list("Start new segment")
          },
          {
            tag = "button";
            attrs = { id = "ws-export"; type = "button"; class = "" };
            children = list("Export proposal history")
          }
        )
      },
      {
        tag = "section";
        attrs = { class = "ws-panel cw-board"; "aria-label" = "Collaborative proposal workbench" };

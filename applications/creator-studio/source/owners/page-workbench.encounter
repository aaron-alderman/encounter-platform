                          { tag = "h2"; attrs = { id = "inspect-heading" }; children = list("Nothing hidden behind the words") }
                        )
                      },
                      { tag = "span"; attrs = { class = "muted" }; children = list("Sources · routes · actual edit events") }
                    )
                  },
                  {
                    tag = "div";

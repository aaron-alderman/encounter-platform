# Usewords language, authoring, inspection and acceptance processes.
# Authoritative source. JSON is a generated representation.
process-module "temple/surface-process-module/1"
profile "usewords/process/1"

process uw.hash:
  port json.stringify { value = $eventInput; space = 0 } → encoded
  port digest.sha256 { text = $encoded } → result

process uw.project:
  port kernel.invoke { query = "ec.prepare"; input = $eventInput } → candidate
  port kernel.invoke { query = "ec.run"; input = { candidate = $candidate } } → projections
  port kernel.invoke { query = "uw.hash"; input = $eventInput } → inputHash
  port kernel.invoke { query = "uw.hash"; input = $projections } → projectionHash
  let result = { inputs = $eventInput; projections = $projections; inputHash = $inputHash; projectionHash = $projectionHash }

process uw.initial:
  port kernel.invoke { query = "uw.project"; input = $data.canonical } → base
  let result = { inputs = $base.inputs; projections = $base.projections; inputHash = $base.inputHash; projectionHash = $base.projectionHash; revision = 0; events = list() }

process uw.parse:
  port value.describe { value = $eventInput } → kind
  assert eq($kind.type, "string")
    otherwise "UW-WORDS: Enter a supported sentence."
  port number.calculate { operation = "lessEqual"; values = list(count($eventInput), 512) } → bounded
  assert $bounded
    otherwise "UW-LIMIT: Words must fit within 512 characters."
  port text.trim { value = $eventInput } → words
  let parsed = null
  fold $data.words.commands as grammar; parsed starts null:
    port text.match { value = $words; pattern = $grammar.pattern } → match
    when $match:
      assert eq($parsed, null)
        otherwise "UW-WORDS: Ambiguous command."
      let parsed = { kind = $grammar.kind; value = if(eq(count($match.groups), 0), "", at($match.groups, 0)) }
      when at($grammar, "target"):
        let parsed = { kind = $grammar.kind; value = at($match.groups, 0); target = $grammar.target }
    yield $parsed → parsed
  assert $parsed
    otherwise "UW-WORDS: Use one of the supported sentence forms below."
  let result = $parsed

process uw.change:
  when eq(at($eventInput.state, "profile"), "journeys.v1"):
    port kernel.invoke { query = "uw.journeyChange"; input = $eventInput } → result
  when not(eq(at($eventInput.state, "profile"), "journeys.v1")):
    let current = $eventInput.state
    let request = $eventInput.request
    assert eq($request.baseRevision, $current.revision)
      otherwise "UW-STALE: The revision changed. Reinspect before editing."
    assert includes(list("shared-title", "menu-label"), $request.kind)
      otherwise "UW-AUTHORITY: Only shared-title and menu-label edits are supported."
    port value.describe { value = $request.value } → valueKind
    assert eq($valueKind.type, "string")
      otherwise "UW-TYPE: An edit value must be text."
    port number.calculate { operation = "lessEqual"; values = list(count($request.value), 160) } → bounded
    assert $bounded
      otherwise "UW-LIMIT: Labels are limited to 160 characters."
    port number.calculate { operation = "less"; values = list(count($current.events), 32) } → bounded
    assert $bounded
      otherwise "UW-LIMIT: Accept or start a new reconstruction after 32 edits."
    port kernel.invoke { query = "ec.prepare"; input = $current.inputs } → candidate
    port kernel.invoke { query = "lab.edit"; input = { candidate = $candidate; kind = if(eq($request.kind, "shared-title"), "title", "web-label"); value = $request.value } } → patched
    port kernel.invoke { query = "uw.project"; input = $patched.candidate.inputs } → next
    assert not(eq($next.inputHash, $current.inputHash))
      otherwise "UW-NOOP: This edit does not change the source."
    let record = { kind = $request.kind; value = $request.value; beforeInputHash = $current.inputHash; afterInputHash = $next.inputHash; afterProjectionHash = $next.projectionHash; destination = $patched.destination }
    let result = { inputs = $next.inputs; projections = $next.projections; inputHash = $next.inputHash; projectionHash = $next.projectionHash; revision = add($current.revision, 1); events = append($current.events, list($record)) }

process uw.reconstruct:
  assert eq($eventInput.protocol, "usewords/acceptance/1")
    otherwise "UW-REPLAY: Unsupported acceptance format."
  let receipt = $eventInput
  assert eq($receipt.body.programHash, $data.programHash)
    otherwise "UW-REPLAY: Process identity differs."
  assert includes(list("example.v1", "journeys.v1"), at($receipt.body, "profile"))
    otherwise "UW-REPLAY: Unknown reconstruction profile."
  assert eq($receipt.body.canonicalHash, if(eq($receipt.body.profile, "journeys.v1"), $data.journeyCanonicalHash, $data.canonicalHash))
    otherwise "UW-REPLAY: Canonical source identity differs."
  port value.describe { value = $receipt.body.events } → eventsKind
  assert $eventsKind.array
    otherwise "UW-REPLAY: Events must be a list."
  port number.calculate { operation = "lessEqual"; values = list(count($receipt.body.events), 32) } → bounded
  assert $bounded
    otherwise "UW-LIMIT: Too many replay events."
  port kernel.invoke { query = "uw.hash"; input = $receipt.body } → receiptHash
  assert eq($receiptHash, $receipt.sha256)
    otherwise "UW-REPLAY: Receipt hash mismatch."
  port kernel.invoke { query = "uw.initial"; input = {  } } → replayed
  when eq($receipt.body.profile, "journeys.v1"):
    port kernel.invoke { query = "uw.journeyInitial"; input = {  } } → replayed
  fold $receipt.body.events as event; replayed starts $replayed:
    port kernel.invoke { query = "uw.change"; input = { state = $replayed; request = { kind = $event.kind; value = $event.value; target = at($event, "target"); baseRevision = $replayed.revision } } } → replayed
    assert eq(at($replayed.events, add(count($replayed.events), -1)), $event)
      otherwise "UW-REPLAY: Event or edit destination differs."
    yield $replayed → replayed
  assert eq($replayed.inputHash, $receipt.body.inputHash)
    otherwise "UW-REPLAY: Final source differs."
  assert eq($replayed.projectionHash, $receipt.body.projectionHash)
    otherwise "UW-REPLAY: Final projections differ."
  assert eq($replayed.revision, $receipt.body.revision)
    otherwise "UW-REPLAY: Final revision differs."
  let result = $replayed

process uw.accept:
  let current = $eventInput.state
  assert eq($eventInput.expectedRevision, $current.revision)
    otherwise "UW-STALE: Acceptance revision changed."
  assert eq($eventInput.expectedInputHash, $current.inputHash)
    otherwise "UW-STALE: Acceptance source changed."
  let body = { profile = if(eq(at($current, "profile"), "journeys.v1"), "journeys.v1", "example.v1"); programHash = $data.programHash; canonicalHash = if(eq(at($current, "profile"), "journeys.v1"), $data.journeyCanonicalHash, $data.canonicalHash); revision = $current.revision; events = $current.events; inputHash = $current.inputHash; projectionHash = $current.projectionHash }
  port kernel.invoke { query = "uw.hash"; input = $body } → receiptHash
  let receipt = { protocol = "usewords/acceptance/1"; body = $body; sha256 = $receiptHash }
  port kernel.invoke { query = "uw.reconstruct"; input = $receipt } → replayed
  assert eq($replayed.inputs, $current.inputs)
    otherwise "UW-ACCEPT: Replay does not reconstruct this source."
  assert eq($replayed.projections, $current.projections)
    otherwise "UW-ACCEPT: Replay does not reconstruct these projections."
  let result = $receipt

process uw.replay:
  port kernel.invoke { query = "uw.reconstruct"; input = $eventInput } → state
  let result = { ok = true; revision = $state.revision; inputHash = $state.inputHash; projectionHash = $state.projectionHash; projections = $state.projections }

process uw.propose:
  let proposal = $eventInput
  port kernel.invoke { query = "uw.initial"; input = {  } } → current
  when eq(at($proposal, "profile"), "journeys.v1"):
    port kernel.invoke { query = "uw.journeyInitial"; input = {  } } → current
  when $proposal.receipt:
    port kernel.invoke { query = "uw.reconstruct"; input = $proposal.receipt } → current
  port kernel.invoke { query = "uw.change"; input = { state = $current; request = $proposal.request } } → changed
  port kernel.invoke { query = "uw.accept"; input = { state = $changed; expectedRevision = $changed.revision; expectedInputHash = $changed.inputHash } } → result

process uw.inspect:
  let current = $eventInput.state
  let selection = $eventInput.selection
  assert includes(list("facts", "meaning", "contract", "process", "generated", "map", "languages", "receipt"), $selection)
    otherwise "UW-INSPECT: Unknown source selection."
  let journeyMode = eq(at($current, "profile"), "journeys.v1")
  let document = { file = if($journeyMode, "source/journeys.rel", "source/experiment/story.rel"); text = $current.inputs.factText }
  when eq($selection, "meaning"):
    let document = { file = if($journeyMode, "source/journeys.encounter", "source/experiment/story.encounter"); text = $current.inputs.codeText }
  when eq($selection, "contract"):
    let document = { file = if($journeyMode, "source/journeys-contracts.rel", "source/experiment/contracts.rel"); text = $current.inputs.contractText }
  when eq($selection, "process"):
    let document = { file = "source/usewords.encounter"; text = $data.policySource }
  when eq($selection, "generated"):
    port json.stringify { value = $data.policy; space = 2 } → text
    let document = { file = "dist/algebra/usewords.process.json"; text = $text }
  when eq($selection, "map"):
    let definitions = filter($data.sourceMap.origins, "origin", eq($origin.kind, "process-definition"))
    port json.stringify { value = { file = $data.sourceMap.file; sourceHash = $data.sourceMap.sourceHash; basis = $data.sourceMap.basis; scope = "Process-definition ranges; the complete map is in dist/algebra/usewords.process.json.map.json"; origins = $definitions }; space = 2 } → text
    let document = { file = "usewords-definition-map.json"; text = $text }
  when eq($selection, "languages"):
    port json.stringify { value = $data.languages; space = 2 } → text
    let document = { file = "source/languages.json"; text = $text }
  when eq($selection, "receipt"):
    port json.stringify { value = { revision = $current.revision; inputHash = $current.inputHash; projectionHash = $current.projectionHash; events = $current.events }; space = 2 } → text
    let document = { file = "current-session-events.json"; text = $text }
  port digest.sha256 { text = $document.text } → sourceHash
  let result = { file = $document.file; text = $document.text; sha256 = $sourceHash; revision = $current.revision; scope = "Exact current source or recorded session events. Static definitions are not execution traces." }

process uw.present:
  port kernel.invoke {
    query = "sp.present";
    input = {
      text = $eventInput.text;
      file = $eventInput.file;
      language = "auto";
      theme = "light";
      expectedHash = $eventInput.sha256;
      lineNumbers = true;
      selectedLine = null;
      origin = { file = $eventInput.file }
    }
  } → result

process uw.document:
  call owner.check
  call cs.document

process uw.styles:
  call cs.styles

process cs.document:
  let result = concat(
    "<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"theme-color\" content=\"#163d37\"><title>Creator Studio — work with meaning</title><meta name=\"description\" content=\"Professional editing, standards, commentary and repeatable workflows. One maintained project, seven working perspectives.\"><meta property=\"og:title\" content=\"Creator Studio — work with meaning\"><meta property=\"og:description\" content=\"Choose your approach. Compose with others. Understand every change. Built with Worldwright through Encounter.\"><meta property=\"og:type\" content=\"website\"><link rel=\"stylesheet\" href=\"style.css\"><script src=\"app.js\" defer></script></head>",
    "<body><a class=\"skip\" href=\"#cs-main\">Skip to work</a><div id=\"cs-shell\" class=\"studio profile-editorial\"><aside class=\"sidebar\"><a class=\"brand\" href=\"#cs-main\"><span class=\"brand-mark\" aria-hidden=\"true\">c<span>✳</span></span><span>Creator<br><strong>Studio</strong></span></a><p class=\"side-caption\">A WORLD OF USEFUL WORK</p><div id=\"cs-project-picker\"></div><nav id=\"cs-nav\" aria-label=\"Workspaces\"></nav><div class=\"sidebar-foot\"><span class=\"status-dot\"></span> Encounter authored<p>Built with Worldwright<br>One project. Many ways in.</p></div><div class=\"practice-controls\"><button type=\"button\" class=\"quiet\" data-action=\"nav\" data-id=\"guide\">About this practice ↗</button><div id=\"cs-reading\"></div></div></aside>",
    "<div class=\"main-frame\"><header class=\"topbar\"><div><span class=\"eyebrow\">YOUR WORKSPACE</span><p id=\"cs-project-title\">Opening your project…</p></div><div class=\"top-actions\"><span id=\"cs-version\" class=\"badge\">Local workspace</span><button type=\"button\" class=\"secondary\" data-action=\"export-project\">Export project</button><button type=\"button\" class=\"primary\" data-action=\"accept\">Save version</button></div></header><main id=\"cs-main\" tabindex=\"-1\"><div class=\"workspace-heading\"><div><p id=\"cs-kicker\" class=\"eyebrow\">THE WORK, CONNECTED</p><h1 id=\"cs-heading\">Make something worth carrying forward.</h1><p id=\"cs-description\" class=\"lede\">Choose a way into your project. Its meaning comes with you.</p></div><div id=\"cs-view-actions\" class=\"view-actions\"></div></div><div id=\"cs-status\" role=\"status\" aria-live=\"polite\" class=\"notice\">Your work is opening through Encounter.</div><div id=\"cs-workspace\"></div><section id=\"cs-context\" class=\"context-section\" aria-label=\"Shared context and commentary\"></section></main><footer class=\"main-footer\"><span>Creator Studio · Built with Worldwright</span><span>Meaning · Standards · Commentary · Practice</span></footer></div></div><p id=\"cs-error\" data-temple-errors role=\"alert\"></p></body></html>"
  )

process cs.styles:
  let result = concat(
    ":root{color-scheme:light;--ink:#183e38;--muted:#536762;--paper:#f6f5f0;--surface:#fffefb;--line:#d7dfd8;--accent:#236656;--wash:#e8f1e9;--serif:'Libre Caslon Display',Georgia,serif;--sans:'DM Sans',system-ui,sans-serif}*{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font:15px/1.65 var(--sans)}button,input,textarea,select{font:inherit}button,a,input,textarea,select{touch-action:manipulation}button{cursor:pointer}button:disabled{cursor:default;opacity:.65}a{color:#205b50;text-underline-offset:4px}button:focus-visible,a:focus-visible,input:focus-visible,textarea:focus-visible,select:focus-visible,summary:focus-visible{outline:3px solid #ad5c24;outline-offset:4px}h1,h2,h3,p{margin-top:0}h1,h2,h3{line-height:1.17;overflow-wrap:anywhere}h1{font:400 clamp(32px,3.25vw,51px)/1.1 var(--serif);letter-spacing:-.025em;margin-bottom:13px}h2{font:400 30px/1.2 var(--serif)}h3{font-size:17px}p{overflow-wrap:anywhere}button{border:0;background:transparent;color:inherit}input,textarea,select{width:100%;padding:11px 13px;color:var(--ink);background:#fff;border:1px solid #bacac0;border-radius:7px;min-width:0}textarea{resize:vertical;min-height:100px;line-height:1.65}label{display:block;font-size:13px;font-weight:600;margin:0 0 16px}label input,label textarea,label select{display:block;margin-top:7px;font-weight:400}.help{font-size:12px;line-height:1.6;color:var(--muted);display:block;margin-top:6px}.skip{position:fixed;top:8px;left:12px;padding:12px 20px;background:#fff;z-index:10;transform:translateY(-160%)}.skip:focus{transform:none}.studio{display:grid;grid-template-columns:235px minmax(0,1fr);min-height:100vh}.profile-technical{--accent:#275574;--wash:#e9f0f5}.profile-client{--accent:#80523a;--wash:#f5ece3}.sidebar{border-right:1px solid var(--line);padding:29px 20px;background:#efF1e9;display:flex;flex-direction:column;gap:24px}.brand{display:flex;gap:13px;align-items:center;text-decoration:none;color:var(--ink);font:25px/1.05 var(--serif)}.brand strong{font-weight:400}.brand-mark{display:grid;place-items:center;position:relative;width:45px;height:51px;border:1px solid #829c8b;border-radius:14px 14px 4px 4px;font-size:42px}.brand-mark span{position:absolute;font:16px var(--sans);right:-6px;top:-6px;color:#8a603c;background:#eff1e9}.side-caption{font-size:9px;letter-spacing:.16em;color:#536c5e;margin:-8px 0 0}.sidebar nav{display:grid;gap:5px}.nav-item{display:flex;align-items:center;gap:11px;width:100%;padding:10px 12px;text-align:left;border-radius:7px;font-size:13px}.nav-item:hover{background:#e3e9df}.nav-item[aria-current=page]{background:#d9e8db;font-weight:700;color:#173e30}.nav-icon{display:grid;place-items:center;flex:none;width:25px;height:25px;border:1px solid #9db6a6;background:#fcfdf7;border-radius:5px;font-family:var(--serif);font-size:17px}.nav-separator{height:1px;background:#d6ded2;margin:12px 0}.sidebar-foot{margin-top:auto;padding-top:22px;border-top:1px solid #d4ded1;font-size:11px;color:#52685c}.sidebar-foot p{margin:12px 0}.status-dot{display:inline-block;width:6px;height:6px;border-radius:50%;background:#31745c;margin-right:6px}.sidebar select{font-size:12px;background:#fffef8}.sidebar label{margin:0}.main-frame{min-width:0}.topbar{padding:20px 4.5%;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:center;gap:20px;background:#fffef9}.eyebrow{font-size:10px;letter-spacing:.16em;text-transform:uppercase;font-weight:700;color:#526e61;margin-bottom:11px}.topbar .eyebrow{font-size:8px;letter-spacing:.15em}.topbar p{margin:2px 0 0;font-size:13px;font-weight:600}.top-actions{display:flex;align-items:center;gap:10px;flex-wrap:wrap}.primary,.secondary,.quiet{display:inline-flex;justify-content:center;align-items:center;gap:7px;min-height:39px;padding:9px 15px;border-radius:6px;font-size:12px;font-weight:600;line-height:1.5}.primary{background:var(--accent);color:#fff}.primary:hover{filter:brightness(.92)}.secondary{border:1px solid #bfcfc3;background:#fffefb;color:#254e42}.secondary:hover{background:#edf4ed}.quiet{padding:6px 0;color:#3b6656;text-align:left;justify-content:flex-start}.badge{display:inline-block;padding:5px 9px;border:1px solid #c4d2c6;border-radius:30px;background:#eef4ec;color:#365d48;font-size:10px}.badge.pending{background:#fff0dc;border-color:#d9b480;color:#77521e}main{width:100%;padding:36px 4.5% 50px;outline:0}.workspace-heading{display:flex;align-items:flex-start;justify-content:space-between;gap:24px;margin:0 0 23px}.lede{font-size:14px;max-width:650px;color:var(--muted);margin-bottom:0}.view-actions{display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end;max-width:330px}.notice{font-size:12px;border-left:3px solid #89a993;background:#eef3e9;padding:11px 15px;margin-bottom:24px;border-radius:0 5px 5px 0}.notice.error{background:#fff0eb;border-color:#ad563c;color:#743b2d}.main-footer{padding:22px 4.5%;border-top:1px solid var(--line);display:flex;gap:16px;justify-content:space-between;font-size:10px;color:var(--muted)}.panel{border:1px solid var(--line);background:var(--surface);padding:24px;border-radius:12px;min-width:0}.panel h2{margin-bottom:10px}.panel>p:last-child{margin-bottom:0}.panel-head{display:flex;justify-content:space-between;align-items:flex-start;gap:16px;margin-bottom:20px}.panel-head h2{margin-bottom:5px}.subtle{color:var(--muted);font-size:12px}.split{display:grid;grid-template-columns:minmax(260px,.9fr) minmax(0,1.3fr);gap:22px;align-items:start}.stack{display:grid;gap:20px}.form-row{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.form-row label{margin-bottom:8px}.record-picker{display:flex;gap:8px;flex-wrap:wrap;margin:0 0 20px}.record-tab{padding:7px 13px;border:1px solid #cbd8ce;border-radius:30px;background:#fff;font-size:11px}.record-tab.active{background:var(--accent);color:#fff;border-color:var(--accent)}.work-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:15px}.work-card{position:relative;display:flex;flex-direction:column;text-align:left;padding:22px;min-height:188px;border:1px solid #cbd6cb;border-radius:12px;background:linear-gradient(140deg,#fffefb,#f1f5ec);transition:transform .2s,box-shadow .2s,border-color .2s}.work-card:hover,.work-card:focus-visible{transform:translateY(-3px);box-shadow:0 8px 22px #1b4a3510;border-color:#7a9c84}.card-top{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:18px}.app-mark{display:grid;place-items:center;width:37px;height:39px;border:1px solid #acc0aa;background:#e7efdf;border-radius:10px 10px 4px 4px;font:25px var(--serif);color:#254f3c}.work-card:is([data-id=tables],[data-id=presentations],[data-id=canvas]){background:linear-gradient(140deg,#fffefb,#edf1f6);border-color:#c8d4e1}.work-card:is([data-id=tables],[data-id=presentations],[data-id=canvas]) .app-mark{background:#e3ecf2;color:#28546d;border-color:#b0c4d2}.work-card:is([data-id=media],[data-id=review]){background:linear-gradient(140deg,#fffefb,#f6eee3);border-color:#dfd1bf}.work-card:is([data-id=media],[data-id=review]) .app-mark{background:#f2e6d5;color:#80563b;border-color:#d0bda2}.work-card h2{font-size:27px;margin-bottom:9px}.work-card p{font-size:12px;color:#54675e;margin-bottom:0}.card-arrow{font-size:18px;color:#54755c}.hero-panel{display:grid;grid-template-columns:1.3fr 1fr;gap:26px;background:linear-gradient(120deg,#e6efe3,#f8f6e9);border:1px solid #becdb9;border-radius:14px;padding:29px;margin-bottom:25px}.hero-panel h2{font-size:35px;max-width:500px}.hero-panel p{color:#4f6857;font-size:13px}.hero-metrics{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.metric{border-left:1px solid #c4d1bd;padding:6px 0 6px 20px}.metric strong{font:30px var(--serif);display:block}.metric span{font-size:10px;color:#536951}.flow-strip{display:flex;gap:9px;flex-wrap:wrap;align-items:center;font-size:11px;color:#4e6758;margin:22px 0}.flow-strip span{padding:7px 12px;border:1px solid #c4d2c3;border-radius:6px;background:#fffdf6}.flow-strip b{font-weight:400;color:#4c6853}.paper{background:#fffdf9;border:1px solid #deddd1;border-radius:3px;box-shadow:0 5px 17px #233d2910;padding:34px;min-height:470px}.paper .paper-label{font-size:8px;letter-spacing:.2em;color:#617360;border-bottom:1px solid #d9dece;padding-bottom:14px;margin-bottom:25px}.paper h1{font-size:36px}.paper h2{font-size:26px;margin:25px 0 12px}.paper p{font-size:13px;line-height:1.9}.paper pre{white-space:pre-wrap}.text-editor{min-height:320px;font:13px/1.8 ui-monospace,SFMono-Regular,Consolas,monospace}.button-row{display:flex;gap:9px;flex-wrap:wrap;margin-top:18px}.table-wrap{max-width:100%;overflow:auto}table{border-collapse:collapse;width:100%;font-size:12px;text-align:left}th,td{padding:13px 12px;border-bottom:1px solid #dce3d9;vertical-align:top;overflow-wrap:anywhere}th{font-size:9px;letter-spacing:.08em;text-transform:uppercase;background:#eff3ea;color:#4e6656}.numeric{font-variant-numeric:tabular-nums;white-space:nowrap}.table-link{text-align:left;padding:0;font-weight:600;color:#245d4a}.calc{background:#f5f6ed}.total-row{background:#e8f1e5;font-weight:700}.chart-list{display:grid;gap:14px;margin:20px 0}.chart-row{display:grid;grid-template-columns:125px 1fr 90px;align-items:center;gap:12px;font-size:11px}.chart-row progress{width:100%;height:12px;accent-color:var(--accent)}.slide{aspect-ratio:16/10;min-height:310px;background:linear-gradient(130deg,#e6efe2,#fffdf5);padding:35px;border:1px solid #c0d1ba;border-radius:8px;display:flex;flex-direction:column;justify-content:center;position:relative}.slide h2{font-size:clamp(28px,3.1vw,45px);max-width:600px}.slide p{font-size:16px;max-width:570px}.slide-number{font-size:10px;color:#526d56;position:absolute;bottom:20px;left:35px}.slide-strip{display:flex;gap:9px;flex-wrap:wrap;margin-top:15px}.slide-thumb{border:1px solid #b8ccb8;background:#f1f6ed;padding:12px 16px;border-radius:5px;font-size:11px}.diagram{display:block;width:100%;height:auto;background:#fafbf5;border:1px solid #d3dfd1;border-radius:8px}.diagram text{font-family:var(--sans);fill:#244c3c}.diagram .node{fill:#e6efdf;stroke:#91ad8f}.diagram .edge{stroke:#75927b;stroke-width:2}.timeline{display:grid;gap:12px}.scene{border:1px solid #d4dfd0;border-radius:9px;padding:19px;background:#fcfdf8}.scene-header{display:flex;justify-content:space-between;align-items:center;gap:15px;margin-bottom:12px}.scene h3{margin:0}.scene p{font:22px/1.5 var(--serif);margin:10px 0}.cue{font:10px ui-monospace,monospace;color:#546e5a}.step-list{list-style:none;margin:0;padding:0;display:grid;gap:11px}.step{border:1px solid #d2ddcf;border-radius:8px;padding:17px;display:flex;gap:15px;align-items:flex-start;background:#fffef9}.step-number{font:25px var(--serif);color:#547359;min-width:24px}.step h3{margin:2px 0 6px}.step p{margin:0;font-size:11px;color:#5c6d5f}.step button{margin-left:auto;flex:none}.comment{padding:17px;border:1px solid #d9dfd4;border-radius:8px;background:#fffdf7}.comment p{font-size:13px;margin:9px 0}.comment-meta{font-size:10px;color:#5a6e5f;display:flex;gap:12px;flex-wrap:wrap}.comment.resolved{background:#eef4eb}.context-section{margin-top:28px}.context-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}.empty{padding:25px;border:1px dashed #b8cbb9;border-radius:8px;color:#526d58;background:#f9fbf4;font-size:13px}.code-view{background:#edf2e9;color:#254b39;padding:22px;border:1px solid #c3d1c1;border-radius:7px;white-space:pre-wrap;overflow-wrap:anywhere;max-height:620px;overflow:auto;font:11px/1.8 ui-monospace,SFMono-Regular,Consolas,monospace}.pill-row{display:flex;gap:8px;flex-wrap:wrap}.pack{border:1px solid #d0d9ca;border-radius:10px;padding:23px;background:linear-gradient(150deg,#fffdf7,#edf3e7)}.pack h2{font-size:29px}.pack .price{font:28px var(--serif)}.two-col{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}.wide-form textarea{min-height:250px}details{border-top:1px solid var(--line);padding-top:16px;margin-top:19px}summary{cursor:pointer;font-size:12px;color:#355f48}#cs-error:empty{display:none}#cs-error{position:fixed;bottom:12px;left:250px;right:18px;background:#fff1e9;border:1px solid #a56548;padding:15px;color:#793f2b;z-index:12;overflow-wrap:anywhere}.project-card{border:1px solid #c9d6c5;padding:20px;background:#fffef9;border-radius:10px}.project-card h3{font:25px var(--serif)}.accepted-mark{color:#315e40;font-size:11px}.source-line{font-size:10px;color:#56705b;border-top:1px solid #d8dfd0;padding-top:15px;margin-top:22px}.impact-list{font-size:12px;padding-left:20px}.impact-list li{margin:8px 0}.print-only{display:none}\n",
    ".reading-roomy *{line-height:1.5!important;letter-spacing:.12em!important;word-spacing:.16em!important}.reading-roomy p{margin-bottom:2em}.diagram-frame{overflow:auto;max-width:100%}.diagram-frame .diagram{min-width:640px}",
    "@media(max-width:1180px){.work-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.split{grid-template-columns:1fr}.workspace-heading{display:block}.view-actions{justify-content:flex-start;max-width:none;margin-top:18px}.topbar{align-items:flex-start}.hero-panel{grid-template-columns:1fr}.hero-metrics{grid-template-columns:repeat(4,minmax(0,1fr))}.metric{padding-left:12px}.metric strong{font-size:25px}}@media(max-width:760px){.studio{grid-template-columns:1fr}.sidebar{padding:18px;border-right:0;border-bottom:1px solid var(--line);gap:16px}.brand{font-size:21px}.brand-mark{width:37px;height:41px;font-size:34px}.side-caption,.sidebar-foot{display:none}.sidebar nav{display:flex;gap:7px;flex-wrap:wrap}.nav-item{width:auto;padding:7px 8px;font-size:11px;border:1px solid #d2ddcd}.nav-icon{width:20px;height:21px;font-size:14px}.nav-separator{display:none}.topbar{padding:17px;display:block}.top-actions{margin-top:15px}.topbar p{font-size:14px}main{padding:26px 17px 40px}.work-grid,.two-col,.context-grid{grid-template-columns:1fr}.hero-panel{padding:23px}.hero-metrics{grid-template-columns:repeat(2,minmax(0,1fr))}.panel{padding:20px}.paper{padding:23px}.paper h1{font-size:31px}.form-row{grid-template-columns:1fr}.chart-row{grid-template-columns:95px 1fr}.chart-row>span:last-child{grid-column:2}.slide{aspect-ratio:auto;min-height:330px;padding:25px}.slide h2{font-size:34px}.slide-number{left:25px}.main-footer{display:block;padding:20px 17px}.main-footer span{display:block;margin-bottom:8px}#cs-error{left:12px;right:12px}.step{flex-wrap:wrap}.step button{margin-left:39px}.top-actions .badge{width:100%;text-align:center}.view-actions{gap:7px}}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important;scroll-behavior:auto!important}}@media print{.sidebar,.topbar,.view-actions,.notice,.context-section,.main-footer,.skip,.button-row{display:none!important}.studio{display:block}main{padding:0}.panel,.paper{border:0;box-shadow:none}.split{display:block}.split>form{display:none}.print-only{display:block}body{background:#fff;color:#000}}"
  )

process uw.retainedDocument:
  let input = $data.page
  call html.serialize

process uw.sourceView:
  port kernel.invoke { query = "uw.present"; input = $eventInput } → presentation
  let input = $presentation.tree
  call html.serialize
  let result = { presentation = $presentation; html = $result }

process uw.retainedStyles:
  let styleRules = $data.style.rules
  call uw.styleRules
  let css = $result
  fold $data.style.media as media; css starts $css:
    let styleRules = $media.rules
    call uw.styleRules
    yield concat($css, "@media", $media.condition, "{", $result, "}\n") → result
  let applicationCss = $result
  call sp.style
  let result = concat($applicationCss, "\n", $result)

process uw.paint:
  port state.get { key = "current" } → current
  let page = at(filter($current.projections, "p", eq($p.output.type, "Page")), 0)
  let row = at(filter($current.projections, "p", eq($p.output.type, "MainframeRow")), 0)
  let menu = at(filter($current.projections, "p", eq($p.output.type, "WebLink")), 0)
  let input = $page.output.tree
  call html.serialize
  port browser.content { ref = "#reading"; html = $result } → _
  port browser.write { ref = "#row-title"; name = "textContent"; value = at($row.values, "N.label") } → _
  port browser.write { ref = "#menu-title"; name = "textContent"; value = at($menu.values, "N.label") } → _
  port browser.write { ref = "#revision"; name = "textContent"; value = concat("Revision ", $current.revision) } → _
  port browser.write { ref = "#source-hash"; name = "textContent"; value = $current.inputHash } → _
  port browser.write { ref = "#projection-hash"; name = "textContent"; value = $current.projectionHash } → _
  port json.stringify { value = $current.events; space = 2 } → eventText
  port browser.write { ref = "#events"; name = "textContent"; value = $eventText } → _
  port state.get { key = "selection" } → selection
  port kernel.invoke { query = "uw.inspect"; input = { state = $current; selection = $selection } } → inspected
  port browser.write { ref = "#inspection-file"; name = "textContent"; value = $inspected.file } → _
  port browser.write { ref = "#inspection-hash"; name = "textContent"; value = $inspected.sha256 } → _
  port kernel.invoke { query = "uw.sourceView"; input = $inspected } → sourceView
  let presentation = $sourceView.presentation
  port browser.content { ref = "#inspection-source"; html = $sourceView.html } → _
  port browser.write { ref = "#presentation-status"; name = "textContent"; value = if($presentation.diagnostic, $presentation.diagnostic, concat("Shared Worldwright presenter · ", $presentation.language, " · exact source text · UTF-16 coordinates")) } → _
  each list("meaning", "facts", "contract", "process", "generated", "map", "languages", "receipt") as choice:
    port browser.write { ref = concat("#inspect-", $choice); name = "className"; value = if(eq($selection, $choice), "is-selected", "") } → _
  call uw.journeyPaint
  port state.get { key = "notice" } → notice
  port browser.write { ref = "#notice"; name = "textContent"; value = $notice } → _
  let result = { revision = $current.revision; inputHash = $current.inputHash; projectionHash = $current.projectionHash }

process uw.words:
  port browser.property { ref = "#words"; name = "value" } → words
  port kernel.invoke { query = "uw.parse"; input = $words } → request
  port state.get { key = "current" } → current
  when eq($request.kind, "recreate"):
    port kernel.invoke { query = "uw.journeyInitial"; input = {  } } → current
    port state.set { key = "current"; value = $current } → _
    port state.set { key = "notice"; value = "Recreated one real encounter in two journeys through ec.prepare and ec.run. Nothing is accepted yet." } → _
  when not(eq($request.kind, "recreate")):
    port kernel.invoke { query = "uw.change"; input = { state = $current; request = { kind = $request.kind; value = $request.value; target = at($request, "target"); baseRevision = $current.revision } } } → changed
    port state.set { key = "current"; value = $changed } → _
    port state.set { key = "notice"; value = if(eq($request.kind, "shared-title"), "Shared title changed once. Both journeys read the new title; their introductions stay independent.", if(eq($request.kind, "journey-intro"), "Changed one journey introduction. The other introduction and shared encounter are unchanged.", "Only the menu label changed through its declared local edit route.")) } → _
  call uw.paint

process uw.action:
  try:
    call uw.words
  catch fault:
    port state.set { key = "notice"; value = concat("Refused: ", $fault.message) } → _
    call uw.paint

process uw.choose:
  port state.set { key = "selection"; value = $eventInput.selection } → _
  call uw.paint

process uw.example:
  port browser.write { ref = "#words"; name = "value"; value = $eventInput.words } → _

process uw.acceptUI:
  try:
    port state.get { key = "current" } → current
    port kernel.invoke { query = "uw.accept"; input = { state = $current; expectedRevision = $current.revision; expectedInputHash = $current.inputHash } } → receipt
    port json.stringify { value = $receipt; space = 2 } → encoded
    port storage.write { key = "usewords.lightning.accepted.v1"; value = $encoded } → stored
    assert $stored.ok
      otherwise "UW-STORAGE: Acceptance replay passed, but browser storage failed. No durable acceptance was recorded."
    port state.set { key = "accepted"; value = $receipt } → _
    port browser.write { ref = "#receipt-input"; name = "value"; value = $encoded } → _
    port state.set { key = "notice"; value = "Accepted after a fresh replay. Saved in this browser; export the receipt to reproduce it elsewhere." } → _
    call uw.paint
  catch fault:
    port state.set { key = "notice"; value = concat("Refused: ", $fault.message) } → _
    call uw.paint

process uw.importUI:
  try:
    port browser.property { ref = "#receipt-input"; name = "value" } → encoded
    port number.calculate { operation = "lessEqual"; values = list(count($encoded), 131072) } → bounded
    assert $bounded
      otherwise "UW-LIMIT: Receipt is too large."
    port json.parse { text = $encoded } → receipt
    port kernel.invoke { query = "uw.reconstruct"; input = $receipt } → current
    port state.set { key = "current"; value = $current } → _
    port state.set { key = "notice"; value = "Receipt replay passed. Reconstructed as a draft; choose Accept to save it in this browser." } → _
    call uw.paint
  catch fault:
    port state.set { key = "notice"; value = concat("Refused: ", $fault.message) } → _
    call uw.paint

process uw.exportUI:
  try:
    port state.get { key = "accepted" } → receipt
    assert $receipt
      otherwise "UW-EXPORT: Accept a revision before exporting."
    port json.stringify { value = $receipt; space = 2 } → encoded
    port download.text { name = "usewords-acceptance.json"; text = $encoded } → _
    port state.set { key = "notice"; value = "Exported the last accepted revision. Unaccepted edits are excluded." } → _
    call uw.paint
  catch fault:
    port state.set { key = "notice"; value = concat("Refused: ", $fault.message) } → _
    call uw.paint

process uw.open:
  port browser.focus { ref = "#reading" } → _
  port state.set { key = "notice"; value = "Opened TheStory. Page, row and menu retain the same encounter identity." } → _
  call uw.paint

process uw.agent:
  assert includes(list("command", "accept", "inspect"), $eventInput.operation)
    otherwise "UW-AUTHORITY: Unknown agent operation."
  let request = $eventInput
  when eq($request.operation, "command"):
    port state.get { key = "current" } → current
    assert eq($request.baseRevision, $current.revision)
      otherwise "UW-STALE: Agent revision changed."
    port kernel.invoke { query = "uw.parse"; input = $request.words } → parsed
    assert not(eq($parsed.kind, "recreate"))
      otherwise "UW-AUTHORITY: Recreate through the explicit UI action."
    port kernel.invoke { query = "uw.change"; input = { state = $current; request = { kind = $parsed.kind; value = $parsed.value; target = at($parsed, "target"); baseRevision = $request.baseRevision } } } → changed
    port state.set { key = "current"; value = $changed } → _
    port state.set { key = "notice"; value = "Agent proposal applied as a draft through the same edit process." } → _
    call uw.paint
  when eq($request.operation, "inspect"):
    port state.get { key = "current" } → current
    port kernel.invoke { query = "uw.inspect"; input = { state = $current; selection = $request.selection } } → result
  when eq($request.operation, "accept"):
    port state.get { key = "current" } → current
    port kernel.invoke { query = "uw.accept"; input = { state = $current; expectedRevision = $request.baseRevision; expectedInputHash = $request.inputHash } } → result

process uw.boot:
  port kernel.invoke { query = "uw.journeyInitial"; input = {  } } → current
  port state.set { key = "current"; value = $current } → _
  port state.set { key = "selection"; value = "meaning" } → _
  port state.set { key = "accepted"; value = null } → _
  port state.set { key = "notice"; value = "One real encounter, two newly authored journeys. Change the shared title, then an introduction in just one journey." } → _
  try:
    port storage.read { key = "usewords.lightning.accepted.v1"; maxLength = 131072 } → stored
    when and($stored.ok, not(eq($stored.value, null))):
      port json.parse { text = $stored.value } → receipt
      port kernel.invoke { query = "uw.reconstruct"; input = $receipt } → restored
      port state.set { key = "current"; value = $restored } → _
      port state.set { key = "accepted"; value = $receipt } → _
      port browser.write { ref = "#receipt-input"; name = "value"; value = $stored.value } → _
      port state.set { key = "notice"; value = "Restored the accepted encounter after checking its hashes and replaying every edit." } → _
    when not($stored.ok):
      port state.set { key = "notice"; value = "Browser storage is unavailable. Draft edits work; acceptance requires storage. Export/import is available after acceptance." } → _
  catch fault:
    port state.set { key = "notice"; value = concat("Saved acceptance refused; canonical draft retained. ", $fault.message) } → _
  port browser.on { ref = "#words-form"; event = "submit"; query = "uw.action"; input = {  }; preventDefault = true } → _
  port browser.on { ref = "#accept"; event = "click"; query = "uw.acceptUI"; input = {  }; preventDefault = false } → _
  port browser.on { ref = "#export"; event = "click"; query = "uw.exportUI"; input = {  }; preventDefault = false } → _
  port browser.on { ref = "#import"; event = "click"; query = "uw.importUI"; input = {  }; preventDefault = false } → _
  port browser.on { ref = "#menu-open"; event = "click"; query = "uw.open"; input = {  }; preventDefault = false } → _
  port browser.on { ref = "#row-open"; event = "click"; query = "uw.open"; input = {  }; preventDefault = false } → _
  port browser.on { ref = "#inspect-meaning"; event = "click"; query = "uw.choose"; input = { selection = "meaning" }; preventDefault = false } → _
  port browser.on { ref = "#inspect-facts"; event = "click"; query = "uw.choose"; input = { selection = "facts" }; preventDefault = false } → _
  port browser.on { ref = "#inspect-contract"; event = "click"; query = "uw.choose"; input = { selection = "contract" }; preventDefault = false } → _
  port browser.on { ref = "#inspect-process"; event = "click"; query = "uw.choose"; input = { selection = "process" }; preventDefault = false } → _
  port browser.on { ref = "#inspect-generated"; event = "click"; query = "uw.choose"; input = { selection = "generated" }; preventDefault = false } → _
  port browser.on { ref = "#inspect-map"; event = "click"; query = "uw.choose"; input = { selection = "map" }; preventDefault = false } → _
  port browser.on { ref = "#inspect-languages"; event = "click"; query = "uw.choose"; input = { selection = "languages" }; preventDefault = false } → _
  port browser.on { ref = "#inspect-receipt"; event = "click"; query = "uw.choose"; input = { selection = "receipt" }; preventDefault = false } → _
  port browser.on { ref = "#example-recreate"; event = "click"; query = "uw.example"; input = { words = "Recreate the two journeys." }; preventDefault = false } → _
  port browser.on { ref = "#example-shared"; event = "click"; query = "uw.example"; input = { words = "Rename the encounter to \"The horse asks us to listen.\"." }; preventDefault = false } → _
  port browser.on { ref = "#example-local"; event = "click"; query = "uw.example"; input = { words = "Introduce it in Listening well as \"Before offering a lesson, notice the question you are being asked.\"." }; preventDefault = false } → _
  port browser.on { ref = "#example-making"; event = "click"; query = "uw.example"; input = { words = "Introduce it in Making with care as \"Make an invitation that leaves room for a different response.\"." }; preventDefault = false } → _
  call uw.paint

process uw.styleRules:
  fold $styleRules as rule; css starts "":
    fold $rule.declarations as declaration; body starts "":
      yield concat($body, $declaration.name, ":", $declaration.value, ";") → body
    yield concat($css, $rule.selector, "{", $body, "}\n") → result

process uw.journeyInitial:
  port kernel.invoke { query = "uw.project"; input = $data.journeyCanonical } → base
  let result = { profile = "journeys.v1"; inputs = $base.inputs; projections = $base.projections; inputHash = $base.inputHash; projectionHash = $base.projectionHash; revision = 0; events = list() }
  port kernel.invoke { query = "uw.journeys"; input = $result } → checked

process uw.journeys:
  let current = $eventInput
  let entries = filter($current.projections, "p", eq($p.output.type, "JourneyEntry"))
  assert eq(count($entries), 2)
    otherwise "UW-JOURNEY: Both journey entries must exist."
  let shared = at(filter($current.projections, "p", eq($p.output.type, "Page")), 0)
  each $data.journeys.journeys as journey:
    let matching = filter($entries, "p", eq($p.contribution.id, $journey.id))
    assert eq(count($matching), 1)
      otherwise "UW-JOURNEY: Each journey must have exactly one contribution."
    let entry = at($matching, 0)
    assert and(eq($entry.source, $data.journeys.subject), eq(at($entry.values, "J.subject"), $data.journeys.subject), eq(at($entry.values, "J.title"), at($shared.values, "P.title")), eq(at($entry.values, "J.paragraphs"), at($shared.values, "P.paragraphs")))
      otherwise "UW-JOURNEY: Both journeys must preserve the shared encounter identity and content."
  let result = $entries

process uw.journeyChange:
  let current = $eventInput.state
  let request = $eventInput.request
  assert eq($request.baseRevision, $current.revision)
    otherwise "UW-STALE: The revision changed. Reinspect before editing."
  assert includes(list("shared-title", "menu-label", "journey-intro"), $request.kind)
    otherwise "UW-AUTHORITY: Only declared shared and local edit routes are supported."
  port value.describe { value = $request.value } → valueKind
  assert eq($valueKind.type, "string")
    otherwise "UW-TYPE: An edit value must be text."
  port number.calculate { operation = "lessEqual"; values = list(count($request.value), 160) } → bounded
  assert $bounded
    otherwise "UW-LIMIT: Edit text is limited to 160 characters."
  port number.calculate { operation = "less"; values = list(count($current.events), 32) } → bounded
  assert $bounded
    otherwise "UW-LIMIT: At most 32 edits are supported per reconstruction."
  let target = null
  let matches = filter($current.projections, "p", eq($p.output.type, if(eq($request.kind, "shared-title"), "Page", "WebLink")))
  let field = if(eq($request.kind, "shared-title"), "P.title", "N.label")
  when eq($request.kind, "journey-intro"):
    let target = at($request, "target")
    assert includes(list("journey.Listening", "journey.Making"), $target)
      otherwise "UW-JOURNEY: Name exactly one known journey for a local introduction edit."
    let matches = filter($current.projections, "p", and(eq($p.output.type, "JourneyEntry"), eq(at($p.contribution, "id"), $target)))
    let field = "J.introduction"
  assert eq(count($matches), 1)
    otherwise "UW-JOURNEY: The edit must select exactly one current projection."
  port kernel.invoke { query = "ec.prepare"; input = $current.inputs } → candidate
  port kernel.invoke { query = "ec.patch"; input = { candidate = $candidate; projection = at($matches, 0); field = $field; value = $request.value } } → patched
  port kernel.invoke { query = "uw.project"; input = $patched.candidate.inputs } → next
  assert not(eq($next.inputHash, $current.inputHash))
    otherwise "UW-NOOP: This edit does not change the source."
  let changed = { profile = "journeys.v1"; inputs = $next.inputs; projections = $next.projections; inputHash = $next.inputHash; projectionHash = $next.projectionHash; revision = add($current.revision, 1); events = append($current.events, list({ kind = $request.kind; target = $target; value = $request.value; beforeInputHash = $current.inputHash; afterInputHash = $next.inputHash; afterProjectionHash = $next.projectionHash; destination = $patched.destination })) }
  port kernel.invoke { query = "uw.journeys"; input = $changed } → checked
  let result = $changed

process uw.journeyPaint:
  port state.get { key = "current" } → current
  let active = eq(at($current, "profile"), "journeys.v1")
  port browser.write { ref = "#journeys-preview"; name = "hidden"; value = not($active) } → _
  port browser.write { ref = "#legacy-preview"; name = "hidden"; value = $active } → _
  when $active:
    port kernel.invoke { query = "uw.journeys"; input = $current } → entries
    each $data.journeys.journeys as journey:
      let entry = at(filter($entries, "p", eq($p.contribution.id, $journey.id)), 0)
      let input = $entry.output.tree
      call html.serialize
      port browser.content { ref = $journey.mount; html = $result } → _
      let localChanges = filter($current.events, "event", and(eq($event.kind, "journey-intro"), eq(at($event, "target"), $journey.id)))
      port browser.write { ref = $journey.badge; name = "textContent"; value = if(eq(count($localChanges), 0), "Own introduction · shared encounter", "Local introduction edited · shared encounter preserved") } → _
    let sharedChanges = filter($current.events, "event", eq($event.kind, "shared-title"))
    port browser.write { ref = "#shared-proof"; name = "textContent"; value = if(eq(count($sharedChanges), 0), "One encounter identity. Two introductions. A single shared title and text.", "Shared title edited once → both journeys updated. Their introductions stay independent.") } → _

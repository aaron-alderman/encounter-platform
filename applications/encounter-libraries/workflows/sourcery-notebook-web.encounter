process-module "temple/surface-process-module/1"

process ui.presentationStyles:
  port kernel.invoke { query = "sourcery.presentation.tokens"; input = null } → tokens
  port kernel.invoke { query = "sourcery.notebook.documentStyles"; input = null } → document
  port kernel.invoke { query = "sourcery.notebook.reviewStyles"; input = null } → review
  port kernel.invoke { query = "sourcery.notebook.workbenchStyles"; input = null } → workbench
  port kernel.invoke { query = "sourcery.notebook.decisionStyles"; input = null } → decisions
  port kernel.invoke { query = "sourcery.notebook.editorStyles"; input = null } → editor
  let result = concat($tokens, $document, $review, $workbench, $decisions, $editor)

process sourcery.notebook.documentStyles:
  let cssRuleSeparator = ""
  let cssRules = list(
    { selector = ":root"; declarations = list(
      { property = "color-scheme"; value = "light" },
      { property = "font"; value = "14px/1.45 var(--sourcery-font)" },
      { property = "color"; value = "var(--sourcery-ink)" },
      { property = "accent-color"; value = "var(--sourcery-accent)" }
    ) },
    { selector = "*"; declarations = list(
      { property = "box-sizing"; value = "border-box" }
    ) },
    { selector = "body"; declarations = list(
      { property = "margin"; value = "0" },
      { property = "min-height"; value = "100dvh" },
      { property = "background-color"; value = "#225b6e" },
      { property = "background-image"; value = "var(--sourcery-desktop)" }
    ) },
    { selector = "main"; declarations = list(
      { property = "max-width"; value = "86rem" },
      { property = "min-width"; value = "0" },
      { property = "margin"; value = "clamp(.55rem,2vw,1.5rem) auto" },
      { property = "width"; value = "calc(100% - 2 * clamp(.55rem,2vw,1.5rem))" },
      { property = "border"; value = "4px solid var(--sourcery-frame)" },
      { property = "background"; value = "var(--sourcery-paper)" },
      { property = "box-shadow"; value = "var(--sourcery-raised),var(--sourcery-shadow)" },
      { property = "overflow-wrap"; value = "anywhere" }
    ) },
    { selector = "h1,h2,h3,p"; declarations = list(
      { property = "margin"; value = "0 0 .55rem" }
    ) },
    { selector = "h1"; declarations = list(
      { property = "font-size"; value = "clamp(1.45rem,3vw,2.15rem)" },
      { property = "line-height"; value = "1.16" }
    ) },
    { selector = "h2"; declarations = list(
      { property = "font-size"; value = "1.22rem" }
    ) },
    { selector = "h3"; declarations = list(
      { property = "font-size"; value = "1rem" }
    ) },
    { selector = "main>header,.nb1-title,.nr-board-title,.nr-inspection>header"; declarations = list(
      { property = "background"; value = "var(--sourcery-title)" },
      { property = "color"; value = "white" },
      { property = "padding"; value = ".45rem .75rem" }
    ) },
    { selector = "main>header h1"; declarations = list(
      { property = "font-size"; value = "1.2rem" }
    ) },
    { selector = "main>header p"; declarations = list(
      { property = "margin"; value = "0" },
      { property = "font-size"; value = ".86rem" }
    ) },
    { selector = "main>header:has(+.feedback+.nb1)"; declarations = list(
      { property = "display"; value = "none" }
    ) },
    { selector = "main>header :is(a,small),.nr-board-title a,.nr-inspection>header a"; declarations = list(
      { property = "color"; value = "inherit" }
    ) },
    { selector = "main>:where(section:not(.decision-form),article,form,p,nav,details,h2,div:not(.nb1,.task-workbench,.feedback,.project-explorer,.decision-workspace))"; declarations = list(
      { property = "margin"; value = "0" },
      { property = "padding"; value = ".65rem .85rem" }
    ) },
    { selector = "main>table"; declarations = list(
      { property = "width"; value = "calc(100% - 1.7rem)" },
      { property = "margin"; value = "0 .85rem .65rem" }
    ) },
    { selector = "main>.nb1"; declarations = list(
      { property = "background"; value = "var(--sourcery-frame)" }
    ) },
    { selector = "section,article,aside"; declarations = list(
      { property = "min-width"; value = "0" }
    ) },
    { selector = "a"; declarations = list(
      { property = "color"; value = "var(--sourcery-accent)" },
      { property = "text-underline-offset"; value = ".16em" }
    ) },
    { selector = "summary"; declarations = list(
      { property = "cursor"; value = "pointer" }
    ) },
    { selector = "button:not([hidden]),.nb1-primary,.project-decision-action,.nr-ed-request,.nr-inspection-nav a,.cb-shot-pager a,.cb-shot-pager span"; declarations = list(
      { property = "display"; value = "inline-block" },
      { property = "padding"; value = ".45rem .7rem" },
      { property = "border"; value = "0" },
      { property = "border-radius"; value = "0" },
      { property = "background"; value = "var(--sourcery-frame)" },
      { property = "box-shadow"; value = "var(--sourcery-raised)" },
      { property = "color"; value = "var(--sourcery-accent)" },
      { property = "font"; value = "inherit" },
      { property = "text-decoration"; value = "none" },
      { property = "cursor"; value = "pointer" }
    ) },
    { selector = ":where(button,.nb1-primary,.project-decision-action,.nr-ed-request,.nr-inspection-nav a,.cb-shot-pager a):hover"; declarations = list(
      { property = "background"; value = "var(--sourcery-selected)" }
    ) },
    { selector = "button:disabled,.cb-shot-pager span"; declarations = list(
      { property = "color"; value = "var(--sourcery-muted)" },
      { property = "cursor"; value = "default" }
    ) },
    { selector = ":where(a,button,input,select,textarea,summary,[tabindex]):focus-visible"; declarations = list(
      { property = "outline"; value = "2px dashed var(--sourcery-accent)" },
      { property = "outline-offset"; value = "2px" }
    ) },
    { selector = "a[aria-current]"; declarations = list(
      { property = "font-weight"; value = "bold" }
    ) },
    { selector = "form"; declarations = list(
      { property = "display"; value = "flex" },
      { property = "flex-wrap"; value = "wrap" },
      { property = "align-items"; value = "end" },
      { property = "gap"; value = ".6rem" },
      { property = "margin"; value = ".55rem 0" }
    ) },
    { selector = "form.entry label"; declarations = list(
      { property = "flex"; value = "1 1 13rem" }
    ) },
    { selector = "form.inline label"; declarations = list(
      { property = "flex"; value = "1 1 8rem" }
    ) },
    { selector = "label"; declarations = list(
      { property = "display"; value = "grid" },
      { property = "gap"; value = ".25rem" },
      { property = "min-width"; value = "0" },
      { property = "font-weight"; value = "bold" }
    ) },
    { selector = "label:has(input:is([type=checkbox],[type=radio]))"; declarations = list(
      { property = "display"; value = "flex" },
      { property = "align-items"; value = "center" }
    ) },
    { selector = "input,select,textarea"; declarations = list(
      { property = "max-width"; value = "100%" },
      { property = "min-width"; value = "0" },
      { property = "font"; value = "inherit" },
      { property = "color"; value = "inherit" }
    ) },
    { selector = "input:not([type=checkbox],[type=radio],[type=range]),select,textarea"; declarations = list(
      { property = "width"; value = "100%" },
      { property = "padding"; value = ".45rem .55rem" },
      { property = "border"; value = "0" },
      { property = "background"; value = "var(--sourcery-paper)" },
      { property = "box-shadow"; value = "var(--sourcery-inset)" }
    ) },
    { selector = "textarea"; declarations = list(
      { property = "resize"; value = "vertical" }
    ) },
    { selector = "fieldset"; declarations = list(
      { property = "min-width"; value = "0" },
      { property = "border"; value = "1px solid var(--sourcery-line)" }
    ) },
    { selector = "pre"; declarations = list(
      { property = "max-width"; value = "100%" },
      { property = "overflow"; value = "auto" },
      { property = "white-space"; value = "pre-wrap" }
    ) },
    { selector = "code"; declarations = list(
      { property = "overflow-wrap"; value = "anywhere" }
    ) },
    { selector = "table"; declarations = list(
      { property = "width"; value = "100%" },
      { property = "border-collapse"; value = "collapse" }
    ) },
    { selector = "th,td"; declarations = list(
      { property = "border"; value = "1px solid var(--sourcery-line)" },
      { property = "padding"; value = ".3rem .45rem" },
      { property = "text-align"; value = "start" }
    ) },
    { selector = "th"; declarations = list(
      { property = "background"; value = "var(--sourcery-frame)" }
    ) },
    { selector = "ul,ol"; declarations = list(
      { property = "padding-inline-start"; value = "1.35rem" }
    ) },
    { selector = "li"; declarations = list(
      { property = "margin-block"; value = ".25rem" }
    ) },
    { selector = "ul:has(>li[data-attention])"; declarations = list(
      { property = "padding"; value = "0" },
      { property = "list-style"; value = "none" }
    ) },
    { selector = "li[data-attention]"; declarations = list(
      { property = "padding"; value = ".35rem .45rem" },
      { property = "background"; value = "var(--sourcery-panel)" },
      { property = "border"; value = "1px solid var(--sourcery-line)" }
    ) },
    { selector = "li[data-attention=critical]"; declarations = list(
      { property = "border-inline-start"; value = "3px solid #992b30" }
    ) },
    { selector = ".feedback"; declarations = list(
      { property = "margin"; value = "4px 0" },
      { property = "padding"; value = ".55rem .75rem" },
      { property = "color"; value = "var(--sourcery-accent)" },
      { property = "background"; value = "var(--sourcery-selected)" }
    ) },
    { selector = ".feedback:empty"; declarations = list(
      { property = "display"; value = "none" }
    ) },
    { selector = ".feedback.error"; declarations = list(
      { property = "background"; value = "#fbe6e4" },
      { property = "color"; value = "#712722" }
    ) },
    { selector = ".quiet,.nr-ed-muted,.nb1-label,.task-kicker"; declarations = list(
      { property = "color"; value = "var(--sourcery-muted)" }
    ) },
    { selector = ".nb1-label,.task-kicker"; declarations = list(
      { property = "font-weight"; value = "bold" },
      { property = "font-size"; value = ".78rem" },
      { property = "letter-spacing"; value = ".06em" },
      { property = "text-transform"; value = "uppercase" }
    ) },
    { selector = ".task-reference,.task-status,.nb1-stamp"; declarations = list(
      { property = "display"; value = "inline-block" },
      { property = "margin-inline-end"; value = ".25rem" },
      { property = "padding"; value = "2px 5px" },
      { property = "color"; value = "var(--sourcery-accent)" },
      { property = "background"; value = "var(--sourcery-selected)" },
      { property = "font-size"; value = ".86rem" }
    ) },
    { selector = ".nb1-stamp"; declarations = list(
      { property = "background"; value = "#ece3b9" },
      { property = "color"; value = "#48380b" }
    ) },
    { selector = ".rich-positive,.task-checked"; declarations = list(
      { property = "color"; value = "#235d2e" }
    ) },
    { selector = ".rich-negative"; declarations = list(
      { property = "color"; value = "#932a23" }
    ) },
    { atRule = "media"; prelude = "(max-width:34rem)"; rules = list(
      { selector = "form.entry>button"; declarations = list(
        { property = "width"; value = "100%" }
      ) },
      { selector = "form.entry label"; declarations = list(
        { property = "flex-basis"; value = "100%" }
      ) },
      { selector = "th,td"; declarations = list(
        { property = "padding"; value = ".2rem .3rem" }
      ) }
    ) }
  )
  call css.renderCompactRules


process sourcery.notebook.reviewStyles:
  let cssRuleSeparator = ""
  let cssRules = list(
    { selector = ".task-workbench,.nb1"; declarations = list(
      { property = "min-width"; value = "0" }
    ) },
    { selector = ".task-document,.nb1-paper"; declarations = list(
      { property = "min-width"; value = "0" },
      { property = "padding"; value = "clamp(.65rem,2vw,1.25rem)" },
      { property = "background"; value = "var(--sourcery-paper)" },
      { property = "box-shadow"; value = "var(--sourcery-inset)" }
    ) },
    { selector = ".nb1-paper header"; declarations = list(
      { property = "margin-bottom"; value = ".75rem" },
      { property = "border-bottom"; value = "1px solid var(--sourcery-line)" },
      { property = "padding-bottom"; value = ".5rem" }
    ) },
    { selector = ".nr-board-title"; declarations = list(
      { property = "margin-bottom"; value = ".65rem" }
    ) },
    { selector = ".task-panel,.task-evidence,.nb1-decision,.nr-ed-panel,.nr-board-card,.nr-board-inspector,.nr-preview,.implementation-evidence,.implementation-blocker"; declarations = list(
      { property = "margin"; value = ".35rem 0" },
      { property = "padding"; value = ".65rem" },
      { property = "background"; value = "var(--sourcery-panel)" },
      { property = "border"; value = "1px solid var(--sourcery-line)" }
    ) },
    { selector = ".task-decision,.nb1-decision,.implementation-blocker"; declarations = list(
      { property = "border-inline-start"; value = "4px solid var(--sourcery-accent)" }
    ) },
    { selector = ".task-decision[data-attention=critical],.implementation-blocker"; declarations = list(
      { property = "border-inline-start-color"; value = "#992b30" }
    ) },
    { selector = ".nb1-decision[data-tone=saved]"; declarations = list(
      { property = "border-inline-start-color"; value = "#235d2e" }
    ) },
    { selector = ".task-decision[data-attention=critical] .task-status"; declarations = list(
      { property = "background"; value = "#fbe6e4" },
      { property = "color"; value = "#712722" }
    ) },
    { selector = ".task-people,.task-live-notice,.task-handoff-actions,.nb1-actions,.nr-ed-actions,.nr-inspection-nav,.nr-ed-scenario-nav,.nr-review-primary,.nr-review-secondary"; declarations = list(
      { property = "display"; value = "flex" },
      { property = "align-items"; value = "center" },
      { property = "flex-wrap"; value = "wrap" },
      { property = "gap"; value = ".4rem .6rem" }
    ) },
    { selector = ".task-live-notice,.nb1-actions,.nr-ed-scenario-nav,.nr-inspection-nav"; declarations = list(
      { property = "margin"; value = ".5rem 0" }
    ) },
    { selector = ".task-people:empty"; declarations = list(
      { property = "display"; value = "none" }
    ) },
    { selector = ".task-template-label,.task-revision"; declarations = list(
      { property = "color"; value = "var(--sourcery-muted)" },
      { property = "font-size"; value = ".86rem" }
    ) },
    { selector = ".task-template-label"; declarations = list(
      { property = "display"; value = "block" }
    ) },
    { selector = ".nb1-title,.nb1-path,.nb1-footer,.nb1-tabs"; declarations = list(
      { property = "display"; value = "flex" },
      { property = "align-items"; value = "center" },
      { property = "flex-wrap"; value = "wrap" },
      { property = "gap"; value = ".3rem .65rem" }
    ) },
    { selector = ".nb1-title,.nb1-footer"; declarations = list(
      { property = "justify-content"; value = "space-between" }
    ) },
    { selector = ".nb1-book"; declarations = list(
      { property = "display"; value = "inline-grid" },
      { property = "place-items"; value = "center" },
      { property = "width"; value = "19px" },
      { property = "height"; value = "19px" },
      { property = "margin-inline-end"; value = "6px" },
      { property = "background"; value = "var(--sourcery-gold)" },
      { property = "color"; value = "var(--sourcery-ink)" },
      { property = "box-shadow"; value = "var(--sourcery-raised)" },
      { property = "font-size"; value = "12px" }
    ) },
    { selector = ".nb1-path,.nb1-footer"; declarations = list(
      { property = "padding"; value = ".3rem .65rem" },
      { property = "background"; value = "var(--sourcery-frame)" },
      { property = "color"; value = "var(--sourcery-muted)" },
      { property = "font-size"; value = ".83rem" }
    ) },
    { selector = ".nb1-tabs"; declarations = list(
      { property = "gap"; value = "3px" },
      { property = "padding"; value = "4px 5px 0" }
    ) },
    { selector = ".nb1-tabs a"; declarations = list(
      { property = "padding"; value = ".35rem .6rem" },
      { property = "background"; value = "var(--sourcery-frame)" },
      { property = "color"; value = "var(--sourcery-ink)" },
      { property = "box-shadow"; value = "var(--sourcery-raised)" },
      { property = "text-decoration"; value = "none" }
    ) },
    { selector = ".nb1-tabs a:hover,.nb1-tabs a[aria-current]"; declarations = list(
      { property = "background"; value = "var(--sourcery-paper)" }
    ) },
    { selector = ".nb1-inspector"; declarations = list(
      { property = "position"; value = "fixed" },
      { property = "z-index"; value = "3" },
      { property = "inset"; value = "clamp(.5rem,5vh,3rem) clamp(.5rem,5vw,3rem) auto auto" },
      { property = "width"; value = "min(42rem,calc(100% - 2 * clamp(.5rem,5vw,3rem)))" },
      { property = "max-height"; value = "85dvh" },
      { property = "overflow"; value = "auto" },
      { property = "margin"; value = "0" },
      { property = "padding"; value = ".75rem" },
      { property = "background"; value = "var(--sourcery-paper)" },
      { property = "border"; value = "4px solid var(--sourcery-frame)" },
      { property = "box-shadow"; value = "var(--sourcery-raised),var(--sourcery-shadow)" }
    ) },
    { selector = ".nb1-inspector:not(:target),.task-inspector-heading,.task-inspector-close"; declarations = list(
      { property = "display"; value = "none" }
    ) },
    { selector = ".nb1-inspector-head"; declarations = list(
      { property = "display"; value = "flex" },
      { property = "align-items"; value = "center" },
      { property = "justify-content"; value = "space-between" },
      { property = "gap"; value = ".5rem" },
      { property = "padding"; value = ".4rem .55rem" },
      { property = "margin-bottom"; value = ".55rem" },
      { property = "color"; value = "white" },
      { property = "background"; value = "var(--sourcery-title)" }
    ) },
    { selector = ".nb1-inspector-head :is(h2,a)"; declarations = list(
      { property = "margin"; value = "0" },
      { property = "color"; value = "inherit" }
    ) },
    { selector = ".nb1-inspector-group+.nb1-inspector-group"; declarations = list(
      { property = "margin-top"; value = ".6rem" },
      { property = "padding-top"; value = ".5rem" },
      { property = "border-top"; value = "1px solid var(--sourcery-line)" }
    ) },
    { selector = ".nr-ed-code,.nr-diff,.implementation-diff,.implementation-checks"; declarations = list(
      { property = "max-width"; value = "100%" },
      { property = "overflow"; value = "auto" },
      { property = "background"; value = "var(--sourcery-paper)" },
      { property = "box-shadow"; value = "var(--sourcery-inset)" },
      { property = "padding"; value = ".4rem" }
    ) },
    { selector = ".nr-ed-code-line,.nr-diff-line"; declarations = list(
      { property = "display"; value = "grid" },
      { property = "grid-template-columns"; value = "3.2rem minmax(0,1fr)" },
      { property = "gap"; value = ".35rem" }
    ) },
    { selector = ".nr-ed-code-line code,.nr-diff-line code"; declarations = list(
      { property = "white-space"; value = "pre-wrap" }
    ) },
    { selector = ".nr-token-keyword"; declarations = list(
      { property = "color"; value = "#152a91" },
      { property = "font-weight"; value = "bold" }
    ) },
    { selector = ".nr-token-string"; declarations = list(
      { property = "color"; value = "#a22e1d" }
    ) },
    { selector = ".nr-token-reference"; declarations = list(
      { property = "color"; value = "#713b82" }
    ) },
    { selector = ".nr-token-literal"; declarations = list(
      { property = "color"; value = "#844900" }
    ) },
    { selector = ".nr-token-qualified"; declarations = list(
      { property = "color"; value = "#20537e" }
    ) },
    { selector = ".nr-token-comment"; declarations = list(
      { property = "color"; value = "#376340" },
      { property = "font-style"; value = "italic" }
    ) },
    { selector = ".nr-flow"; declarations = list(
      { property = "list-style"; value = "none" },
      { property = "padding"; value = "0" }
    ) },
    { selector = ".nr-ed-stage-screen,.nr-flow li"; declarations = list(
      { property = "padding"; value = ".35rem .45rem" },
      { property = "border"; value = "1px solid var(--sourcery-line)" },
      { property = "background"; value = "var(--sourcery-paper)" }
    ) },
    { atRule = "media"; prelude = "(max-width:48rem)"; rules = list(
      { selector = ".nr-ed-panel table"; declarations = list(
        { property = "table-layout"; value = "fixed" }
      ) }
    ) }
  )
  call css.renderCompactRules


process sourcery.notebook.workbenchStyles:
  let cssRuleSeparator = ""
  let cssRules = list(
    { selector = "body:has(>main>.cb-workbench)"; declarations = list(
      { property = "display"; value = "grid" },
      { property = "grid-template-rows"; value = "auto minmax(0,1fr)" },
      { property = "height"; value = "100dvh" }
    ) },
    { selector = "body:has(>main:first-child>.cb-workbench)"; declarations = list(
      { property = "grid-template-rows"; value = "minmax(0,1fr)" }
    ) },
    { selector = "main:has(>.cb-workbench)"; declarations = list(
      { property = "display"; value = "grid" },
      { property = "min-height"; value = "0" },
      { property = "max-width"; value = "none" }
    ) },
    { selector = ".cb-workbench"; declarations = list(
      { property = "display"; value = "grid" },
      { property = "grid-template-rows"; value = "auto minmax(0,1fr)" },
      { property = "min-width"; value = "0" },
      { property = "min-height"; value = "0" },
      { property = "gap"; value = "4px" }
    ) },
    { selector = ".cb-workspace"; declarations = list(
      { property = "display"; value = "grid" },
      { property = "grid-template-columns"; value = "clamp(8rem,14vw,13rem) minmax(0,1fr)" },
      { property = "min-height"; value = "0" },
      { property = "gap"; value = "4px" }
    ) },
    { selector = ".cb-folders,.cb-record-pane,.cb-shot-inspector,.cb-timeline,.cb-workbench #context"; declarations = list(
      { property = "min-width"; value = "0" },
      { property = "min-height"; value = "0" },
      { property = "overflow"; value = "auto" },
      { property = "background"; value = "var(--sourcery-paper)" },
      { property = "box-shadow"; value = "var(--sourcery-inset)" },
      { property = "padding"; value = "5px" }
    ) },
    { selector = ".cb-folder p"; declarations = list(
      { property = "margin"; value = ".25rem" },
      { property = "color"; value = "var(--sourcery-accent)" },
      { property = "font-weight"; value = "bold" }
    ) },
    { selector = ".cb-folder a"; declarations = list(
      { property = "display"; value = "block" },
      { property = "padding"; value = ".2rem .4rem" },
      { property = "text-decoration"; value = "none" }
    ) },
    { selector = ".cb-folder a[aria-current]"; declarations = list(
      { property = "background"; value = "var(--sourcery-accent)" },
      { property = "color"; value = "white" }
    ) },
    { selector = ".cb-workbench #context"; declarations = list(
      { property = "display"; value = "flex" },
      { property = "flex-direction"; value = "column" },
      { property = "padding"; value = "3px" }
    ) },
    { selector = ".cb-workbench #context>header"; declarations = list(
      { property = "display"; value = "flex" },
      { property = "flex-wrap"; value = "wrap" },

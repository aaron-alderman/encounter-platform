("v1", "entry", "v8")
("v8", "type", "Entry")
("v8", "key", "text")
("v9", "type", "String")
("v9", "scalar", "process-module \"temple/surface-process-module/1\"\n\nprocess nr.timeEmployee:\n  let result = null\n  when and(eq($task.phase, \"imported\"), eq($actor.role, \"employee\")):\n    let registry = $task.import\n    let links = filter($registry.links, \"link\", eq($link.accountRef, $actor.id))\n    when eq(count($links), 1):\n      let link = at($links, 0)\n      let employees = filter($registry.employees, \"employee\", eq($employee.id, $link.employee))\n      when eq(count($employees), 1):\n        let result = at($employees, 0)\n\nprocess nr.timeLoad:\n  let documents = $eventInput\n  let saved = filter($documents, \"document\", eq($document.path, \"timesheet.rel\"))\n  let result = list()\n  when count($saved):\n    assert eq(count($saved), 1)\n      otherwise \"TIMESHEET: Ambiguous saved entries.\"\n    let document = at($saved, 0)\n    port rel.decode { text = $document.text; kind = \"NorthRiverTimeEntries\" } → result\n\nprocess nr.timeSelect:\n  let matches = filter($mine, \"entry\", eq($entry.id, $eventInput))\n  assert eq(count($matches), 1)\n    otherwise \"ACCESS: This entry is unavailable to your account.\"\n  let result = at($matches, 0)\n\nprocess nr.timeChange:\n  assert eq($fields.employee, $employee.id)\n    otherwise \"ACCESS: You can only save time for your assigned employee.\"\n  assert includes(list(\"add-time\", \"edit-time\"), $fields.action)\n    otherwise \"Choose an offered timesheet action.\"\n  let id = $request.nonce\n  when eq($fields.action, \"edit-time\"):\n    port kernel.invoke { query = \"nr.timeSelect\"; input = $fields.entry } → existing\n    let id = $existing.id\n  port kernel.invoke { query = \"timesheet.date\"; input = $fields.date } → date\n  port scalar.read { text = $fields.minutes } → minutes\n  port value.type { value = $minutes } → type\n  assert eq($type, \"number\")\n    otherwise \"Enter positive whole minutes.\"\n  port number.calculate { operation = \"floor\"; values = list($minutes) } → whole\n  port number.calculate { operation = \"lessEqual\"; values = list($minutes, 9007199254740991) } → bounded\n  port number.calculate { operation = \"greater\"; values = list($minutes, 0) } → positive\n  assert and(eq($minutes, $whole), $bounded, $positive)\n    otherwise \"Enter positive whole minutes.\"\n  let entry = { id = $id; employee = $employee.id; date = $date; minutes = $minutes }\n  let next = $entries\n  when eq($fields.action, \"add-time\"):\n    let next = append($entries, list($entry))\n  when eq($fields.action, \"edit-time\"):\n    let next = map($entries, \"item\", if(and(eq($item.id, $id), eq($item.employee, $employee.id)), $entry, $item))\n  let result = $next\n\nprocess nr.timeRequest:\n  let notice = \"\"\n  let error = false\n  let entry = null\n  let mine = list()\n  let role = at($actor, \"role\")\n  port kernel.invoke { query = \"nr.timeEmployee\"; input = null } → employee\n  when $employee:\n    port kernel.invoke { query = \"nr.timeLoad\"; input = $snapshot.documents } → entries\n    let mine = filter($entries, \"item\", eq($item.employee, $employee.id))\n  try:\n    when eq($request.method, \"POST\"):\n      assert $employee\n        otherwise \"ACCESS: This account cannot save employee time.\"\n      port scalar.read { text = $fields.base } → base\n      assert eq($base, $snapshot.revision)\n        otherwise \"STALE: Reopen the timesheet before saving.\"\n      port kernel.invoke { query = \"nr.timeChange\"; input = null } → next\n      port rel.encode { value = $next; kind = \"NorthRiverTimeEntries\" } → saved\n      let documents = append(filter($snapshot.documents, \"document\", not(eq($document.path, \"timesheet.rel\"))), list({ path = \"timesheet.rel\"; text = $saved }))\n      let notice = if(eq($fields.action, \"add-time\"), \"Time entry saved.\", \"Time entry corrected.\")\n      port kernel.invoke { query = \"nr.persist\"; input = { documents = $documents; notice = $notice; target = $employee.id; goal = \"Record employee time\" } } → _\n      port storage.snapshot {} → snapshot\n      port kernel.invoke { query = \"nr.timeLoad\"; input = $snapshot.documents } → entries\n      let mine = filter($entries, \"item\", eq($item.employee, $employee.id))\n    when and(eq($request.method, \"GET\"), not(eq(at($fields, \"entry\"), at({}, \"absent\")))):\n      port kernel.invoke { query = \"nr.timeSelect\"; input = $fields.entry } → entry\n  catch fault:\n    let notice = $fault.message\n    let error = true\n  port kernel.invoke { query = \"nr.timePage\"; input = { project = $task.project; active = eq($task.phase, \"imported\"); csrf = $request.csrf; revision = $snapshot.revision; account = at($actor, \"id\"); role = $role; employee = $employee; mine = $mine; entry = $entry; notice = $notice; error = $error } } → html\n  let result = { html = $html; session = $session }\n\nprocess nr.sickLoad:\n  let document = at(filter($eventInput, \"item\", eq($item.path, \"sick-leave.rel\")), 0)\n  let result = list()\n  when $document:\n    port rel.decode { text = $document.text; kind = \"NorthRiverSickLeave\" } → result\n\nprocess nr.sickMinutes:\n  port scalar.read { text = $eventInput } → minutes\n  port value.type { value = $minutes } → type\n  assert eq($type, \"number\")\n    otherwise \"Enter positive whole minutes.\"\n  port number.calculate { operation = \"floor\"; values = list($minutes) } → whole\n  port number.calculate { operation = \"greater\"; values = list($minutes, 0) } → positive\n  port number.calculate { operation = \"lessEqual\"; values = list($minutes, 9007199254740991) } → bounded\n  assert and(eq($minutes, $whole), $positive, $bounded)\n    otherwise \"Enter positive whole minutes.\"\n  let result = $minutes\n\nprocess nr.sickChange:\n  let action = $fields.action\n  let result = $entries\n  when eq($action, \"notify-sick\"):\n    assert and($employee, some($managers, \"manager\", eq($manager.id, $fields.manager)))\n      otherwise \"ACCESS: Choose a configured manager for your own notice.\"\n    port kernel.invoke { query = \"timesheet.date\"; input = $fields.date } → date\n    port kernel.invoke { query = \"nr.sickMinutes\"; input = $fields.minutes } → minutes\n    let result = append($entries, list({ id = $request.nonce; employee = $employee.id; manager = $fields.manager;\n      date = $date; requested = $minutes; minutes = 0; approved = false; reduction = null }))\n  when not(eq($action, \"notify-sick\")):\n    let matches = filter($entries, \"entry\", eq($entry.id, $fields.entry))\n    assert eq(count($matches), 1)\n      otherwise \"ACCESS: This sick-leave notice is unavailable.\"\n    let item = at($matches, 0)\n    let manager = and(eq($actor.role, \"manager\"), eq($actor.id, $item.manager))\n    let next = $item\n    when eq($action, \"approve-sick\"):\n      assert and($manager, not($item.approved))\n        otherwise \"ACCESS: Only the recipient manager can approve a pending notice.\"\n      port record.put { record = $item; key = \"minutes\"; value = $item.requested } → next\n      port record.put { record = $next; key = \"approved\"; value = true } → next\n    when eq($action, \"adjust-sick\"):\n      assert and($manager, $item.approved, not($item.reduction))\n        otherwise \"ACCESS: The recipient manager can adjust an approved notice with no pending reduction.\"\n      port kernel.invoke { query = \"nr.sickMinutes\"; input = $fields.minutes } → minutes\n      assert not(eq($minutes, $item.minutes))\n        otherwise \"Choose a different amount.\"\n      port number.calculate { operation = \"greater\"; values = list($minutes, $item.minutes) } → increase\n      port record.put { record = $item; key = if($increase, \"minutes\", \"reduction\"); value = $minutes } → next\n    when eq($action, \"approve-reduction\"):\n      assert and($employee, eq($employee.id, $item.employee), $item.approved, $item.reduction)\n        otherwise \"ACCESS: Only the affected employee can approve a pending reduction.\"\n      port record.put { record = $item; key = \"minutes\"; value = $item.reduction } → next\n      port record.put { record = $next; key = \"reduction\"; value = null } → next\n    assert includes(list(\"approve-sick\", \"adjust-sick\", \"approve-reduction\"), $action)\n      otherwise \"Choose an offered sick-leave action.\"\n    let result = map($entries, \"entry\", if(eq($entry.id, $item.id), $next, $entry))\n\nprocess nr.sickRequest:\n  port kernel.invoke { query = \"nr.timeEmployee\"; input = null } → employee\n  port reflection.image {} → identity\n  let managers = filter($identity.operators, \"operator\", eq($operator.role, \"manager\"))\n  port kernel.invoke { query = \"nr.sickLoad\"; input = $snapshot.documents } → entries\n  let notice = \"\"\n  let error = false\n  when eq($request.method, \"POST\"):\n    try:\n      port scalar.read { text = $fields.base } → base\n      assert eq($base, $snapshot.revision)\n        otherwise \"STALE: Reopen the sick-leave page before saving.\"\n      port kernel.invoke { query = \"nr.sickChange\"; input = null } → entries\n      port rel.encode { value = $entries; kind = \"NorthRiverSickLeave\" } → bytes\n      let notice = \"Sick-leave activity recorded.\"\n      port kernel.invoke { query = \"nr.persist\"; input = { documents = list({ path = \"sick-leave.rel\"; text = $bytes }); notice = $notice; target = \"sick-leave\"; goal = \"Record sick leave\" } } → _\n    catch fault:\n      let notice = $fault.message\n      let error = true\n    port storage.snapshot {} → snapshot\n    port kernel.invoke { query = \"nr.sickLoad\"; input = $snapshot.documents } → entries\n  let visible = filter($entries, \"entry\", or(and($employee, eq($entry.employee, $employee.id)), and(eq($actor.role, \"manager\"), eq($entry.manager, $actor.id))))\n  let view = { employee = $employee; role = $actor.role; managers = $managers; entries = $visible; csrf = $request.csrf; revision = $snapshot.revision }\n  port kernel.invoke { query = \"nr.sickPage\"; input = $view } → html\n  let result = { html = $html; session = $session }\n")
("v8", "value", "v9")

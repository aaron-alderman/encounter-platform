("v17", "type", "Entry")
("v17", "key", "text")
("v18", "type", "String")
("v18", "scalar", "process-module \"temple/surface-process-module/1\"\n\nprocess nr.timeForm:\n  let view = $eventInput\n  let editing = $view.entry\n  let employee = $view.employee\n  let option = { tag = \"option\"; attrs = { value = $employee.id; selected = true }; children = list($employee.displayName) }\n  let who = { tag = \"label\"; attrs = {}; children = list(\"Employee\", { tag = \"select\"; attrs = { name = \"employee\"; \"aria-label\" = \"Employee\"; required = true }; children = list($option) }) }\n  let date = { tag = \"label\"; attrs = {}; children = list(\"Work date\", { tag = \"input\"; attrs = { name = \"date\"; type = \"date\"; value = if($editing, $view.entry.date, \"\"); required = true }; children = list() }) }\n  let minutes = { tag = \"label\"; attrs = {}; children = list(\"Minutes worked\", { tag = \"input\"; attrs = { name = \"minutes\"; type = \"number\"; min = 1; step = 1; value = if($editing, $view.entry.minutes, \"\"); required = true }; children = list() }) }\n  let fields = list($who, $date, $minutes)\n  when $editing:\n    let fields = append($fields, list({ tag = \"input\"; attrs = { type = \"hidden\"; name = \"entry\"; value = $view.entry.id }; children = list() }))\n  port kernel.invoke { query = \"work.form\"; input = { csrf = $view.csrf; revision = $view.revision; action = if($editing, \"edit-time\", \"add-time\"); fields = $fields; button = if($editing, \"Save correction\", \"Save time entry\"); style = \"entry\" } } → result\n\nprocess nr.timePage:\n  let view = $eventInput\n  let identity = if($view.account, $view.account, \"Unavailable\")\n  let coordinate = { tag = \"span\"; attrs = { id = \"timesheet-session\"; hidden = true; \"data-csrf\" = $view.csrf; \"data-revision\" = $view.revision }; children = list() }\n  let content = list({ tag = \"p\"; attrs = {}; children = list(concat(\"Signed in as \", $identity)) }, $coordinate)\n  when not($view.active):\n    let content = append($content, list({ tag = \"p\"; attrs = {}; children = list(\"The timesheet opens after the employee import is approved.\") }))\n  when and($view.active, eq($view.role, \"manager\")):\n    let content = append($content, list({ tag = \"p\"; attrs = {}; children = list(\"Manager access is for reports. \", { tag = \"a\"; attrs = { href = \"/report\" }; children = list(\"Open timesheet report\") }) }))\n  when and($view.active, eq($view.role, \"employee\"), not($view.employee)):\n    let content = append($content, list({ tag = \"p\"; attrs = {}; children = list(\"This account has no accepted employee assignment.\") }))\n  when not(includes(list(\"employee\", \"manager\"), $view.role)):\n    let content = append($content, list({ tag = \"p\"; attrs = {}; children = list(\"This account has no timesheet access.\") }))\n  when $view.employee:\n    port kernel.invoke { query = \"nr.timeForm\"; input = $view } → form\n    let title = if($view.entry, \"Correct entry\", \"Add time\")\n    let content = append($content, list({ tag = \"section\"; attrs = { \"aria-label\" = $title }; children = list({ tag = \"h2\"; attrs = {}; children = list($title) }, $form) }))\n    let rows = map($view.mine, \"row\", { tag = \"li\"; attrs = {}; children = list(concat($row.date, \" · \", $row.minutes, \" minutes\"), \" · \", { tag = \"a\"; attrs = { href = concat(\"/timesheet?entry=\", $row.id) }; children = list(concat(\"Correct \", $row.date, \" · \", $row.minutes, \" minutes\")) }) })\n    let listing = if(count($rows), { tag = \"ul\"; attrs = {}; children = $rows }, { tag = \"p\"; attrs = {}; children = list(\"You have no time entries.\") })\n    let content = append($content, list({ tag = \"section\"; attrs = { \"aria-label\" = \"Your entries\" }; children = list({ tag = \"h2\"; attrs = {}; children = list(\"Your entries\") }, $listing) }))\n  when or($view.employee, eq($view.role, \"manager\")):\n    let content = append($content, list({ tag = \"a\"; attrs = { href = \"/sick-leave\" }; children = list(\"Sick leave\") }))\n  let summary = if($view.project, concat($view.project, \" · Demo\"), \"Demo workspace\")\n  port kernel.invoke { query = \"work.page\"; input = { page = { title = \"Timesheet\"; summary = $summary; content = $content }; notice = $view.notice; error = $view.error } } → result\n\nprocess nr.sickForm:\n  let spec = $eventInput\n  port kernel.invoke { query = \"work.form\"; input = { csrf = $view.csrf; revision = $view.revision;\n    action = $spec.action; fields = $spec.fields; button = $spec.button; style = \"entry\" } } → form\n  port record.put { record = $form.attrs; key = \"action\"; value = \"/sick-leave\" } → attrs\n  port record.put { record = $form; key = \"attrs\"; value = $attrs } → result\n\nprocess nr.sickPage:\n  let view = $eventInput\n  let content = list()\n  let minutes = { tag = \"input\"; attrs = { name = \"minutes\"; type = \"number\"; min = 1; required = true; \"aria-label\" = \"Sick-leave minutes\" }; children = list() }\n  when and($view.employee, count($view.managers)):\n    let options = map($view.managers, \"manager\", { tag = \"option\"; attrs = { value = $manager.id }; children = list($manager.id) })\n    let date = { tag = \"input\"; attrs = { name = \"date\"; type = \"date\"; required = true; \"aria-label\" = \"Sick-leave date\" }; children = list() }\n    let recipient = { tag = \"select\"; attrs = { name = \"manager\"; \"aria-label\" = \"Recipient manager\" }; children = $options }\n    port kernel.invoke { query = \"nr.sickForm\"; input = { action = \"notify-sick\"; button = \"Notify management\"; fields = list($date, $minutes, $recipient) } } → form\n    let content = list($form)\n  fold $view.entries as entry; listing starts list():\n    let id = { tag = \"input\"; attrs = { name = \"entry\"; type = \"hidden\"; value = $entry.id }; children = list() }\n    let form = null\n    when and(eq($view.role, \"manager\"), not($entry.approved)):\n      port kernel.invoke { query = \"nr.sickForm\"; input = { action = \"approve-sick\"; button = \"Approve sick leave\"; fields = list($id) } } → form\n    when and(eq($view.role, \"manager\"), $entry.approved, not($entry.reduction)):\n      port kernel.invoke { query = \"nr.sickForm\"; input = { action = \"adjust-sick\"; button = \"Adjust approved minutes\"; fields = list($id, $minutes) } } → form\n    when and($view.employee, $entry.reduction):\n      port kernel.invoke { query = \"nr.sickForm\"; input = { action = \"approve-reduction\"; button = \"Approve reduction\"; fields = list($id) } } → form\n    let status = if($entry.approved, concat($entry.minutes, \" approved minutes\"), concat($entry.requested, \" minutes awaiting management approval\"))\n    let pending = if($entry.reduction, concat(\"Reduction to \", $entry.reduction, \" minutes awaiting employee approval\"), \"\")\n    let item = { tag = \"li\"; attrs = {}; children = list({ tag = \"p\"; attrs = {}; children = list(concat($entry.employee, \" · \", $entry.date, \" · \", $status)) },\n      { tag = \"p\"; attrs = {}; children = list($pending) }, $form) }\n    yield append($listing, list($item)) → listing\n  fold $view.entries as entry; total starts 0:\n    yield add($total, $entry.minutes) → total\n  let content = append($content, list({ tag = \"p\"; attrs = {}; children = list(concat(\"Approved sick-leave minutes: \", $total)) },\n    { tag = \"ul\"; attrs = {}; children = $listing }))\n  port kernel.invoke { query = \"work.page\"; input = { page = { title = \"Sick leave\"; summary = \"Notices and approved minutes\"; content = $content }; notice = $notice; error = $error } } → result\n")
("v17", "value", "v18")
("v0", "item", "v10")
("rel.document", "root", "v0")

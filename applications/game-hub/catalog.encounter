      images = list(
        { file = "sourcery-game-port.jpg"; bytes = 288804; sha256 = "da5e5326850c50bd31e6bc774616df441bceedf14f33854fc0d40d824e474323"; title = "Export port"; alt = "One World export port with rail receival, stockyards and a vessel at berth" },

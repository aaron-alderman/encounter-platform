  let result = list(
    {
      id = "one-world"; number = "01"; group = "Worlds & tools"; title = "One World"; icon = "world";
      kind = "Simulation"; status = "EDITABLE SIMULATION"; heading = "From mine to port";
      summary = "A transport and production simulation. Build rail infrastructure, route freight, operate facilities and move inventory from the mine to an export vessel.";

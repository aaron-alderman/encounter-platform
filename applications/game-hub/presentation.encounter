process-module "temple/surface-process-module/1"

process hub.styles:
  let rules = list(
    { selector = "*"; props = { "box-sizing" = "border-box" } },
    { selector = "html,body"; props = { height = "100%"; margin = "0"; overflow = "hidden" } },
    { selector = "body"; props = { color = "#171717"; background = "#9e9e99"; font = "13px Tahoma,Verdana,Arial,sans-serif" } },
    { selector = "a"; props = { color = "#000080" } },
    { selector = ":focus-visible"; props = { outline = "2px dotted #12126e"; "outline-offset" = "-2px" } },
    { selector = ".skip"; props = { position = "absolute"; left = "8px"; top = "8px"; padding = "8px"; background = "#fff"; "z-index" = "2"; transform = "translateY(-160%)" } },
    { selector = ".skip:focus"; props = { transform = "none" } },
    { selector = ".desktop"; props = { height = "100dvh"; display = "grid"; "grid-template-rows" = "28px 27px 39px minmax(0,1fr) 28px";
      padding = "3px"; background = "#c8c7bf"; border = "2px outset #e2e1da" } },
    { selector = ".titlebar"; props = { display = "flex"; "justify-content" = "space-between"; "align-items" = "center"; gap = "7px";
      padding = "0 8px"; color = "white"; background = "linear-gradient(90deg,#00006c,#195294)" } },
    { selector = ".brand"; props = { display = "flex"; "align-items" = "center"; gap = "7px"; "text-decoration" = "none"; color = "white"; "font-size" = "14px" } },
    { selector = ".brand-mark"; props = { color = "#ffd25d"; "font-size" = "17px"; "font-weight" = "bold" } },
    { selector = ".edition"; props = { "font-size" = "11px"; "white-space" = "nowrap" } },
    { selector = ".toolbar,.document-picker"; props = { display = "flex"; "align-items" = "center"; gap = "5px"; "min-width" = "0";
      "border-bottom" = "1px solid #85857d"; padding = "2px 6px" } },
    { selector = ".toolbar a"; props = { color = "#171717"; padding = "3px 7px"; border = "1px solid transparent"; "text-decoration" = "none" } },
    { selector = ".toolbar a:hover,.toolbar a[aria-current]"; props = { border = "1px outset #eee" } },
    { selector = ".document-picker label"; props = { "font-weight" = "bold" } },
    { selector = ".document-picker select,.inspector-tools input,.inspector-tools select"; props = {
      "min-width" = "0"; "max-width" = "100%"; font = "inherit"; background = "#fffdf4"; border = "2px inset #ddd"; padding = "2px 4px" } },
    { selector = ".workspace"; props = { display = "grid"; "grid-template-columns" = "200px minmax(0,1fr)"; gap = "4px"; padding = "4px 0"; "min-height" = "0" } },
    { selector = ".pane"; props = { "min-width" = "0"; "min-height" = "0"; border = "2px inset #dfded7"; background = "#fffef5" } },
    { selector = ".navigation"; props = { padding = "5px"; background = "#f8f5df"; overflow = "auto" } },
    { selector = ".navigation:has(.asset-explorer)"; props = { display = "grid"; "grid-template-rows" = "auto minmax(7rem,1fr)"; gap = "6px" } },
    { selector = ".asset-explorer"; props = { overflow = "auto"; "border-top" = "1px solid #aba381"; padding = "4px 0" } },
    { selector = ".folder-group h2"; props = { margin = "9px 0 3px"; font = "bold 12px Tahoma,sans-serif"; color = "#1c2850" } },
    { selector = ".folder-group ul"; props = { margin = "0"; padding = "0"; "list-style" = "none" } },
    { selector = ".folder-group a"; props = { display = "flex"; gap = "6px"; "align-items" = "center"; padding = "4px 6px 4px 10px"; "text-decoration" = "none"; color = "#1c2850" } },
    { selector = ".folder-group a:hover"; props = { background = "#f8ecb3" } },
    { selector = ".folder-group a[aria-current]"; props = { background = "#000080"; color = "white" } },
    { selector = ".icon"; props = { display = "inline-block"; width = "9px"; height = "9px"; "flex-shrink" = "0"; border = "1px solid #534b32"; background = "#ecc35f" } },
    { selector = ".icon.world"; props = { background = "#6f9d9c"; "border-radius" = "50%" } },
    { selector = ".icon.asset"; props = { background = "#cda6ce" } },
    { selector = ".icon.land"; props = { background = "#b5c784" } },
    { selector = ".reader"; props = { display = "grid"; "grid-template-rows" = "auto auto minmax(0,1fr)" } },
    { selector = ".reader:has(> .pane-title:first-child)"; props = { "grid-template-rows" = "auto minmax(0,1fr)" } },
    { selector = ".document-tabs"; props = { display = "flex"; "flex-wrap" = "wrap"; gap = "2px"; padding = "4px 4px 0";
      background = "#c8c7bf"; "border-bottom" = "1px solid #808079" } },
    { selector = ".document-tabs a,.document-tabs span,.notes-button,.document-picker button,.inspector-tools button"; props = {
      display = "inline-block"; color = "#171717"; background = "#deddd5"; border = "2px outset #ededdf"; padding = "3px 8px";
      "text-decoration" = "none"; font = "inherit"; cursor = "pointer" } },
    { selector = ".document-tabs [aria-current],.notes-button:active"; props = { "border-style" = "inset"; background = "#f8ecb3" } },
    { selector = ".pane-title"; props = { display = "flex"; "align-items" = "center"; "justify-content" = "space-between"; gap = "8px"; padding = "5px 8px";
      background = "#fff1b5"; "border-bottom" = "1px solid #aba381" } },
    { selector = ".pane-title h1"; props = { margin = "0"; "font-size" = "15px"; "line-height" = "1.15" } },
    { selector = ".pane-title span"; props = { color = "#474333"; "font-size" = "11px"; "text-align" = "right" } },
    { selector = ".paper"; props = { "min-width" = "0"; "min-height" = "0"; overflow = "auto"; padding = "10px clamp(8px,2vw,22px)"; "overscroll-behavior" = "contain" } },
    { selector = ".route-notice,.map-note"; props = { padding = "7px"; margin = "0"; background = "#f8f0c9"; border = "1px solid #a9a187"; "line-height" = "1.4" } },
    { selector = ".paper h2"; props = { margin = "0 0 6px"; "font-size" = "15px"; color = "#1c2850" } },
    { selector = ".summary,.record-note p"; props = { margin = "0 0 12px"; "line-height" = "1.5"; "max-width" = "76ch" } },
    { selector = ".folio-activities"; props = { display = "grid"; "grid-template-columns" = "repeat(auto-fit,minmax(min(100%,240px),1fr))"; gap = "10px"; "max-width" = "760px" } },
    { selector = ".folio-activities section"; props = { padding = "12px"; border = "1px solid #aba381"; background = "#f8f5df" } },
    { selector = ".gallery"; props = { display = "grid"; "grid-template-columns" = "repeat(auto-fit,minmax(min(100%,180px),1fr))"; gap = "8px"; "margin-bottom" = "12px" } },
    { selector = ".attachment"; props = { display = "block"; padding = "4px"; border = "1px solid #8c8378"; background = "#ebe8dc"; "text-decoration" = "none" } },
    { selector = ".attachment img"; props = { display = "block"; width = "100%"; "aspect-ratio" = "16/9"; "object-fit" = "cover"; background = "#dedbd0" } },
    { selector = ".attachment span"; props = { display = "block"; padding = "4px 2px 2px"; "font-size" = "11px" } },
    { selector = ".statusbar"; props = { display = "flex"; "align-items" = "center"; gap = "4px"; padding = "2px 4px"; "font-size" = "12px"; "min-width" = "0" } },
    { selector = ".statusbar span"; props = { padding = "2px 6px"; border = "1px inset #deddd5"; "white-space" = "nowrap"; overflow = "hidden"; "text-overflow" = "ellipsis" } },
    { selector = ".statusbar span:last-child"; props = { "margin-left" = "auto" } },
    { selector = ".execution-notice"; props = { margin = "0 0 9px" } },
    { selector = ".execution-table"; props = { "border-collapse" = "collapse"; "text-align" = "left"; width = "100%"; background = "#fffdf4" } },
    { selector = ".execution-table th,.execution-table td"; props = { padding = "4px 6px"; border = "1px solid #c2bcaa"; "vertical-align" = "top"; "overflow-wrap" = "anywhere" } },
    { selector = ".execution-table thead th"; props = { background = "#e3dfd1" } },
    { selector = ".execution-table small"; props = { display = "block"; color = "#474333" } },
    { selector = ".inspector"; props = { display = "grid"; gap = "7px"; "min-width" = "0" } },
    { selector = ".inspector-tools"; props = { display = "flex"; "align-items" = "center"; "flex-wrap" = "wrap"; gap = "5px"; "min-width" = "0" } },
    { selector = ".inspector-tools label"; props = { display = "flex"; "align-items" = "center"; gap = "4px"; "min-width" = "0" } },
    { selector = ".inspector-tools p"; props = { margin = "0"; "overflow-wrap" = "anywhere" } },
    { selector = ".inspector-tools input[type=number]"; props = { width = "7ch" } },
    { selector = ".site-picker label"; props = { flex = "1 1 220px" } },
    { selector = ".site-picker select"; props = { flex = "1"; "min-width" = "0" } },
    { selector = ".inspector-sheet"; props = { padding = "7px"; border = "2px inset #dfded7"; background = "#fffdf4"; "overflow-wrap" = "anywhere" } },
    { selector = ".inspector-sheet p"; props = { margin = "5px 0" } },
    { selector = ".inspector-pin"; props = { "overflow-wrap" = "anywhere"; "font-family" = "monospace"; margin = "3px 0" } },
    { selector = ".source-code"; props = { border = "2px inset #dfded7"; background = "#fffdf4"; overflow = "auto"; "min-width" = "0" } },
    { selector = ".source-line"; props = { display = "grid"; "grid-template-columns" = "5ch minmax(0,1fr)"; "min-width" = "max-content"; font = "13px/18px 'Courier New',monospace" } },
    { selector = ".source-line .gutter"; props = { padding = "0 5px"; "text-align" = "right" } },
    { selector = ".source-line code"; props = { padding = "0 5px"; "white-space" = "pre" } },
    { selector = ".workbench-split"; props = { display = "grid"; "grid-template-columns" = "minmax(0,320px) minmax(0,1fr)"; "align-items" = "start"; gap = "14px" } },
    { selector = ".workbench-split > *"; props = { "min-width" = "0" } },
    { selector = ".workbench-split > :only-child"; props = { "grid-column" = "1 / -1" } },
    { selector = ".asset-preview > .workbench-split"; props = { "margin-top" = "8px" } },
    { selector = ".asset-build-forms"; props = { display = "grid"; gap = "9px" } },
    { selector = ".terrain-controls > .asset-controls:first-of-type"; props = { "margin-bottom" = "7px" } },
    { selector = ".terrain-controls fieldset"; props = { "grid-template-columns" = "repeat(2,minmax(0,1fr))" } },
    { selector = ".terrain-controls .terrain-full-row"; props = { "grid-column" = "1 / -1" } },
    { context = " (max-width: 850px)"; selector = ".workbench-split"; props = { "grid-template-columns" = "minmax(0,1fr)" } },
    { context = " (max-width: 850px)"; selector = ".asset-improvement .asset-improvement-fields"; props = { "grid-template-columns" = "repeat(3,minmax(0,1fr))" } },
    { context = " (max-width: 740px)"; selector = ".asset-preview-toolbar"; props = { position = "sticky"; top = "0"; "z-index" = "1"; background = "#fffef5"; padding = "5px 0"; "border-bottom" = "1px solid #aba381" } },
    { selector = ".asset-preview-panes"; props = { display = "grid"; "grid-template-columns" = "repeat(2,minmax(0,1fr))"; gap = "8px" } },
    { selector = ".asset-preview-panes section"; props = { "min-width" = "0"; padding = "6px"; border = "2px inset #deddd5"; background = "#f7f4e8" } },
    { selector = ".asset-preview-panes canvas"; props = { display = "block"; width = "100%"; height = "clamp(200px,42dvh,420px)"; background = "#e3e8ed"; "touch-action" = "none" } },
    { selector = ".asset-preview-panes p"; props = { margin = "5px 0 0"; "overflow-wrap" = "anywhere" } },
    { selector = "[data-preview-copy],[data-preview-copy-status]"; props = { "margin-left" = "6px" } },
    { context = " (max-width: 620px)"; selector = ".asset-preview-panes"; props = { "grid-template-columns" = "minmax(0,1fr)" } },
    { context = " (max-width: 620px)"; selector = ".asset-preview-panes canvas"; props = { height = "clamp(160px,30dvh,280px)" } },
    { selector = ".asset-tree-heading"; props = { margin = "3px 5px 5px"; "font-size" = "13px"; color = "#172b50" } },
    { selector = ".asset-tree,.asset-tree ul"; props = { "list-style" = "none"; margin = "0"; padding = "0" } },
    { selector = ".asset-tree summary,.mobile-asset-tree summary"; props = { cursor = "pointer"; padding = "4px 5px"; "font-weight" = "bold"; color = "#172b50" } },
    { selector = ".asset-tree ul"; props = { "margin-left" = "13px"; "border-left" = "1px dotted #89897c" } },
    { selector = ".asset-tree a"; props = { display = "block"; padding = "4px 6px"; "text-decoration" = "none"; color = "#172b50" } },
    { selector = ".asset-tree a:hover"; props = { background = "#fff4c7" } },
    { selector = ".asset-tree a[aria-current]"; props = { background = "#143771"; color = "#fff" } },
    { selector = ".mobile-asset-tree"; props = { display = "none" } },
    { context = " (max-width: 740px)"; selector = ".workspace:has(.mobile-asset-tree)"; props = { "grid-template-rows" = "auto minmax(0,1fr)" } },
    { context = " (max-width: 740px)"; selector = ".mobile-asset-tree"; props = { display = "block"; "max-height" = "32dvh"; overflow = "auto"; background = "#f8f5df"; border = "2px inset #deddd5" } },
    { selector = ".asset-lifecycle"; props = { padding = "8px"; border = "2px inset #dfded7"; background = "#fffdf4" } },
    { selector = ".asset-improvement-fields"; props = { display = "grid"; "grid-template-columns" = "repeat(auto-fit,minmax(min(100%,145px),1fr))"; gap = "7px" } },
    { selector = ".asset-improvement-fields label"; props = { display = "grid"; gap = "3px" } },
    { selector = ".asset-improvement button"; props = { "justify-self" = "start" } },
    { selector = ".asset-workbench"; props = { display = "grid"; gap = "13px"; "margin-bottom" = "18px" } },
    { selector = ".asset-picker,.asset-controls"; props = { display = "flex"; "flex-wrap" = "wrap"; gap = "8px"; "align-items" = "center" } },
    { selector = ".asset-editor fieldset"; props = { display = "grid"; gap = "7px"; "min-width" = "0"; margin = "0 0 10px"; padding = "10px"; border = "1px solid #a49aaa" } },
    { selector = ".asset-editor fieldset p"; props = { margin = "0 0 4px"; "line-height" = "1.5" } },
    { selector = ".asset-editor input,.asset-editor textarea,.asset-workbench select"; props = { padding = "6px"; border = "1px solid #756c84"; background = "#fffdf5"; font = "inherit"; "min-width" = "0" } },
    { selector = ".asset-workbench button"; props = { padding = "6px 9px"; background = "#e7e1f0"; border = "1px outset #9e94aa"; color = "#302643"; cursor = "pointer"; "font-weight" = "bold" } },
    { selector = ".asset-editor fieldset button"; props = { "justify-self" = "start" } },
    { selector = ".asset-error,.asset-notice"; props = { padding = "8px"; margin = "0"; border = "1px solid #b5a36a"; background = "#f2e5a9" } },
    { selector = ".asset-error"; props = { background = "#f3d9d0"; border = "1px solid #b5776d" } },
    { selector = ".asset-code"; props = { "max-height" = "18rem"; overflow = "auto"; padding = "9px"; background = "#f1eee6"; border = "1px solid #c1bbc6" } },
    { selector = ".asset-id"; props = { "overflow-wrap" = "anywhere"; "font-family" = "monospace" } },
    { selector = ".asset-wireframe"; props = { width = "min(100%, 260px)"; display = "block"; background = "#efe9f4"; fill = "none"; stroke = "#49406b"; "stroke-width" = ".75" } },
    { selector = ".asset-metrics"; props = { display = "grid"; "grid-template-columns" = "repeat(auto-fit,minmax(85px,1fr))"; gap = "7px" } },
    { selector = ".asset-metrics div"; props = { padding = "5px"; background = "#ebe7ef" } },
    { selector = ".asset-metrics dd"; props = { margin = "0"; "font-weight" = "bold" } },
    { selector = ".world-scene > .asset-controls"; props = { "margin-bottom" = "7px" } },
    { selector = ".world-scene canvas,.landscape-viewport canvas"; props = { display = "block"; width = "100%"; height = "clamp(200px,36dvh,420px)"; background = "#e3e8ed"; "touch-action" = "none" } },
    { selector = ".landscape-viewport [hidden]"; props = { display = "none" } },
    { selector = ".landscape-viewport p"; props = { margin = "5px 0" } },
    { selector = ".world-scene-fields"; props = { "grid-template-columns" = "repeat(auto-fit,minmax(min(100%,190px),1fr))" } },
    { selector = ".world-scene-fields button"; props = { "grid-column" = "1 / -1" } },
    { selector = ".world-map"; props = { width = "min(100%, 420px)"; "max-height" = "230px"; background = "#e9e4ed"; stroke = "#4c4269"; "stroke-width" = "2"; fill = "#6b5c91" } },
    { selector = ".world-alignment"; props = { margin = "8px 0"; "font-family" = "monospace" } },
    { selector = ".world-table"; props = { "border-collapse" = "collapse"; "font-size" = "12px"; "text-align" = "left" } },
    { selector = ".world-table caption"; props = { "text-align" = "left"; "font-weight" = "bold"; padding = "5px 0" } },
    { selector = ".world-table td,.world-table th"; props = { "border-bottom" = "1px solid #bdb2c6"; padding = "5px"; "overflow-wrap" = "anywhere" } },
    { selector = ".asset-editor fieldset label"; props = { display = "grid"; gap = "3px" } },
    { context = " (max-width: 740px)"; selector = ".workspace"; props = { "grid-template-columns" = "minmax(0,1fr)" } },
    { context = " (max-width: 740px)"; selector = ".navigation,.navigation:has(.asset-explorer)"; props = { display = "none" } },
    { context = " (max-width: 430px)"; selector = ".edition,.pane-title span,.statusbar span:last-child"; props = { display = "none" } },
    { context = " (max-width: 430px)"; selector = ".asset-workbench:has(.asset-build-forms),.asset-build-forms,.asset-preview > .workbench-split"; props = { gap = "6px" } },
    { context = " (max-width: 430px)"; selector = ".asset-build-forms .asset-controls,.asset-preview-toolbar"; props = { gap = "5px" } },
    { context = " (max-width: 430px)"; selector = ".asset-build-forms button,.asset-preview-toolbar button,.asset-preview-toolbar .notes-button"; props = { padding = "4px 6px" } },
    { context = " (max-width: 430px)"; selector = ".asset-build-forms input,.asset-build-forms select,.asset-preview-toolbar select"; props = { padding = "3px 4px" } },
    { context = " (max-width: 430px)"; selector = ".asset-build-forms .asset-improvement"; props = { padding = "6px"; margin = "0" } },
    { context = " (max-width: 430px)"; selector = ".terrain-controls .asset-controls button,.terrain-controls input,.terrain-controls select"; props = { padding = "4px 6px" } },
    { context = " (max-width: 430px)"; selector = ".document-tabs a,.document-tabs span"; props = { "padding-inline" = "5px" } },
    { context = " (max-width: 430px)"; selector = ".source-line"; props = { font = "12px/16px 'Courier New',monospace" } }
  )
  let rules = append($rules, or(at($eventInput, "extraRules"), list()))
  fold $rules as rule; planned starts list():
    port record.entries { value = $rule.props } → properties
    let declarations = map($properties, "pair", { property = at($pair, 0); value = at($pair, 1) })
    yield append($planned, list({ selector = $rule.selector; context = $rule.context; declarations = $declarations })) → planned
  let cssPlan = { imports = list(); tokens = list(); rules = $planned }
  call css.renderPlan
  let styles = $result
  call semantic.sourceStyles
  let result = concat($styles, $result)

process-module "temple/surface-process-module/1"

process gateway.styles:
  port kernel.invoke { query = "sourcery.presentation.tokens"; input = null } → tokens
  let result = concat($tokens,
    ".pilot-skip{position:absolute;inset:.5rem auto auto .5rem;z-index:5;padding:.5rem;background:var(--sourcery-paper);color:var(--sourcery-accent);transform:translateY(-200%)}.pilot-skip:focus{transform:none}",
    ".pilot-shell{box-sizing:border-box;padding:4px;color:var(--sourcery-ink);background:var(--sourcery-frame);box-shadow:var(--sourcery-raised);font:14px/1.4 var(--sourcery-font)}",
    ".pilot-bar,.pilot-nav{display:flex;align-items:center;flex-wrap:wrap;gap:5px}.pilot-bar{padding:2px 4px;column-gap:12px}",
    ".pilot-appdev,.pilot-brand{color:var(--sourcery-accent);font-weight:bold;text-decoration:none}.pilot-appdev:hover,.pilot-brand:hover{text-decoration:underline}",
    ".pilot-brand{display:inline-flex;align-items:center;gap:6px}.pilot-brand small{margin-inline-start:7px;color:var(--sourcery-muted);font-weight:normal}",
    ".pilot-mark{display:grid;place-items:center;width:23px;height:23px;background:var(--sourcery-gold);box-shadow:var(--sourcery-raised);color:var(--sourcery-ink);font-size:11px}",
    ".pilot-nav a,.pilot-primary{display:inline-block;padding:5px 8px;background:var(--sourcery-frame);color:var(--sourcery-accent);box-shadow:var(--sourcery-raised);text-decoration:none}",
    ".pilot-nav a:hover,.pilot-primary:hover{background:var(--sourcery-selected)}.pilot-nav a[aria-current]{background:var(--sourcery-paper);box-shadow:var(--sourcery-inset);font-weight:bold}",
    ".pilot-shell a:focus-visible,.pilot-primary:focus-visible{outline:2px dashed var(--sourcery-accent);outline-offset:-3px}",
    ".pilot-review-inner,.pilot-context{padding:.65rem .85rem;background:var(--sourcery-paper);color:var(--sourcery-ink);box-shadow:var(--sourcery-inset)}.pilot-review-inner p,.pilot-context p{margin:0 0 .25rem}.pilot-review-inner nav+nav{margin-top:.3rem}",
    ".pilot-review-label,.pilot-label{color:var(--sourcery-accent);font-weight:bold;font-size:12px}.pilot-review-inner a,.pilot-jump a{color:var(--sourcery-accent);text-underline-offset:.17em}.pilot-review-inner a[aria-current]{background:var(--sourcery-selected)}",
    ".pilot-preview-layout{display:grid;grid-template-columns:minmax(0,4fr) minmax(14rem,1fr);align-items:start;gap:10px;max-width:102rem;margin:10px auto;padding-inline:10px}.pilot-preview-surface{min-width:0}.pilot-preview-comments{position:sticky;top:.6rem;min-width:0;scroll-margin-top:.6rem;background:var(--sourcery-frame);padding:4px;box-shadow:var(--sourcery-raised)}.pilot-preview-comments iframe{display:block;width:100%;height:34rem;border:0;background:var(--sourcery-paper)}@media(max-width:50rem){.pilot-preview-layout{grid-template-columns:minmax(0,1fr);padding-inline:6px}.pilot-preview-comments{position:static}.pilot-preview-comments iframe{height:32rem}}",
    ".pilot-context-tools{display:flex;align-items:center;flex-wrap:wrap;gap:.4rem .7rem}.pilot-context-tools:has(button:not([hidden])){margin-top:.55rem}.pilot-context-tools button,.pilot-context-back{padding:.35rem .6rem;background:var(--sourcery-frame);color:var(--sourcery-accent);box-shadow:var(--sourcery-raised);border:0;border-radius:0;font:inherit;cursor:pointer}.pilot-context-tools button[aria-pressed=true]{background:var(--sourcery-selected);box-shadow:var(--sourcery-inset)}.pilot-preview-surface [data-pilot-context-active]{outline:3px solid var(--sourcery-accent);outline-offset:3px;scroll-margin-block:1rem}.pilot-preview-surface:has([data-pilot-context-pick]) [data-pilot-context-active]:not([data-pilot-context-pick]){outline:none}.pilot-preview-surface [data-pilot-context-pick]{outline:2px dashed var(--sourcery-accent);outline-offset:3px;cursor:crosshair}.pilot-preview-surface [data-pilot-context-pick]:focus-visible{outline:3px solid var(--sourcery-accent)}.pilot-context-back{display:none}@media(max-width:50rem){.pilot-context-back:not([hidden]){display:block;position:fixed;z-index:4;inset:auto .8rem .8rem auto;min-height:2.5rem;text-decoration:underline}body:has(.pilot-context-tools button[aria-pressed=true]) .pilot-context-back{display:none}.pilot-context-tools:has(button[aria-pressed=true]) #pilot-context-status{position:fixed;z-index:4;inset:auto .8rem .8rem;padding:.55rem;background:var(--sourcery-paper);box-shadow:var(--sourcery-raised)}}",
    ".pilot-app-scope{display:flex;align-items:center;justify-content:space-between;gap:.5rem;margin:0 .35rem;padding:.35rem .65rem;background:var(--sourcery-frame);color:var(--sourcery-accent);box-shadow:var(--sourcery-raised);font:600 14px var(--sourcery-font)}.pilot-preview-surface[data-pilot-context-active]>.pilot-app-scope{outline:3px solid var(--sourcery-accent);outline-offset:2px}.pilot-preview-surface[data-pilot-context-pick]>.pilot-app-scope{outline:2px dashed var(--sourcery-accent);outline-offset:2px;cursor:crosshair}.pilot-preview-surface[data-pilot-context-pick]:focus-visible{outline:none}.pilot-preview-surface[data-pilot-context-pick]:focus-visible>.pilot-app-scope{outline:3px solid var(--sourcery-accent)}",
    ".pilot-comment-count{display:inline-block;min-height:2.25rem;margin:.35rem .25rem;padding:.2rem .65rem;border:1px solid var(--sourcery-accent);border-radius:0;background:var(--sourcery-paper);color:var(--sourcery-accent);font:600 14px var(--sourcery-font);cursor:pointer}.pilot-comment-count:hover,.pilot-comment-count:focus-visible{background:var(--sourcery-selected)}.pilot-preview-surface:has([data-pilot-context-pick]) .pilot-comment-count{display:none}.pilot-preview-surface main[data-pilot-context-pick]{outline-offset:-3px}main:has(>.nr-preview-comments)>header{position:sticky;top:0;z-index:1}.pilot-comment-filter{padding:.15rem 0}.pilot-comment-filter p:empty{display:none}.pilot-comment-filter button[hidden]{display:none}",
    ".pilot-aster-support{display:block;padding:.4rem .55rem;color:var(--sourcery-accent);font:600 14px var(--sourcery-font);text-underline-offset:.16em}",
    ".pilot-context{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:.65rem;margin-block:.65rem;font:14px/1.4 var(--sourcery-font)}.pilot-jump{display:flex;gap:.65rem;flex-wrap:wrap;margin-block:.5rem}",
    ".pilot-recovery{margin:0;padding:clamp(12px,4vw,48px);min-height:100dvh;box-sizing:border-box;background-color:#225b6e;background-image:var(--sourcery-desktop);color:var(--sourcery-ink);font:14px/1.45 var(--sourcery-font)}",
    ".pilot-recovery-window{max-width:38rem;margin:auto;padding:4px;background:var(--sourcery-frame);box-shadow:var(--sourcery-raised),var(--sourcery-shadow)}",
    ".pilot-recovery-title{margin:0;padding:5px 8px;background:var(--sourcery-title);color:white;font-size:16px}.pilot-recovery-content{margin-top:4px;padding:12px;background:var(--sourcery-paper);box-shadow:var(--sourcery-inset)}.pilot-recovery-content p{margin-top:0}",
    "@media(max-width:38rem){.pilot-brand small{display:none}.pilot-nav{width:100%}}"
  )

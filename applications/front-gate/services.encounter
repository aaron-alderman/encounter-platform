    { id = "evaluation"; defaultAction = "open"; group = "Encounter platform"; name = "Model Evaluation"; detail = "Inspect Ollama trials, semantic evidence, and the PageRank comparison."; port = 24228; readOnlyPaths = list("/evaluation", "/evaluation.css", "/receipt.rel", "/decompiler", "/decompiler/lexical", "/decompiler/pagerank", "/decompiler/notebook.css", "/decompiler/desk.css", "/decompiler/desk.js", "/decompiler/desk-editor.js", "/decompiler/desk-rich.js", "/decompiler/trace-data", "/decompiler/trace-site", "/decompiler/source-data", "/decompiler/image.rel.gz", "/decompiler/trace.rel.gz", "/decompiler/encounter.gz", "/decompiler/manifest.rel", "/decompiler/offline-replay.tar", "/decompiler/benchmark"); postPaths = list("/decompiler/verify", "/decompiler/benchmark-action") },

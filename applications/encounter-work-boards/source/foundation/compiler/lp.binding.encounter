process-module "temple/surface-process-module/1"
profile "encounter/reconstituted-source/1"

process lp.binding:
  let bindingToken = at($lpTokens, $eventInput.i)
  port kernel.invoke {
    query = "lp.name";
    input = { text = $bindingToken.text; qualified = $eventInput.qualified; token = $bindingToken }
  } → bindingValue
  port kernel.invoke {
    query = "lp.origin";
    input = {
      pointer = $eventInput.pointer;
      kind = "binding";
      start = $bindingToken.start;
      end = $bindingToken.end;
      token = $bindingToken
    }
  } → bindingOrigin
  let result = {
    i = add($eventInput.i, 1);
    value = $bindingValue;
    origins = append($eventInput.origins, list($bindingOrigin))
  }

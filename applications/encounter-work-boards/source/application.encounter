process-module "temple/surface-process-module/1"

process app.load:
  let snapshot = $eventInput
  port kernel.invoke { query = "types.named"; input = { name = "Snapshot"; value = $snapshot } } → _
  let documents = $snapshot.documents
  let entries = filter($documents, "document", eq($document.path, "application.rel"))
  let state = null
  when eq(count($entries), 0):
    assert eq($snapshot.revision, 0)
      otherwise "STORE: Accepted source is missing."
    port kernel.invoke { query = "domain.empty"; input = null } → state
  when not(eq(count($entries), 0)):
    assert eq(count($entries), 1)
      otherwise "STORE: Competing source documents."
    port rel.decode { text = at(at($entries, 0), "text"); kind = "Application" } → state
  port kernel.invoke { query = "domain.check"; input = $state } → _
  each $state.actions as action:
    port kernel.invoke { query = "action.check"; input = $action } → _
  let expected = if(eq($snapshot.revision, 0), list(), list("application.rel"))
  let expected = append($expected, map($state.actions, "action", $action.source))
  each $state.jobs as job:
    when eq($job.status, "completed"):
      assert eq($job.output, concat("exports/", $job.id, ".html"))
        otherwise "RESULT: The export coordinate is inconsistent."
      port kernel.invoke { query = "source.get"; input = $job.output } → text
      port digest.sha256 { text = $text } → hash
      assert eq($hash, $job.digest)
        otherwise "RESULT: The retained export bytes changed."
  let expected = append($expected, map(filter($state.jobs, "job", eq($job.status, "completed")), "job", $job.output))
  let paths = map($documents, "document", $document.path)
  assert and(eq(count($paths), count(distinct($paths))), eq(count($paths), count($expected)), every($expected, "path", includes($paths, $path)))
    otherwise "SOURCE: The source set must exactly match the accepted application."
  let result = $state

process app.newSession:
  let result = { view = "work"; selected = ""; alias = ""; notice = "Start with what you want to make."; draft = {}; prepared = { case = "none"; value = null } }

process app.request:
  let request = $eventInput
  port kernel.invoke { query = "types.named"; input = { name = "Request"; value = $request } } → _
  let snapshot = $request.snapshot
  let documents = $snapshot.documents
  port kernel.invoke { query = "app.load"; input = $snapshot } → state
  let session = $request.session
  port kernel.invoke { query = "types.named"; input = { name = "Session"; value = $session } } → _
  let form = $request.fields
  let commandName = if(eq(at($form, "command"), at({}, "absent")), "", at($form, "command"))
  let artifact = false
  when not(eq($request.path, "/")):
    port text.indexOf { value = $request.path; search = "/artifact/"; from = 0 } → prefix
    assert and(eq($request.method, "GET"), eq($prefix, 0))
      otherwise "ROUTE: This workspace route does not exist."
    let artifact = true
  when eq($request.method, "GET"):
    when not(eq(at($form, "view"), at({}, "absent"))):
      assert includes(list("work", "type", "thing", "projections", "actions", "jobs", "history", "sources"), $form.view)
        otherwise "VIEW: Choose a known workspace view."
      port record.put { record = $session; key = "view"; value = $form.view } → session
      port record.put { record = $session; key = "selected"; value = if(eq(at($form, "id"), at({}, "absent")), "", at($form, "id")) } → session
      port record.put { record = $session; key = "alias"; value = if(eq(at($form, "alias"), at({}, "absent")), "", at($form, "alias")) } → session
  when eq($request.method, "POST"):
    when eq($commandName, "cancel"):
      port record.put { record = $session; key = "prepared"; value = { case = "none"; value = null } } → session
      port record.put { record = $session; key = "notice"; value = "Cancelled. Accepted work is unchanged; your draft is retained." } → session
    when eq($commandName, "prepare"):
      port record.put { record = $session; key = "draft"; value = $form } → session
      port record.put { record = $session; key = "prepared"; value = { case = "none"; value = null } } → session
      try:
        assert and(count($form.reason), count($form.target), count($form.goal))
          otherwise "INTENT: Give the reason, exact target and goal of this one change."
        port scalar.read { text = $form.base } → base
        assert eq($base, $snapshot.revision)
          otherwise "STALE: This view is out of date. Reopen current work before preparing a change."
        port record.entries { value = $form } → fields
        fold $fields as field; values starts {}:
          when not(includes(list("command", "operation", "origin", "base", "reason", "target", "goal"), at($field, 0))):
            port record.put { record = $values; key = at($field, 0); value = at($field, 1) } → values
          yield $values → values
        let command = { operation = $form.operation; base = $base; operationId = $request.nonce; profile = $request.profile; basis = $request.basis; source = if(eq($form.operation, "intent"), "user/intent", "application/intent"); reason = $form.reason; target = $form.target; goal = $form.goal; values = $values }
        port kernel.invoke { query = "types.named"; input = { name = "Command"; value = $command } } → _
        port kernel.invoke { query = "command.apply"; input = $command } → proposal
        let prepared = { command = $command; documents = $proposal.documents; description = $proposal.description }
        port kernel.invoke { query = "types.named"; input = { name = "Prepared"; value = $prepared } } → _
        port record.put { record = $session; key = "prepared"; value = { case = "some"; value = $prepared } } → session
        port record.put { record = $session; key = "notice"; value = "Review this exact change before accepting it." } → session
      catch fault:
        port record.put { record = $session; key = "notice"; value = $fault.message } → session
    when eq($commandName, "accept"):
      assert eq($session.prepared.case, "some")
        otherwise "REVIEW: There is no prepared decision in this session."
      let prepared = $session.prepared.value
      assert eq($form.review, $prepared.command.operationId)
        otherwise "REVIEW: This decision belongs to another review."
      port storage.operation { operationId = $prepared.command.operationId } → existing
      let committed = $existing
      when eq($existing, null):
        try:
          assert eq($snapshot.revision, $prepared.command.base)
            otherwise "STALE: The accepted revision changed. Cancel this review and prepare it again."
          assert and(eq($request.basis, $prepared.command.basis), eq($request.profile, $prepared.command.profile))
            otherwise "BASIS: The source/type/effect basis changed. Prepare a new review."
          port kernel.invoke { query = "command.apply"; input = $prepared.command } → rechecked
          assert eq($rechecked.documents, $prepared.documents)
            otherwise "REVIEW: Revalidation changed the reviewed source. Prepare a new review."
          port storage.cas { base = $prepared.command.base; operationId = $prepared.command.operationId; profile = $prepared.command.profile; basis = $prepared.command.basis; documents = $prepared.documents; reason = $prepared.command.reason; target = $prepared.command.target; goal = $prepared.command.goal; source = $prepared.command.source; description = $prepared.description } → committed
        catch fault:
          port storage.operation { operationId = $prepared.command.operationId } → committed
          when eq($committed, null):
            port record.put { record = $session; key = "notice"; value = concat("Not committed: ", $fault.message, " Your review is retained.") } → session
      when not(eq($committed, null)):
        port kernel.invoke { query = "types.named"; input = { name = "Receipt"; value = $committed } } → _
        assert eq($committed.operationId, $prepared.command.operationId)
          otherwise "RECEIPT: The storage result belongs to another operation."
        assert and(eq($committed.base, $prepared.command.base), eq($committed.basis, $prepared.command.basis), eq($committed.profile, $prepared.command.profile), eq($committed.reason, $prepared.command.reason), eq($committed.target, $prepared.command.target), eq($committed.goal, $prepared.command.goal), eq($committed.source, $prepared.command.source), eq($committed.description, $prepared.description))
          otherwise "RECEIPT: Stored decision metadata differs from the review."
        port storage.snapshot { revision = $committed.revision } → accepted
        port kernel.invoke { query = "types.named"; input = { name = "Snapshot"; value = $accepted } } → _
        assert eq(count($accepted.documents), count($prepared.documents))
          otherwise "RECEIPT: The stored source set differs from the review."
        each $prepared.documents as document:
          assert some($accepted.documents, "stored", and(eq($stored.path, $document.path), eq($stored.text, $document.text)))
            otherwise "RECEIPT: The exact reviewed source was not retained."
        port record.put { record = $session; key = "prepared"; value = { case = "none"; value = null } } → session
        port record.put { record = $session; key = "draft"; value = {} } → session
        port record.put { record = $session; key = "notice"; value = concat("Saved revision ", $committed.revision, ". ", $prepared.description) } → session
        port storage.snapshot {} → snapshot
        let documents = $snapshot.documents
        port kernel.invoke { query = "app.load"; input = $snapshot } → state
    assert includes(list("prepare", "accept", "cancel"), $commandName)
      otherwise "COMMAND: Use an offered workspace control."
  port kernel.invoke { query = "types.named"; input = { name = "Session"; value = $session } } → _
  let html = ""
  when not($artifact):
    let context = { state = $state; snapshot = $snapshot; session = $session; csrf = $request.csrf }
    port kernel.invoke { query = "ui.page"; input = $context } → html
  when $artifact:
    port text.slice { value = $request.path; start = 10 } → id
    let jobs = filter($state.jobs, "job", and(eq($job.id, $id), eq($job.status, "completed")))
    assert eq(count($jobs), 1)
      otherwise "RESULT: This job has no completed result."
    let job = at($jobs, 0)
    port kernel.invoke { query = "source.get"; input = $job.output } → html
    port digest.sha256 { text = $html } → digest
    assert eq($digest, $job.digest)
      otherwise "RESULT: The retained artifact does not match its digest."
  let result = { session = $session; html = $html }
  port kernel.invoke { query = "types.named"; input = { name = "Response"; value = $result } } → _

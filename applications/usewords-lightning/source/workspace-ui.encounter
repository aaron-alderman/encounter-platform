# Authoritative Usewords workspace processes.
process-module "temple/surface-process-module/1"
profile "usewords/process/1"

# Workspace interface.

process ws.persist:
  port state.get { key = "workspace" } → state
  port kernel.invoke { query = "ws.receipt"; input = { state = $state; expectedRevision = $state.revision; expectedHash = $state.documentHash } } → receipt
  port json.stringify { value = $receipt; space = 0 } → encoded
  port storage.write { key = "usewords.workspace.draft.v1"; value = $encoded } → stored
  when not($stored.ok):
    port state.set { key = "workspaceNotice"; value = "Draft is in memory. Browser storage is unavailable; export source to keep it." } → _

process ws.saveDefinition:
  port browser.property { ref = "#ws-definition"; name = "value" } → source
  port text.utf8Length { value = $source } → length
  port number.calculate { operation = "lessEqual"; values = list($length, 12000) } → bounded
  when $bounded:
    port storage.write { key = "usewords.workspace.definition-draft.v1"; value = $source } → stored

process ws.agent:
  let request = $eventInput
  assert includes(list("status", "apply", "check-definition", "inspect", "accept-candidate", "export-source", "collaboration-status", "collaboration-command", "matter-status", "matter-overview", "matter-brief", "matter-suggestions"), $request.operation)
    otherwise "WS-AGENT: Unsupported operation."
  port state.get { key = "workspace" } → state
  when eq($request.operation, "matter-overview"):
    port state.get { key = "collaboration" } → board
    port kernel.invoke { query = "mm.overview"; input = { board = $board; actor = $request.actor } } → result
  when eq($request.operation, "matter-status"):
    let result = at($state.document, "matter")
  when eq($request.operation, "matter-brief"):
    port kernel.invoke { query = "mw.brief"; input = $state } → brief
    let nextAI = { brief = $brief; package = null }
    call mw.storeAI
    let result = { request = $brief.request; sha256 = $brief.sha256 }
  when eq($request.operation, "matter-suggestions"):
    let response = $request.response
    let modelRun = at($request, "run")
    call mw.checkResponseUI
    let result = $checked.response
  when eq($request.operation, "collaboration-status"):
    port state.get { key = "collaboration" } → result
  when eq($request.operation, "collaboration-command"):
    let input = $request.request
    call cw.commitUI
    let result = { revision = $next.revision; documentHash = $next.head.documentHash }
  when eq($request.operation, "status"):
    let result = { revision = $state.revision; documentHash = $state.documentHash; document = $state.document }
  when eq($request.operation, "apply"):
    port state.get { key = "collaboration" } → board
    assert not($board)
      otherwise "CW-PROPOSAL: Use collaboration-command; direct mutation cannot bypass review."
    port kernel.invoke { query = "ws.apply"; input = { state = $state; request = $request.request } } → next
    port state.set { key = "workspace"; value = $next } → _
    port state.set { key = "workspaceNotice"; value = "Agent proposal checked and applied as a draft." } → _
    call ws.persist
    call ws.paint
    let result = { revision = $next.revision; documentHash = $next.documentHash }
  when eq($request.operation, "check-definition"):
    port kernel.invoke { query = "ws.definition"; input = $request.source } → result
  when eq($request.operation, "inspect"):
    let result = { inputs = $state.inputs; projections = $state.projections; journal = $state.journal }
  when eq($request.operation, "export-source"):
    let result = { protocol = "usewords/workspace-source/1"; document = $state.document }
  when eq($request.operation, "accept-candidate"):
    port kernel.invoke { query = "ws.accept"; input = { state = $state; expectedRevision = $request.revision; expectedHash = $request.documentHash } } → result

process ws.boot:
  port kernel.invoke { query = "ws.initial"; input = {  } } → initial
  port state.set { key = "workspace"; value = $initial } → _
  port state.set { key = "workspaceAccepted"; value = null } → _
  port state.set { key = "workspaceNotice"; value = "A real encounter is here to begin. Create your own objects, compose journeys, or adopt a new construct." } → _
  port browser.write { ref = "#ws-definition"; name = "value"; value = "construct Reflection\nfield question text shared required max 200\nfield invitation text local optional max 600\nheading question\nparagraph invitation" } → _
  try:
    port storage.read { key = "usewords.workspace.accepted.v1"; maxLength = 180000 } → stored
    when and($stored.ok, not(eq($stored.value, null))):
      port json.parse { text = $stored.value } → receipt
      port kernel.invoke { query = "ws.reconstruct"; input = $receipt } → restored
      port state.set { key = "workspace"; value = $restored } → _
      port state.set { key = "workspaceAccepted"; value = $receipt } → _
      port state.set { key = "workspaceNotice"; value = "Restored the accepted workspace after replay." } → _
  catch fault:
    port state.set { key = "workspaceNotice"; value = concat("Previous acceptance retained in storage but not activated: ", $fault.message) } → _
  try:
    port storage.read { key = "usewords.workspace.draft.v1"; maxLength = 180000 } → stored
    when and($stored.ok, not(eq($stored.value, null))):
      port json.parse { text = $stored.value } → receipt
      port state.get { key = "workspaceAccepted" } → accepted
      when not(eq($receipt.sha256, at($accepted, "sha256"))):
        port kernel.invoke { query = "ws.reconstruct"; input = $receipt } → restored
        port state.set { key = "workspace"; value = $restored } → _
        port state.set { key = "workspaceNotice"; value = "Restored your checked draft. It remains separate from accepted source." } → _
  catch fault:
    port state.set { key = "workspaceNotice"; value = concat("Saved draft could not be replayed; source was not replaced. ", $fault.message) } → _
  port storage.read { key = "usewords.workspace.definition-draft.v1"; maxLength = 12000 } → raw
  when and($raw.ok, not(eq($raw.value, null))):
    port browser.write { ref = "#ws-definition"; name = "value"; value = $raw.value } → _
  port browser.on { ref = "#ws-object-form"; event = "submit"; query = "ws.action"; input = { kind = "object" }; preventDefault = true } → _
  port browser.on { ref = "#ws-journey-form"; event = "submit"; query = "ws.action"; input = { kind = "journey" }; preventDefault = true } → _
  port browser.on { ref = "#ws-compose-form"; event = "submit"; query = "ws.action"; input = { kind = "compose" }; preventDefault = true } → _
  port browser.on { ref = "#ws-edit-form"; event = "submit"; query = "ws.action"; input = { kind = "edit" }; preventDefault = true } → _
  port browser.on { ref = "#ws-adopt"; event = "click"; query = "ws.action"; input = { kind = "define" }; preventDefault = false } → _
  port browser.on { ref = "#ws-check-definition"; event = "click"; query = "ws.checkDefinition"; input = {  }; preventDefault = false } → _
  port browser.on { ref = "#ws-accept"; event = "click"; query = "ws.acceptUI"; input = {  }; preventDefault = false } → _
  port browser.on { ref = "#ws-segment"; event = "click"; query = "ws.segmentUI"; input = {  }; preventDefault = false } → _
  port browser.on { ref = "#ws-export"; event = "click"; query = "ws.exportUI"; input = {  }; preventDefault = false } → _
  port browser.on { ref = "#ws-source-package"; event = "click"; query = "ws.sourceUI"; input = {  }; preventDefault = false } → _
  port browser.on { ref = "#ws-download-source"; event = "click"; query = "ws.downloadSourceUI"; input = {  }; preventDefault = false } → _
  port browser.on { ref = "#ws-import"; event = "click"; query = "ws.importUI"; input = {  }; preventDefault = false } → _
  port browser.on { ref = "#ws-object-type"; event = "change"; query = "ws.newFields"; input = {  }; preventDefault = false } → _
  port browser.on { ref = "#ws-edit-scope"; event = "change"; query = "ws.editorFields"; input = {  }; preventDefault = false } → _
  port browser.on { ref = "#ws-edit-object"; event = "change"; query = "ws.editorFields"; input = {  }; preventDefault = false } → _
  port browser.on { ref = "#ws-edit-entry"; event = "change"; query = "ws.editorFields"; input = {  }; preventDefault = false } → _
  port browser.on { ref = "#ws-edit-field"; event = "change"; query = "ws.editorFields"; input = {  }; preventDefault = false } → _
  port browser.on { ref = "#ws-inspect-choice"; event = "change"; query = "ws.inspectUI"; input = {  }; preventDefault = false } → _
  port browser.on { ref = "#ws-definition"; event = "input"; query = "ws.saveDefinition"; input = {  }; preventDefault = false } → _
  port browser.on { ref = "#ws-old-demo"; event = "click"; query = "ws.openDemo"; input = {  }; preventDefault = false } → _
  call cw.boot
  port dom.exists { selector = "#mw-root" } → mattersUI
  when $mattersUI:
    call mw.boot
  call ws.paint
  when $mattersUI:
    each list("#mw-create-submit", "#mw-example", "#mw-import") as ref:
      port browser.write { ref = $ref; name = "disabled"; value = false } → _

process cw.boot:
  call cw.resetUI
  port state.set { key = "collaborationSelected"; value = "" } → _
  try:
    port storage.read { key = concat("usewords.collaboration.v1.", $data.programHash); maxLength = 300000 } → stored
    when and($stored.ok, not(eq($stored.value, null))):
      port json.parse { text = $stored.value } → receipt
      port kernel.invoke { query = "cw.reconstruct"; input = $receipt } → board
      port state.set { key = "collaboration"; value = $board } → _
      port state.set { key = "workspace"; value = $board.head } → _
      port state.set { key = "workspaceNotice"; value = "Restored proposal history and accepted material after exact replay. Personas are local simulations." } → _
  catch fault:
    port state.set { key = "workspaceNotice"; value = concat("Saved proposal history refused and retained in storage: ", $fault.message) } → _
  port browser.on { ref = "#cw-selection"; event = "change"; query = "mw.selectProposalUI"; input = { }; preventDefault = false } → _
  port browser.on { ref = "#cw-review"; event = "click"; query = "cw.decisionUI"; input = { action = "review" }; preventDefault = false } → _
  port browser.on { ref = "#cw-accept"; event = "click"; query = "cw.decisionUI"; input = { action = "accept" }; preventDefault = false } → _
  port browser.on { ref = "#cw-reject"; event = "click"; query = "cw.decisionUI"; input = { action = "reject" }; preventDefault = false } → _
  port browser.on { ref = "#cw-import-history"; event = "click"; query = "cw.importUI"; input = { }; preventDefault = false } → _

process cw.commitUI:
  port state.get { key = "collaboration" } → board
  port kernel.invoke { query = "cw.apply"; input = { board = $board; request = $input } } → next
  port kernel.invoke { query = "cw.receipt"; input = $next } → receipt
  when includes(list("accept", "attest", "withdraw-attestation"), $input.action):
    port kernel.invoke { query = "cw.reconstruct"; input = $receipt } → replayed
    assert eq($replayed, $next)
      otherwise "CW-REPLAY: Accepted history was not reproduced."
  port json.stringify { value = $receipt; space = 0 } → encoded
  port number.calculate { operation = "lessEqual"; values = list(count($encoded), 300000) } → bounded
  assert $bounded
    otherwise "CW-LIMIT: Proposal history exceeds the local storage profile."
  port kernel.invoke { query = "mw.storageKey"; input = at(at($next.head.document, "matter"), "id") } → storageKey
  port storage.read { key = $storageKey; maxLength = 300000 } → currentSaved
  assert $currentSaved.ok
    otherwise "CW-STORAGE: Cannot check the saved head."
  when not(eq($currentSaved.value, null)):
    port json.parse { text = $currentSaved.value } → currentReceipt
    port kernel.invoke { query = "cw.receipt"; input = $board } → expectedReceipt
    assert eq($currentReceipt, $expectedReceipt)
      otherwise "CW-CONFLICT: Another tab changed the saved board. Reload before proposing again."
  when eq($currentSaved.value, null):
    assert eq($board.revision, 0)
      otherwise "CW-CONFLICT: The saved board disappeared; reload before writing."
  port storage.write { key = $storageKey; value = $encoded } → stored
  assert $stored.ok
    otherwise "CW-STORAGE: Could not save proposal history. The previous board remains active."
  port state.set { key = "collaboration"; value = $next } → _
  port state.set { key = "workspace"; value = $next.head } → _
  port state.set { key = "collaborationSelected"; value = $input.id } → _
  port state.set { key = "workspaceNotice"; value = if(eq($input.action, "accept"), "Proposal accepted after independent review and exact history replay. Saved locally; no authenticated identity is claimed.", "Proposal board saved locally. Accepted material has not changed.") } → _
  try:
    call mm.syncIndex
    call ws.paint
  catch fault:
    port state.set { key = "workspaceNotice"; value = concat("Board saved, but its register or view could not refresh. Reload to replay saved history. ", $fault.message) } → _
    call ws.showNotice

process cw.saveUI:
  try:
    port browser.write { ref = "#ws-notice"; name = "textContent"; value = "Replaying proposal, review and acceptance history…" } → _
    port browser.delay { milliseconds = 1 } → _
    port state.get { key = "collaboration" } → board
    port kernel.invoke { query = "cw.receipt"; input = $board } → receipt
    port kernel.invoke { query = "cw.reconstruct"; input = $receipt } → checked
    assert eq($checked, $board)
      otherwise "CW-REPLAY: Board does not match its history."
    port json.stringify { value = $receipt; space = 2 } → encoded
    port kernel.invoke { query = "mw.storageKey"; input = at(at($board.head.document, "matter"), "id") } → storageKey
    port storage.write { key = $storageKey; value = $encoded } → stored
    assert $stored.ok
      otherwise "CW-STORAGE: History replayed but could not be saved."
    port browser.write { ref = "#ws-package"; name = "value"; value = $encoded } → _
    port state.set { key = "workspaceNotice"; value = "Proposal history verified and saved. Saving history does not accept open proposals." } → _
    call ws.showNotice
  catch fault:
    port state.set { key = "workspaceNotice"; value = concat("Refused: ", $fault.message) } → _
    call ws.showNotice

process cw.importUI:
  try:
    port state.get { key = "collaboration" } → board
    assert not(at($board.head.document, "matter"))
      otherwise "MW-IMPORT: Use the matter history importer for active matters."
    assert eq($board.revision, 0)
      otherwise "CW-IMPORT: Existing proposal history cannot be replaced. Import into a fresh browser or empty board."
    port browser.property { ref = "#ws-package"; name = "value" } → encoded
    port number.calculate { operation = "lessEqual"; values = list(count($encoded), 300000) } → bounded
    assert $bounded
      otherwise "CW-IMPORT: History exceeds the import limit."
    port json.parse { text = $encoded } → receipt
    port kernel.invoke { query = "cw.reconstruct"; input = $receipt } → next
    assert not(at($next.head.document, "matter"))
      otherwise "MW-IMPORT: Use the matter history importer for this record."
    port storage.write { key = concat("usewords.collaboration.v1.", $data.programHash); value = $encoded } → stored
    assert $stored.ok
      otherwise "CW-STORAGE: History verified but could not be saved."
    port state.set { key = "collaboration"; value = $next } → _
    port state.set { key = "workspace"; value = $next.head } → _
    port state.set { key = "workspaceNotice"; value = "Imported proposal history after exact replay. Persona names remain local simulations." } → _
    call ws.paint
  catch fault:
    port state.set { key = "workspaceNotice"; value = concat("Refused: ", $fault.message) } → _
    call ws.showNotice

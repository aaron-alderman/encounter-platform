          { name = "font-family"; value = "Georgia,serif" },
          { name = "font-size"; value = "23px" },
          { name = "font-weight"; value = "400" }
        )
      },
      {
        selector = ".ws-entry";
        declarations = list(
          { name = "margin-top"; value = "20px" },
          { name = "padding-top"; value = "15px" },
          { name = "border-top"; value = "1px solid var(--line)" }
        )
      },
      {
        selector = ".ws-entry-id";
        declarations = list(
          { name = "font-size"; value = "11px" },
          { name = "color"; value = "var(--muted)" },
          { name = "margin-bottom"; value = "12px" }
        )
      },
      {
        selector = ".ws-entry article p";
        declarations = list(
          { name = "white-space"; value = "pre-line" },
          { name = "font-family"; value = "Georgia,serif" },
          { name = "font-size"; value = "15px" },
          { name = "line-height"; value = "1.7" },
          { name = "margin-bottom"; value = "14px" }
        )
      },
      { selector = ".ws-entry article h2"; declarations = list({ name = "font-size"; value = "24px" }) },
      {
        selector = ".ws-library";
        declarations = list({ name = "padding"; value = "0" }, { name = "margin"; value = "0" }, { name = "list-style"; value = "none" })
      },
      {
        selector = ".ws-library li";
        declarations = list({ name = "padding"; value = "12px 0" }, { name = "border-bottom"; value = "1px solid var(--line)" })
      },
      {
        selector = ".ws-library span";
        declarations = list(
          { name = "display"; value = "block" },
          { name = "color"; value = "var(--muted)" },
          { name = "font-size"; value = "12px" }
        )
      },
      {
        selector = ".ws-language";
        declarations = list(
          { name = "display"; value = "grid" },
          { name = "grid-template-columns"; value = "1.2fr 1fr" },
          { name = "gap"; value = "32px" },
          { name = "border-top"; value = "1px solid var(--line)" },
          { name = "padding"; value = "30px 0" },
          { name = "margin-bottom"; value = "12px" }
        )
      },
      {
        selector = "#ws-definition";
        declarations = list({ name = "font-family"; value = "ui-monospace,monospace" }, { name = "font-size"; value = "14px" })
      },
      {
        selector = ".ws-language-help";
        declarations = list(
          { name = "min-width"; value = "0" },
          { name = "padding"; value = "20px" },
          { name = "background"; value = "#eee9df" },
          { name = "border-radius"; value = "8px" }
        )
      },
      {
        selector = ".ws-language-help p";
        declarations = list({ name = "font-size"; value = "14px" }, { name = "margin-bottom"; value = "12px" })
      },
      {
        selector = ".ws-language-help pre";
        declarations = list(
          { name = "white-space"; value = "pre-wrap" },
          { name = "padding"; value = "12px 0" },
          { name = "font-size"; value = "12px" }
        )
      },
      { selector = "#ws-source"; declarations = list({ name = "max-height"; value = "420px" }) },
      {
        selector = "#ws-earlier>main";
        declarations = list({ name = "padding"; value = "0" }, { name = "margin-top"; value = "20px" })
      },
      { selector = ".cw-board"; declarations = list({ name = "margin-bottom"; value = "2rem" }) },
      {
        selector = ".cw-controls, .cw-diff";
        declarations = list(
          { name = "display"; value = "grid" },
          { name = "grid-template-columns"; value = "1fr 1fr" },
          { name = "gap"; value = "1rem" }
        )
      },
      {
        selector = ".cw-details";
        declarations = list({ name = "overflow-wrap"; value = "anywhere" }, { name = "font-size"; value = ".85rem" })
      },
      {
        selector = ".cw-code";
        declarations = list(
          { name = "max-height"; value = "22rem" },
          { name = "overflow"; value = "auto" },
          { name = "min-width"; value = "0" }
        )
      },
      {
        selector = ".cw-board label";
        declarations = list(
          { name = "display"; value = "grid" },
          { name = "gap"; value = ".5rem" },
          { name = "margin-bottom"; value = "1rem" }
        )
      },
      {
        selector = ".cw-board select, .cw-board input, .cw-board textarea";
        declarations = list({ name = "width"; value = "100%" }, { name = "min-width"; value = "0" })
      },
      { selector = ".cw-diff section"; declarations = list({ name = "min-width"; value = "0" }) },
      { selector = ".mw-opening"; declarations = list({ name = "margin-bottom"; value = "2rem" }) },
      {
        selector = "#mw-root label";
        declarations = list(
          { name = "display"; value = "grid" },
          { name = "gap"; value = ".5rem" },
          { name = "margin-bottom"; value = "1rem" }
        )
      },
      {
        selector = "#mw-root input, #mw-root select, #mw-root textarea";
        declarations = list({ name = "width"; value = "100%" }, { name = "min-width"; value = "0" })
      },
      {
        selector = ".mw-columns";
        declarations = list(
          { name = "display"; value = "grid" },
          { name = "grid-template-columns"; value = "repeat(3,minmax(0,1fr))" },
          { name = "gap"; value = "1rem" },
          { name = "margin"; value = "1.5rem 0" }
        )
      },
      {
        selector = ".mw-card";
        declarations = list(
          { name = "padding"; value = "1rem" },
          { name = "border"; value = "1px solid var(--line)" },
          { name = "border-radius"; value = ".6rem" },
          { name = "margin-bottom"; value = ".8rem" },
          { name = "overflow-wrap"; value = "anywhere" }
        )
      },
      { selector = ".mw-card h4"; declarations = list({ name = "margin"; value = "0 0 .6rem" }) },
      {
        selector = ".mw-origin, .mw-status";
        declarations = list({ name = "font-size"; value = ".85rem" }, { name = "color"; value = "var(--accent)" })
      },
      {
        selector = ".mw-narrative";
        declarations = list({ name = "white-space"; value = "pre-wrap" }, { name = "max-width"; value = "75ch" })
      },
      { selector = "#mw-active .ws-panel"; declarations = list({ name = "margin-bottom"; value = "1rem" }) },
      { selector = "#mw-workbench"; declarations = list({ name = "margin-top"; value = "1.5rem" }) },
      {
        selector = "#mw-brief";
        declarations = list({ name = "font-family"; value = "ui-monospace, monospace" }, { name = "font-size"; value = ".8rem" })
      },
      { selector = ".mw-ai .mw-card"; declarations = list({ name = "border-left"; value = "3px solid var(--accent)" }) },
      {
        selector = ".mm-form";
        declarations = list(
          { name = "display"; value = "grid" },
          { name = "gap"; value = "12px" },
          { name = "margin"; value = "20px 0" },
          { name = "padding"; value = "16px" },
          { name = "border"; value = "1px solid #dedbd4" },
          { name = "border-radius"; value = "10px" }
        )
      },
      { selector = "#mm-register .mw-card"; declarations = list({ name = "min-width"; value = "0" }) }
    );
    media = list(
      {
        condition = "(max-width:1050px)";
        rules = list({ selector = ".workspace"; declarations = list({ name = "grid-template-columns"; value = "1fr" }) })
      },
      {
        condition = "(max-width:760px)";
        rules = list(
          {
            selector = ".workspace, .reproduction";
            declarations = list({ name = "grid-template-columns"; value = "1fr" }, { name = "gap"; value = "28px" })
          },
          { selector = ".masthead-note"; declarations = list({ name = "display"; value = "none" }) },
          {
            selector = ".masthead";
            declarations = list({ name = "padding"; value = "16px 5vw" }, { name = "gap"; value = "12px" })
          },
          { selector = ".source-link"; declarations = list({ name = "font-size"; value = "11px" }) },
          { selector = ".intro"; declarations = list({ name = "padding"; value = "38px 0 26px" }) }
        )
      },
      {
        condition = "(max-width:400px)";
        rules = list(
          { selector = ".alternate-views"; declarations = list({ name = "grid-template-columns"; value = "1fr" }) },
          { selector = "#reading"; declarations = list({ name = "padding"; value = "22px" }) }
        )
      },
      {
        condition = "(max-width:620px)";
        rules = list({ selector = ".journey-grid"; declarations = list({ name = "grid-template-columns"; value = "1fr" }) })
      },
      {
        condition = "(max-width:850px)";
        rules = list(
          { selector = ".ws-layout, .ws-language"; declarations = list({ name = "grid-template-columns"; value = "1fr" }) }
        )
      },
      {
        condition = "(max-width:850px)";
        rules = list({ selector = ".cw-controls, .cw-diff"; declarations = list({ name = "grid-template-columns"; value = "1fr" }) })
      },
      {
        condition = "(max-width:850px)";
        rules = list({ selector = ".mw-columns"; declarations = list({ name = "grid-template-columns"; value = "1fr" }) })
      }
    )
  }

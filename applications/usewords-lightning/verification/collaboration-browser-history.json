                "title": "An unexpected beginning",
                "body": "An encounter starts when the visitor can answer back.",
                "introduction": "Begin here."
              }
            },
            {
              "id": "question1",
              "type": "Question",
              "values": {
                "prompt": "What changes when we make room for an answer?",
                "invitation": "Pause before explaining."
              }
            }

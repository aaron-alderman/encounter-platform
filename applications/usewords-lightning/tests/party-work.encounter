  port test.match { text = $observedHostValue141; pattern = "prior draft remains"; flags = "" } → observedMatch142
  assert $observedMatch142
    otherwise "Expected match(h.content.get('#ws-notice'),/prior draft remains/)"
  port test.invoke { entry = "pc.downloadUI"; input = { format = "html" }; host = $h } → observedRun143
  port test.effects { host = $h; field = "downloads" } → observedEffects144
  let downloads = $observedEffects144
  assert eq(count($downloads), 1)
    otherwise "Expected equal(downloads.length,1)"

# local competing-tab heads refuse before overwriting saved preparation or shared boards
process test.party-work.local-competing-tab-heads-refuse-before-overwriting-saved-preparation-or-shared-boards:
  call fixture.party-work.setup
  port kernel.invoke { query = "fixture.party-work.harness"; input = list() } → observedResult154
  let h = $observedResult154
  port test.invoke { entry = "ws.boot"; input = null; host = $h } → observedRun155
  port test.invoke { entry = "mw.createUI"; input = null; host = $h } → observedRun156
  port test.get { host = $h; store = "state"; key = "collaboration" } → observedHostValue157
  let before = $observedHostValue157
  port test.get { host = $h; store = "state"; key = "workspace" } → workspace
  let matterId = at(at(at($workspace, "document"), "matter"), "id")
  port kernel.invoke { query = "fixture.party-work.change"; input = list($before, $issue, "alice") } → observedResult158
  port test.merge { records = list($observedResult158, { matterId = $matterId }) } → observedRecord159
  port kernel.invoke { query = "fixture.party-work.command"; input = list($before, { action = "propose"; actor = "alice"; id = "other_tab"; title = "From another tab"; change = $observedRecord159 }) } → observedResult160
  let newer = $observedResult160
  let key = concat("usewords.matter-board.v1.", at($runtime, "identity"), ".", $matterId)
  port test.invoke { entry = "cw.receipt"; input = $newer } → observedRun161
  port test.stringify { value = at($observedRun161, "value") } → observedJson162
  port test.set { host = $h; store = "storage"; key = $key; value = $observedJson162 } → observedHostValue163
  port test.set { host = $h; store = "values"; key = "#mm-purpose-input"; value = "An outdated scope" } → observedHostValue164
  port test.set { host = $h; store = "values"; key = "#mm-scope-input"; value = "Stale tab" } → observedHostValue165
  port test.invoke { entry = "mm.orientUI"; input = null; host = $h } → observedRun166
  port test.get { host = $h; store = "state"; key = "collaboration" } → observedHostValue167
  port test.sameReference { left = $observedHostValue167; right = $before } → sameState167
  assert $sameState167
    otherwise "Expected the previous collaboration object to remain in state"
  port test.get { host = $h; store = "content"; key = "#ws-notice" } → observedHostValue168
  port test.match { text = $observedHostValue168; pattern = "Another tab"; flags = "" } → observedMatch169
  assert $observedMatch169

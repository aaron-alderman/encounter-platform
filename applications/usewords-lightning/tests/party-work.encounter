  port test.invoke { entry = "mm.refreshUI"; input = null; host = $h } → observedRun129
  port test.get { host = $h; store = "values"; key = "#pc-note" } → observedHostValue130
  assert eq($observedHostValue130, "")
    otherwise "Expected equal(h.values.get('#pc-note'),'')"
  port test.get { host = $h; store = "state"; key = "preparation" } → observedHostValue131
  assert eq(at($observedHostValue131, "drafts"), list())
    otherwise "Expected deepEqual(h.state.get('preparation').drafts,[])"
  port test.set { host = $h; store = "values"; key = "#cw-actor"; value = "alice" } → observedHostValue132
  port test.invoke { entry = "mm.refreshUI"; input = null; host = $h } → observedRun133
  port test.invoke { entry = "pc.loadDraftUI"; input = null; host = $h } → observedRun134
  port test.get { host = $h; store = "values"; key = "#pc-note" } → observedHostValue135
  assert eq($observedHostValue135, "PREPARATION ONLY")
    otherwise "Expected equal(h.values.get('#pc-note'),'PREPARATION ONLY')"
  port test.get { host = $h; store = "state"; key = "preparation" } → observedHostValue136
  let before = $observedHostValue136
  port test.failWrites { host = $h } → observedWrites137
  port test.set { host = $h; store = "values"; key = "#pc-note"; value = "Unsaved replacement" } → observedHostValue138
  port test.invoke { entry = "pc.saveUI"; input = null; host = $h } → observedRun139
  port test.get { host = $h; store = "state"; key = "preparation" } → observedHostValue140
  port test.sameReference { left = $observedHostValue140; right = $before } → sameState140
  assert $sameState140
    otherwise "Expected the previous preparation object to remain in state"

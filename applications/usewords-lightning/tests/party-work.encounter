  let room = $observedHostValue170
  port test.invoke { entry = "pc.saveDraft"; input = { room = $room; actor = "alice"; matterId = $matterId; expectedRevision = 0; draft = { item = $issue; privateNote = "Newer private preparation" } } } → observedRun171
  let otherRoom = at($observedRun171, "value")
  port test.stringify { value = $otherRoom } → observedJson172
  port test.set { host = $h; store = "storage"; key = concat("usewords.preparation.v1.", at($runtime, "identity"), ".", $matterId, ".alice"); value = $observedJson172 } → observedHostValue173
  port test.set { host = $h; store = "values"; key = "#pc-id"; value = at($issue, "id") } → observedHostValue174
  port test.set { host = $h; store = "values"; key = "#pc-title"; value = at($issue, "title") } → observedHostValue175
  port test.set { host = $h; store = "values"; key = "#pc-body"; value = at($issue, "body") } → observedHostValue176
  port test.invoke { entry = "pc.saveUI"; input = null; host = $h } → observedRun177
  port test.get { host = $h; store = "state"; key = "preparation" } → observedHostValue178
  port test.sameReference { left = $observedHostValue178; right = $room } → sameState178
  assert $sameState178
    otherwise "Expected the previous preparation object to remain in state"
  port test.get { host = $h; store = "content"; key = "#ws-notice" } → observedHostValue179
  port test.match { text = $observedHostValue179; pattern = "another tab"; flags = "" } → observedMatch180
  assert $observedMatch180

  assert $observedMatch145
    otherwise "Expected match(downloads[0].name,/\\.html$/)"
  port test.match { text = at(at($downloads, 0), "text"); pattern = "Evidence needs and outstanding responses"; flags = "" } → observedMatch146
  assert $observedMatch146
    otherwise "Expected match(downloads[0].text,/Evidence needs and outstanding responses/)"
  assert eq(includes(at(at($downloads, 0), "text"), "PREPARATION ONLY"), false)

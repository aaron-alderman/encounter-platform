  port kernel.invoke { query = "fixture.matters.acceptedManagement"; input = list($board, "response", "respond", { id = "costs"; response = "The available figures are incomplete; I cannot confirm a total." }, "bob") } → observedResult326
  let board = $observedResult326
  port test.invoke { entry = "mm.overview"; input = { board = $board; actor = "bob" } } → observedRun327
  let view = at($observedRun327, "value")

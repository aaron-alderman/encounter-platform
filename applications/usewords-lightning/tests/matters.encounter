# management lifecycle concludes with disagreement, archives and reopens without settling issues
process test.matters.management-lifecycle-concludes-with-disagreement-archives-and-reopens-without-settling-issues:
  call fixture.matters.setup
  port kernel.invoke { query = "fixture.matters.suggestion"; input = list($initial, "access") } → observedResult295
  port kernel.invoke { query = "fixture.matters.incorporate"; input = list($initial, "issue", $observedResult295) } → observedResult296
  let board = $observedResult296
  let itemsBefore = at(at(at(at($board, "head"), "document"), "matter"), "items")
  port kernel.invoke { query = "fixture.matters.acceptedManagement"; input = list($board, "wait", "transition", { status = "waiting"; reason = "Waiting for cost evidence."; outcome = null }) } → observedResult297
  let board = $observedResult297
  port kernel.invoke { query = "fixture.matters.acceptedManagement"; input = list($board, "pause", "transition", { status = "paused"; reason = "Participants need time."; outcome = null }) } → observedResult298
  let board = $observedResult298
  port kernel.invoke { query = "fixture.matters.acceptedManagement"; input = list($board, "conclude", "transition", { status = "concluded"; reason = "We have accurately recorded our different priorities."; outcome = "disagreement" }) } → observedResult299
  let board = $observedResult299
  let observedRefused300 = false
  port kernel.invoke { query = "fixture.matters.suggestion"; input = list($board, "low_fees") } → observedResult301
  try:
    port kernel.invoke { query = "fixture.matters.propose"; input = list($board, "closed_item", $observedResult301) } → observedResult302
  catch observedFault303:
    port test.match { text = $observedFault303.message; pattern = "MM-CLOSED"; flags = "" } → observedDiagnostic304
    let observedRefused300 = $observedDiagnostic304
  assert $observedRefused300
    otherwise "Expected rejects(propose(board,'closed_item',await suggestion(board,'low_fees')),/MM-CLOSED/)"
  let observedRefused305 = false
  port kernel.invoke { query = "fixture.matters.manage"; input = list($board, "orient", { purpose = "Changed"; scope = "Changed" }) } → observedResult306
  try:
    port kernel.invoke { query = "fixture.matters.propose"; input = list($board, "closed_orientation", $observedResult306) } → observedResult307
  catch observedFault308:
    port test.match { text = $observedFault308.message; pattern = "MM-CLOSED"; flags = "" } → observedDiagnostic309
    let observedRefused305 = $observedDiagnostic309
  assert $observedRefused305
    otherwise "Expected rejects(propose(board,'closed_orientation',manage(board,'orient',{purpose:'Changed',scope:'Changed'})),/MM-CLOSED/)"
  port kernel.invoke { query = "fixture.matters.acceptedManagement"; input = list($board, "archive", "transition", { status = "archived"; reason = "Retain this record for reference."; outcome = "disagreement" }) } → observedResult310
  let board = $observedResult310
  port kernel.invoke { query = "fixture.matters.acceptedManagement"; input = list($board, "reopen", "transition", { status = "open"; reason = "New information is available."; outcome = null }) } → observedResult311
  let board = $observedResult311
  assert eq(at(at(at(at($board, "head"), "document"), "matter"), "items"), $itemsBefore)
    otherwise "Expected deepEqual(board.head.document.matter.items,itemsBefore)"
  assert eq(at(at(at(at(at($board, "head"), "document"), "matter"), "management"), "outcome"), null)
    otherwise "Expected equal(board.head.document.matter.management.outcome,null)"
  port test.invoke { entry = "cw.receipt"; input = $board } → observedRun312
  port test.invoke { entry = "cw.reconstruct"; input = at($observedRun312, "value") } → observedRun313
  assert eq(at($observedRun313, "value"), $board)
    otherwise "Expected deepEqual(await run('cw.reconstruct',await run('cw.receipt',board)),board)"

# management authority, assignee authorship and independent review are enforced by algebra
process test.matters.management-authority-assignee-authorship-and-independent-review-are-enforced-by-algebra:
  call fixture.matters.setup
  port kernel.invoke { query = "fixture.matters.acceptedManagement"; input = list($initial, "request", "request", { id = "costs"; title = "What costs remain unknown?"; assignee = "bob" }) } → observedResult314
  let board = $observedResult314
  port test.invoke { entry = "mm.overview"; input = { board = $board; actor = "bob" } } → observedRun315
  let view = at($observedRun315, "value")
  assert eq(at(at(at($view, "responseRequests"), 0), "id"), "costs")
    otherwise "Expected equal(view.responseRequests[0].id,'costs')"
  assert eq(count(at($view, "needsReview")), 0)
    otherwise "Expected equal(view.needsReview.length,0)"
  let observedRefused316 = false
  port kernel.invoke { query = "fixture.matters.manage"; input = list($board, "respond", { id = "costs"; response = "Speaking for Bob." }) } → observedResult317
  try:
    port kernel.invoke { query = "fixture.matters.propose"; input = list($board, "wrong_author", $observedResult317) } → observedResult318
  catch observedFault319:

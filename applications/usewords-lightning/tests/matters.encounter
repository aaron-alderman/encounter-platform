process-module "temple/surface-process-module/1"

process fixture.matters.create:
  let id = if(eq(at($eventInput, 0), at({}, "absent")), "workshop", at($eventInput, 0))
  let description = if(eq(at($eventInput, 1), at({}, "absent")), "People want affordable access and reliable staffing. Costs and usage remain unknown.", at($eventInput, 1))
  port test.invoke { entry = "mw.create"; input = { id = $id; title = "A shared workshop"; description = $description } } → observedRun1
  let result = at($observedRun1, "value")

process fixture.matters.propose:
  let board = at($eventInput, 0)
  let id = at($eventInput, 1)
  let change = at($eventInput, 2)
  port test.invoke { entry = "cw.apply"; input = { board = $board; request = { action = "propose"; actor = "alice"; expectedBoardRevision = at($board, "revision"); id = $id; title = "Explore a framing"; change = $change } } } → observedRun2
  let result = at($observedRun2, "value")

process fixture.matters.incorporate:
  let board = at($eventInput, 0)
  let id = at($eventInput, 1)
  let change = at($eventInput, 2)
  port kernel.invoke { query = "fixture.matters.propose"; input = list($board, $id, $change) } → observedResult3
  let board = $observedResult3
  let contentHash = at(at(at($board, "proposals"), add(count(at($board, "proposals")), -1)), "contentHash")
  port test.invoke { entry = "cw.apply"; input = { board = $board; request = { action = "review"; actor = "bob"; id = $id; expectedBoardRevision = at($board, "revision"); contentHash = $contentHash; decision = "approve"; comment = "Incorporate this framing without endorsing its claim." } } } → observedRun4
  let board = at($observedRun4, "value")
  port test.invoke { entry = "cw.apply"; input = { board = $board; request = { action = "accept"; actor = "bob"; id = $id; expectedBoardRevision = at($board, "revision"); contentHash = $contentHash } } } → observedRun5
  let result = at($observedRun5, "value")

process fixture.matters.suggestion:
  let board = at($eventInput, 0)
  let id = at($eventInput, 1)
  port test.invoke { entry = "mw.suggestionChange"; input = { state = at($board, "head"); package = $packageAI; id = $id } } → observedRun6
  let result = at($observedRun6, "value")

process fixture.matters.harness:
  port test.open { fallback = ""; elements = list("#mw-root"); values = list(list("#cw-actor", "alice"), list("#ws-object-type", "Encounter"), list("#ws-edit-scope", "shared"), list("#ws-inspect-choice", "definitions"), list("#mw-title", "First matter"), list("#mw-description", "Explore a question, without requiring a conclusion.")); selectors = list("#mw-select", "#cw-selection", "#ws-object-type", "#ws-compose-object", "#ws-edit-object", "#ws-compose-journey", "#ws-edit-entry", "#ws-edit-field", "#mw-issue", "#mw-suggestion") } → observedHost7
  let result = $observedHost7

process fixture.matters.manage:
  let board = at($eventInput, 0)
  let operation = at($eventInput, 1)
  let payload = at($eventInput, 2)
  let result = { kind = "matter-manage"; matterId = at(at(at(at($board, "head"), "document"), "matter"), "id"); operation = $operation; payload = $payload; baseRevision = at(at($board, "head"), "revision") }

process fixture.matters.acceptedManagement:
  let board = at($eventInput, 0)
  let id = at($eventInput, 1)
  let operation = at($eventInput, 2)
  let payload = at($eventInput, 3)
  let author = if(eq(at($eventInput, 4), at({}, "absent")), "alice", at($eventInput, 4))
  port kernel.invoke { query = "fixture.matters.manage"; input = list($board, $operation, $payload) } → observedResult8
  let change = $observedResult8
  let reviewer = if(eq($author, "alice"), "bob", "alice")
  port test.invoke { entry = "cw.apply"; input = { board = $board; request = { action = "propose"; actor = $author; expectedBoardRevision = at($board, "revision"); id = $id; title = concat("Manage ", $operation); change = $change } } } → observedRun9
  let board = at($observedRun9, "value")
  let contentHash = at(at(at($board, "proposals"), add(count(at($board, "proposals")), -1)), "contentHash")
  port test.invoke { entry = "cw.apply"; input = { board = $board; request = { action = "review"; actor = $reviewer; expectedBoardRevision = at($board, "revision"); id = $id; contentHash = $contentHash; decision = "approve"; comment = "Record this management change without endorsing substantive claims." } } } → observedRun10
  let board = at($observedRun10, "value")
  port test.invoke { entry = "cw.apply"; input = { board = $board; request = { action = "accept"; actor = $reviewer; expectedBoardRevision = at($board, "revision"); id = $id; contentHash = $contentHash } } } → observedRun11
  let result = at($observedRun11, "value")

process fixture.matters.setup:
  port test.runtime {} → observedRuntime12
  let runtime = $observedRuntime12
  port kernel.invoke { query = "fixture.matters.create"; input = list() } → observedResult13
  let initial = $observedResult13
  port test.invoke { entry = "mw.brief"; input = at($initial, "head") } → observedRun14
  let brief = at($observedRun14, "value")
  let items = list({ id = "access"; kind = "issue"; title = "Affordability and reliability"; body = "Which trade-offs and unknowns need exploration?"; issue = null; voice = null }, { id = "low_fees"; kind = "position"; title = "Keep fees accessible"; body = "A possible perspective prioritises participation; its feasibility is uncertain."; issue = "access"; voice = "Possible affordability perspective" }, { id = "pilot"; kind = "option"; title = "Explore a limited pilot"; body = "A pilot could reveal costs and usage before a commitment. It is not a decision."; issue = "access"; voice = null })
  let response = { protocol = "usewords/matter-suggestions/1"; briefHash = at($brief, "sha256"); matterId = "workshop"; provider = "Test agent (synthetic fixture)"; items = $items }
  port test.invoke { entry = "mw.checkSuggestions"; input = { brief = $brief; response = $response } } → observedRun15
  let packageAI = at($observedRun15, "value")

# a matter preserves its original narrative and starts open, without imported example content
process test.matters.a-matter-preserves-its-original-narrative-and-starts-open-without-imported-example-content:
  call fixture.matters.setup
  assert eq(at(at(at(at($initial, "head"), "document"), "matter"), "status"), "open")
    otherwise "Expected equal(initial.head.document.matter.status,'open')"
  assert eq(at(at(at(at($initial, "head"), "document"), "matter"), "description"), "People want affordable access and reliable staffing. Costs and usage remain unknown.")
    otherwise "Expected equal(initial.head.document.matter.description,'People want affordable access and reliable staffing. Costs and usage remain unknown.')"
  assert eq(at(at(at($initial, "head"), "document"), "objects"), list())
    otherwise "Expected deepEqual(initial.head.document.objects,[])"
  assert eq(at(at(at($initial, "head"), "document"), "journeys"), list())
    otherwise "Expected deepEqual(initial.head.document.journeys,[])"
  assert eq(at(at(at(at($initial, "head"), "document"), "matter"), "items"), list())
    otherwise "Expected deepEqual(initial.head.document.matter.items,[])"
  let invalid = at(at($initial, "head"), "document")
  port test.put { value = at($invalid, "matter"); key = "status"; replacement = "resolved" } → observedUpdated16
  port test.put { value = $invalid; key = "matter"; replacement = $observedUpdated16 } → observedUpdated17
  let invalid = $observedUpdated17
  let observedRefused18 = false
  try:
    port test.invoke { entry = "ws.initial"; input = { basis = $invalid } } → observedRun19
  catch observedFault20:
    port test.match { text = $observedFault20.message; pattern = "MW-OPEN|MM-STATE"; flags = "" } → observedDiagnostic21
    let observedRefused18 = $observedDiagnostic21
  assert $observedRefused18
    otherwise "Expected rejects(run('ws.initial',{basis:invalid}),/MW-OPEN|MM-STATE/)"

# the AI brief scopes only this matter and binds its source; checking suggestions incorporates nothing
process test.matters.the-ai-brief-scopes-only-this-matter-and-binds-its-source-checking-suggestions-incorporates-nothing:
  call fixture.matters.setup
  assert eq(at(at(at($brief, "request"), "context"), "id"), "workshop")
    otherwise "Expected equal(brief.request.context.id,'workshop')"
  assert eq(at(at($brief, "request"), "sourceHash"), at(at($initial, "head"), "documentHash"))
    otherwise "Expected equal(brief.request.sourceHash,initial.head.documentHash)"
  port test.match { text = at(at($brief, "request"), "instruction"); pattern = "without deciding"; flags = "" } → observedMatch22
  assert $observedMatch22
    otherwise "Expected match(brief.request.instruction,/without deciding/)"
  let source = at(at($initial, "head"), "document")
  port test.put { value = $source; key = "extraPrivateNotes"; replacement = "DO NOT EXPORT" } → observedUpdated23
  let source = $observedUpdated23
  port test.invoke { entry = "ws.initial"; input = { basis = $source } } → observedRun24
  let state = at($observedRun24, "value")
  port test.invoke { entry = "mw.brief"; input = $state } → observedRun25
  let scoped = at($observedRun25, "value")
  port test.stringify { value = { request = at($scoped, "request"); sha256 = at($scoped, "sha256") } } → observedJson26
  assert eq(includes($observedJson26, "DO NOT EXPORT"), false)
    otherwise "Expected equal(JSON.stringify({request:scoped.request,sha256:scoped.sha256}).includes('DO NOT EXPORT'),false)"
  assert eq(at(at(at(at($initial, "head"), "document"), "matter"), "items"), list())
    otherwise "Expected deepEqual(initial.head.document.matter.items,[])"
  assert eq(count(at(at($packageAI, "response"), "items")), 3)
    otherwise "Expected equal(packageAI.response.items.length,3)"

# AI suggestions require independent review and linked issues; incorporation preserves unconfirmed standing and open status
process test.matters.ai-suggestions-require-independent-review-and-linked-issues-incorporation-preserves-unconfirmed-standing-and-open-status:
  call fixture.matters.setup
  let board = $initial
  let observedRefused27 = false
  port kernel.invoke { query = "fixture.matters.suggestion"; input = list($board, "low_fees") } → observedResult28
  try:
    port kernel.invoke { query = "fixture.matters.propose"; input = list($board, "too_early", $observedResult28) } → observedResult29
  catch observedFault30:
    port test.match { text = $observedFault30.message; pattern = "MW-REFERENCE"; flags = "" } → observedDiagnostic31
    let observedRefused27 = $observedDiagnostic31
  assert $observedRefused27
    otherwise "Expected rejects(propose(board,'too_early',await suggestion(board,'low_fees')),/MW-REFERENCE/)"
  port kernel.invoke { query = "fixture.matters.suggestion"; input = list($board, "access") } → observedResult32
  port kernel.invoke { query = "fixture.matters.propose"; input = list($board, "issue", $observedResult32) } → observedResult33
  let pending = $observedResult33
  assert eq(at(at(at(at($pending, "head"), "document"), "matter"), "items"), list())
    otherwise "Expected deepEqual(pending.head.document.matter.items,[])"
  port kernel.invoke { query = "fixture.matters.suggestion"; input = list($board, "access") } → observedResult34
  port kernel.invoke { query = "fixture.matters.incorporate"; input = list($board, "issue", $observedResult34) } → observedResult35
  let board = $observedResult35
  port kernel.invoke { query = "fixture.matters.suggestion"; input = list($board, "low_fees") } → observedResult36
  port kernel.invoke { query = "fixture.matters.incorporate"; input = list($board, "position", $observedResult36) } → observedResult37
  let board = $observedResult37
  port kernel.invoke { query = "fixture.matters.suggestion"; input = list($board, "pilot") } → observedResult38
  port kernel.invoke { query = "fixture.matters.incorporate"; input = list($board, "option", $observedResult38) } → observedResult39
  let board = $observedResult39
  assert eq(map(at(at(at(at($board, "head"), "document"), "matter"), "items"), "r", at($r, "standing")), list("open question", "unconfirmed position", "unaccepted approach"))
    otherwise "Expected deepEqual(board.head.document.matter.items.map(r=>r.standing),['open question','unconfirmed position','unaccepted approach'])"
  assert eq(at(at(at(at($board, "head"), "document"), "matter"), "status"), "open")
    otherwise "Expected equal(board.head.document.matter.status,'open')"
  assert eq(at(at(at(at(at(at(at($board, "head"), "document"), "matter"), "items"), 1), "origin"), "briefHash"), at($brief, "sha256"))
    otherwise "Expected equal(board.head.document.matter.items[1].origin.briefHash,brief.sha256)"
  port test.invoke { entry = "cw.receipt"; input = $board } → observedRun40
  port test.invoke { entry = "cw.reconstruct"; input = at($observedRun40, "value") } → observedRun41
  assert eq(at($observedRun41, "value"), $board)
    otherwise "Expected deepEqual(await run('cw.reconstruct',await run('cw.receipt',board)),board)"

# wrong matter, tampered brief, invented references, duplicate IDs and extra authority fields are refused
process test.matters.wrong-matter-tampered-brief-invented-references-duplicate-ids-and-extra-authority-fields-are-refused:
  call fixture.matters.setup
  port test.merge { records = list($response, { matterId = "another" }) } → observedRecord42
  port test.repeat { text = "0"; count = 64 } → observedRepeated43
  port test.merge { records = list($response, { briefHash = $observedRepeated43 }) } → observedRecord44
  port test.merge { records = list($response, { resolved = true }) } → observedRecord45
  port test.merge { records = list($response, { items = list(at($items, 0), at($items, 0)) }) } → observedRecord46
  port test.merge { records = list(at($items, 1), { issue = "invented" }) } → observedRecord47
  port test.merge { records = list($response, { items = list($observedRecord47) }) } → observedRecord48
  each list($observedRecord42, $observedRecord44, $observedRecord45, $observedRecord46, $observedRecord48) as bad:
    let observedRefused50 = false
    try:
      port test.invoke { entry = "mw.checkSuggestions"; input = { brief = $brief; response = $bad } } → observedRun51
    catch observedFault52:
      port test.match { text = $observedFault52.message; pattern = "MW-AI|MW-SHAPE"; flags = "" } → observedDiagnostic53
      let observedRefused50 = $observedDiagnostic53
    assert $observedRefused50
      otherwise "Expected rejects(run('mw.checkSuggestions',{brief,response:bad}),/MW-AI|MW-SHAPE/)"
  port test.stringify { value = $brief } → observedJson54
  port test.parse { text = $observedJson54 } → observedJson55
  let changed = $observedJson55
  port test.put { value = at(at($changed, "request"), "context"); key = "description"; replacement = "Unrecorded context" } → observedUpdated56
  port test.put { value = at($changed, "request"); key = "context"; replacement = $observedUpdated56 } → observedUpdated57
  port test.put { value = $changed; key = "request"; replacement = $observedUpdated57 } → observedUpdated58
  let changed = $observedUpdated58
  port test.stringify { value = at($changed, "request") } → observedJson59
  port test.digest { text = $observedJson59 } → observedHash60
  port test.put { value = $changed; key = "sha256"; replacement = $observedHash60 } → observedUpdated61
  let changed = $observedUpdated61
  let observedRefused62 = false
  port test.merge { records = list($response, { briefHash = at($changed, "sha256") }) } → observedRecord63
  try:
    port test.invoke { entry = "mw.checkSuggestions"; input = { brief = $changed; response = $observedRecord63 } } → observedRun64
  catch observedFault65:
    port test.match { text = $observedFault65.message; pattern = "MW-AI"; flags = "" } → observedDiagnostic66
    let observedRefused62 = $observedDiagnostic66
  assert $observedRefused62
    otherwise "Expected rejects(run('mw.checkSuggestions',{brief:changed,response:{...response,briefHash:changed.sha256}}),/MW-AI/)"
  port kernel.invoke { query = "fixture.matters.create"; input = list("other") } → observedResult67
  let other = $observedResult67
  let observedRefused68 = false
  try:
    port test.invoke { entry = "mw.suggestionChange"; input = { state = at($other, "head"); package = $packageAI; id = "access" } } → observedRun69
  catch observedFault70:
    port test.match { text = $observedFault70.message; pattern = "MW-SCOPE"; flags = "" } → observedDiagnostic71
    let observedRefused68 = $observedDiagnostic71
  assert $observedRefused68
    otherwise "Expected rejects(run('mw.suggestionChange',{state:other.head,package:packageAI,id:'access'}),/MW-SCOPE/)"

# stale incoming AI output refuses before replacing the current suggestion draft
process test.matters.stale-incoming-ai-output-refuses-before-replacing-the-current-suggestion-draft:
  call fixture.matters.setup
  port kernel.invoke { query = "fixture.matters.suggestion"; input = list($initial, "access") } → observedResult72
  port kernel.invoke { query = "fixture.matters.incorporate"; input = list($initial, "issue", $observedResult72) } → observedResult73
  let board = $observedResult73
  port test.open { state = list(list("workspace", at($board, "head")), list("matterBrief", $brief), list("matterSuggestions", null)) } → observedHost74
  let h = $observedHost74
  let observedRefused75 = false
  try:
    port test.invoke { entry = "ws.agent"; input = { operation = "matter-suggestions"; response = $response }; host = $h } → observedRun76
  catch observedFault77:
    port test.match { text = $observedFault77.message; pattern = "MW-STALE"; flags = "" } → observedDiagnostic78
    let observedRefused75 = $observedDiagnostic78
  assert $observedRefused75
    otherwise "Expected rejects(h.run('ws.agent',{operation:'matter-suggestions',response}),/MW-STALE/)"
  port test.get { host = $h; store = "state"; key = "matterSuggestions" } → observedHostValue79
  assert eq($observedHostValue79, null)
    otherwise "Expected equal(h.state.get('matterSuggestions'),null)"

# positions refuse null placeholders as their voice
process test.matters.positions-refuse-null-placeholders-as-their-voice:
  call fixture.matters.setup
  each list("null", "  NULL  ") as voice:
    port test.merge { records = list(at($items, 1), { voice = $voice }) } → observedRecord81
    port test.merge { records = list($response, { items = list(at($items, 0), $observedRecord81) }) } → observedRecord82
    let suggestions = $observedRecord82
    let observedRefused83 = false
    try:
      port test.invoke { entry = "mw.checkSuggestions"; input = { brief = $brief; response = $suggestions } } → observedRun84
    catch observedFault85:
      port test.match { text = $observedFault85.message; pattern = "MW-VOICE"; flags = "" } → observedDiagnostic86
      let observedRefused83 = $observedDiagnostic86
    assert $observedRefused83
      otherwise "Expected rejects(run('mw.checkSuggestions', {brief, response: suggestions}), /MW-VOICE/)"

process fixture.matters.command1:
  let action = at($eventInput, 0)
  let fields = at($eventInput, 1)
  port test.get { host = $h; store = "state"; key = "collaboration" } → observedHostValue186
  port test.merge { records = list({ action = $action; actor = "bob"; id = at($proposal, "id"); contentHash = at($proposal, "contentHash"); expectedBoardRevision = at($observedHostValue186, "revision") }, $fields) } → observedRecord187
  port test.invoke { entry = "ws.agent"; input = { operation = "collaboration-command"; request = $observedRecord187 }; host = $h } → observedRun188
  let result = at($observedRun188, "value")

# both local model bindings use the existing bridge, checker and receipt
process test.matters.both-local-model-bindings-use-the-existing-bridge-checker-and-receipt:
  call fixture.matters.setup
  port kernel.invoke { query = "fixture.matters.harness"; input = list() } → observedResult87
  let h = $observedResult87
  port test.invoke { entry = "ws.boot"; input = null; host = $h } → observedRun88
  port test.invoke { entry = "mw.createUI"; input = null; host = $h } → observedRun89
  port test.invoke { entry = "ws.agent"; input = { operation = "matter-brief" }; host = $h } → observedRun90
  let exported = at($observedRun90, "value")
  port test.repeat { text = "a"; count = 64 } → observedRepeated91
  port test.repeat { text = "b"; count = 64 } → observedRepeated92
  let bindings = { fast = { model = "fast-fixture:local"; digest = $observedRepeated91 }; deep = { model = "deep-fixture:local"; digest = $observedRepeated92 } }
  port test.entries { value = $bindings } → observedEntries93
  port test.openModel { configuration = { tags = "http://127.0.0.1:11434/api/tags"; generate = "http://127.0.0.1:11434/api/generate"; models = map(map($observedEntries93, "recordEntry", at($recordEntry, 1)), "observedItem94", { name = at($observedItem94, "model"); digest = at($observedItem94, "digest") }); items = $items } } → observedModel95
  let modelFixture = $observedModel95
  port test.get { host = $h; store = "state"; key = "collaboration" } → observedHostValue96
  port test.invoke { entry = "cw.receipt"; input = $observedHostValue96; host = $h } → observedRun97
  let receipt = at($observedRun97, "value")
  each list("fast", "deep") as slot:
    port test.model { slot = $slot; bindings = $bindings; brief = $exported; host = $modelFixture } → observedModel99
    let generated = $observedModel99
    port test.modelRequests { host = $modelFixture } → observedRequests100
    let requests = $observedRequests100
    let latest = at($requests, add(count($requests), -1))
    assert eq(at($latest, "url"), "http://127.0.0.1:11434/api/generate")
      otherwise "Expected equal(latest.url,'http://127.0.0.1:11434/api/generate')"
    port test.parse { text = at($latest, "body") } → observedJson101
    let request = $observedJson101
    port test.parse { text = at($request, "prompt") } → observedJson102
    assert eq($observedJson102, at($exported, "request"))
      otherwise "Expected deepEqual(JSON.parse(request.prompt),exported.request)"
    let shapes = at(at(at(at(at($request, "format"), "properties"), "items"), "items"), "anyOf")
    assert eq(map($shapes, "shape", at(at(at($shape, "properties"), "kind"), "const")), list("issue", "position", "option"))
      otherwise "Expected deepEqual(shapes.map(shape=>shape.properties.kind.const),['issue','position','option'])"
    assert eq(at(at(at($shapes, 0), "properties"), "voice"), { type = "null" })
      otherwise "Expected deepEqual(shapes[0].properties.voice,{type:'null'})"
    port test.match { text = "Prioritises reliable opening hours"; pattern = at(at(at(at($shapes, 1), "properties"), "voice"), "pattern") } → observedMatch103
    assert $observedMatch103
      otherwise "Expected ok(matchesPattern('Prioritises reliable opening hours',shapes[1].properties.voice.pattern))"
    port test.match { text = "null"; pattern = at(at(at(at($shapes, 1), "properties"), "voice"), "pattern") } → observedMatch104
    assert eq($observedMatch104, false)
      otherwise "Expected equal(matchesPattern('null',shapes[1].properties.voice.pattern),false)"
    port test.merge { records = list({ operation = "matter-suggestions" }, $generated) } → observedRecord105
    port test.invoke { entry = "ws.agent"; input = $observedRecord105; host = $h } → observedRun106
    assert eq(at($observedRun106, "value"), at($generated, "response"))
      otherwise "Expected deepEqual(await h.run('ws.agent', {operation: 'matter-suggestions', ...generated}), generated.response)"
    assert eq(at(at($generated, "run"), "modelDigest"), at(at($bindings, $slot), "digest"))
      otherwise "Expected equal(generated.run.modelDigest, bindings[slot].digest)"
    port test.get { host = $h; store = "state"; key = "matterModelRun" } → observedHostValue107
    assert eq($observedHostValue107, at($generated, "run"))
      otherwise "Expected deepEqual(h.state.get('matterModelRun'), generated.run)"
    port test.keys { host = $h; store = "storage" } → observedHostValue108
    let draftKey = at(filter($observedHostValue108, "key", and(eq(at($key, add(count($key), -3)), "."), eq(at($key, add(count($key), -2)), "a"), eq(at($key, add(count($key), -1)), "i"))), 0)
    port test.get { host = $h; store = "storage"; key = $draftKey } → observedHostValue109
    port test.parse { text = $observedHostValue109 } → observedJson110
    assert eq(at($observedJson110, "run"), at($generated, "run"))
      otherwise "Expected deepEqual(JSON.parse(h.storage.get(draftKey)).run, generated.run)"
    let observedRefused111 = false
    port test.repeat { text = "0"; count = 64 } → observedRepeated112
    port test.merge { records = list(at($generated, "run"), { responseHash = $observedRepeated112 }) } → observedRecord113
    port test.merge { records = list({ operation = "matter-suggestions" }, $generated, { run = $observedRecord113 }) } → observedRecord114
    try:
      port test.invoke { entry = "ws.agent"; input = $observedRecord114; host = $h } → observedRun115
    catch observedFault116:
      port test.match { text = $observedFault116.message; pattern = "MW-MODEL-RUN"; flags = "" } → observedDiagnostic117
      let observedRefused111 = $observedDiagnostic117
    assert $observedRefused111
      otherwise "Expected rejects( h.run('ws.agent', {operation: 'matter-suggestions', ...generated, run: {...generated.run, responseHash: '0'.repeat(64)}}), /MW-MODEL-RUN/, )"
    port test.get { host = $h; store = "storage"; key = $draftKey } → observedHostValue118
    port test.parse { text = $observedHostValue118 } → observedJson119
    assert eq(at($observedJson119, "run"), at($generated, "run"))
      otherwise "Expected deepEqual(JSON.parse(h.storage.get(draftKey)).run, generated.run)"
    port test.clear { host = $h; store = "state" } → observedHostValue120
    port test.invoke { entry = "ws.boot"; input = null; host = $h } → observedRun121
    port test.get { host = $h; store = "state"; key = "matterModelRun" } → observedHostValue122
    assert eq($observedHostValue122, at($generated, "run"))
      otherwise "Expected deepEqual(h.state.get('matterModelRun'), generated.run)"
    port test.get { host = $h; store = "state"; key = "collaboration" } → observedHostValue123
    port test.invoke { entry = "cw.receipt"; input = $observedHostValue123; host = $h } → observedRun124
    assert eq(at($observedRun124, "value"), $receipt)

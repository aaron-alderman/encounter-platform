# related matters are declared references and do not mutate or grant access to their target
process test.matters.related-matters-are-declared-references-and-do-not-mutate-or-grant-access-to-their-target:
  call fixture.matters.setup
  port kernel.invoke { query = "fixture.matters.create"; input = list("separate") } → observedResult368

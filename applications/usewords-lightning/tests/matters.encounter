    otherwise "Expected deepEqual(unlinked.head.document.matter.management.links,[])"

# a twelve-proposal management board replays inside the unchanged process budget
process test.matters.a-twelve-proposal-management-board-replays-inside-the-unchanged-process-budget:
  call fixture.matters.setup
  let board = $initial
  fold range(12) as observedIndex381; observedLoop382 starts { board = $board }:
    let board = at($observedLoop382, "board")
    let i = add($observedIndex381, -1)
    port kernel.invoke { query = "fixture.matters.acceptedManagement"; input = list($board, concat("orientation_", $i), "orient", { purpose = concat("Explore the costs and priorities, revision ", $i, "."); scope = "No substantive decision is implied." }) } → observedResult383
    let board = $observedResult383
    yield { board = $board } → observedLoop382
  let board = at($observedLoop382, "board")
  port test.invoke { entry = "cw.receipt"; input = $board } → observedRun384
  port test.invoke { entry = "cw.reconstruct"; input = at($observedRun384, "value") } → observedRun385
  let replay = $observedRun385
  assert eq(at($replay, "value"), $board)
    otherwise "Expected deepEqual(replay.value,board)"
  port test.compare { left = at(at($replay, "usage"), "steps"); right = 20000000; operation = "<=" } → observedComparison386
  assert $observedComparison386
    otherwise "Expected ok(replay.usage.steps<=20000000)"
  let observedRefused387 = false
  port kernel.invoke { query = "fixture.matters.manage"; input = list($board, "orient", { purpose = "Beyond bounded profile"; scope = "" }) } → observedResult388
  try:
    port kernel.invoke { query = "fixture.matters.propose"; input = list($board, "too_many", $observedResult388) } → observedResult389
  catch observedFault390:
    port test.match { text = $observedFault390.message; pattern = "CW-LIMIT"; flags = "" } → observedDiagnostic391
    let observedRefused387 = $observedDiagnostic391
  assert $observedRefused387
    otherwise "Expected rejects(propose(board,'too_many',manage(board,'orient',{purpose:'Beyond bounded profile',scope:''})),/CW-LIMIT/)"
  let forged = $board
  port test.put { value = at(at(at(at($forged, "head"), "document"), "matter"), "management"); key = "purpose"; replacement = "Unrecorded purpose" } → observedUpdated392
  port test.put { value = at(at(at($forged, "head"), "document"), "matter"); key = "management"; replacement = $observedUpdated392 } → observedUpdated393
  port test.put { value = at(at($forged, "head"), "document"); key = "matter"; replacement = $observedUpdated393 } → observedUpdated394
  port test.put { value = at($forged, "head"); key = "document"; replacement = $observedUpdated394 } → observedUpdated395
  port test.put { value = $forged; key = "head"; replacement = $observedUpdated395 } → observedUpdated396
  let forged = $observedUpdated396
  let observedRefused397 = false
  port test.invoke { entry = "cw.receipt"; input = $forged } → observedRun398
  try:
    port test.invoke { entry = "cw.reconstruct"; input = at($observedRun398, "value") } → observedRun399
  catch observedFault400:
    port test.match { text = $observedFault400.message; pattern = "CW-REPLAY"; flags = "" } → observedDiagnostic401
    let observedRefused397 = $observedDiagnostic401
  assert $observedRefused397
    otherwise "Expected rejects(run('cw.reconstruct',await run('cw.receipt',forged)),/CW-REPLAY/)"

process fixture.matters.command2:
  let action = at($eventInput, 0)
  let actor = at($eventInput, 1)
  let extra = if(eq(at($eventInput, 2), at({}, "absent")), {}, at($eventInput, 2))
  port test.get { host = $h; store = "state"; key = "collaboration" } → observedHostValue413
  port test.get { host = $h; store = "state"; key = "collaboration" } → observedHostValue414

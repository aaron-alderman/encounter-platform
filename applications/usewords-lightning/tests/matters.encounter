  let before = $other
  port kernel.invoke { query = "fixture.matters.acceptedManagement"; input = list($initial, "relate", "link", { matterId = "separate"; relation = "depends-on"; note = "A declared dependency to inspect, not verified causation." }) } → observedResult369
  let board = $observedResult369
  assert eq($other, $before)
    otherwise "Expected deepEqual(other,before)"
  assert eq(at(at(at(at(at(at(at($board, "head"), "document"), "matter"), "management"), "links"), 0), "matterId"), "separate")
    otherwise "Expected equal(board.head.document.matter.management.links[0].matterId,'separate')"

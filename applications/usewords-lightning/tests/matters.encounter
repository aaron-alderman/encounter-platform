  assert $observedRefused316
    otherwise "Expected rejects(propose(board,'wrong_author',manage(board,'respond',{id:'costs',response:'Speaking for Bob.'})),/MM-AUTHORITY/)"
  let observedRefused321 = false
  port kernel.invoke { query = "fixture.matters.manage"; input = list($board, "orient", { purpose = "A purpose"; scope = "A scope" }) } → observedResult322
  try:
    port test.invoke { entry = "cw.apply"; input = { board = $board; request = { action = "propose"; actor = "bob"; id = "not_coordinator"; expectedBoardRevision = at($board, "revision"); title = "Change scope"; change = $observedResult322 } } } → observedRun323
  catch observedFault324:
    port test.match { text = $observedFault324.message; pattern = "MM-AUTHORITY"; flags = "" } → observedDiagnostic325
    let observedRefused321 = $observedDiagnostic325

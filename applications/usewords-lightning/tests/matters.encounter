# two local matters keep separate boards and AI drafts, with selection restored by replay
process test.matters.two-local-matters-keep-separate-boards-and-ai-drafts-with-selection-restored-by-replay:
  call fixture.matters.setup
  port kernel.invoke { query = "fixture.matters.harness"; input = list() } → observedResult228
  let h = $observedResult228
  port test.invoke { entry = "ws.boot"; input = null; host = $h } → observedRun229
  port test.invoke { entry = "mw.createUI"; input = null; host = $h } → observedRun230
  port test.get { host = $h; store = "state"; key = "workspace" } → observedHostValue231
  let firstMatter = at(at(at($observedHostValue231, "document"), "matter"), "id")
  port test.match { text = $firstMatter; pattern = "^matter_[0-9a-f]{25}$"; flags = "" } → validId
  assert $validId
    otherwise "Expected a matter identifier with a fresh nonce"
  port test.invoke { entry = "mw.briefUI"; input = null; host = $h } → observedRun232
  port test.get { host = $h; store = "state"; key = "matterBrief" } → observedHostValue233
  let firstBrief = $observedHostValue233
  port test.set { host = $h; store = "values"; key = "#mw-ai-response"; value = "PRIVATE UNCHECKED DRAFT" } → observedHostValue234
  port test.set { host = $h; store = "values"; key = "#mw-item-body"; value = "PRIVATE FORM TEXT" } → observedHostValue235
  port test.set { host = $h; store = "values"; key = "#cw-comment"; value = "PRIVATE REVIEW DRAFT" } → observedHostValue236
  port test.set { host = $h; store = "values"; key = "#mw-title"; value = "Second matter" } → observedHostValue237
  port test.set { host = $h; store = "values"; key = "#mw-description"; value = "A separate inquiry with its own context." } → observedHostValue238
  port test.invoke { entry = "mw.createUI"; input = null; host = $h } → observedRun239
  port test.get { host = $h; store = "state"; key = "workspace" } → observedHostValue240
  let secondMatter = at(at(at($observedHostValue240, "document"), "matter"), "id")
  port test.match { text = $secondMatter; pattern = "^matter_[0-9a-f]{25}$"; flags = "" } → validSecondId
  assert and($validSecondId, not(eq($firstMatter, $secondMatter)))
    otherwise "Expected a distinct matter identifier for the second matter"
  port test.get { host = $h; store = "state"; key = "matterBrief" } → observedHostValue241
  assert eq($observedHostValue241, null)
    otherwise "Expected equal(h.state.get('matterBrief'),null)"
  port test.get { host = $h; store = "values"; key = "#mw-ai-response" } → observedHostValue242
  assert eq($observedHostValue242, "")
    otherwise "Expected equal(h.values.get('#mw-ai-response'),'')"
  port test.get { host = $h; store = "values"; key = "#mw-item-body" } → observedHostValue243
  assert eq($observedHostValue243, "")
    otherwise "Expected equal(h.values.get('#mw-item-body'),'')"
  port test.get { host = $h; store = "values"; key = "#cw-comment" } → observedHostValue244
  assert eq($observedHostValue244, "")
    otherwise "Expected equal(h.values.get('#cw-comment'),'')"
  port test.set { host = $h; store = "values"; key = "#mw-select"; value = $firstMatter } → observedHostValue245
  port test.invoke { entry = "mw.selectUI"; input = null; host = $h } → observedRun246
  port test.get { host = $h; store = "state"; key = "matterBrief" } → observedHostValue247
  assert eq($observedHostValue247, $firstBrief)
    otherwise "Expected deepEqual(h.state.get('matterBrief'),firstBrief)"
  port test.get { host = $h; store = "state"; key = "workspace" } → observedHostValue248
  assert eq(at(at(at($observedHostValue248, "document"), "matter"), "title"), "First matter")
    otherwise "Expected equal(h.state.get('workspace').document.matter.title,'First matter')"
  port test.clear { host = $h; store = "state" } → observedHostValue249
  port test.invoke { entry = "ws.boot"; input = null; host = $h } → observedRun250
  port test.get { host = $h; store = "state"; key = "workspace" } → observedHostValue251
  assert eq(at(at(at($observedHostValue251, "document"), "matter"), "id"), $firstMatter)
    otherwise "Expected the first matter to be restored after replay"
  port test.get { host = $h; store = "state"; key = "matterBrief" } → observedHostValue252
  assert eq($observedHostValue252, $firstBrief)
    otherwise "Expected deepEqual(h.state.get('matterBrief'),firstBrief)"
  port test.get { host = $h; store = "content"; key = "#mw-status" } → observedHostValue253
  port test.match { text = $observedHostValue253; pattern = "Open matter"; flags = "" } → observedMatch254
  assert $observedMatch254
    otherwise "Expected match(h.content.get('#mw-status'),/Open matter/)"

# AI text is rendered literally and a storage failure does not register a new matter
process test.matters.ai-text-is-rendered-literally-and-a-storage-failure-does-not-register-a-new-matter:
  call fixture.matters.setup
  port kernel.invoke { query = "fixture.matters.harness"; input = list() } → observedResult255
  let h = $observedResult255
  port test.invoke { entry = "ws.boot"; input = null; host = $h } → observedRun256
  port test.invoke { entry = "mw.createUI"; input = null; host = $h } → observedRun257
  port test.invoke { entry = "mw.briefUI"; input = null; host = $h } → observedRun258
  port test.get { host = $h; store = "state"; key = "matterBrief" } → observedHostValue259
  let current = $observedHostValue259
  port test.merge { records = list(at($items, 0), { title = "<script>execute()</script>" }) } → observedRecord260
  let literal = { protocol = "usewords/matter-suggestions/1"; briefHash = at($current, "sha256"); matterId = at(at($current, "request"), "matterId"); provider = "Unverified fixture"; items = list($observedRecord260) }
  port test.stringify { value = $literal } → observedJson261
  port test.set { host = $h; store = "values"; key = "#mw-ai-response"; value = $observedJson261 } → observedHostValue262
  port test.invoke { entry = "mw.checkUI"; input = null; host = $h } → observedRun263
  port test.get { host = $h; store = "content"; key = "#mw-suggestion-cards" } → observedHostValue264
  port test.match { text = $observedHostValue264; pattern = "&lt;script&gt;"; flags = "" } → observedMatch265
  assert $observedMatch265
    otherwise "Expected match(h.content.get('#mw-suggestion-cards'),/&lt;script&gt;/)"
  port test.get { host = $h; store = "content"; key = "#mw-suggestion-cards" } → observedHostValue266
  assert eq(includes($observedHostValue266, "<script>"), false)
    otherwise "Expected equal(h.content.get('#mw-suggestion-cards').includes('<script>'),false)"
  port test.get { host = $h; store = "state"; key = "workspace" } → observedHostValue267
  let previous = $observedHostValue267
  port test.failWrites { host = $h } → observedWrites268
  port test.set { host = $h; store = "values"; key = "#mw-title"; value = "Unsaved matter" } → observedHostValue269
  port test.invoke { entry = "mw.createUI"; input = null; host = $h } → observedRun270
  port test.get { host = $h; store = "state"; key = "workspace" } → observedHostValue271
  port test.sameReference { left = $observedHostValue271; right = $previous } → sameState271
  assert $sameState271
    otherwise "Expected the previous workspace object to remain in state"
  port test.get { host = $h; store = "state"; key = "matterIndex" } → observedHostValue272

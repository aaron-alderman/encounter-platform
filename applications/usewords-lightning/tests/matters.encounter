  port test.invoke { entry = "ws.agent"; input = { operation = "collaboration-command"; request = $observedRecord415 }; host = $h } → observedRun416
  let result = at($observedRun416, "value")

# matter register, attention and management forms follow scoped durable boards and refuse storage failure
process test.matters.matter-register-attention-and-management-forms-follow-scoped-durable-boards-and-refuse-storage-failure:

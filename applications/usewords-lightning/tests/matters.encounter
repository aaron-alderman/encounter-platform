    otherwise "Expected equal(board.head.document.matter.management.participants[1].role,'coordinator')"
  port test.invoke { entry = "cw.receipt"; input = $board } → observedRun339
  port test.invoke { entry = "cw.reconstruct"; input = at($observedRun339, "value") } → observedRun340
  assert eq(at($observedRun340, "value"), $board)

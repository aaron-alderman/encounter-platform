    otherwise "Expected equal(board.head.document.matter.status,'open')"
  let observedRefused328 = false
  port kernel.invoke { query = "fixture.matters.manage"; input = list($board, "participant", { id = "casey"; role = "coordinator"; capacity = "Attempt to expand authority" }) } → observedResult329
  try:
    port kernel.invoke { query = "fixture.matters.propose"; input = list($board, "escalate", $observedResult329) } → observedResult330
  catch observedFault331:
    port test.match { text = $observedFault331.message; pattern = "MM-ROLE"; flags = "" } → observedDiagnostic332
    let observedRefused328 = $observedDiagnostic332
  assert $observedRefused328
    otherwise "Expected rejects(propose(board,'escalate',manage(board,'participant',{id:'casey',role:'coordinator',capacity:'Attempt to expand authority'})),/MM-ROLE/)"
  let observedRefused333 = false
  port kernel.invoke { query = "fixture.matters.manage"; input = list($board, "participant", { id = "bob"; role = "observer"; capacity = "No independent reviewer" }) } → observedResult334
  try:
    port kernel.invoke { query = "fixture.matters.propose"; input = list($board, "no_review", $observedResult334) } → observedResult335
  catch observedFault336:

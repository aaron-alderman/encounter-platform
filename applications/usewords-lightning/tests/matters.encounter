    otherwise "Expected rejects(propose(board,'no_review',manage(board,'participant',{id:'bob',role:'observer',capacity:'No independent reviewer'})),/MM-REVIEW/)"
  port kernel.invoke { query = "fixture.matters.acceptedManagement"; input = list($board, "coordinate", "participant", { id = "bob"; role = "coordinator"; capacity = "Coordinating evidence gathering" }) } → observedResult338
  let board = $observedResult338

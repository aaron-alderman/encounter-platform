process-module "temple/surface-process-module/1"

process fixture.platform.prepare:
  let request = at($eventInput, 0)
  let context = if(eq(at($eventInput, 1), at({}, "absent")), $trusted, at($eventInput, 1))
  port test.invoke { entry = "wp.prepare"; input = { request = $request; trusted = $context }; platform = $platform } → observedRun1
  let result = at($observedRun1, "value")

process fixture.platform.prepareParty:
  let request = if(eq(at($eventInput, 0), at({}, "absent")), $partyRequest, at($eventInput, 0))
  let context = if(eq(at($eventInput, 1), at({}, "absent")), $partyTrusted, at($eventInput, 1))
  port test.invoke { entry = "pr.prepare"; input = { request = $request; trusted = $context }; platform = $platform } → observedRun2
  let result = at($observedRun2, "value")

process fixture.platform.setup:
  port test.runtime {} → observedRuntime3
  let app = $observedRuntime3
  port test.openPlatform {
    files = list("platform/service.encounter", "platform/parties.encounter");
    entry = "wp.prepare"
  } → projection
  let platform = $projection.id
  let overlaps = $projection.overlaps
  assert eq($overlaps, list())
    otherwise "Platform processes must have distinct names from one another and from the live runtime"
  port test.invoke { entry = "ws.initial"; input = {}; platform = $platform } → observedRun5
  let initial = at($observedRun5, "value")
  port test.invoke { entry = "ws.accept"; input = { state = $initial; expectedRevision = at($initial, "revision"); expectedHash = at($initial, "documentHash") }; platform = $platform } → observedRun6
  let receipt = at($observedRun6, "value")
  let trusted = { authenticated = true; principal = "owner-a"; origin = "https://usewords.ai"; current = null }
  let request = { action = "accept"; workspace = "lightning"; operationId = "accept_one"; expectedHead = null; receipt = $receipt }
  port test.invoke { entry = "mw.create"; input = { id = "workshop"; title = "A shared workshop"; description = "Explore different priorities without requiring agreement." }; platform = $platform } → observedRun7
  let partyBoard = at($observedRun7, "value")
  port test.invoke { entry = "cw.receipt"; input = $partyBoard; platform = $platform } → observedRun8
  let partyReceipt = at($observedRun8, "value")
  let partyTrusted = { applicationId = "app.usewords"; programHash = at($app, "identity"); authenticated = true; csrfVerified = true; principal = "subject-a"; matterId = "workshop"; members = list({ principal = "subject-a"; actor = "alice" }, { principal = "subject-b"; actor = "bob" }); sharedSlot = { matterId = "workshop"; head = "shared-head"; value = $partyReceipt }; privateSlot = { principal = "subject-a"; matterId = "workshop"; head = null; value = null }; priorOperation = null }
  let partyRequest = { action = "shared-command"; matterId = "workshop"; operationId = "include_issue"; expectedHead = "shared-head"; payload = { action = "propose"; expectedBoardRevision = 0; id = "issue_one"; title = "Include an open question"; change = { kind = "matter-item"; matterId = "workshop"; baseRevision = 0; item = { id = "balance"; kind = "issue"; title = "How should priorities be balanced?"; body = "We still need costs and usage evidence."; issue = null; voice = null }; origin = { kind = "participant"; label = "alice"; briefHash = null; sourceHash = null } } } }

# proposed platform policy prepares owner-scoped replayed acceptance without claiming an effect
process test.platform.proposed-platform-policy-prepares-owner-scoped-replayed-acceptance-without-claiming-an-effect:
  call fixture.platform.setup
  port kernel.invoke { query = "fixture.platform.prepare"; input = list($request) } → observedResult9
  let command = $observedResult9
  assert eq(at($command, "owner"), "owner-a")
    otherwise "Expected equal(command.owner,'owner-a')"
  assert eq(at(at(at($command, "value"), "accepted"), "sha256"), at($receipt, "sha256"))
    otherwise "Expected equal(command.value.accepted.sha256,receipt.sha256)"
  assert eq(at($command, "applicationAdmission"), false)
    otherwise "Expected equal(command.applicationAdmission,false)"
  assert eq(at($command, "requiredEffect"), "authenticated-atomic-compare-and-swap-with-idempotency")
    otherwise "Expected equal(command.requiredEffect,'authenticated-atomic-compare-and-swap-with-idempotency')"
  port kernel.invoke { query = "fixture.platform.prepare"; input = list($request) } → observedResult10
  assert eq($command, $observedResult10)
    otherwise "Expected deepEqual(command,await prepare(request))"
  let bad = $receipt
  port test.repeat { text = "0"; count = 64 } → observedRepeated11
  port test.put { value = $bad; key = "sha256"; replacement = $observedRepeated11 } → observedUpdated12
  let bad = $observedUpdated12
  let observedRefused13 = false
  port test.merge { records = list($request, { receipt = $bad }) } → observedRecord14
  try:
    port kernel.invoke { query = "fixture.platform.prepare"; input = list($observedRecord14) } → observedResult15
  catch observedFault16:
    port test.match { text = $observedFault16.message; pattern = "hash mismatch"; flags = "" } → observedDiagnostic17
    let observedRefused13 = $observedDiagnostic17
  assert $observedRefused13
    otherwise "Expected rejects(prepare({...request,receipt:bad}),/hash mismatch/)"


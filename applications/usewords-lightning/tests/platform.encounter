  let observedRefused121 = false
  port test.merge { records = list($partyRequest, { action = "read-private"; payload = {} }) } → observedRecord122
  port test.merge { records = list(at($partyTrusted, "privateSlot"), { principal = "subject-b" }) } → observedRecord123

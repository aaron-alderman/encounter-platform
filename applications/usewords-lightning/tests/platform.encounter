# private receiver preparation and shared packet projections have disjoint payloads
process test.platform.private-receiver-preparation-and-shared-packet-projections-have-disjoint-payloads:
  call fixture.platform.setup
  let draft = { item = at(at(at($partyRequest, "payload"), "change"), "item"); privateNote = "DO NOT DISCLOSE PREPARATION" }
  port test.merge { records = list($partyRequest, { action = "save-private"; operationId = "save_preparation"; expectedHead = null; payload = { draft = $draft; expectedRevision = 0 } }) } → observedRecord133
  port kernel.invoke { query = "fixture.platform.prepareParty"; input = list($observedRecord133) } → observedResult134
  let privateWrite = $observedResult134
  assert eq(at($privateWrite, "scope"), "principal-preparation")
    otherwise "Expected equal(privateWrite.scope,'principal-preparation')"
  assert eq(at(at($privateWrite, "value"), "actor"), "alice")
    otherwise "Expected equal(privateWrite.value.actor,'alice')"
  port test.stringify { value = at($privateWrite, "value") } → observedJson135
  port test.match { text = $observedJson135; pattern = "DO NOT DISCLOSE"; flags = "" } → observedMatch136
  assert $observedMatch136
    otherwise "Expected match(JSON.stringify(privateWrite.value),/DO NOT DISCLOSE/)"
  port test.merge { records = list(at($partyTrusted, "privateSlot"), { head = at($privateWrite, "valueHash"); value = at($privateWrite, "value") }) } → observedRecord137
  port test.merge { records = list($partyTrusted, { privateSlot = $observedRecord137 }) } → observedRecord138
  let context = $observedRecord138
  port test.merge { records = list($partyRequest, { action = "packet"; operationId = "read_packet"; payload = {} }) } → observedRecord139
  port kernel.invoke { query = "fixture.platform.prepareParty"; input = list($observedRecord139, $context) } → observedResult140
  let packet = $observedResult140
  port test.stringify { value = at($packet, "value") } → observedJson141
  assert eq(includes($observedJson141, "DO NOT DISCLOSE"), false)
    otherwise "Expected equal(JSON.stringify(packet.value).includes('DO NOT DISCLOSE'),false)"
  assert eq(at($packet, "scope"), "shared-matter")
    otherwise "Expected equal(packet.scope,'shared-matter')"
  port test.invoke { entry = "pc.checkPacket"; input = at($packet, "value"); platform = $platform } → observedRun142
  assert eq(at(at($observedRun142, "value"), "ok"), true)
    otherwise "Expected equal((await run('pc.checkPacket',packet.value)).ok,true)"

# principal-scoped idempotency reconciles a known result and rejects changed content or ledger scope
process test.platform.principal-scoped-idempotency-reconciles-a-known-result-and-rejects-changed-content-or-ledger-scope:
  call fixture.platform.setup
  port kernel.invoke { query = "fixture.platform.prepareParty"; input = list() } → observedResult143
  let result = $observedResult143
  let priorOperation = { principal = "subject-a"; matterId = "workshop"; operationId = at($partyRequest, "operationId"); requestHash = at($result, "requestHash"); result = $result }
  port test.merge { records = list(at($partyTrusted, "sharedSlot"), { head = "later-head" }) } → observedRecord144
  port test.merge { records = list($partyTrusted, { priorOperation = $priorOperation; sharedSlot = $observedRecord144 }) } → observedRecord145
  let context = $observedRecord145
  port kernel.invoke { query = "fixture.platform.prepareParty"; input = list($partyRequest, $context) } → observedResult146
  assert eq($observedResult146, $result)
    otherwise "Expected deepEqual(await prepareParty(partyRequest,context),result)"
  let observedRefused147 = false
  port test.merge { records = list(at($partyRequest, "payload"), { title = "Changed request" }) } → observedRecord148
  port test.merge { records = list($partyRequest, { payload = $observedRecord148 }) } → observedRecord149
  try:
    port kernel.invoke { query = "fixture.platform.prepareParty"; input = list($observedRecord149, $context) } → observedResult150
  catch observedFault151:
    port test.match { text = $observedFault151.message; pattern = "PR-IDEMPOTENCY"; flags = "" } → observedDiagnostic152
    let observedRefused147 = $observedDiagnostic152
  assert $observedRefused147
    otherwise "Expected rejects(prepareParty({...partyRequest,payload:{...partyRequest.payload,title:'Changed request'}},context),/PR-IDEMPOTENCY/)"
  let observedRefused153 = false
  port test.merge { records = list($priorOperation, { principal = "subject-b" }) } → observedRecord154

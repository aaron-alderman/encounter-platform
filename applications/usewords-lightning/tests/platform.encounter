    let observedRefused38 = $observedDiagnostic43
  assert $observedRefused38
    otherwise "Expected rejects(prepare({...request,expectedHead:'head-one'},{...trusted,current}),/WP-OWNER/)"
  let observedRefused44 = false
  port test.merge { records = list($current, { owner = "owner-a" }) } → observedRecord45
  port test.merge { records = list($trusted, { current = $observedRecord45 }) } → observedRecord46
  try:
    port kernel.invoke { query = "fixture.platform.prepare"; input = list($request, $observedRecord46) } → observedResult47
  catch observedFault48:
    port test.match { text = $observedFault48.message; pattern = "WP-CONFLICT"; flags = "" } → observedDiagnostic49
    let observedRefused44 = $observedDiagnostic49
  assert $observedRefused44
    otherwise "Expected rejects(prepare(request,{...trusted,current:{...current,owner:'owner-a'}}),/WP-CONFLICT/)"

# proposed publication derives only the selected accepted journey and excludes later drafts
process test.platform.proposed-publication-derives-only-the-selected-accepted-journey-and-excludes-later-drafts:
  call fixture.platform.setup
  let draft = at($initial, "document")
  port test.put { value = at(at(at($draft, "objects"), 0), "values"); key = "title"; replacement = "PRIVATE UNACCEPTED TITLE" } → observedUpdated50
  port test.put { value = at(at($draft, "objects"), 0); key = "values"; replacement = $observedUpdated50 } → observedUpdated51
  port test.put { value = at($draft, "objects"); key = 0; replacement = $observedUpdated51 } → observedUpdated52
  port test.put { value = $draft; key = "objects"; replacement = $observedUpdated52 } → observedUpdated53
  let draft = $observedUpdated53
  let current = { owner = "owner-a"; workspace = "lightning"; head = "head-one"; draft = $draft; accepted = $receipt }
  let publish = { action = "publish"; workspace = "lightning"; operationId = "publish_one"; expectedHead = "head-one"; acceptedHash = at($receipt, "sha256"); journey = "listening"; slug = "listening" }
  port test.merge { records = list($trusted, { current = $current }) } → observedRecord54
  port kernel.invoke { query = "fixture.platform.prepare"; input = list($publish, $observedRecord54) } → observedResult55
  let command = $observedResult55
  port test.stringify { value = at($command, "value") } → observedJson56
  let text = $observedJson56
  assert eq(at($command, "publicPath"), "/j/listening")
    otherwise "Expected equal(command.publicPath,'/j/listening')"
  assert eq(at(at($command, "value"), "name"), "Listening well")
    otherwise "Expected equal(command.value.name,'Listening well')"
  assert eq(count(at(at($command, "value"), "entries")), 1)
    otherwise "Expected equal(command.value.entries.length,1)"
  assert eq(includes($text, "PRIVATE UNACCEPTED TITLE"), false)
    otherwise "Expected equal(text.includes('PRIVATE UNACCEPTED TITLE'),false)"
  assert eq(includes($text, "Making with care"), false)
    otherwise "Expected equal(text.includes('Making with care'),false)"
  assert eq(includes($text, "owner-a"), false)
    otherwise "Expected equal(text.includes('owner-a'),false)"
  assert eq(includes($text, "Before offering a lesson"), false)
    otherwise "Expected equal(text.includes('Before offering a lesson'),false)"
  assert eq(at(at($command, "value"), "acceptanceHash"), at($receipt, "sha256"))
    otherwise "Expected equal(command.value.acceptanceHash,receipt.sha256)"
  let observedRefused57 = false
  port test.merge { records = list($publish, { acceptedHash = "other" }) } → observedRecord58
  port test.merge { records = list($trusted, { current = $current }) } → observedRecord59
  try:
    port kernel.invoke { query = "fixture.platform.prepare"; input = list($observedRecord58, $observedRecord59) } → observedResult60
  catch observedFault61:
    port test.match { text = $observedFault61.message; pattern = "WP-ACCEPT"; flags = "" } → observedDiagnostic62
    let observedRefused57 = $observedDiagnostic62
  assert $observedRefused57
    otherwise "Expected rejects(prepare({...publish,acceptedHash:'other'},{...trusted,current}),/WP-ACCEPT/)"
  let observedRefused63 = false
  port test.merge { records = list($publish, { journey = "absent" }) } → observedRecord64
  port test.merge { records = list($trusted, { current = $current }) } → observedRecord65
  try:
    port kernel.invoke { query = "fixture.platform.prepare"; input = list($observedRecord64, $observedRecord65) } → observedResult66
  catch observedFault67:
    port test.match { text = $observedFault67.message; pattern = "WP-JOURNEY"; flags = "" } → observedDiagnostic68
    let observedRefused63 = $observedDiagnostic68
  assert $observedRefused63
    otherwise "Expected rejects(prepare({...publish,journey:'absent'},{...trusted,current}),/WP-JOURNEY/)"
  let observedRefused69 = false
  port test.merge { records = list($current, { accepted = null }) } → observedRecord70
  port test.merge { records = list($trusted, { current = $observedRecord70 }) } → observedRecord71
  try:
    port kernel.invoke { query = "fixture.platform.prepare"; input = list($publish, $observedRecord71) } → observedResult72
  catch observedFault73:
    port test.match { text = $observedFault73.message; pattern = "WP-ACCEPT"; flags = "" } → observedDiagnostic74
    let observedRefused69 = $observedDiagnostic74
  assert $observedRefused69
    otherwise "Expected rejects(prepare(publish,{...trusted,current:{...current,accepted:null}}),/WP-ACCEPT/)"

# saving a checked draft preserves the accepted pointer and does not prepare publication
process test.platform.saving-a-checked-draft-preserves-the-accepted-pointer-and-does-not-prepare-publication:
  call fixture.platform.setup
  let current = { owner = "owner-a"; workspace = "lightning"; head = "head-one"; accepted = $receipt }
  port test.merge { records = list($trusted, { current = $current }) } → observedRecord75
  port kernel.invoke { query = "fixture.platform.prepare"; input = list({ action = "save-draft"; workspace = "lightning"; operationId = "draft_one"; expectedHead = "head-one"; document = at($initial, "document") }, $observedRecord75) } → observedResult76
  let command = $observedResult76
  assert eq(at(at(at($command, "value"), "accepted"), "sha256"), at($receipt, "sha256"))
    otherwise "Expected equal(command.value.accepted.sha256,receipt.sha256)"
  assert eq(at($command, "publicPath"), null)
    otherwise "Expected equal(command.publicPath,null)"
  assert eq(at($command, "expectedHead"), "head-one")
    otherwise "Expected equal(command.expectedHead,'head-one')"
  port test.stringify { value = at($command, "value") } → observedJson77
  port test.digest { text = $observedJson77 } → observedHash78
  assert eq(at($command, "valueHash"), $observedHash78)
    otherwise "Expected equal(command.valueHash,digest(JSON.stringify(command.value)))"

# party receiver policy derives the actor from trusted membership and prepares a replay-checked atomic command
process test.platform.party-receiver-policy-derives-the-actor-from-trusted-membership-and-prepares-a-replay-checked-atomic-command:
  call fixture.platform.setup
  port kernel.invoke { query = "fixture.platform.prepareParty"; input = list() } → observedResult79
  let candidate = $observedResult79
  assert eq(at($candidate, "mode"), "atomic-write-required")
    otherwise "Expected equal(candidate.mode,'atomic-write-required')"
  assert eq(at($candidate, "applicationAdmission"), false)
    otherwise "Expected equal(candidate.applicationAdmission,false)"
  assert eq(at($candidate, "authenticatedEffectProven"), false)
    otherwise "Expected equal(candidate.authenticatedEffectProven,false)"
  port test.invoke { entry = "cw.reconstruct"; input = at($candidate, "value"); platform = $platform } → observedRun80
  let reconstructed = at($observedRun80, "value")
  assert eq(at(at(at(at($reconstructed, "proposals"), 0), "content"), "author"), "alice")
    otherwise "Expected equal(reconstructed.proposals[0].content.author,'alice')"
  assert eq(count(at(at(at(at($reconstructed, "head"), "document"), "matter"), "items")), 0)
    otherwise "Expected equal(reconstructed.head.document.matter.items.length,0)"
  let observedRefused81 = false
  port test.merge { records = list(at($partyRequest, "payload"), { actor = "bob" }) } → observedRecord82
  port test.merge { records = list($partyRequest, { payload = $observedRecord82 }) } → observedRecord83
  try:
    port kernel.invoke { query = "fixture.platform.prepareParty"; input = list($observedRecord83) } → observedResult84
  catch observedFault85:
    port test.match { text = $observedFault85.message; pattern = "PR-IDENTITY"; flags = "" } → observedDiagnostic86
    let observedRefused81 = $observedDiagnostic86
  assert $observedRefused81
    otherwise "Expected rejects(prepareParty({...partyRequest,payload:{...partyRequest.payload,actor:'bob'}}),/PR-IDENTITY/)"
  let observedRefused87 = false
  port test.merge { records = list(at($partyRequest, "payload"), { trusted = { principal = "subject-b" } }) } → observedRecord88
  port test.merge { records = list($partyRequest, { payload = $observedRecord88 }) } → observedRecord89
  try:
    port kernel.invoke { query = "fixture.platform.prepareParty"; input = list($observedRecord89) } → observedResult90
  catch observedFault91:
    port test.match { text = $observedFault91.message; pattern = "PR-IDENTITY"; flags = "" } → observedDiagnostic92
    let observedRefused87 = $observedDiagnostic92
  assert $observedRefused87
    otherwise "Expected rejects(prepareParty({...partyRequest,payload:{...partyRequest.payload,trusted:{principal:'subject-b'}}}),/PR-IDENTITY/)"
  let observedRefused93 = false
  port test.merge { records = list($partyTrusted, { principal = "subject-b" }) } → observedRecord94
  try:
    port kernel.invoke { query = "fixture.platform.prepareParty"; input = list($partyRequest, $observedRecord94) } → observedResult95
  catch observedFault96:
    port test.match { text = $observedFault96.message; pattern = "PC-AUTHORITY"; flags = "" } → observedDiagnostic97
    let observedRefused93 = $observedDiagnostic97
  assert $observedRefused93
    otherwise "Expected rejects(prepareParty(partyRequest,{...partyTrusted,principal:'subject-b'}),/PC-AUTHORITY/)"

# party receiver policy refuses missing identity, CSRF, foreign membership, stale heads and cross-party slots
process test.platform.party-receiver-policy-refuses-missing-identity-csrf-foreign-membership-stale-heads-and-cross-party-slots:
  call fixture.platform.setup
  port test.merge { records = list($partyTrusted, { authenticated = false }) } → observedRecord98
  port test.merge { records = list($partyTrusted, { csrfVerified = false }) } → observedRecord99
  port test.merge { records = list($partyTrusted, { programHash = "other" }) } → observedRecord100
  each list($observedRecord98, $observedRecord99, $observedRecord100) as context:
    let observedRefused102 = false
    try:
      port kernel.invoke { query = "fixture.platform.prepareParty"; input = list($partyRequest, $context) } → observedResult103
    catch observedFault104:
      port test.match { text = $observedFault104.message; pattern = "PR-AUTH"; flags = "" } → observedDiagnostic105
      let observedRefused102 = $observedDiagnostic105
    assert $observedRefused102
      otherwise "Expected rejects(prepareParty(partyRequest,context),/PR-AUTH/)"
  let observedRefused106 = false
  port test.merge { records = list($partyTrusted, { principal = "outsider" }) } → observedRecord107

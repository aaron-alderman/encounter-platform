    let observedRefused121 = $observedDiagnostic127
  assert $observedRefused121
    otherwise "Expected rejects(prepareParty({...partyRequest,action:'read-private',payload:{}},{...partyTrusted,privateSlot:{...partyTrusted.privateSlot,principal:'subject-b'}}),/PR-PRIVATE/)"
  let observedRefused128 = false
  port test.merge { records = list($partyRequest, { owner = "subject-b" }) } → observedRecord129
  try:
    port kernel.invoke { query = "fixture.platform.prepareParty"; input = list($observedRecord129) } → observedResult130
  catch observedFault131:

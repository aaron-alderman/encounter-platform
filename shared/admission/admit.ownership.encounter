process-module "temple/surface-process-module/1"
profile "encounter/reconstituted-source/1"

process admit.ownership:
  fold $sources as source; ownershipEntries starts list():
    fold $source.facts as fact; ownershipKeys starts list():
      port value.encode { value = list($fact.s, $fact.p) } → ownershipKey
      yield append($ownershipKeys, list($ownershipKey)) → ownershipKeys
    yield append(
    $ownershipEntries,
    map(distinct($ownershipKeys), "ownershipKey", list($ownershipKey, $source.file))
  ) → ownershipEntries
  port record.fromEntries { entries = $ownershipEntries } → owners
  each $ownershipEntries as ownershipEntry:
    assert eq(at($owners, at($ownershipEntry, 0)), at($ownershipEntry, 1))
      otherwise "TEMPLE-S018: Relation cell has multiple source owners. Correct the owning module; do not duplicate shared facts."
  let result = { ok = true; owners = $owners }

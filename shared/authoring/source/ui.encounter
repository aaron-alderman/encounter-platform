process-module "temple/surface-process-module/1"

process ui.field:
  let field = $eventInput
  let value = $field.value
  when and(eq(at($session.draft, "origin"), $formOrigin), not(eq(at($session.draft, $field.id), at({}, "absent")))):
    let value = at($session.draft, $field.id)
  let control = { tag = "input"; attrs = { name = $field.id; value = $value }; children = list() }
  when eq($field.kind, "identity"):
    let control = { tag = "input"; attrs = { name = $field.id; value = $value; readonly = true }; children = list() }
  when eq($field.kind, "textarea"):
    let control = { tag = "textarea"; attrs = { name = $field.id; rows = if(eq($field.id, "code"), 7, 3); spellcheck = "false" }; children = list($value) }
  when eq($field.kind, "check"):
    let control = { tag = "input"; attrs = { type = "checkbox"; name = $field.id; value = "yes"; checked = eq($value, "yes") }; children = list() }
  when eq($field.kind, "select"):
    let options = map($field.options, "option", { tag = "option"; attrs = { value = $option; selected = eq($option, $value) }; children = list(if(eq($option, ""), "None / unaliased", $option)) })
    let control = { tag = "select"; attrs = { name = $field.id }; children = $options }
  port rel.encode { value = list($formOperation, $formIdentity, $formTarget, $formTitle, $formHelp, $field.id); kind = "ControlCoordinates" } → coordinates
  port digest.sha256 { text = $coordinates } → identity
  let id = concat("control-", $identity)
  port record.put { record = $control.attrs; key = "id"; value = $id } → attributes
  port record.put { record = $control; key = "attrs"; value = $attributes } → control
  let result = { tag = "div"; attrs = { class = "field" }; children = list({ tag = "label"; attrs = { for = $id }; children = list($field.label) }, $control) }

process ui.form:
  let formOperation = $eventInput.operation
  let formIdentity = $eventInput.identity
  let form = $eventInput
  let formTarget = $form.target
  let formTitle = $form.title
  let formHelp = $form.help
  port rel.encode { value = list($formOperation, $formIdentity, $formTarget, $formTitle, $formHelp); kind = "FormCoordinates" } → coordinates
  port digest.sha256 { text = $coordinates } → formOrigin
  fold $form.fields as field; controls starts list():
    port kernel.invoke { query = "ui.field"; input = $field } → control
    yield append($controls, list($control)) → controls
  let metadata = list(
    { id = "reason"; label = "Why this change?"; value = ""; kind = "text"; options = list() },
    { id = "target"; label = "What exactly changes?"; value = $form.target; kind = "text"; options = list() },
    { id = "goal"; label = "What should it help achieve?"; value = $state.intent; kind = "text"; options = list() }
  )
  fold $metadata as field; purpose starts list():
    port kernel.invoke { query = "ui.field"; input = $field } → control
    yield append($purpose, list($control)) → purpose
  let result = { tag = "form"; attrs = { method = "post"; action = "/"; "data-operation" = $formOperation }; children = append(list(
    { tag = "h3"; attrs = {}; children = list($form.title) },
    { tag = "p"; attrs = { class = "hint" }; children = list($form.help) },
    { tag = "input"; attrs = { type = "hidden"; name = "_csrf"; value = $csrf }; children = list() },
    { tag = "input"; attrs = { type = "hidden"; name = "command"; value = "prepare" }; children = list() },
    { tag = "input"; attrs = { type = "hidden"; name = "operation"; value = $formOperation }; children = list() },
    { tag = "input"; attrs = { type = "hidden"; name = "origin"; value = $formOrigin }; children = list() },
    { tag = "input"; attrs = { type = "hidden"; name = "base"; value = $snapshot.revision }; children = list() }
  ), append($controls, list({ tag = "fieldset"; attrs = { class = "purpose" }; children = append(list({ tag = "legend"; attrs = {}; children = list("Purpose of this one change") }), $purpose) }, { tag = "button"; attrs = { type = "submit" }; children = list("Review one change") }))) }

process ui.work:
  let content = list({ tag = "h2"; attrs = {}; children = list("Your work") })
  when eq($state.intent, ""):
    port kernel.invoke { query = "ui.form"; input = { operation = "intent"; identity = ""; title = "What would you like to make?"; help = "Start with your purpose. No application types or objects have been supplied."; target = "Original intent"; fields = list({ id = "intent"; label = "I want to… because…"; value = ""; kind = "textarea"; options = list() }) } } → form
    let content = append($content, list($form))
  when not(eq($state.intent, "")):
    let content = append($content, list({ tag = "blockquote"; attrs = {}; children = list($state.intent) }))
    port kernel.invoke { query = "ui.form"; input = { operation = "type"; identity = ""; title = "Define a kind of thing"; help = "Choose your own name. Add fields when you need them, one at a time."; target = "A new type"; fields = list({ id = "id"; label = "Type identity"; value = ""; kind = "text"; options = list() }, { id = "label"; label = "Type name"; value = ""; kind = "text"; options = list() }) } } → form
    let content = append($content, list($form))
  let types = map($state.definitions, "type", { tag = "li"; attrs = {}; children = list({ tag = "a"; attrs = { href = concat("/?view=type&id=", $type.id) }; children = list($type.label) }, { tag = "small"; attrs = {}; children = list(concat(" — ", $type.id)) }) })
  let things = map($state.things, "thing", { tag = "li"; attrs = {}; children = list({ tag = "a"; attrs = { href = concat("/?view=thing&id=", $thing.id) }; children = list($thing.label) }, { tag = "small"; attrs = {}; children = list(concat(" — ", $thing.id)) }) })
  let content = append($content, list({ tag = "section"; attrs = {}; children = list({ tag = "h3"; attrs = {}; children = list("Types") }, { tag = "ul"; attrs = {}; children = $types }, { tag = "h3"; attrs = {}; children = list("Things") }, { tag = "ul"; attrs = {}; children = $things }) }))
  let result = $content

process ui.type:
  let definition = at(filter($state.definitions, "type", eq($type.id, $session.selected)), 0)
  assert $definition
    otherwise "VIEW: This type does not exist."
  let content = list({ tag = "h2"; attrs = {}; children = list($definition.label) }, { tag = "p"; attrs = { class = "hint" }; children = list(concat("Type / ", $definition.id, ". Every object must resolve all its fields.")) })
  let fields = map($definition.fields, "field", { tag = "li"; attrs = {}; children = list(concat($field.label, " · ", $field.kind, if(eq($field.kind, "Reference"), concat(" → ", $field.expects), ""))) })
  let content = append($content, list({ tag = "ul"; attrs = {}; children = $fields }))
  let inputs = list({ id = "type"; label = "Type identity"; value = $definition.id; kind = "select"; options = list($definition.id) }, { id = "id"; label = "Field identity"; value = ""; kind = "text"; options = list() }, { id = "label"; label = "Field name"; value = ""; kind = "text"; options = list() }, { id = "kind"; label = "Value type"; value = "Text"; kind = "select"; options = list("Text", "Number", "Boolean", "Reference") }, { id = "expects"; label = "Reference target type (Reference only)"; value = ""; kind = "select"; options = append(list(""), map($state.definitions, "type", $type.id)) })
  fold $state.things as thing; inputs starts $inputs:
    fold $thing.roles as role; inputs starts $inputs:
      when eq($role.type, $definition.id):
        let inputs = append($inputs, list({ id = concat("resolve.", $thing.id, ".", $role.alias); label = concat("Resolve ", $thing.label, " / ", if(eq($role.alias, ""), "unaliased", $role.alias)); value = ""; kind = "text"; options = list() }, { id = concat("confirmed.", $thing.id, ".", $role.alias); label = concat("Confirm this resolution for ", $thing.label); value = ""; kind = "check"; options = list() }))
      yield $inputs → inputs
    yield $inputs → inputs
  port kernel.invoke { query = "ui.form"; input = { operation = "field"; identity = ""; title = "Add one field"; help = "Resolve each existing role explicitly. For Number or Boolean use a scalar literal; Text and Reference use plain words or identity."; target = $definition.id; fields = $inputs } } → form
  let content = append($content, list($form))
  fold $definition.fields as field; defaults starts {}:
    let initial = if(eq($field.kind, "Number"), 0, if(eq($field.kind, "Boolean"), false, ""))
    port record.put { record = $defaults; key = $field.id; value = $initial } → defaults
    yield $defaults → defaults
  port kernel.invoke { query = "document.print"; input = $defaults } → document
  port kernel.invoke { query = "ui.form"; input = { operation = "thing"; identity = ""; title = "Create a thing"; help = "The document is a visible starting draft, not a default policy. Choose every initial value and review it."; target = $definition.id; fields = list({ id = "id"; label = "Thing identity"; value = ""; kind = "text"; options = list() }, { id = "label"; label = "Thing name"; value = ""; kind = "text"; options = list() }, { id = "type"; label = "Type"; value = $definition.id; kind = "select"; options = list($definition.id) }, { id = "alias"; label = "Role alias (blank for unaliased)"; value = ""; kind = "text"; options = list() }, { id = "document"; label = "Initial values document"; value = $document; kind = "textarea"; options = list() }) } } → form
  let result = append($content, list($form))

process ui.thing:
  let thing = at(filter($state.things, "thing", eq($thing.id, $session.selected)), 0)
  assert $thing
    otherwise "VIEW: This thing does not exist."
  let content = list({ tag = "h2"; attrs = {}; children = list($thing.label) }, { tag = "p"; attrs = { class = "hint" }; children = list(concat("Canonical thing / ", $thing.id)) })
  fold $thing.roles as role; content starts $content:
    let definition = at(filter($state.definitions, "type", eq($type.id, $role.type)), 0)
    let content = append($content, list({ tag = "h3"; attrs = {}; children = list(concat($definition.label, " as ", if(eq($role.alias, ""), "unaliased", $role.alias))) }))
    fold $definition.fields as field; content starts $content:
      let value = at($role.values, $field.id)
      port value.string { value = $value } → text
      port kernel.invoke { query = "ui.form"; input = { operation = "value"; identity = ""; title = concat("Edit ", $field.label); help = concat($field.kind, " · source ", $thing.id, " / ", $role.type, " / ", $field.id); target = concat($thing.id, "/", $field.id); fields = list({ id = "thing"; label = "Thing"; value = $thing.id; kind = "select"; options = list($thing.id) }, { id = "alias"; label = "Exact role"; value = $role.alias; kind = "select"; options = list($role.alias) }, { id = "field"; label = "Field"; value = $field.id; kind = "select"; options = list($field.id) }, { id = "value"; label = $field.label; value = $text; kind = "textarea"; options = list() }) } } → form
      let content = append($content, list({ tag = "details"; attrs = {}; children = list({ tag = "summary"; attrs = {}; children = list(concat($field.label, " — ", $text)) }, $form) }))
      yield $content → content
    port kernel.invoke { query = "document.print"; input = $role.values } → document
    port kernel.invoke { query = "ui.form"; input = { operation = "document"; identity = ""; title = "Edit the text document"; help = "Change one value. Preserve all other fields. Quoted words and scalar literals are data, never executable references."; target = concat($thing.id, "/", $role.type); fields = list({ id = "thing"; label = "Thing"; value = $thing.id; kind = "select"; options = list($thing.id) }, { id = "alias"; label = "Exact role"; value = $role.alias; kind = "select"; options = list($role.alias) }, { id = "field"; label = "GUI field (unused for document edits)"; value = ""; kind = "select"; options = list("") }, { id = "document"; label = "Values document"; value = $document; kind = "textarea"; options = list() }) } } → form
    let content = append($content, list($form))
    yield $content → content
  let unused = filter($state.definitions, "definition", not(some($thing.roles, "role", eq($role.type, $definition.id))))
  fold $unused as definition; content starts $content:
    fold $definition.fields as field; cells starts {}:
      port record.put { record = $cells; key = $field.id; value = if(eq($field.kind, "Number"), 0, if(eq($field.kind, "Boolean"), false, "")) } → cells
      yield $cells → cells
    port kernel.invoke { query = "document.print"; input = $cells } → document
    port kernel.invoke { query = "ui.form"; input = { operation = "role"; identity = $thing.id; title = concat("Add role — ", $definition.label); help = "One canonical thing, another explicit type and alias. No first-role winner or duplicate object is created."; target = $thing.id; fields = list({ id = "id"; label = "Thing identity"; value = $thing.id; kind = "identity"; options = list() }, { id = "type"; label = "Role type"; value = $definition.id; kind = "select"; options = list($definition.id) }, { id = "alias"; label = "New role alias"; value = ""; kind = "text"; options = list() }, { id = "document"; label = "Role values document"; value = $document; kind = "textarea"; options = list() }) } } → form
    let content = append($content, list({ tag = "details"; attrs = {}; children = list({ tag = "summary"; attrs = {}; children = list(concat("Add role — ", $definition.label)) }, $form) }))
    yield $content → content
  let result = $content

process ui.projections:
  let content = list({ tag = "h2"; attrs = {}; children = list("Views and their sources") }, { tag = "p"; attrs = {}; children = list("One thing can appear in several contexts. Follow a view to its input, rule or explicit overlay.") })
  fold $state.projections as projection; content starts $content:
    port kernel.invoke { query = "projection.value"; input = $projection } → mapping
    let rendered = { tag = "a"; attrs = { href = concat("/?view=thing&id=", $projection.thing) }; children = list($mapping.value) }
    when eq($projection.kind, "row"):
      let rendered = { tag = "table"; attrs = {}; children = list({ tag = "caption"; attrs = {}; children = list($projection.id) }, { tag = "tbody"; attrs = {}; children = list({ tag = "tr"; attrs = {}; children = list({ tag = "th"; attrs = { scope = "row" }; children = list($projection.thing) }, { tag = "td"; attrs = {}; children = list($mapping.value) }) }) }) }
    let content = append($content, list({ tag = "section"; attrs = { "data-projection" = $projection.id }; children = list({ tag = "h3"; attrs = {}; children = list(concat($projection.id, " · ", $projection.kind)) }, $rendered, { tag = "p"; attrs = { class = "hint"; "data-mapping" = $projection.id }; children = list(concat("Edit goes to ", $mapping.source, ". Inverse: ", $mapping.inverse, ".")) }, { tag = "p"; attrs = { class = "links" }; children = list({ tag = "a"; attrs = { href = concat("/?view=thing&id=", $projection.thing) }; children = list("Open the input") }, { tag = "a"; attrs = { href = "/?view=sources" }; children = list("Inspect the source and rule") }) }) }))
    when not(eq($mapping.inverse, "none")):
      port kernel.invoke { query = "ui.form"; input = { operation = "projection-value"; identity = $projection.id; title = concat("Edit visible value — ", $projection.id); help = concat("Checked route: ", $mapping.source, if(eq($mapping.inverse, "suffix"), concat(". Preserve the suffix “", $mapping.suffix, "”."), "")); target = $mapping.source; fields = list({ id = "id"; label = "Projection"; value = $projection.id; kind = "select"; options = list($projection.id) }, { id = "value"; label = "Visible value"; value = $mapping.value; kind = "textarea"; options = list() }) } } → form
      let content = append($content, list({ tag = "details"; attrs = {}; children = list({ tag = "summary"; attrs = {}; children = list(concat("Edit visible value — ", $projection.id)) }, $form) }))
    when eq($projection.kind, "web"):
      port kernel.invoke { query = "ui.form"; input = { operation = "overlay"; identity = $projection.id; title = concat("Web label overlay — ", $projection.id); help = "An explicit local label. It does not overwrite the source title or other views."; target = concat("overlay/", $projection.id); fields = list({ id = "id"; label = "Projection"; value = $projection.id; kind = "select"; options = list($projection.id) }, { id = "value"; label = "Context label"; value = $mapping.value; kind = "textarea"; options = list() }) } } → form
      let content = append($content, list({ tag = "details"; attrs = {}; children = list({ tag = "summary"; attrs = {}; children = list(concat("Web label overlay — ", $projection.id)) }, $form) }))
    port kernel.invoke { query = "ui.form"; input = { operation = "projection-action"; identity = $projection.id; title = concat("Choose action — ", $projection.id); help = "The action's input and output must satisfy the source field and representation."; target = $projection.id; fields = list({ id = "id"; label = "Projection"; value = $projection.id; kind = "select"; options = list($projection.id) }, { id = "action"; label = "Action"; value = $projection.action; kind = "select"; options = append(list(""), map($state.actions, "action", $action.id)) }) } } → form
    let content = append($content, list({ tag = "details"; attrs = {}; children = list({ tag = "summary"; attrs = {}; children = list(concat("Choose action — ", $projection.id)) }, $form) }))
    yield $content → content
  when count($state.things):
    fold $state.definitions as definition; fieldIds starts list():
      yield append($fieldIds, map(filter($definition.fields, "field", eq($field.kind, "Text")), "field", $field.id)) → fieldIds
    port kernel.invoke { query = "ui.form"; input = { operation = "projection"; identity = ""; title = "Create a projection"; help = "Choose the exact thing, role alias and Text field. The supplied web-link and row representations contain no application-specific template."; target = "A new projection"; fields = list({ id = "id"; label = "Projection identity"; value = ""; kind = "text"; options = list() }, { id = "thing"; label = "Source thing"; value = at(at($state.things, 0), "id"); kind = "select"; options = map($state.things, "thing", $thing.id) }, { id = "alias"; label = "Exact role alias (blank selects unaliased)"; value = ""; kind = "text"; options = list() }, { id = "field"; label = "Source field identity"; value = ""; kind = "text"; options = list() }, { id = "kind"; label = "Representation"; value = "web"; kind = "select"; options = list("web", "row") }, { id = "action"; label = "Optional action"; value = ""; kind = "select"; options = append(list(""), map($state.actions, "action", $action.id)) }) } } → form
    let content = append($content, list({ tag = "details"; attrs = { open = or(eq(count($state.projections), 0), eq(at($session.draft, "operation"), "projection")) }; children = list({ tag = "summary"; attrs = {}; children = list("Create a projection") }, $form) }))
  let result = $content

process ui.actions:
  let content = list({ tag = "h2"; attrs = {}; children = list("Reusable actions") }, { tag = "p"; attrs = {}; children = list("Write an action once and use it in a view. Its input and result types are checked before it can be used.") })
  let actions = append($state.actions, list({ id = ""; label = ""; input = "Text"; output = "Text"; source = "" }))
  fold $actions as action; content starts $content:
    let code = "process-module \"temple/surface-process-module/1\"\nprocess run:\n  let result = $eventInput\n"
    when not(eq($action.source, "")):
      port kernel.invoke { query = "source.get"; input = $action.source } → code
    port kernel.invoke { query = "ui.form"; input = { operation = "action"; identity = $action.id; title = if(eq($action.id, ""), "Create an action", concat("Edit action — ", $action.label)); help = "Source compiles and hydrates through the newer Encounter foundation. Declared and inferred types must agree before review."; target = if(eq($action.id, ""), "A new action", $action.id); fields = list({ id = "id"; label = "Action identity"; value = $action.id; kind = "text"; options = list() }, { id = "label"; label = "Action name"; value = $action.label; kind = "text"; options = list() }, { id = "input"; label = "Input type"; value = $action.input; kind = "select"; options = list("Text", "Number", "Boolean") }, { id = "output"; label = "Output type"; value = $action.output; kind = "select"; options = list("Text", "Number", "Boolean") }, { id = "code"; label = "Encounter source"; value = $code; kind = "textarea"; options = list() }) } } → form
    let content = append($content, list($form))
    let operator = "identity"
    let suffix = ""
    when not(eq($action.id, "")):
      port kernel.invoke { query = "action.check"; input = $action } → mapping
      when eq($mapping.inverse, "suffix"):
        let operator = "append"
        let suffix = $mapping.suffix
    port kernel.invoke { query = "ui.form"; input = { operation = "action-builder"; identity = $action.id; title = if(eq($action.id, ""), "Build an action with fields", concat("Build action — ", $action.label)); help = "The field builder writes real Encounter source through the same checked owner. Identity returns the input; append adds the exact Text suffix."; target = if(eq($action.id, ""), "A new action", $action.id); fields = list({ id = "id"; label = "Action identity"; value = $action.id; kind = if(eq($action.id, ""), "text", "identity"); options = list() }, { id = "label"; label = "Action name"; value = $action.label; kind = "text"; options = list() }, { id = "input"; label = "Input type"; value = $action.input; kind = "select"; options = list("Text", "Number", "Boolean") }, { id = "output"; label = "Output type"; value = $action.output; kind = "select"; options = list("Text", "Number", "Boolean") }, { id = "operator"; label = "Operation"; value = $operator; kind = "select"; options = list("identity", "append") }, { id = "suffix"; label = "Text to append"; value = $suffix; kind = "text"; options = list() }) } } → builder
    let content = append($content, list({ tag = "details"; attrs = {}; children = list({ tag = "summary"; attrs = {}; children = list(if(eq($action.id, ""), "Build an action with fields", concat("Build action — ", $action.label))) }, $builder) }))
    yield $content → content
  let result = $content

process ui.jobs:
  let content = list({ tag = "h2"; attrs = {}; children = list("Work and results") }, { tag = "p"; attrs = {}; children = list("Local exports use current accepted views. They can be queued, cancelled, resumed and completed once. No mail, network or deployment capability is granted.") })
  port kernel.invoke { query = "ui.form"; input = { operation = "queue"; identity = ""; title = "Queue an export"; help = "The result will be a retained local HTML document."; target = "Local export job"; fields = list({ id = "id"; label = "Job identity"; value = ""; kind = "text"; options = list() }) } } → form
  let content = append($content, list($form))
  fold $state.jobs as job; content starts $content:
    let content = append($content, list({ tag = "section"; attrs = { "data-job" = $job.id }; children = list({ tag = "h3"; attrs = {}; children = list($job.id) }, { tag = "p"; attrs = {}; children = list(concat("Status: ", $job.status, " · source revision ", $job.basis)) }) }))
    when eq($job.status, "completed"):
      let content = append($content, list({ tag = "p"; attrs = { class = "hint" }; children = list(concat("Result digest: ", $job.digest)) }, { tag = "a"; attrs = { href = concat("/artifact/", $job.id); target = "_blank"; rel = "noopener" }; children = list(concat("Open result — ", $job.id)) }))
    when not(eq($job.status, "completed")):
      let operations = if(eq($job.status, "queued"), list("run", "cancel-job"), list("resume-job"))
      fold $operations as operation; content starts $content:
        port kernel.invoke { query = "ui.form"; input = { operation = $operation; identity = $job.id; title = concat($operation, " — ", $job.id); help = "Review this one job transition. A completed job cannot be rerun."; target = $job.id; fields = list({ id = "id"; label = "Job"; value = $job.id; kind = "select"; options = list($job.id) }) } } → form
        let content = append($content, list($form))
        yield $content → content
    yield $content → content
  let result = $content

process ui.history:
  port storage.history {} → history
  port kernel.invoke { query = "types.named"; input = { name = "History"; value = $history } } → _
  let content = list({ tag = "h2"; attrs = {}; children = list("History and recovery") }, { tag = "p"; attrs = {}; children = list("Restore an earlier source set as a new checked revision. Existing revisions and their reasons remain intact.") })
  fold $history as revision; content starts $content:
    let content = append($content, list({ tag = "section"; attrs = {}; children = list({ tag = "h3"; attrs = {}; children = list(concat("Revision ", $revision.revision)) }, { tag = "p"; attrs = {}; children = list($revision.description) }, { tag = "p"; attrs = { class = "hint" }; children = list(concat("Because: ", $revision.reason, " · Target: ", $revision.target, " · Goal: ", $revision.goal)) }) }))
    when not(eq($revision.revision, $snapshot.revision)):
      port value.string { value = $revision.revision } → id
      port kernel.invoke { query = "ui.form"; input = { operation = "restore"; identity = ""; title = concat("Restore revision ", $id); help = "Rechecks all types, references, action sources and projection dependencies."; target = concat("revision/", $id); fields = list({ id = "revision"; label = "Revision"; value = $id; kind = "select"; options = list($id) }) } } → form
      let content = append($content, list({ tag = "details"; attrs = {}; children = list({ tag = "summary"; attrs = {}; children = list(concat("Restore revision ", $id)) }, $form) }))
    yield $content → content
  let result = $content

process ui.sources:
  let content = list({ tag = "h2"; attrs = {}; children = list("Source and ownership") }, { tag = "p"; attrs = {}; children = list("Application facts are REL; action programs are separate Encounter documents. Outputs and inspection data grant no execution authority.") })
  fold $documents as document; content starts $content:
    let content = append($content, list({ tag = "details"; attrs = {}; children = list({ tag = "summary"; attrs = {}; children = list($document.path) }, { tag = "pre"; attrs = {}; children = list($document.text) }) }))
    yield $content → content
  port source.catalogue {} → basis
  port kernel.invoke { query = "types.named"; input = { name = "Documents"; value = $basis } } → _
  let content = append($content, list({ tag = "h3"; attrs = {}; children = list("Supplied environment — inspectable source") }))
  fold $basis as document; content starts $content:
    let content = append($content, list({ tag = "details"; attrs = {}; children = list({ tag = "summary"; attrs = {}; children = list($document.path) }, { tag = "pre"; attrs = {}; children = list($document.text) }) }))
    yield $content → content
  let result = $content

process ui.flatten:
  let value = $eventInput.value
  let path = $eventInput.path
  port value.describe { value = $value } → shape
  let cells = list()
  when or($shape.plain, $shape.array):
    port record.entries { value = $value } → entries
    fold $entries as entry; cells starts $cells:
      let key = at($entry, 0)
      let item = at($entry, 1)
      port value.describe { value = $item } → childShape
      when and($shape.array, $childShape.plain):
        when not(eq(at($item, "id"), at({}, "absent"))):
          let key = $item.id
        when and(not(eq(at($item, "type"), at({}, "absent"))), not(eq(at($item, "alias"), at({}, "absent")))):
          let key = concat($item.type, " as ", if(eq($item.alias, ""), "unaliased", $item.alias))
      port kernel.invoke { query = "ui.flatten"; input = { value = $item; path = concat($path, "/", $key) } } → children
      let cells = append($cells, $children)
      yield $cells → cells
  when not(or($shape.plain, $shape.array)):
    port scalar.quoteValue { value = $value } → text
    let cells = list({ path = $path; value = $text })
  let result = $cells

process ui.review:
  let prepared = $session.prepared.value
  let before = $state
  port kernel.invoke { query = "app.load"; input = { revision = add($snapshot.revision, 1); documents = $prepared.documents } } → after
  port kernel.invoke { query = "ui.flatten"; input = { value = $before; path = "application" } } → oldCells
  port kernel.invoke { query = "ui.flatten"; input = { value = $after; path = "application" } } → newCells
  let paths = distinct(append(map($oldCells, "cell", $cell.path), map($newCells, "cell", $cell.path)))
  fold $paths as path; rows starts list():
    let old = filter($oldCells, "cell", eq($cell.path, $path))
    let new = filter($newCells, "cell", eq($cell.path, $path))
    let beforeText = if(count($old), at(at($old, 0), "value"), "not present")
    let afterText = if(count($new), at(at($new, 0), "value"), "not present")
    when not(eq($beforeText, $afterText)):
      let rows = append($rows, list({ tag = "tr"; attrs = {}; children = list({ tag = "th"; attrs = { scope = "row" }; children = list($path) }, { tag = "td"; attrs = {}; children = list($beforeText) }, { tag = "td"; attrs = {}; children = list($afterText) }) }))
    yield $rows → rows
  let headings = { tag = "tr"; attrs = {}; children = list({ tag = "th"; attrs = {}; children = list("Value") }, { tag = "th"; attrs = {}; children = list("Before") }, { tag = "th"; attrs = {}; children = list("After") }) }
  let table = { tag = "table"; attrs = {}; children = list({ tag = "caption"; attrs = {}; children = list("Exact semantic changes") }, { tag = "thead"; attrs = {}; children = list($headings) }, { tag = "tbody"; attrs = {}; children = $rows }) }
  let content = list({ tag = "h2"; attrs = {}; children = list("Review one change") }, { tag = "p"; attrs = {}; children = list($prepared.description) }, { tag = "p"; attrs = { class = "hint" }; children = list(concat("Reason: ", $prepared.command.reason, " · Target: ", $prepared.command.target, " · Goal: ", $prepared.command.goal, " · Base revision: ", $prepared.command.base)) }, $table)
  let content = append($content, list({ tag = "details"; attrs = {}; children = list({ tag = "summary"; attrs = {}; children = list("Decision and source basis") }, { tag = "pre"; attrs = {}; children = list(concat("Operation: ", $prepared.command.operationId, "\nProfile: ", $prepared.command.profile, "\nRuntime basis: ", $prepared.command.basis, "\nIntent source: ", $prepared.command.source)) }) }))
  fold $prepared.documents as document; content starts $content:
    let old = filter($documents, "item", eq($item.path, $document.path))
    when or(eq(count($old), 0), not(eq(at(at($old, 0), "text"), $document.text))):
      when not(eq($document.path, "application.rel")):
        let content = append($content, list({ tag = "details"; attrs = { open = true }; children = list({ tag = "summary"; attrs = {}; children = list(concat("Exact source: ", $document.path)) }, { tag = "pre"; attrs = {}; children = list($document.text) }) }))
    yield $content → content
  let form = { tag = "form"; attrs = { method = "post"; action = "/" }; children = list({ tag = "input"; attrs = { type = "hidden"; name = "_csrf"; value = $csrf }; children = list() }, { tag = "input"; attrs = { type = "hidden"; name = "review"; value = $prepared.command.operationId }; children = list() }, { tag = "button"; attrs = { name = "command"; value = "accept" }; children = list("Accept this change") }, { tag = "button"; attrs = { name = "command"; value = "cancel"; class = "secondary" }; children = list("Cancel") }) }
  let result = append($content, list($form))

process export.document:
  fold $state.projections as projection; views starts list():
    port kernel.invoke { query = "projection.value"; input = $projection } → mapping
    yield append($views, list({ tag = "section"; attrs = {}; children = list({ tag = "h2"; attrs = {}; children = list($projection.id) }, { tag = "p"; attrs = {}; children = list($mapping.value) }, { tag = "small"; attrs = {}; children = list(concat("Source: ", $mapping.source)) }) })) → views
  let input = { tag = "html"; attrs = { lang = "en" }; children = list({ tag = "head"; attrs = {}; children = list({ tag = "meta"; attrs = { charset = "utf-8" }; children = list() }, { tag = "title"; attrs = {}; children = list("Encounter export") }) }, { tag = "body"; attrs = {}; children = list({ tag = "main"; attrs = {}; children = append(list({ tag = "h1"; attrs = {}; children = list($state.intent) }), $views) }) }) }
  call html.serialize
  let result = concat("<!doctype html>", $result)

process ui.page:
  let state = $eventInput.state
  let snapshot = $eventInput.snapshot
  let session = $eventInput.session
  let csrf = $eventInput.csrf
  let documents = $snapshot.documents
  let content = list()
  when eq($session.prepared.case, "some"):
    port kernel.invoke { query = "ui.review"; input = null } → content
  when eq($session.prepared.case, "none"):
    let view = $session.view
    when eq($view, "work"):
      port kernel.invoke { query = "ui.work"; input = null } → content
    when eq($view, "type"):
      port kernel.invoke { query = "ui.type"; input = null } → content
    when eq($view, "thing"):
      port kernel.invoke { query = "ui.thing"; input = null } → content
    when eq($view, "projections"):
      port kernel.invoke { query = "ui.projections"; input = null } → content
    when eq($view, "actions"):
      port kernel.invoke { query = "ui.actions"; input = null } → content
    when eq($view, "jobs"):
      port kernel.invoke { query = "ui.jobs"; input = null } → content
    when eq($view, "history"):
      port kernel.invoke { query = "ui.history"; input = null } → content
    when eq($view, "sources"):
      port kernel.invoke { query = "ui.sources"; input = null } → content
  let navigation = map(list({ view = "work"; label = "Your work" }, { view = "projections"; label = "Projections" }, { view = "actions"; label = "Actions" }, { view = "jobs"; label = "Jobs" }, { view = "history"; label = "History" }, { view = "sources"; label = "Source" }), "item", { tag = "a"; attrs = { href = concat("/?view=", $item.view); "aria-current" = if(eq($session.view, $item.view), "page", null) }; children = list($item.label) })
  let input = { tag = "html"; attrs = { lang = "en" }; children = list({ tag = "head"; attrs = {}; children = list({ tag = "meta"; attrs = { charset = "utf-8" }; children = list() }, { tag = "meta"; attrs = { name = "viewport"; content = "width=device-width, initial-scale=1" }; children = list() }, { tag = "title"; attrs = {}; children = list("Encounter — your work") }, { tag = "link"; attrs = { rel = "stylesheet"; href = "/styles.css" }; children = list() }) }, { tag = "body"; attrs = {}; children = list({ tag = "a"; attrs = { href = "#main"; class = "skip" }; children = list("Skip to your work") }, { tag = "header"; attrs = {}; children = list({ tag = "div"; attrs = { class = "brand" }; children = list("Encounter") }, { tag = "p"; attrs = {}; children = list("Make something you can understand.") }, { tag = "nav"; attrs = { "aria-label" = "Workspace" }; children = $navigation }) }, { tag = "main"; attrs = { id = "main" }; children = append(list({ tag = "p"; attrs = { class = "notice"; role = "status" }; children = list($session.notice) }, { tag = "p"; attrs = { class = "revision" }; children = list(concat("Accepted revision ", $snapshot.revision, " · Local workspace")) }), $content) }, { tag = "footer"; attrs = {}; children = list("Your intent, your source, one checked change at a time.") }) }) }
  call html.serialize
  let result = concat("<!doctype html>", $result)

process ui.styles:
  let styles = list(
    { selector = "*"; declarations = { "box-sizing" = "border-box" } },
    { selector = "body"; declarations = { margin = "0"; color = "#203a38"; background = "#f5f2eb"; "font-family" = "system-ui,sans-serif"; "font-size" = "16px"; "line-height" = "1.6" } },
    { selector = "header,main,footer"; declarations = { "max-width" = "1100px"; margin = "auto"; padding = "24px clamp(18px,4vw,48px)" } },
    { selector = "header"; declarations = { "border-bottom" = "1px solid #d7ddd5" } },
    { selector = ".brand"; declarations = { "font-family" = "Georgia,serif"; "font-size" = "36px"; "font-weight" = "bold"; "letter-spacing" = "-1px" } },
    { selector = "nav"; declarations = { display = "flex"; "flex-wrap" = "wrap"; gap = "12px 22px"; "margin-top" = "18px" } },
    { selector = "a"; declarations = { color = "#205b53"; "text-underline-offset" = ".2em" } },
    { selector = ".links"; declarations = { display = "flex"; "flex-wrap" = "wrap"; gap = "8px 24px" } },
    { selector = "[aria-current=page]"; declarations = { "font-weight" = "bold"; "text-decoration-thickness" = "3px" } },
    { selector = "h1,h2,h3"; declarations = { "line-height" = "1.25"; "text-wrap" = "balance" } },
    { selector = "h2"; declarations = { "font-family" = "Georgia,serif"; "font-size" = "30px" } },
    { selector = "form,section,blockquote"; declarations = { background = "#fffefa"; border = "1px solid #d7ddd5"; "border-radius" = "12px"; padding = "clamp(16px,3vw,28px)"; margin = "20px 0" } },
    { selector = "label"; declarations = { display = "grid"; gap = "6px"; margin = "16px 0"; "font-weight" = "600" } },
    { selector = ".field"; declarations = { margin = "16px 0" } },
    { selector = ".field label"; declarations = { margin = "0 0 6px" } },
    { selector = "input,textarea,select,button"; declarations = { font = "inherit"; "max-width" = "100%"; "min-width" = "0" } },
    { selector = "input,textarea,select"; declarations = { width = "100%"; padding = "10px 12px"; border = "1px solid #718880"; "border-radius" = "6px"; background = "white"; color = "#182f2d" } },
    { selector = "input[type=checkbox]"; declarations = { width = "22px"; height = "22px" } },
    { selector = "textarea,pre"; declarations = { "font-family" = "ui-monospace,monospace"; "font-size" = "14px"; "white-space" = "pre-wrap"; "overflow-wrap" = "anywhere"; "tab-size" = "2" } },
    { selector = "button"; declarations = { background = "#245d53"; color = "white"; border = "0"; "border-radius" = "6px"; padding = "11px 18px"; cursor = "pointer"; "font-weight" = "600"; margin = "8px 8px 0 0" } },
    { selector = "button.secondary"; declarations = { background = "#e0e7de"; color = "#203a38" } },
    { selector = ":focus-visible"; declarations = { outline = "3px solid #a65318"; "outline-offset" = "4px" } },
    { selector = ".hint,.revision,small,footer"; declarations = { color = "#506761"; "font-size" = "14px" } },
    { selector = ".notice"; declarations = { "border-left" = "4px solid #9b6f2c"; padding = "12px 16px"; background = "#eee9dc" } },
    { selector = ".purpose"; declarations = { border = "0"; "border-top" = "1px solid #d7ddd5"; padding = "16px 0 0"; margin = "24px 0 12px" } },
    { selector = ".purpose label"; declarations = { "font-size" = "14px" } },
    { selector = "summary"; declarations = { cursor = "pointer"; padding = "12px 0"; "font-weight" = "600"; "overflow-wrap" = "anywhere" } },
    { selector = "table"; declarations = { width = "100%"; "border-collapse" = "collapse"; "table-layout" = "fixed"; "font-size" = "14px" } },
    { selector = "th,td"; declarations = { "text-align" = "left"; "vertical-align" = "top"; padding = "10px"; "border-bottom" = "1px solid #d7ddd5"; "overflow-wrap" = "anywhere"; "white-space" = "pre-wrap" } },
    { selector = "caption"; declarations = { "text-align" = "left"; "font-weight" = "bold"; padding = "12px 0" } },
    { selector = ".skip"; declarations = { position = "absolute"; left = "-9999px" } },
    { selector = ".skip:focus"; declarations = { left = "16px"; top = "8px"; background = "white"; padding = "8px" } }
  )
  fold $styles as style; rules starts list():
    port record.entries { value = $style.declarations } → entries
    let declarations = map($entries, "entry", { property = at($entry, 0); value = at($entry, 1) })
    yield append($rules, list({ selector = $style.selector; context = ""; declarations = $declarations })) → rules
  let cssPlan = { imports = list(); tokens = list(); rules = $rules }
  call css.renderPlan

process-module "temple/surface-process-module/1"
profile "encounter/reconstituted-source/1"

process lp.decode:
  try:
    port scalar.read { text = at(at($eventInput, "token"), "text") } → value
  catch decodeFault:
    port kernel.invoke {
      query = "lp.fail";
      input = {
        code = "PROC-TEXT-LEX";
        summary = "Invalid REL scalar.";
        token = at($eventInput, "token")
      }
    } → unused
  let result = $value

# Operative source-owned admission. No native checker selects these rules.
process-module "temple/surface-process-module/1"

process foundation.admit:
  let input = { queries = $eventInput.queries }
  let sourceQueries = $eventInput.queries
  let entries = $eventInput.entries
  let grants = $eventInput.grants
  port kernel.invoke { query = "foundation.sourceGuard"; input = { value = $sourceQueries; depth = 0 } } → _
  assert isArray($entries)
    otherwise "ADMISSION: Explicit entries required."
  assert count($entries)
    otherwise "ADMISSION: An entry is required."
  assert eq(count($entries), count(distinct($entries)))
    otherwise "ADMISSION: Duplicate entry."
  each $grants as grant:
    assert not(includes(list("kernel.execute", "kernel.evaluate", "json.parse", "json.stringify"), $grant))
      otherwise "ADMISSION: Raw model or object-codec grant is forbidden."
    assert includes($eventInput.available, $grant)
      otherwise "ADMISSION: Unavailable effect."
  let mode = "model"
  call lower.start
  let lowered = $result.value
  port record.entries { value = $lowered.queries } → queries
  each $entries as entry:
    assert some($queries, "query", eq(at($query, 0), $entry))
      otherwise "ADMISSION: Missing entry."
  let target = { queries = $lowered.queries; entry = at($entries, 0) }
  call admit.model
  each $queries as query:
    let programme = at($query, 1)
    call foundation.effects
  let result = { queries = $lowered.queries; entries = $entries; grants = $grants }

process foundation.effects:
  each $programme as statement:
    when at($statement, "port"):
      assert includes($grants, $statement.port)
        otherwise "ADMISSION: Undeclared effect."
    port record.entries { value = $statement } → fields
    each $fields as field:
      when includes(list("steps", "then", "try", "catch"), at($field, 0)):
        let programme = at($field, 1)
        call foundation.effects

process foundation.childGrants:
  let allowed = list("value.describe", "value.string", "value.type", "value.freeze", "value.encode", "record.entries", "record.fromEntries", "record.put", "record.get", "text.replaceAll", "text.split", "text.join", "text.slice", "text.indexOf", "text.compare", "text.trim", "text.lowerCase", "text.matches", "scalar.quote", "scalar.unquote", "rel.encode", "rel.decode", "rel.facts", "rel.print", "kernel.invoke", "encounter.execute", "encounter.evaluate")
  let result = filter($allowed, "name", includes($eventInput.available, $name))

process foundation.sourceGuard:
  port number.calculate { operation = "lessEqual"; values = list($eventInput.depth, 128) } → bounded
  assert $bounded
    otherwise "ADMISSION: Source structure exceeds its bound."
  let value = $eventInput.value
  port value.describe { value = $value } → shape
  when eq($shape.type, "string"):
    port text.slice { value = $value; start = 0; end = 7 } → prefix
    assert not(eq($prefix, concat(at(" $", 1), "__rel_")))
      otherwise "ADMISSION: Reserved generated reference."
  when $shape.array:
    each $value as item:
      port kernel.invoke { query = "foundation.sourceGuard"; input = { value = $item; depth = add($eventInput.depth, 1) } } → _
  when and($shape.plain, not($shape.array)):
    port record.entries { value = $value } → entries
    each $entries as entry:
      let key = at($entry, 0)
      when includes(list("let", "as", "accumulator", "into", "error"), $key):
        let item = at($entry, 1)
        port value.describe { value = $item } → bindingShape
        when eq($bindingShape.type, "string"):
          port text.slice { value = $item; start = 0; end = 6 } → prefix
          assert not(eq($prefix, "__rel_"))
            otherwise "ADMISSION: Reserved generated binding."
      port kernel.invoke { query = "foundation.sourceGuard"; input = { value = at($entry, 1); depth = add($eventInput.depth, 1) } } → _

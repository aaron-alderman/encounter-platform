process-module "temple/surface-process-module/1"
profile "encounter/reconstituted-source/1"

process lower.programme:
  port value.describe { value = $input } → kind
  assert $kind.array
    otherwise "Process must be an array"
  fold $input as statement; built starts { value = list(); context = $context }:
    port record.entries { value = $statement } → entries
    fold $entries as entry; fields starts { value = list(); context = $built.context }:
      let field = at($entry, 0)
      let context = $fields.context
      let result = { value = at($entry, 1); context = $context }
      when includes($definitions.statementFields.programmes, $field):
        fold list(at($entry, 1)) as invokeInput; invokeAcc starts null:
          let input = $invokeInput
          fold list(null) as callFrame; frameResult starts null:
            call lower.programme
            yield $result → result
          yield $result → result
      when includes($definitions.statementFields.expressions, $field):
        fold list(at($entry, 1)) as invokeInput; invokeAcc starts null:
          let input = $invokeInput
          fold list(null) as callFrame; frameResult starts null:
            call lower.expression
            yield $result → result
          yield $result → result
      yield {
      value = append($fields.value, list(list(at($entry, 0), $result.value)));
      context = $result.context
    } → fields
    port record.fromEntries { entries = $fields.value } → statement
    yield { value = append($built.value, list($statement)); context = $fields.context } → result

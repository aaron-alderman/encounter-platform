process-module "temple/surface-process-module/1"

process desk.styles:
  port kernel.invoke { query = "semantic.sourceStyles"; input = {} } → syntaxPalette
  let result = concat(
    ":root{font:13px Tahoma,Verdana,Arial,sans-serif;color:#171717;background:#9e9e99;color-scheme:light}",
    "*{box-sizing:border-box}",
    "[hidden]{display:none!important}",
    "html,body{height:100%;margin:0;overflow:hidden}",
    ".notes{height:100dvh;display:grid;grid-template-columns:minmax(0,1fr);grid-template-rows:28px 27px 39px minmax(0,1fr);padding:3px;background:#c8c7bf;border:2px outset #e2e1da}",
    ".caption{display:flex;align-items:center;gap:7px;padding:0 8px;color:white;background:linear-gradient(90deg,#00006c,#195294)}",
    ".mark{font-size:20px;color:#ffd25d}",
    ".caption h1{font-size:14px;margin:0}",
    ".edition{margin-left:auto;font-size:11px}",
    ".menu,.toolbar{display:flex;align-items:center;gap:5px;border-bottom:1px solid #85857d;padding:2px 6px}",
    ".menu a,.menu button{color:#171717;text-decoration:none;padding:3px 7px;background:none;border:1px solid transparent;white-space:nowrap}",
    ".menu a:hover,.menu button:hover{border:1px outset #eee}",
    ".toolbar label{font-weight:bold}",
    ".toolbar select{min-width:0;max-width:calc(100% - 75px);font:inherit;background:#fffdf3;border:2px inset #ddd;padding:2px 4px}",
    ".workbench{min-height:0;display:grid;grid-template-columns:200px minmax(0,1fr);gap:4px;padding-top:4px}",
    ".workbench nav{border:2px inset #dfded7;background:#f8f5df;padding:6px;overflow:hidden}",
    ".folder{font-weight:bold;color:#1c2850;margin:9px 0 3px}",
    ".folder::before{content:'▣ ';color:#a57112}",
    ".workbench nav button{font:inherit;text-align:left;display:block;width:100%;padding:3px 5px 3px 15px;border:0;background:none;text-overflow:ellipsis;overflow:hidden;white-space:nowrap}",
    ".workbench nav button[aria-current=true]{background:#000080;color:white}",
    ".book{min-height:0;min-width:0;display:grid;grid-template-rows:auto auto minmax(0,1fr) 32px;border:2px inset #eee;background:#fffef5}",
    ".tabs{display:flex;gap:2px;flex-wrap:wrap;padding:4px 4px 0;background:#c8c7bf;border-bottom:1px solid #808079}",
    "button{font:inherit;color:inherit;background:#deddd5;border:2px outset #ededdf;cursor:pointer;padding:3px 8px}",
    "button:active,button[aria-pressed=true]{border-style:inset;background:#f8ecb3}",
    "button:disabled{color:#676760;cursor:default}",
    ".document-head{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:5px 8px;background:#fff1b5;border-bottom:1px solid #aba381}",
    ".document-head h2{font-size:15px;line-height:1.15;margin:0}",
    ".document-head span{color:#474333;text-align:right;font-size:11px}",
    ".reading{min-height:0;min-width:0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:4px;padding:5px}",
    ".reading.single{grid-template-columns:minmax(0,1fr)}",
    ".column{display:grid;grid-template-rows:23px minmax(0,1fr);min-height:0;min-width:0;border:2px inset #e2e1d8;background:#fffdf4}",
    ".column h3{margin:0;padding:3px 6px;font-size:12px;border-bottom:1px solid #aba79c;background:#e5e9f3}",
    ".column pre{margin:0;padding:5px 7px;font:13px/18px 'Courier New',monospace;white-space:pre-wrap;overflow-wrap:anywhere;overflow:hidden}",
    ".status{display:grid;grid-template-columns:minmax(0,1fr) auto minmax(0,auto) auto;gap:4px;align-items:center;background:#c8c7bf;border-top:1px solid #85857d;padding:2px 4px;font-size:12px}",
    "body:has(#aster-desktop:not([hidden])) .notes .status{padding-inline-end:92px}",
    ".status span{padding:3px 6px;border:1px inset #deddd5;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}",
    ".filebox{padding:5px 10px;min-height:0}",
    ".filebox h3{margin:4px 0}",
    ".filebox div{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:4px;margin-bottom:9px}",
    ".filebox a{padding:4px;color:#000080;background:#f8f0c9;border:1px solid #a9a187}",
    "@media(max-height:600px){.filebox{padding:3px 8px;font-size:11px}.filebox h3{margin:2px 0;font-size:12px}.filebox a{padding:2px}.filebox div{gap:3px;margin-bottom:4px}.filebox button{font-size:11px;padding:2px 4px}#benchmark-status{margin:3px 0;line-height:1.2}}",
    "button:focus-visible,a:focus-visible,select:focus-visible{outline:2px dotted #12126e;outline-offset:1px}",
    "@media(max-width:740px),(max-height:470px){.workbench{grid-template-columns:minmax(0,1fr)}.workbench nav{display:none}}",
    "@media(max-width:430px){body:has(.notes) #aster-kernel-menu{inset:7px 10px auto auto}.edition,.document-head span{display:none}.tabs button{padding-inline:5px}.column pre{font-size:12px;line-height:16px;padding:4px}.caption h1{font-size:13px}.status button{padding-inline:5px}#counter{padding-inline:2px}}",
    ".trace-controls{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.5fr);align-items:center;gap:3px 8px;padding:4px 6px;background:#deddd5;border-bottom:1px solid #85857d}",
    ".trace-pickers,.trace-pickers label{display:flex;align-items:center;gap:4px;min-width:0}",
    ".trace-pickers select{min-width:0;max-width:100%;font:inherit;background:#fffdf4}",
    ".trace-pickers .site-picker{flex:1}",
    ".site-picker select{flex:1}",
    ".trace-controls a,.source-controls span{grid-column:1/-1;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}",
    ".trace-controls a{color:#000080}",
    ".source-controls{grid-template-columns:auto minmax(0,1fr)}",
    ".source-controls span{grid-column:auto}",
    "@media(max-width:890px){.trace-controls{grid-template-columns:minmax(0,1fr)}.trace-pickers label{flex:1}.source-controls{grid-template-columns:auto minmax(0,1fr)}}",
    ".source-tools{grid-column:1/-1;display:flex;align-items:center;gap:4px;flex-wrap:wrap}.source-tools form{display:flex;gap:3px}.source-tools input,#trace-search{min-width:0;font:inherit;background:#fffdf4;border:1px inset #c8c7bf;padding:3px}.source-tools input[type=number]{width:7ch}.source-tools input[type=search]{width:15ch}.trace-controls #trace-search{max-width:100%;width:19ch}",
    $syntaxPalette,
    ".column pre.rich-body{font:13px/1.42 Tahoma,Verdana,Arial,sans-serif;padding:7px 9px}.rich-heading{color:#1c3565;letter-spacing:.025em}.rich-positive{color:#215b3a}.rich-warning{color:#80520c}.rich-negative{color:#922d2d}.rich-note{color:#454e63}.rich-code{color:#254d7a;font-family:'Courier New',monospace}.column pre a{color:#153d88;text-decoration:underline;text-underline-offset:2px}.column pre a:hover{background:#fff0a2}#left h3{border-left:3px solid #355b92}#right h3{background:#e3eee5;border-left:3px solid #397355}@media(max-width:430px){.column pre.rich-body{font-size:12px;padding:4px 5px}}",
    ".trace-search-row{grid-column:1/-1;display:flex;justify-content:space-between;gap:5px;min-width:0}.trace-mode{display:flex;gap:8px;align-items:center;min-width:0}.trace-mode label{white-space:nowrap}.trace-mode span{font-size:11px;color:#475168}.rich-change{background:#ffe39b;color:#623100;border-bottom:1px solid #d2a549}.rich-json-key{color:#174b85;font-weight:bold}.rich-json-string{color:#8d3526}.rich-json-number{color:#743a83}.rich-json-literal{color:#206045;font-weight:bold}.trace-search-row #trace-search{flex:1}.trace-search-row .trace-mode{flex:none}",
    ".reply-controls{display:flex;align-items:center;gap:5px;padding:3px 6px;border-bottom:1px solid #85857d;background:#deddd5}.reply-controls label{margin-inline-end:6px;white-space:nowrap}.reply-controls span{min-width:8ch;text-align:center;color:#475168;font-size:11px}.reply-change{color:inherit;background:#fff0b5}"
  )
